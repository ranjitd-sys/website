# DeepRank SEO Agent — copy to `.env` and fill in real values.
# See docs/deeprank-seo-agent.md §21 for where to get each credential.

# PostgreSQL (P2)
SEO_DATABASE_URL=postgres://user:password@host:5432/deeprank

# Google Search Console (P3)
GSC_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY----"
GSC_SITE_URL=https://deepecom.com

# Google Analytics 4 (P3)
GA_PROPERTY_ID=your_ga4_property_id

# OpenAI driver + reviewer (P4+)
OPENAI_API_KEY=your_openai_api_key

# GitHub PAT — contents + pull_requests scope (P8)
GITHUB_TOKEN=your_github_token
