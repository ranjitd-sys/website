# DeepRank SEO Agent — copy to `.env` and fill in real values.
# See docs/deeprank-seo-agent.md §21 for where to get each credential.

# PostgreSQL (P2)
SEO_DATABASE_URL=postgres://user:password@host:5432/deeprank

# Google Search Console (P3) — creds still PENDING; stub used until granted
GSC_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY----"
GSC_SITE_URL=https://deepecom.com

# LLM (P4) — required for real plan/act/revise/review/learn; omit => stub mode
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REVIEWER_MODEL=openai/gpt-oss-120b

# GitHub PAT — contents + pull_requests scope (P5)
# Must be a real PAT for live branch/commit/draft-PR; a placeholder keeps dry-runs green.
GITHUB_TOKEN=your_github_token

# SerpApi (P5) — real SERP results; omit => seeded mock fallback
SERPAPI_KEY=