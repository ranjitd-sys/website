# DeepRank SEO Agent — copy to `.env` and fill in real values.
# See docs/deeprank-seo-agent.md §21 for where to get each credential.

# PostgreSQL (P2)
SEO_DATABASE_URL=postgres://user:password@host:5432/deeprank

# Google Search Console (P3) — OPTIONAL; creds still PENDING, stub used until granted.
# Empty values => stub metrics, the run stays green.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=""
GSC_SITE_URL=

# LLM (P4) — required for real plan/act/revise/review/learn; omit => stub mode
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REVIEWER_MODEL=openai/gpt-oss-120b

# GitHub PAT — OPTIONAL for dry-runs / Actions (which fall back to github.token).
# A real PAT (contents + pull_requests scope) is required for live branch/commit/draft-PR.
GITHUB_TOKEN=

# SerpApi (P5) — OPTIONAL; real SERP results; omit => seeded mock fallback
SERPAPI_KEY=