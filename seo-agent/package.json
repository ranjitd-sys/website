{
  "name": "deeprank-seo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepRank — DeepEcom's autonomous SEO agent. Built on Effect.",
  "scripts": {
    "dev": "bun run --hot src/cli.ts optimize",
    "check": "tsc --noEmit",
    "migrate": "bun run src/store/migrate.ts",
    "seed": "bun run src/store/seed.ts",
    "optimize": "bun run src/cli.ts optimize",
    "measure": "bun run src/cli.ts measure",
    "probe:reviewer": "bun run src/agent/reviewerProbe.ts"
  },
  "dependencies": {
    "effect": "4.0.0-beta.100",
    "node-html-parser": "^9.0.4",
    "octokit": "^5.0.5",
    "pg": "^8.22.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^7.0.2"
  }
}