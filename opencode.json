{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI",

      "options": {
        "baseURL": "https://api.b.ai/v1",
        "apiKey": "{env:BAI_API_KEY}"
      },

      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    }
  },

  "model": "bai/deepseek-v4-flash"
}