# GitHub OAuth — DeepEcom Careers Institute
# Copy this file to `.env` and fill in real values.

# GitHub OAuth app credentials
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Restrict sign-in to a single GitHub organization (optional)
# Optional: restrict login to a single GitHub org. Leave empty to allow everyone.
ALLOWED_GITHUB_ORG=

# Session encryption secret — a 64-char hex string (32 bytes) for AES-256-GCM.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=generate_with_openssl_rand_hex_32

# SMTP — sends Book a Demo / Contact form submissions to INFO_EMAIL.
# Example for a Google Workspace account, or your mail server / SMTP relay.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Optional. Sender address (with your verified domain). Defaults to SMTP_USER.
SMTP_FROM=no-reply@deepecom.com
# Recipient for demo requests.
INFO_EMAIL=info@deepecom.com
