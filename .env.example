# GitHub OAuth — DeepEcom Careers Institute
# Copy this file to `.env` and fill in real values.

# GitHub OAuth app credentials
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Restrict sign-in to a single GitHub organization (optional)
# Optional: restrict login to a single GitHub org. Leave empty to allow everyone.
ALLOWED_GITHUB_ORG=

# Session encryption secret — a 64-char hex string (32 bytes) for AES-256-GCM.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=generate_with_openssl_rand_hex_32

# Resend — sends Book a Demo / Contact form submissions.
# https://resend.com → Dashboard → API Keys → create a key.
# Then verify your sending domain under Resend → Domains (or use onboarding@resend.dev for testing).
RESEND_API_KEY=re_your_api_key_here
# Must be a verified sender on a verified domain.
RESEND_FROM=DeepEcom <no-reply@deepecom.com>
# Recipient for demo requests (your inbox).
INFO_EMAIL=info@deepecom.com
