{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/github/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/github/repos/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/github/select-repo/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/github/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/careers/analyze-repo/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/careers/submit-quiz/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/careers/analysis-report/?$",
			"dest": "_render"
		},
		{
			"src": "^/careers/?$",
			"dest": "_render"
		},
		{
			"src": "^/careers(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}