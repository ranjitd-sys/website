---
const showConsent = Boolean(import.meta.env.PUBLIC_CLARITY_ID)
---

{
  showConsent && (
    <aside id="analytics-consent" class="analytics-consent" aria-labelledby="analytics-consent-title" hidden>
      <span class="analytics-consent-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18" />
          <path d="M7 15v2" />
          <path d="M12 11v6" />
          <path d="M17 7v10" />
        </svg>
      </span>

      <div class="analytics-consent-copy">
        <div class="analytics-consent-heading">
          <h2 id="analytics-consent-title" tabindex="-1">
            Optional analytics
          </h2>
          <span class="analytics-consent-tag">Microsoft Clarity</span>
        </div>
        <p>
          Help us improve DeepEcom. We use Clarity to understand how visitors use the site. It stays off unless you accept, and is disabled on label tools. Read our
          <a href="/privacy-policy">Privacy Policy</a>.
        </p>
      </div>

      <div class="analytics-consent-actions">
        <button type="button" data-analytics-choice="rejected">
          Reject
        </button>
        <button type="button" data-analytics-choice="accepted">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          Accept analytics
        </button>
      </div>
    </aside>
  )
}

<style>
  .analytics-consent {
    position: fixed;
    z-index: 80;
    inset-inline: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem 1rem;
    width: min(calc(100% - 2rem), 56rem);
    margin-inline: auto;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface, #fff) 94%, transparent);
    color: var(--foreground);
    box-shadow: var(--shadow-popover, 0 20px 40px -12px rgb(10 24 54 / 18%));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    animation: consent-in 380ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
  }

  .analytics-consent[hidden] {
    display: none;
  }

  .analytics-consent-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--brand-100);
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand-50), #fff);
    box-shadow: inset 0 1px 0 #fff;
    color: var(--brand-600);
  }

  .analytics-consent-copy {
    min-width: 0;
  }

  .analytics-consent-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .analytics-consent h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-950);
  }

  .analytics-consent h2:focus {
    border-radius: 4px;
    outline: 2px solid var(--brand-300);
    outline-offset: 3px;
  }

  .analytics-consent-tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--brand-100);
    border-radius: 999px;
    background: var(--brand-50);
    color: var(--brand-700);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .analytics-consent p {
    max-width: 44rem;
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-600);
  }

  .analytics-consent a {
    color: var(--brand-700);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brand-600) 40%, transparent);
    text-underline-offset: 0.15em;
  }

  .analytics-consent a:hover {
    text-decoration-color: currentColor;
  }

  .analytics-consent-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
  }

  .analytics-consent-actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: 10px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--transition-fast, 150ms ease),
      border-color var(--transition-fast, 150ms ease),
      color var(--transition-fast, 150ms ease),
      box-shadow var(--transition-fast, 150ms ease),
      transform var(--transition-fast, 150ms ease);
  }

  .analytics-consent-actions button:active {
    transform: translateY(1px);
  }

  .analytics-consent-actions [data-analytics-choice="rejected"] {
    border: 1px solid var(--border);
    background: var(--surface, #fff);
    color: var(--ink-700);
  }

  .analytics-consent-actions [data-analytics-choice="rejected"]:hover {
    border-color: var(--ink-300);
    background: var(--ink-50);
    color: var(--ink-900);
  }

  .analytics-consent-actions [data-analytics-choice="accepted"] {
    border: 1px solid var(--brand-600);
    background: linear-gradient(180deg, var(--brand-600) 0%, var(--brand-700) 100%);
    box-shadow:
      0 1px 2px rgb(33 101 236 / 28%),
      inset 0 1px 0 rgb(255 255 255 / 20%);
    color: #fff;
  }

  .analytics-consent-actions [data-analytics-choice="accepted"]:hover {
    background: linear-gradient(180deg, var(--brand-600) 0%, var(--brand-800) 100%);
    box-shadow:
      0 4px 12px -2px rgb(33 101 236 / 35%),
      inset 0 1px 0 rgb(255 255 255 / 18%);
  }

  .analytics-consent-actions [data-analytics-choice="accepted"] svg {
    flex: none;
  }

  .analytics-consent button:focus-visible,
  .analytics-consent a:focus-visible {
    outline: 2px solid var(--brand-300);
    outline-offset: 2px;
  }

  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @media (max-width: 52rem) {
    .analytics-consent {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .analytics-consent-actions {
      grid-column: 1 / -1;
    }

    .analytics-consent-actions button {
      flex: 1;
    }
  }

  @media (max-width: 34rem) {
    .analytics-consent {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.75rem;
      border-radius: 14px;
    }

    .analytics-consent-icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .analytics-consent {
      animation: none;
    }

    .analytics-consent-actions button {
      transition: none;
    }
  }
</style>

<script is:inline>
  ;(() => {
    if (!document.getElementById("analytics-consent")) return
    const storageKey = "deepecom-analytics-consent-v1"
    const banner = document.getElementById("analytics-consent")
    const settingsButton = document.getElementById("analytics-settings")
    if (!banner) return

    const choiceButtons = banner.querySelectorAll("[data-analytics-choice]")
    const focusTitle = () => banner.querySelector("#analytics-consent-title")?.focus()
    const emitConsentChange = () => {
      document.dispatchEvent(new Event("deepecom:analytics-consent"))
    }

    let savedChoice = ""
    try {
      savedChoice = localStorage.getItem(storageKey) || ""
    } catch {}

    banner.hidden = savedChoice === "accepted" || savedChoice === "rejected"
    settingsButton?.setAttribute("aria-expanded", String(!banner.hidden))

    settingsButton?.addEventListener("click", () => {
      banner.hidden = false
      settingsButton.setAttribute("aria-expanded", "true")
      focusTitle()
    })

    choiceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.dataset.analyticsChoice
        if (choice !== "accepted" && choice !== "rejected") return

        try {
          localStorage.setItem(storageKey, choice)
        } catch {
          return
        }

        banner.hidden = true
        settingsButton?.setAttribute("aria-expanded", "false")
        emitConsentChange()
      })
    })
  })()
</script>
