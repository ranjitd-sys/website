---
import { Eye, Scale, TrendingUp, BookOpenCheck } from "lucide-react"

const results = [
  { icon: Eye, title: "Understand", desc: "One connected view of sales, costs and profitability across every channel.", tone: "violet" },
  { icon: Scale, title: "Reconcile", desc: "Expected payments matched to received amounts, order by order.", tone: "emerald" },
  { icon: TrendingUp, title: "Grow on real numbers", desc: "Decisions based on actual margins, not estimates.", tone: "sky" },
  { icon: BookOpenCheck, title: "Close the books faster", desc: "Detailed ERP accounting ready when month-end arrives.", tone: "amber" },
]
---

<section class="rs-section">
  <div class="sec">
    <div class="rs-panel reveal">
      <div class="rs-grid">
        {results.map((r, i) => {
          const Icon = r.icon
          return (
            <div class="rs-item" data-delay={i * 60}>
              <span class={`rs-icon tone-${r.tone}`}><Icon size={18} /></span>
              <div>
                <h3 class="rs-title">{r.title}</h3>
                <p class="rs-desc">{r.desc}</p>
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .rs-section { padding: clamp(2rem, 4vh, 3.5rem) 0; }
  .rs-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1.5rem;
    background:
      radial-gradient(120% 120% at 100% -20%, rgba(92, 148, 255, 0.35), transparent 50%),
      linear-gradient(150deg, #0a317c 0%, #0d42aa 45%, #2165EC 130%);
    padding: clamp(2.25rem, 5vw, 3.75rem) var(--space-gutter);
    color: #fff;
  }
  .rs-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(80% 70% at 50% 0%, #000, transparent);
  }
  .rs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 48rem) {
    .rs-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem 2.5rem; }
  }
  .rs-item { display: flex; align-items: flex-start; gap: 1rem; }
  .rs-icon {
    flex: none;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: 12px;
  }
  .rs-icon.tone-violet { background: rgba(164, 197, 255, 0.25); border: 1px solid rgba(164, 197, 255, 0.45); color: #d8d0ff; }
  .rs-icon.tone-emerald { background: rgba(34, 197, 94, 0.22); border: 1px solid rgba(34, 197, 94, 0.45); color: #86efac; }
  .rs-icon.tone-sky { background: rgba(59, 130, 246, 0.22); border: 1px solid rgba(59, 130, 246, 0.45); color: #93c5fd; }
  .rs-icon.tone-amber { background: rgba(245, 158, 11, 0.22); border: 1px solid rgba(245, 158, 11, 0.45); color: #fcd34d; }

  .rs-title { font-size: 1.05rem; font-weight: 700; color: #fff; letter-spacing: -0.01em; }
  .rs-desc { margin-top: 0.3rem; font-size: 0.88rem; line-height: 1.6; color: rgba(255, 255, 255, 0.72); }
</style>