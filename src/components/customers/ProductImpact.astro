---
import { LayoutDashboard, ScanSearch, BookOpenCheck, Plug2, Check } from "lucide-react"

const areas = [
  {
    icon: LayoutDashboard,
    key: "UNDERSTAND",
    title: "Understand",
    color: "#2165EC",
    bg: "var(--brand-50)",
    bd: "var(--brand-100)",
    features: ["Dashboard", "Profitability", "Reports", "Channel Performance"],
  },
  {
    icon: ScanSearch,
    key: "RECONCILE",
    title: "Reconcile",
    color: "#16a34a",
    bg: "#f0fdf4",
    bd: "#dcfce7",
    features: ["Payment Reconciliation", "Expected vs Received", "Settlement Matching"],
  },
  {
    icon: BookOpenCheck,
    key: "ACCOUNT",
    title: "Account",
    color: "#2563eb",
    bg: "#eff6ff",
    bd: "#dbeafe",
    features: ["Order-wise Accounting", "GST", "Warehouse Accounting", "Stock Transfers"],
  },
  {
    icon: Plug2,
    key: "CONNECT",
    title: "Connect",
    color: "#d97706",
    bg: "#fffbeb",
    bd: "#fef3c7",
    features: ["Marketplaces", "Payment Gateways", "ERP Systems", "Shipping Partners"],
  },
]
---

<section class="pi-section">
  <div class="sec">
    <div class="pi-head reveal">
      <span class="eyebrow">WHAT DEEPECOM DOES</span>
      <h2 class="pi-title">A financial layer built around how ecommerce actually works.</h2>
      <p class="pi-lead">
        The same connected foundation powers every customer outcome — understand it,
        reconcile it, account for it.
      </p>
    </div>

    <div class="pi-steps reveal" data-delay="100">
      {areas.map((a, i) => {
        const Icon = a.icon
        return (
          <div class="pi-step" style={`--a-color:${a.color}; --a-bg:${a.bg}; --a-bd:${a.bd}`}>
            <span class="pi-step-num">0{i + 1}</span>
            <div class="pi-step-head">
              <span class="pi-step-icon"><Icon size={18} /></span>
              <div>
                <span class="pi-step-key">{a.key}</span>
                <h3 class="pi-step-title">{a.title}</h3>
              </div>
            </div>
            <ul class="pi-features">
              {a.features.map((f) => (
                <li class="pi-feat">
                  <span class="pi-feat-check"><Check size={11} /></span>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        )
      })}
    </div>
  </div>
</section>

<style>
  .pi-section { padding: clamp(3rem, 6vh, 5rem) 0; background: var(--ink-50); }
  .pi-head { max-width: 46rem; }
  .pi-title { margin-top: 0.9rem; font-size: clamp(1.75rem, 3vw, 2.4rem); line-height: 1.12; letter-spacing: -0.03em; font-weight: 800; color: var(--ink-950); }
  .pi-lead { margin-top: 0.9rem; font-size: 1.02rem; line-height: 1.7; color: var(--ink-500); max-width: 40rem; }

  .pi-steps {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 56rem) { .pi-steps { grid-template-columns: repeat(4, 1fr); } }

  .pi-step {
    position: relative;
    background: #fff;
    border: 1px solid var(--ink-200);
    border-radius: 16px;
    padding: 1.5rem 1.4rem;
    box-shadow: 0 1px 2px rgba(11, 17, 32, 0.04), 0 12px 28px -16px rgba(11, 17, 32, 0.12);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .pi-step::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--a-color), transparent 70%);
    opacity: 0.5;
  }
  .pi-step:hover {
    transform: translateY(-4px);
    border-color: var(--a-bd);
    box-shadow: 0 20px 40px -20px color-mix(in srgb, var(--a-color) 45%, transparent), 0 12px 28px -16px rgba(11, 17, 32, 0.14);
  }
  .pi-step-num { position: absolute; top: 1.1rem; right: 1.2rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; color: var(--ink-300); }
  .pi-step-head { display: flex; align-items: center; gap: 0.75rem; }
  .pi-step-icon {
    flex: none;
    width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 11px;
    color: var(--a-color);
    background: var(--a-bg);
    border: 1px solid var(--a-bd);
  }
  .pi-step-key { display: block; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; color: var(--a-color); }
  .pi-step-title { margin-top: 0.1rem; font-size: 1.02rem; font-weight: 700; color: var(--ink-900); letter-spacing: -0.01em; }
  .pi-features { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .pi-feat { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--ink-600); line-height: 1.4; }
  .pi-feat-check {
    flex: none; width: 17px; height: 17px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--a-bg); color: var(--a-color);
    border: 1px solid var(--a-bd);
  }
</style>