---
// inputs/outputs arrays no longer needed for rendering — SVG has them baked in
---

<section class="tf-section">
  <div class="tf-ambient" aria-hidden="true"></div>
  <div class="tf-container">
    <div class="tf-grid">
      <!-- LEFT COPY HEADER (unchanged) -->
      <header class="tf-copy reveal">
        <span class="eyebrow">THE TRANSFORMATION</span>
        <h2 class="tf-title">Then it all flows through one layer.</h2>
        <p class="tf-lead">
          DeepEcom sits between your systems. Fragmented inputs go in, one
          connected financial picture comes out — ready to understand, reconcile
          and account.
        </p>
        <div class="tf-points">
          <div class="tf-point">
            <span class="tf-point-dot" style="background:#533afd"></span>
            <span><strong>Understand</strong> — one view of sales and profitability</span>
          </div>
          <div class="tf-point">
            <span class="tf-point-dot" style="background:#22c55e"></span>
            <span><strong>Reconcile</strong> — expected vs received, order by order</span>
          </div>
          <div class="tf-point">
            <span class="tf-point-dot" style="background:#3b82f6"></span>
            <span><strong>Account</strong> — detailed ERP entries, automatically</span>
          </div>
        </div>
      </header>

      <!-- RIGHT VISUAL: single pre-built SVG, replaces the whole chip/conduit/engine markup -->
      <div class=" reveal" data-delay="120">
        <img
          src="/images/deepecom_diagram.svg"
          alt="Fragmented inputs like marketplaces, payments, fees, returns and inventory flow through DeepEcom's understand, reconcile and account layer, producing profitability, reconciliation, reports and ERP accounting."
          class="tf-diagram-img"
          width="805"
          height="540"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .tf-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3rem, 6vh, 5rem) 0;
  }

  .tf-ambient {
    position: absolute;
    inset: -10% -5% auto;
    z-index: -2;
    height: 40rem;
    background: radial-gradient(
      48rem 24rem at 82% 10%,
      rgba(83, 58, 253, 0.08),
      transparent 60%
    );
    pointer-events: none;
  }

  .tf-container {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 var(--space-gutter, 1.5rem);
  }

  .tf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .tf-grid {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  .tf-title {
    margin-top: 0.9rem;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--ink-950, #0f172a);
  }

  .tf-lead {
    margin-top: 0.9rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ink-500, #64748b);
    max-width: 36rem;
  }

  .tf-points {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tf-point {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-600, #475569);
  }

  .tf-point strong {
    color: var(--ink-900, #0f172a);
    font-weight: 700;
  }

  .tf-point-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 0.4em;
  }

  /* ---- FLOW CONTAINER: now just frames the SVG ---- */
  .tf-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.25rem 1.5rem;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 20px;
    background: linear-gradient(180deg, #ffffff 0%, #fcfcff 100%);
    box-shadow:
      0 1px 2px rgba(11, 17, 32, 0.04),
      0 22px 44px -18px rgba(83, 58, 253, 0.14),
      0 14px 30px -12px rgba(11, 17, 32, 0.1);
    position: relative;
  }

  .tf-diagram-img {
    width: 100%;
    height: auto;
    max-width: 640px;
    display: block;
  }

  @media (max-width: 40rem) {
    .tf-flow {
      padding: 1.5rem 1rem;
    }
  }
</style>