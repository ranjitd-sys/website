---
import { customers } from "@/data/customers"
import { logoAsset } from "@/data/logoAssets"

const logoed = customers.map((c) => ({
  customer: c,
  logo: logoAsset(c.slug),
}))
---

<section class="ls-section">
  <div class="sec">
    <div class="ls-inner reveal">
      <span class="ls-label">TRUSTED BY BUSINESSES ACROSS MARKETPLACES, D2C AND ENTERPRISE</span>
      <div class="ls-row">
        {logoed.map(({ customer: c, logo }) => (
          <div class="ls-item">
            {logo ? (
              <img
                src={logo.src}
                alt={`${c.logoText} logo`}
                class="ls-logo-img"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="ls-logo">{c.logoText}</span>
            )}
            <span class="ls-rule" aria-hidden="true"></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ls-section { padding: clamp(0.5rem, 1.5vh, 1rem) 0 clamp(1.25rem, 2.5vh, 2rem); }
  .ls-inner { text-align: center; }
  .ls-label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-400); }
  .ls-row { margin-top: 1.1rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2rem; }
  .ls-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }
  .ls-logo {
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--ink-300);
    letter-spacing: -0.015em;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .ls-item:hover .ls-logo { color: var(--ink-500); }
  .ls-logo-img {
    width: auto;
    height: 28px;
    max-width: 100px;
    object-fit: contain;
    opacity: 0.62;
    filter: grayscale(1);
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .ls-item:hover .ls-logo-img { opacity: 1; filter: grayscale(0); }
  .ls-rule {
    width: 1px; height: 18px;
    background: var(--ink-200);
  }
  .ls-item:last-child .ls-rule { display: none; }
</style>