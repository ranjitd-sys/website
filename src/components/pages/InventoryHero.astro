---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const warehouseA = { code: "DEL-01", name: "Delhi", qty: "100", value: "₹24,900.00" }
const warehouseB = { code: "MUM-02", name: "Mumbai", qty: "0", value: "—" }
const transfer = { id: "TRF-8831", qty: "100", value: "₹24,900.00", sku: "SKU-2048" }
const ledgerRows = [
  { txn: "Stock — DEL-01", debit: "", credit: "₹24,900.00" },
  { txn: "Stock — MUM-02", debit: "₹24,900.00", credit: "" },
]
---

<style is:global>
  .inv-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 0 clamp(2.5rem, 5vh, 4rem);
    background:
      radial-gradient(44rem 22rem at 80% -12%, rgba(47, 114, 240, 0.12), transparent 60%),
      radial-gradient(32rem 16rem at 6% -8%, rgba(127, 125, 252, 0.09), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .inv-hero-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .inv-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.25rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .inv-hero-grid {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  /* ---------- Left ---------- */
  .inv-copy {
    max-width: 35rem;
  }
  .inv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .inv-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }
  .inv-title {
    margin-top: 1.05rem;
    font-size: clamp(2.35rem, 4.2vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .inv-title .accent {
    color: var(--brand-500);
  }
  .inv-lead {
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }
  .inv-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .inv-importance {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--brand-100);
    border-radius: 0.75rem;
    background: linear-gradient(180deg, #fff, var(--brand-50));
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-600);
  }
  .inv-importance svg {
    flex: none;
    color: var(--brand-600);
  }
  .inv-importance b {
    color: var(--ink-900);
    font-weight: 700;
  }

  /* ---------- Right: stock transfer visual ---------- */
  .inv-visual {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .inv-visual-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    background: var(--ink-50);
    border-bottom: 1px solid var(--ink-200);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .inv-visual-head .id {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }
  .inv-transfer {
    position: relative;
    padding: 1.1rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.6rem;
    align-items: center;
  }
  .inv-wh {
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
    padding: 0.8rem 0.75rem;
    text-align: center;
  }
  .inv-wh.from {
    border-color: var(--brand-200);
    background: var(--brand-50);
  }
  .inv-wh-code {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .inv-wh-name {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-900);
  }
  .inv-wh-sub {
    margin-top: 0.25rem;
    font-size: 0.68rem;
    color: var(--ink-400);
  }
  .inv-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .inv-flow-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--brand-200);
  }
  .inv-flow-dot {
    position: absolute;
    top: 0;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
    animation: inv-slide 1.6s linear infinite;
  }
  .inv-flow-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-600);
    white-space: nowrap;
  }
  @keyframes inv-slide {
    0% { top: 0; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { top: calc(100% - 7px); opacity: 0; }
  }
  .inv-detail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0 1.1rem 1rem;
  }
  .inv-detail-box {
    border: 1px solid var(--ink-100);
    border-radius: 0.5rem;
    background: var(--ink-50);
    padding: 0.5rem;
    text-align: center;
  }
  .inv-detail-box .k {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-400);
  }
  .inv-detail-box .v {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-900);
    font-variant-numeric: tabular-nums;
  }
  .inv-ledger {
    border-top: 1px solid var(--ink-200);
    background: var(--ink-50);
    padding: 0.6rem 1.1rem;
  }
  .inv-ledger-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    font-size: 0.75rem;
  }
  .inv-ledger-row .txn {
    color: var(--ink-600);
    font-weight: 600;
  }
  .inv-ledger-row .amt {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .inv-ledger-row .amt.cr {
    color: var(--danger-600);
  }
  .inv-ledger-row .amt.dr {
    color: var(--success-600);
  }
  .inv-ledger-foot {
    padding: 0.75rem 1.1rem;
    border-top: 1px solid var(--ink-200);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-600);
    background: #fff;
  }
  .inv-ledger-foot .ok {
    margin-left: auto;
    color: var(--success-600);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 47.99rem) {
    .inv-hero {
      padding-top: 5rem;
    }
    .inv-title {
      font-size: clamp(2rem, 8.5vw, 2.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .inv-flow-dot {
      animation: none;
      opacity: 0;
    }
  }
</style>

<section class="inv-hero" data-hero>
  <div class="inv-hero-inner">
    <div class="inv-hero-grid">
      <!-- Left -->
      <div class="inv-copy reveal">
        <span class="inv-eyebrow"><span class="dot" aria-hidden="true"></span>Inventory &amp; Stock Transfers</span>
        <h1 class="inv-title">
          Know where every unit is — and <span class="accent">account for every movement.</span>
        </h1>
        <p class="inv-lead">
          Connect ecommerce orders, returns and stock movements with warehouse-level inventory and detailed ERP accounting.
        </p>
        <div class="inv-actions">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="#how-it-works" class={buttonVariants({ variant: "outline", size: "lg" })}>
            See How It Works →
          </a>
        </div>
        <div class="inv-importance">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 12v4"/></svg>
          <span>Every order, return and transfer moves stock. If that movement isn't accounted, <b>your books stop matching your warehouses.</b></span>
        </div>
      </div>

      <!-- Right: warehouse → stock transfer → warehouse -->
      <div class="inv-visual reveal" data-delay="120" aria-label="Example: 100 units of SKU-2048 transfer from the Delhi warehouse to Mumbai, posted as a balanced stock transfer in accounting">
        <div class="inv-visual-head">
          Stock Transfer
          <span class="id">{transfer.id}</span>
        </div>

        <div class="inv-transfer">
          <div class="inv-wh from">
            <div class="inv-wh-code">{warehouseA.code}</div>
            <div class="inv-wh-name">{warehouseA.name}</div>
            <div class="inv-wh-sub">{warehouseA.qty} units · {warehouseA.value}</div>
          </div>
          <div class="inv-flow" aria-hidden="true">
            <div class="inv-flow-line"><span class="inv-flow-dot"></span></div>
            <span class="inv-flow-label">{transfer.qty} units</span>
          </div>
          <div class="inv-wh">
            <div class="inv-wh-code">{warehouseB.code}</div>
            <div class="inv-wh-name">{warehouseB.name}</div>
            <div class="inv-wh-sub">{warehouseB.qty} units · {warehouseB.value}</div>
          </div>
        </div>

        <div class="inv-detail">
          <div class="inv-detail-box"><div class="k">SKU</div><div class="v">{transfer.sku}</div></div>
          <div class="inv-detail-box"><div class="k">Qty</div><div class="v">{transfer.qty}</div></div>
          <div class="inv-detail-box"><div class="k">Value</div><div class="v">{transfer.value}</div></div>
        </div>

        <div class="inv-ledger">
          {ledgerRows.map((r) => (
            <div class="inv-ledger-row">
              <span class="txn">{r.txn}</span>
              <span class:list={["amt", r.credit ? "cr" : "dr"]}>{r.credit || r.debit}</span>
            </div>
          ))}
        </div>

        <div class="inv-ledger-foot">
          Both warehouses posted in accounting
          <span class="ok">Posted → ERP ✓</span>
        </div>
      </div>
    </div>
  </div>
</section>