---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const kpis = [
  { label: "Revenue", value: "₹42.6L", tone: "light" },
  { label: "Costs & deductions", value: "₹31.8L", tone: "muted" },
  { label: "Net profit", value: "₹10.8L", tone: "accent" },
  { label: "Profit margin", value: "25.4%", tone: "accent" },
]
const channels = [
  { name: "Amazon", profit: "₹6.4L", margin: "28%" },
  { name: "Flipkart", profit: "₹3.1L", margin: "22%" },
  { name: "Shopify", profit: "₹1.3L", margin: "31%" },
]
---

<style is:global>
  .pf-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 0 clamp(3rem, 6vh, 4.5rem);
    background:
      radial-gradient(46rem 24rem at 78% -12%, rgba(83, 58, 253, 0.12), transparent 60%),
      radial-gradient(36rem 18rem at 8% -8%, rgba(167, 139, 250, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .pf-hero-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .pf-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .pf-hero-grid {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  /* ---------- Left ---------- */
  .pf-copy {
    max-width: 34rem;
  }
  .pf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .pf-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }
  .pf-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .pf-title .accent {
    color: var(--brand-500);
  }
  .pf-lead {
    margin-top: 1.05rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }
  .pf-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pf-note {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .pf-note svg {
    color: var(--brand-500);
    flex: none;
  }
  .pf-note b {
    color: var(--ink-700);
  }

  /* ---------- Right: profitability snapshot card ---------- */
  .pf-card {
    background: #ffffff;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    max-width: 32rem;
    margin-inline: auto;
    width: 100%;
  }
  .pf-card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    background: linear-gradient(180deg, #ffffff, var(--ink-50));
    border-bottom: 1px solid var(--ink-200);
  }
  .pf-card-head .dots {
    display: flex;
    gap: 0.3rem;
  }
  .pf-card-head .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-200);
  }
  .pf-card-head .dots i:nth-child(1) { background: #fca5a5; }
  .pf-card-head .dots i:nth-child(2) { background: #fcd34d; }
  .pf-card-head .dots i:nth-child(3) { background: #86efac; }
  .pf-card-head .title {
    margin-left: 0.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .pf-card-head .period {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 0.5rem;
    background: #fff;
    border: 1px solid var(--ink-200);
    color: var(--ink-500);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .pf-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    padding: 1rem;
  }
  @media (max-width: 34rem) {
    .pf-kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pf-kpi {
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.7rem;
    background: linear-gradient(180deg, #fff, var(--ink-50));
  }
  .pf-kpi .k {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-400);
  }
  .pf-kpi .v {
    margin-top: 0.25rem;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }
  .pf-kpi.accent .v {
    color: var(--brand-600);
  }
  .pf-kpi.muted .v {
    color: var(--ink-500);
  }
  /* waterfall bars */
  .pf-waterfall {
    padding: 0 1rem 0.9rem;
  }
  .pf-water-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: 0.5rem;
  }
  .pf-bar-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .pf-bar-row .lb {
    width: 3.6rem;
    flex: none;
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--ink-500);
    text-align: right;
  }
  .pf-bar-row .track {
    flex: 1;
    height: 8px;
    border-radius: 999px;
    background: var(--ink-100);
    overflow: hidden;
  }
  .pf-bar-row .fill {
    height: 100%;
    border-radius: 999px;
  }
  .pf-bar-row .vl {
    width: 3.2rem;
    flex: none;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-800);
    font-variant-numeric: tabular-nums;
  }
  /* channel rows */
  .pf-channels {
    border-top: 1px solid var(--ink-200);
    background: var(--ink-50);
    padding: 0.7rem 1rem;
  }
  .pf-channel {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    font-size: 0.75rem;
  }
  .pf-channel .name {
    font-weight: 700;
    color: var(--ink-800);
    width: 4.5rem;
  }
  .pf-channel .track {
    flex: 1;
    height: 5px;
    border-radius: 999px;
    background: var(--ink-200);
    overflow: hidden;
  }
  .pf-channel .fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--brand-500), var(--brand-400));
  }
  .pf-channel .vals {
    font-weight: 600;
    color: var(--ink-500);
    font-variant-numeric: tabular-nums;
  }
  .pf-card-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--ink-200);
    background: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-600);
  }
  .pf-card-foot .ok {
    margin-left: auto;
    color: var(--success-600);
    font-weight: 700;
  }
  @media (max-width: 47.99rem) {
    .pf-hero {
      padding-top: 5rem;
    }
    .pf-title {
      font-size: clamp(2rem, 8.5vw, 2.6rem);
    }
  }
</style>

<section class="pf-hero" data-hero>
  <div class="pf-hero-inner">
    <div class="pf-hero-grid">
      <!-- Left -->
      <div class="pf-copy reveal">
        <span class="pf-eyebrow"><span class="dot" aria-hidden="true"></span>Profitability</span>
        <h1 class="pf-title">
          Know what you <span class="accent">actually make.</span>
        </h1>
        <p class="pf-lead">
          Turn marketplace sales and transaction data into a clear view of revenue, costs, deductions and profitability — across the parts of your ecommerce business that matter.
        </p>
        <div class="pf-actions">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="/platform" class={buttonVariants({ variant: "outline", size: "lg" })}>
            Explore Platform →
          </a>
        </div>
        <p class="pf-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>Sales are revenue. <b>Profit is what's left after the marketplace keeps its share.</b></span>
        </p>
      </div>

      <!-- Right: profitability snapshot -->
      <div class="pf-card reveal" data-delay="120" aria-label="Illustrative profitability snapshot: revenue, costs, net profit and margin across marketplaces">
        <div class="pf-card-head">
          <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <span class="title">Profitability</span>
          <span class="period">Aug 2026</span>
        </div>
        <div class="pf-kpis">
          {kpis.map((k) => (
            <div class:list={["pf-kpi", k.tone]}>
              <div class="k">{k.label}</div>
              <div class="v">{k.value}</div>
            </div>
          ))}
        </div>
        <div class="pf-waterfall">
          <div class="pf-water-label">Revenue → costs → profit</div>
          <div class="pf-bar-row"><span class="lb">Revenue</span><span class="track"><span class="fill" style="width:100%;background:var(--brand-500)"></span></span><span class="vl">₹42.6L</span></div>
          <div class="pf-bar-row"><span class="lb">Costs</span><span class="track"><span class="fill" style="width:75%;background:var(--ink-300)"></span></span><span class="vl">₹31.8L</span></div>
          <div class="pf-bar-row"><span class="lb">Profit</span><span class="track"><span class="fill" style="width:25%;background:var(--success-500)"></span></span><span class="vl">₹10.8L</span></div>
        </div>
        <div class="pf-channels">
          {channels.map((c) => (
            <div class="pf-channel">
              <span class="name">{c.name}</span>
              <span class="track"><span class="fill" style={`width:${parseInt(c.margin)}%`}></span></span>
              <span class="vals">{c.profit} · {c.margin}</span>
            </div>
          ))}
        </div>
        <div class="pf-card-foot">
          Built from transaction-level marketplace data
          <span class="ok">✓</span>
        </div>
      </div>
    </div>
  </div>
</section>