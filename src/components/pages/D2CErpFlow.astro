---
const inputs = [
  { label: "Website", sub: "storefront" },
  { label: "Amazon", sub: "marketplace" },
  { label: "Flipkart", sub: "marketplace" },
  { label: "Other channels", sub: "supported" },
  { label: "Payment sources", sub: "collections" },
  { label: "Returns", sub: "reversals" },
]
const core = [
  { label: "Understand", desc: "one financial view" },
  { label: "Reconcile", desc: "expected vs received" },
  { label: "Account", desc: "detailed entries" },
]
const erps = ["Tally", "SAP", "Zoho"]
---

<style is:global>
  .d2cef {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .d2cef-app {
    position: relative;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .d2cef-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .d2cef-svg {
    display: block;
    width: 100%;
    min-width: 42rem;
    height: auto;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  @media (min-width: 48rem) {
    .d2cef-svg {
      min-width: 0;
    }
  }
  .d2cef-lbl {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    fill: var(--ink-400);
  }
  .d2cef-node-title {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--ink-900);
  }
  .d2cef-node-sub {
    font-size: 9.5px;
    font-weight: 500;
    fill: var(--ink-400);
  }
  .d2cef-core-name { font-size: 19px; font-weight: 800; fill: #fff; letter-spacing: -0.01em; }
  .d2cef-core-sub { font-size: 10.5px; font-weight: 500; fill: rgba(255, 255, 255, 0.8); }
  .d2cef-chip { rx: 999px; }
  .d2cef-chip-text { font-size: 10px; font-weight: 700; fill: #fff; }
  .d2cef-erp { font-size: 13px; font-weight: 800; fill: var(--ink-800); }
  .d2cef-wire { fill: none; stroke: #e4e7ee; stroke-width: 1.4; }
  .d2cef-wire-flow {
    fill: none;
    stroke: var(--brand-500);
    stroke-opacity: 0.5;
    stroke-width: 1.4;
    stroke-dasharray: 5 8;
    animation: d2cef-dash 1.2s linear infinite;
  }
  @keyframes d2cef-dash { to { stroke-dashoffset: -26; } }
  @media (prefers-reduced-motion: reduce) {
    .d2cef-wire-flow { animation: none; }
  }
  .d2cef-note {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--ink-100);
    background: var(--ink-50);
    text-align: center;
    font-size: 0.72rem;
    color: var(--ink-400);
  }
</style>

<section class="d2cef">
  <div class="mx-auto max-w-6xl px-6">
    <div class="d2cef-app reveal">
      <div class="d2cef-scroll">
      <svg viewBox="0 0 1160 440" fill="none" class="d2cef-svg" role="img" aria-label="Diagram: website, Amazon, Flipkart, other channels, payment sources and returns flow into DeepEcom, which understands, reconciles and accounts, then posts to Tally, SAP and Zoho">
        <defs>
          <linearGradient id="d2cefCore" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#2F72F0" />
            <stop offset="100%" stop-color="#1A4FC4" />
          </linearGradient>
          <filter id="d2cefGlow" x="-10%" y="-10%" width="125%" height="125%" filterUnits="userSpaceOnUse">
            <feDropShadow dx="0" dy="14" stdDeviation="18" flood-color="#2F72F0" flood-opacity="0.28" />
          </filter>
        </defs>

        <rect width="1160" height="440" fill="#fff" />

        <text x="70" y="50" class="d2cef-lbl">Your selling ecosystem</text>
        <text x="545" y="50" class="d2cef-lbl">DeepEcom</text>
        <text x="930" y="50" class="d2cef-lbl">Your ERP</text>

        <!-- left input nodes (3 cols x 2 rows) -->
        <g font-family="Inter, sans-serif">
          {inputs.map((n, i) => {
            const col = i % 3
            const row = Math.floor(i / 3)
            const x = 60 + col * 160
            const y = 78 + row * 74
            return (
              <g>
                <rect x={x} y={y} width="146" height="56" rx="10" fill="#fff" stroke="#e2e5ee" />
                <circle cx={x + 18} cy={y + 28} r="4" fill="#2F72F0" />
                <text x={x + 30} y={y + 24} class="d2cef-node-title">{n.label}</text>
                <text x={x + 30} y={y + 39} class="d2cef-node-sub">{n.sub}</text>
              </g>
            )
          })}
        </g>

        <!-- connectors from inputs to core -->
        <path d="M 206 106 C 320 106, 360 150, 470 168" class="d2cef-wire" />
        <path d="M 206 106 C 320 106, 360 150, 470 168" class="d2cef-wire-flow" />
        <path d="M 366 106 C 420 106, 420 160, 470 180" class="d2cef-wire" />
        <path d="M 366 106 C 420 106, 420 160, 470 180" class="d2cef-wire-flow" />
        <path d="M 526 106 C 480 106, 470 160, 470 192" class="d2cef-wire" />
        <path d="M 526 106 C 480 106, 470 160, 470 192" class="d2cef-wire-flow" />
        <path d="M 206 180 C 320 180, 360 200, 470 210" class="d2cef-wire" />
        <path d="M 206 180 C 320 180, 360 200, 470 210" class="d2cef-wire-flow" />
        <path d="M 366 180 C 420 180, 420 210, 470 220" class="d2cef-wire" />
        <path d="M 366 180 C 420 180, 420 210, 470 220" class="d2cef-wire-flow" />
        <path d="M 526 180 C 480 180, 470 210, 470 230" class="d2cef-wire" />
        <path d="M 526 180 C 480 180, 470 210, 470 230" class="d2cef-wire-flow" />

        <!-- DeepEcom core -->
        <rect x="450" y="150" width="260" height="170" rx="18" fill="url(#d2cefCore)" filter="url(#d2cefGlow)" />
        <text x="478" y="186" class="d2cef-core-name">DeepEcom</text>
        <text x="478" y="204" class="d2cef-core-sub">The layer connecting it all</text>
        <g>
          {core.map((c, i) => {
            const x = 478 + (i % 2) * 108
            const y = 226 + Math.floor(i / 2) * 36
            return (
              <g>
                <rect x={x} y={y} width="100" height="30" rx="999" fill="rgba(255,255,255,0.16)" />
                <text x={x + 10} y={y + 19} class="d2cef-chip-text">{c.label}</text>
              </g>
            )
          })}
        </g>

        <!-- connectors from core to ERP -->
        <path d="M 710 190 C 800 190, 830 240, 900 250" class="d2cef-wire" />
        <path d="M 710 190 C 800 190, 830 240, 900 250" class="d2cef-wire-flow" />
        <path d="M 710 230 C 800 230, 830 270, 900 270" class="d2cef-wire" />
        <path d="M 710 230 C 800 230, 830 270, 900 270" class="d2cef-wire-flow" />
        <path d="M 710 270 C 800 270, 830 300, 900 290" class="d2cef-wire" />
        <path d="M 710 270 C 800 270, 830 300, 900 290" class="d2cef-wire-flow" />

        <!-- ERP nodes -->
        <g font-family="Inter, sans-serif">
          {erps.map((e, i) => {
            const y = 226 + i * 56
            return (
              <g>
                <rect x="900" y={y} width="190" height="48" rx="10" fill="#fff" stroke="#e2e5ee" />
                <circle cx="918" cy={y + 24} r="3.5" fill="#2F72F0" />
                <text x="928" y={y + 24} class="d2cef-erp">{e}</text>
                <text x="928" y={y + 38} class="d2cef-node-sub">ERP posting</text>
              </g>
            )
          })}
        </g>
      </svg>
      </div>
      <p class="d2cef-note">Illustrative architecture — supported channels, payment sources and ERP systems depend on your setup.</p>
    </div>
  </div>
</section>