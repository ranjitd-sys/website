---
const inputs = ["Amazon", "Flipkart", "Shopify", "Other supported channels"]
const centerSteps = ["Data ingestion", "Transaction processing", "Accounting structure", "ERP mapping"]
const outputs = ["Tally", "SAP", "Zoho"]
const leftY = [120, 200, 280, 360]
const rightY = [170, 270, 370]
const centerY = 300
const leftCurves = leftY.map((y) => `M 300 ${y} C 350 ${y}, 355 ${centerY}, 430 ${centerY}`)
const rightCurves = rightY.map((y) => `M 860 ${centerY} C 900 ${centerY}, 905 ${y}, 970 ${y}`)
---

<style is:global>
  .ea {
    padding-block: clamp(2.25rem, 4.5vh, 3.25rem);
  }
  .ea-diagram {
    margin-top: 2rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
  }
  .ea-diagram svg {
    width: 100%;
    height: auto;
    user-select: none;
  }
  .ea-col-label {
    font-family: Inter, sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    fill: var(--ink-400);
  }
  .ea-node-rect {
    fill: #ffffff;
    stroke: var(--ink-200);
    stroke-width: 1.5;
    filter: url(#ea-shadow);
  }
  .ea-node-text {
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 700;
    fill: var(--ink-900);
  }
  .ea-node-sub {
    font-family: Inter, sans-serif;
    font-size: 12px;
    font-weight: 500;
    fill: var(--ink-500);
  }
  .ea-center-rect {
    fill: url(#ea-center-grad);
    stroke: none;
    filter: url(#ea-center-shadow);
  }
  .ea-center-title {
    font-family: Inter, sans-serif;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.03em;
    fill: #ffffff;
  }
  .ea-center-sub {
    font-family: Inter, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    fill: rgba(255, 255, 255, 0.85);
  }
  .ea-center-step {
    font-family: Inter, sans-serif;
    font-size: 12px;
    font-weight: 600;
    fill: rgba(255, 255, 255, 0.92);
  }
  .ea-flow-guide {
    stroke: url(#ea-flow);
    stroke-width: 1.5;
    stroke-dasharray: 2.5 6;
    fill: none;
    opacity: 0.85;
  }
  .ea-packet {
    fill: none;
    stroke: var(--brand-500);
    stroke-width: 2.5;
    stroke-dasharray: 10 140;
    filter: url(#ea-glow);
    animation: ea-flow 2.4s linear infinite;
  }
  .ea-packet-l0 { animation-delay: 0s; }
  .ea-packet-l1 { animation-delay: 0.5s; }
  .ea-packet-l2 { animation-delay: 1s; }
  .ea-packet-l3 { animation-delay: 1.5s; }
  .ea-packet-r0 { animation-delay: 0.2s; }
  .ea-packet-r1 { animation-delay: 0.9s; }
  .ea-packet-r2 { animation-delay: 1.6s; }
  @keyframes ea-flow {
    from { stroke-dashoffset: 150; }
    to { stroke-dashoffset: 0; }
  }
</style>

<section class="ea">
  <div class="mx-auto max-w-6xl px-6">
    <div class="ea-diagram reveal">
      <svg viewBox="0 0 1200 520" role="img" aria-label="Architecture diagram: marketplaces flow into the DeepEcom ERP Connector which processes and maps transactions into detailed accounting posted to Tally, SAP and Zoho">
        <defs>
          <filter id="ea-shadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#0f172a" flood-opacity="0.06" />
          </filter>
          <filter id="ea-center-shadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="16" stdDeviation="28" flood-color="#533afd" flood-opacity="0.16" />
          </filter>
          <filter id="ea-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
          <linearGradient id="ea-center-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#533afd" />
            <stop offset="100%" stop-color="#1e2bd6" />
          </linearGradient>
          <linearGradient id="ea-flow" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#c7d2fe" />
            <stop offset="100%" stop-color="#8a98f7" />
          </linearGradient>
        </defs>

        <!-- Section labels -->
        <text x="170" y="40" text-anchor="middle" class="ea-col-label">MARKETPLACES</text>
        <text x="1030" y="40" text-anchor="middle" class="ea-col-label">YOUR ERP</text>

        <!-- Curved flows -->
        <g>
          {leftCurves.map((d) => <path d={d} class="ea-flow-guide" />)}
          {leftCurves.map((d, i) => <path d={d} class={`ea-packet ea-packet-l${i}`} />)}
        </g>
        <g>
          {rightCurves.map((d) => <path d={d} class="ea-flow-guide" />)}
          {rightCurves.map((d, i) => <path d={d} class={`ea-packet ea-packet-r${i}`} />)}
        </g>

        <!-- Inputs -->
        <g>
          {inputs.map((name, i) => (
            <g key={name} transform={`translate(40, ${leftY[i] - 30})`}>
              <rect width="260" height="60" rx="14" class="ea-node-rect" />
              <text x="130" y="27" text-anchor="middle" class="ea-node-text">{name}</text>
            </g>
          ))}
        </g>

        <!-- Center: DeepEcom ERP Connector -->
        <g transform="translate(430, 40)">
          <rect width="430" height="440" rx="24" class="ea-center-rect" />
          <text x="215" y="70" text-anchor="middle" class="ea-center-title">DEEPECOM</text>
          <text x="215" y="92" text-anchor="middle" class="ea-center-sub">ERP CONNECTOR</text>
          <line x1="100" y1="112" x2="330" y2="112" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
          <g>
            {centerSteps.map((s, i) => (
              <text key={s} x="215" y={170 + i * 60} text-anchor="middle" class="ea-center-step">{s}</text>
            ))}
          </g>
          <circle cx="215" cy="410" r="5" fill="#fff" opacity="0.9" />
          <circle cx="215" cy="410" r="9" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
        </g>---
interface Step {
  num: string
  label: string
  desc: string
}
interface Props {
  steps?: Step[]
}
const defaultSteps: Step[] = [
  { num: "1", label: "Connect", desc: "Connect marketplace accounts." },
  { num: "2", label: "Fetch", desc: "Bring relevant transaction data into DeepEcom." },
  { num: "3", label: "Map", desc: "Map transactions to accounting structures." },
  { num: "4", label: "Generate", desc: "Create detailed accounting entries." },
  { num: "5", label: "Post", desc: "Push accounting into the ERP." },
]
const { steps = defaultSteps } = Astro.props
---

<style is:global>
  .pipeline {
    padding-block: clamp(3rem, 6vh, 5rem);
    background: transparent;
  }
  
  .pipeline-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  /* The Container */
  .pipeline-track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Connecting Line (Mobile: Vertical) */
  .pipeline-track::before {
    content: "";
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 1.25rem; /* Centers exactly behind the 2.5rem nodes */
    width: 2px;
    background: var(--ink-200, #e2e8f0);
    z-index: 0;
  }

  /* Step Item */
  .pipeline-step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    z-index: 1;
  }

  /* Node Number */
  .pipeline-node {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brand-50, #eef2ff);
    border: 2px solid var(--brand-500, #6366f1);
    color: var(--brand-600, #4f46e5);
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px #ffffff; /* Fake mask to cut the line behind it */
  }

  /* Text Content */
  .pipeline-content {
    padding-top: 0.4rem;
  }

  .pipeline-label {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink-900, #0f172a);
    letter-spacing: -0.01em;
  }

  .pipeline-desc {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-500, #64748b);
  }

  /* --- Desktop Layout (Horizontal) --- */
  @media (min-width: 48rem) {
    .pipeline-track {
      flex-direction: row;
      gap: 1.5rem;
    }

    /* Connecting Line (Desktop: Horizontal) */
    .pipeline-track::before {
      top: 1.25rem; /* Centers behind nodes */
      left: 2rem;
      right: 2rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }

    .pipeline-step {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .pipeline-content {
      padding-top: 0;
    }

    /* Remove the fake shadow on desktop if you prefer a solid fill */
    .pipeline-node {
      background: #ffffff;
    }
  }
</style>

<section class="pipeline">
  <div class="pipeline-inner">
    <div class="pipeline-track reveal">
      {steps.map((s) => (
        <div class="pipeline-step">
          <div class="pipeline-node">{s.num}</div>
          <div class="pipeline-content">
            <div class="pipeline-label">{s.label}</div>
            <div class="pipeline-desc">{s.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

        <!-- Outputs -->
        <g>
          {outputs.map((name, i) => (
            <g key={name} transform={`translate(970, ${rightY[i] - 30})`}>
              <rect width="190" height="60" rx="14" class="ea-node-rect" />
              <text x="95" y="27" text-anchor="middle" class="ea-node-text">{name}</text>
            </g>
          ))}
        </g>
      </svg>
    </div>
  </div>
</section>