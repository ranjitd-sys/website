---
interface Props {
  eyebrow: string
  title: string
  lead?: string
  /** when true, renders a centered, standalone header (max-w-3xl) */
  center?: boolean
  /** when true, render title at the larger .h2 scale (default h2-md) */
  large?: boolean
  /** right-aligned link in a full-width header row */
  actionLabel?: string
  actionHref?: string
}
const { eyebrow, title, lead, center = false, large = false, actionLabel, actionHref } = Astro.props
---

<style is:global>
  .sh {
    position: relative;
  }
  .sh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .sh-eyebrow::before {
    content: "";
    width: 1.75rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-500), var(--brand-300));
  }
  .sh-title {
    margin-top: 0.9rem;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .sh-title.large {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .sh-title.medium {
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .sh-lead {
    margin-top: 0.9rem;
    color: var(--ink-500);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.7;
  }
  .sh-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brand-600);
    text-decoration: none;
    transition: color var(--transition-fast), gap var(--transition-fast);
    white-space: nowrap;
  }
  .sh-action:hover {
    color: var(--brand-700);
    gap: 0.6rem;
  }
  .sh-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .sh-center {
    text-align: center;
  }
  .sh-center .sh-eyebrow {
    justify-content: center;
  }
  .sh-center .sh-eyebrow::after {
    content: "";
    width: 1.75rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-300), var(--brand-500));
  }
  .sh-center .sh-lead {
    margin-inline: auto;
    max-width: 40rem;
  }
</style>

<div
  class:list={[
    "sh reveal",
    center && "sh-center mx-auto max-w-3xl",
  ]}
>
  <div class:list={[!center && actionLabel && "sh-row"]}>
    <div>
      <span class="sh-eyebrow">{eyebrow}</span>
      <h2 class:list={["sh-title", large ? "large" : "medium"]}>{title}</h2>
      {lead && <p class="sh-lead">{lead}</p>}
    </div>
    {actionLabel && actionHref && (
      <a href={actionHref} class="sh-action">
        {actionLabel}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    )}
  </div>
  <slot />
</div>