---
import PlatformErpConnector from "./PlatformErpConnector.astro";

const platforms = [
  { name: "Amazon",   svg: '<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/>' },
  { name: "Flipkart", svg: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a4 4 0 00-8 0v2"/>' },
  { name: "Shopify",  svg: '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path d="M9 22V12h6v10"/>' },
  { name: "Meesho",   svg: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>' },
  { name: "Payments", svg: '<rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>' },
  { name: "Returns",  svg: '<path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 105.64-8.36L3 12"/>' },
]

const erps = [
  { name: "Tally",   svg: '<path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/>' },
  { name: "SAP",     svg: '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>' },
  { name: "Zoho Books", svg: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8M10 9H8"/>' },
]
---
<style is:global>
  .cfpec {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .cfpec-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.025em; color: var(--ink-950); text-align: center; }
  .cfpec-lead { margin-top: 0.75rem; font-size: clamp(1rem, 1.3vw, 1.125rem); line-height: 1.6; color: var(--ink-500); text-align: center; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .cfpec-wrap {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .cfpec-wrap { grid-template-columns: 1fr auto 1fr; gap: 1.25rem; }
  }
  .cfpec-col { display: flex; flex-direction: column; gap: 0.6rem; }
  .cfpec-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: linear-gradient(180deg, #fff, var(--ink-50));
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .cfpec-card:hover { border-color: var(--ink-300); box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .cfpec-card svg { width: 18px; height: 18px; color: var(--brand-600); flex: none; }
  .cfpec-card .name { font-size: 0.85rem; font-weight: 700; color: var(--ink-800); }
  .cfpec-arrow {
    display: flex;
    justify-content: center;
    color: var(--brand-500);
  }
  @media (max-width: 55.99rem) { .cfpec-arrow { transform: rotate(90deg); } }
  .cfpec-center {
    border: 2px solid var(--brand-200);
    border-radius: 1.25rem;
    background: linear-gradient(135deg, var(--brand-50), #fff);
    padding: 1.5rem 2rem;
    text-align: center;
    box-shadow: 0 4px 16px rgba(83, 58, 253, 0.08);
  }
  .cfpec-center .name { font-size: 1.35rem; font-weight: 800; color: var(--brand-700); }
  .cfpec-center .sub { margin-top: 0.3rem; font-size: 0.8rem; color: var(--ink-500); }
  .cfpec-center .tag {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--brand-100);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--brand-700);
  }
</style>

<section class="cfpec">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="cfpec-title">One platform for visibility. One connector for accounting.</h2>
    <p class="cfpec-lead">Platform = understand the business. ERP Connector = put the detailed transactions into the books.</p>

    <PlatformErpConnector/>
  </div>
</section>