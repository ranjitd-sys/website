---
const chain = [
  { label: "ERP Voucher", sub: "JRNL-45892" },
  { label: "Accounting Entry", sub: "Sales · ORD-104928" },
  { label: "Order", sub: "ORD-104928" },
  { label: "Marketplace", sub: "Amazon" },
  { label: "Settlement", sub: "₹2,184.00" },
]
---

<style is:global>
  .tr {
    padding-block: clamp(2.25rem, 4.5vh, 3.25rem);
  }
  .tr-chain {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 32rem;
    margin-inline: auto;
  }
  @media (min-width: 48rem) {
    .tr-chain {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      max-width: none;
    }
  }
  .tr-node {
    flex: 1;
    padding: 1rem 1.25rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
    text-align: center;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .tr-node:hover {
    border-color: var(--ink-300);
    box-shadow: var(--shadow-sm);
  }
  .tr-node-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-400);
  }
  .tr-node-sub {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .tr-arrow {
    display: flex;
    justify-content: center;
    color: var(--ink-300);
  }
  @media (max-width: 47.99rem) {
    .tr-arrow {
      transform: rotate(90deg);
    }
  }
</style>

<section class="tr">
  <div class="mx-auto max-w-6xl px-6">
    <div class="tr-chain reveal">
      {chain.map((c, i) => (
        <>
          <div class="tr-node">
            <div class="tr-node-label">{c.label}</div>
            <div class="tr-node-sub">{c.sub}</div>
          </div>
          {i < chain.length - 1 && (
            <div class="tr-arrow" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M0 12h20M16 6l6 6-6 6" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
