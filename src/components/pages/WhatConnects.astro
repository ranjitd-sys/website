---
const items = [
  { label: "Orders", icon: "receipt" },
  { label: "Payments", icon: "bank" },
  { label: "GST", icon: "scale" },
  { label: "Marketplace Charges", icon: "wallet" },
  { label: "Returns", icon: "refresh" },
  { label: "TCS / TDS", icon: "file" },
  { label: "Inventory", icon: "package" },
  { label: "Warehouses", icon: "boxes" },
  { label: "Stock Transfers", icon: "truck" },
  { label: "Settlements", icon: "check" },
]

const ICONS: Record<string, string> = {
  receipt: '<path d="M6 3h12a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2zM9 8h6M9 12h6"/>',
  bank: '<path d="M3 10h18M5 10l1 9h12l1-9M2 6l10-3 10 3H2zM12 14h.01"/>',
  scale: '<path d="M12 3v18M8 21h8M4 6h16M6 6 3 11a3 3 0 0 0 6 0L6 6zM18 6l-3 5a3 3 0 0 0 6 0l-3-5z"/>',
  wallet: '<path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 9h18M16 14h.01"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-2.6-6.3M21 3v6h-6"/>',
  file: '<path d="M6 2h8l4 4v16H6zM14 2v4h4"/>',
  package: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8zM3 8l9 5 9-5M12 13v8"/>',
  boxes: '<path d="M3 7 12 2l9 5-9 5-9-5zM3 7v10l9 5 9-5V7M12 12v10"/>',
  truck: '<path d="M1 3h15v13H1zM16 8h4l3 3v5h-7zM5.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM17.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
}
---

<style is:global>
  .wc {
    padding-block: clamp(2.25rem, 4.5vh, 3.25rem);
  }
  .wc-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 64rem) {
    .wc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .wc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .wc-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .wc-item:hover {
    border-color: var(--ink-300);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
  .wc-item-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    flex: none;
    background: var(--brand-50);
    color: var(--brand-600);
  }
  .wc-item-icon svg {
    width: 1rem;
    height: 1rem;
  }
  .wc-item-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-800);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<section class="wc">
  <div class="mx-auto max-w-6xl px-6">
    <div class="wc-grid reveal">
      {items.map((it) => (
        <div class="wc-item">
          <span class="wc-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={ICONS[it.icon]} />
            </svg>
          </span>
          <span class="wc-item-label">{it.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>