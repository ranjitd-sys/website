---
const events = [
  { label: "Sale", sub: "Taxable value", icon: "receipt", color: "var(--brand-500)" },
  { label: "GST", sub: "CGST / SGST / IGST", icon: "scale", color: "var(--brand-600)" },
  { label: "Marketplace Charges", sub: "Commission · Fees", icon: "wallet", color: "var(--ink-700)" },
  { label: "TCS / TDS", sub: "Tax deductions", icon: "file", color: "var(--ink-700)" },
  { label: "Receivable", sub: "Amount due", icon: "bank", color: "var(--brand-500)" },
  { label: "Payment", sub: "Settlement received", icon: "check", color: "var(--success-600)" },
  { label: "Return / Refund", sub: "Reversal entries", icon: "refresh", color: "var(--danger-600)" },
  { label: "Inventory", sub: "Stock movement", icon: "package", color: "var(--ink-700)" },
  { label: "Stock Transfer", sub: "Warehouse movement", icon: "truck", color: "var(--ink-700)" },
]

const ICONS: Record<string, string> = {
  receipt: '<path d="M6 3h12a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2zM9 8h6M9 12h6"/>',
  scale: '<path d="M12 3v18M8 21h8M4 6h16M6 6 3 11a3 3 0 0 0 6 0L6 6zM18 6l-3 5a3 3 0 0 0 6 0l-3-5z"/>',
  wallet: '<path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 9h18M16 14h.01"/>',
  file: '<path d="M6 2h8l4 4v16H6zM14 2v4h4"/>',
  bank: '<path d="M3 10h18M5 10l1 9h12l1-9M2 6l10-3 10 3H2zM12 14h.01"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-2.6-6.3M21 3v6h-6"/>',
  package: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8zM3 8l9 5 9-5M12 13v8"/>',
  truck: '<path d="M1 3h15v13H1zM16 8h4l3 3v5h-7zM5.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM17.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>',
}
---

<style is:global>
  .td-section {
    padding-block: clamp(2.25rem, 4.5vh, 3.25rem);
  }
  .td-order {
    position: relative;
    margin: 2rem auto 0;
    max-width: 28rem;
    padding: 1.75rem 2rem;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .td-order-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .td-order-id {
    margin-top: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-900);
  }
  .td-order-amount {
    margin-top: 0.25rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }
  .td-arrow {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
    color: var(--ink-300);
  }
  .td-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 48rem) {
    .td-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 30rem) {
    .td-grid {
      grid-template-columns: 1fr;
    }
  }
  .td-event {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .td-event:hover {
    border-color: var(--ink-300);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
  .td-event-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    flex: none;
    background: var(--ink-50);
  }
  .td-event-icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .td-event-text {
    min-width: 0;
  }
  .td-event-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-800);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .td-event-sub {
    font-size: 0.72rem;
    color: var(--ink-400);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<section class="td-section">
  <div class="mx-auto max-w-6xl px-6">
    <div class="td-order reveal">
      <span class="td-order-label">Order</span>
      <p class="td-order-id">#104928</p>
      <p class="td-order-amount">₹2,499</p>
    </div>

    <div class="td-arrow" aria-hidden="true">
      <svg width="24" height="40" viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M12 0v36M6 30l6 6 6-6" />
      </svg>
    </div>

    <div class="td-grid reveal">
      {
        events.map((e) => (
          <div class="td-event">
            <span class="td-event-icon" style={`color:${e.color}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={ICONS[e.icon]} />
              </svg>
            </span>
            <span class="td-event-text">
              <span class="td-event-label">{e.label}</span>
              <span class="td-event-sub">{e.sub}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
