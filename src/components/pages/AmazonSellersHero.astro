---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const amazonStreams = [
  { label: "Orders", sub: "every sale" },
  { label: "Payments", sub: "settlements & fees" },
  { label: "Returns", sub: "reversals" },
  { label: "Charges", sub: "deductions" },
  { label: "GST", sub: "tax context" },
]
const capabilities = [
  { label: "Profitability", sub: "What you actually make" },
  { label: "Reconciliation", sub: "Expected vs received" },
  { label: "Reports", sub: "Structured exports" },
  { label: "Accounting", sub: "Order-wise entries" },
]
---

<style is:global>
  .az-h {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 0 clamp(3rem, 6vh, 4.5rem);
    background:
      radial-gradient(46rem 24rem at 78% -12%, rgba(44, 62, 233, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 6% -8%, rgba(167, 139, 250, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .az-h-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .az-h-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .az-h-grid {
      grid-template-columns: 0.92fr 1.08fr;
    }
  }

  .az-h-copy {
    max-width: 34rem;
  }
  .az-h-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .az-h-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }
  .az-h-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .az-h-title .accent {
    color: var(--brand-500);
  }
  .az-h-lead {
    margin-top: 1.05rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }
  .az-h-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .az-h-note {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .az-h-note svg {
    color: var(--brand-500);
    flex: none;
  }
  .az-h-note b {
    color: var(--ink-700);
  }

  .az-h-visual {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
  }
  .az-h-flow {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .az-h-amazon {
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .az-h-amazon-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: linear-gradient(180deg, #ffffff, var(--ink-50));
    border-bottom: 1px solid var(--ink-200);
  }
  .az-h-amazon-head .name {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink-900);
  }
  .az-h-amazon-head .badge {
    margin-left: auto;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--ink-100);
    color: var(--ink-500);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .az-h-streams {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.35rem;
    padding: 0.7rem 0.85rem;
  }
  @media (max-width: 30rem) {
    .az-h-streams {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .az-h-stream {
    padding: 0.4rem 0.35rem;
    border: 1px solid var(--ink-100);
    border-radius: 0.55rem;
    background: var(--ink-50);
    text-align: center;
  }
  .az-h-stream .l {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .az-h-stream .s {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.58rem;
    color: var(--ink-400);
  }
  .az-h-down {
    display: flex;
    justify-content: center;
    color: var(--brand-400);
  }
  .az-h-center {
    border: 1px solid var(--brand-200);
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
    color: #fff;
    padding: 0.9rem 1.1rem;
    box-shadow: 0 16px 32px -16px rgba(44, 62, 233, 0.4);
  }
  .az-h-center-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .az-h-center-name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .az-h-center-tag {
    margin-left: auto;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .az-h-center-sub {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    opacity: 0.85;
  }
  .az-h-cap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .az-h-cap-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
  }
  .az-h-cap-chip .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500);
    flex: none;
  }
  .az-h-cap-chip .txt {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .az-h-cap-chip .sub {
    font-size: 0.66rem;
    color: var(--ink-400);
  }

  @media (max-width: 47.99rem) {
    .az-h {
      padding-top: 5rem;
    }
    .az-h-title {
      font-size: clamp(2rem, 8.5vw, 2.6rem);
    }
  }
</style>

<section class="az-h" data-hero>
  <div class="az-h-inner">
    <div class="az-h-grid">
      <div class="az-h-copy reveal">
        <span class="az-h-eyebrow"><span class="dot" aria-hidden="true"></span>For Amazon Sellers</span>
        <h1 class="az-h-title">
          Run your Amazon business <span class="accent">with clarity.</span>
        </h1>
        <p class="az-h-lead">
          Connect Amazon data to DeepEcom to understand profitability, reconcile payments and automatically account for ecommerce transactions in your ERP.
        </p>
        <div class="az-h-actions">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="#how-it-works" class={buttonVariants({ variant: "outline", size: "lg" })}>
            See How It Works →
          </a>
        </div>
        <p class="az-h-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>Amazon sales are revenue. <b>What reaches your books is the full picture.</b></span>
        </p>
      </div>

      <div class="az-h-visual reveal" data-delay="120" aria-label="Illustration: Amazon orders, payments, returns, charges and GST flow into DeepEcom, becoming profitability, reconciliation, reports and accounting">
        <div class="az-h-flow">
          <div class="az-h-amazon">
            <div class="az-h-amazon-head">
              <span class="name">Amazon</span>
              <span class="badge">Data streams</span>
            </div>
            <div class="az-h-streams">
              {amazonStreams.map((s) => (
                <div class="az-h-stream"><span class="l">{s.label}</span><span class="s">{s.sub}</span></div>
              ))}
            </div>
          </div>

          <div class="az-h-down" aria-hidden="true">
            <svg width="20" height="16" viewBox="0 0 20 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 0v12M4 8l6 6 6-6" /></svg>
          </div>

          <div class="az-h-center">
            <div class="az-h-center-top">
              <span class="az-h-center-name">DeepEcom</span>
              <span class="az-h-center-tag">Platform + ERP Connector</span>
            </div>
            <div class="az-h-center-sub">One financial layer for your Amazon business</div>
          </div>

          <div class="az-h-cap">
            {capabilities.map((c) => (
              <div class="az-h-cap-chip">
                <span class="dot" aria-hidden="true"></span>
                <span>
                  <span class="txt">{c.label}</span>
                  <span class="sub"> {c.sub}</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>