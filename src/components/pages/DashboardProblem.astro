---
const sources = [
  { label: "Amazon", sub: "sales · fees · settlements" },
  { label: "Flipkart", sub: "sales · fees · settlements" },
  { label: "Shopify", sub: "orders · payouts" },
  { label: "Payments", sub: "what reached the bank" },
  { label: "Reports", sub: "scattered exports" },
]
---

<style is:global>
  .dpb {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .dpb-wrap {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .dpb-wrap {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.25rem;
    }
  }
  .dpb-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .dpb-source {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
  }
  .dpb-source .name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .dpb-source .sub {
    font-size: 0.7rem;
    color: var(--ink-400);
  }
  .dpb-arrow {
    display: flex;
    justify-content: center;
    color: var(--ink-300);
  }
  @media (max-width: 55.99rem) {
    .dpb-arrow {
      transform: rotate(90deg);
    }
  }
  .dpb-dest {
    border: 1px solid var(--brand-200);
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--brand-50), #fff);
    padding: 1.25rem 1.5rem;
  }
  .dpb-dest-name {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--brand-700);
  }
  .dpb-dest-sub {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--ink-500);
  }
  .dpb-dest-tags {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .dpb-tag {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--brand-100);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--brand-700);
  }
</style>

<section class="dpb">
  <div class="mx-auto max-w-6xl px-6">
    <div class="dpb-wrap reveal">
      <div class="dpb-col">
        {sources.map((s) => (
          <div class="dpb-source">
            <span class="name">{s.label}</span>
            <span class="sub">{s.sub}</span>
          </div>
        ))}
      </div>

      <div class="dpb-arrow" aria-hidden="true">
        <svg width="28" height="24" viewBox="0 0 28 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M0 12h24M18 6l6 6-6 6" />
        </svg>
      </div>

      <div class="dpb-dest">
        <div class="dpb-dest-name">DeepEcom Dashboard</div>
        <div class="dpb-dest-sub">One business view</div>
        <div class="dpb-dest-tags">
          <span class="dpb-tag">Sales</span>
          <span class="dpb-tag">Profitability</span>
          <span class="dpb-tag">Payments</span>
          <span class="dpb-tag">Performance</span>
        </div>
      </div>
    </div>
  </div>
</section>