---
const kpis = [
  { label: "Revenue", value: "₹42.6L", delta: "+18.2%", tone: "brand" },
  { label: "Profit", value: "₹10.8L", delta: "+21.7%", tone: "brand" },
  { label: "Orders", value: "24,820", delta: "+9.4%", tone: "brand" },
  { label: "Realization", value: "₹39.4L", delta: "+12.1%", tone: "brand" },
]
const channels = [
  { name: "Amazon", init: "Am", revenue: "₹2,10,000", profit: "₹1,56,000", margin: "74%", bar: 90 },
  { name: "Flipkart", init: "Fk", revenue: "₹1,38,000", profit: "₹96,000", margin: "70%", bar: 68 },
  { name: "Shopify", init: "Sy", revenue: "₹73,740", profit: "₹57,240", margin: "78%", bar: 45 },
]
const line = "M72,150 C112,150 120,140 160,140 C200,140 208,145 248,145 C288,145 296,128 336,128 C376,128 384,118 424,118 C464,118 472,100 512,100 C552,100 560,78 600,78 C640,78 648,58 688,58"
const prev = "M72,160 C112,160 120,152 160,152 C200,152 208,157 248,157 C288,157 296,142 336,142 C376,142 384,136 424,136 C464,136 472,120 512,120 C552,120 560,100 600,100 C640,100 648,82 688,82"
---

<style is:global>
  .cc {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .cc-app {
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .cc-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: linear-gradient(180deg, #ffffff, var(--ink-50));
    border-bottom: 1px solid var(--ink-200);
  }
  .cc-bar .dots {
    display: flex;
    gap: 0.3rem;
  }
  .cc-bar .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-200);
  }
  .cc-bar .dots i:nth-child(1) { background: #fca5a5; }
  .cc-bar .dots i:nth-child(2) { background: #fcd34d; }
  .cc-bar .dots i:nth-child(3) { background: #86efac; }
  .cc-bar .title {
    margin-left: 0.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .cc-bar .period {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem;
    border-radius: 0.5rem;
    background: #fff;
    border: 1px solid var(--ink-200);
    color: var(--ink-500);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .cc-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    padding: 1rem;
  }
  @media (max-width: 34rem) {
    .cc-kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .cc-kpi {
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.7rem;
    background: linear-gradient(180deg, #fff, var(--ink-50));
  }
  .cc-kpi .k {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-400);
  }
  .cc-kpi .v {
    margin-top: 0.25rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }
  .cc-kpi .delta {
    margin-top: 0.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: var(--success-50);
    color: var(--success-700);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .cc-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    padding: 0 1rem 1rem;
  }
  @media (min-width: 48rem) {
    .cc-body {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .cc-chart {
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .cc-chart-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--ink-100);
    background: var(--ink-50);
  }
  .cc-chart-head .t {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .cc-chart-head .legend {
    margin-left: auto;
    display: flex;
    gap: 0.6rem;
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--ink-400);
  }
  .cc-chart-head .legend i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 0.2rem;
    vertical-align: middle;
  }
  .cc-chart svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .cc-channels {
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .cc-ch-head {
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--ink-100);
    background: var(--ink-50);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .cc-ch-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--ink-100);
  }
  .cc-ch-row:last-child {
    border-bottom: 0;
  }
  .cc-ch-init {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: 0.7rem;
    font-weight: 800;
    flex: none;
  }
  .cc-ch-info {
    min-width: 0;
    flex: 1;
  }
  .cc-ch-name {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-900);
  }
  .cc-ch-meta {
    font-size: 0.66rem;
    color: var(--ink-400);
  }
  .cc-ch-track {
    width: 2.4rem;
    flex: none;
    height: 5px;
    border-radius: 999px;
    background: var(--ink-100);
    overflow: hidden;
  }
  .cc-ch-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--brand-500), var(--brand-400));
  }
  .cc-ch-val {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-800);
    font-variant-numeric: tabular-nums;
    width: 3.2rem;
    text-align: right;
    flex: none;
  }
</style>

<section class="cc">
  <div class="mx-auto max-w-6xl px-6">
    <div class="cc-app reveal">
      <div class="cc-bar">
        <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span class="title">Business Overview</span>
        <span class="period">Aug 2026</span>
      </div>
      <div class="cc-kpis">
        {kpis.map((k) => (
          <div class="cc-kpi">
            <div class="k">{k.label}</div>
            <div class="v">{k.value}</div>
            <span class="delta">▲ {k.delta}</span>
          </div>
        ))}
      </div>
      <div class="cc-body">
        <div class="cc-chart">
          <div class="cc-chart-head">
            <span class="t">Revenue vs profit</span>
            <span class="legend">
              <span><i style="background:var(--brand-500)"></i>Revenue</span>
              <span><i style="background:var(--ink-300)"></i>Last year</span>
            </span>
          </div>
          <svg viewBox="0 0 760 240" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="ccArea" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#533afd" stop-opacity="0.14" />
                <stop offset="100%" stop-color="#533afd" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g stroke="#eeeef2">
              <line x1="64" y1="220" x2="704" y2="220" />
              <line x1="64" y1="170" x2="704" y2="170" />
              <line x1="64" y1="120" x2="704" y2="120" />
              <line x1="64" y1="70" x2="704" y2="70" />
            </g>
            <g fill="#8b8b94" font-family="Inter, sans-serif" font-size="10.5">
              <text x="54" y="224" text-anchor="end">₹0</text>
              <text x="54" y="174" text-anchor="end">₹7L</text>
              <text x="54" y="124" text-anchor="end">₹14L</text>
              <text x="54" y="74" text-anchor="end">₹21L</text>
              <text x="88" y="242" text-anchor="middle">Jan</text>
              <text x="176" y="242" text-anchor="middle">Mar</text>
              <text x="264" y="242" text-anchor="middle">May</text>
              <text x="352" y="242" text-anchor="middle">Jul</text>
              <text x="440" y="242" text-anchor="middle">Sep</text>
              <text x="528" y="242" text-anchor="middle">Nov</text>
              <text x="616" y="242" text-anchor="middle">Jan</text>
              <text x="688" y="242" text-anchor="middle" fill="#18181b" font-weight="600">Aug</text>
            </g>
            <path d={prev} stroke="#d4d4d8" stroke-width="1.75" stroke-dasharray="4 4" stroke-linecap="round" />
            <path d={`${line} L688,220 L72,220 Z`} fill="url(#ccArea)" />
            <path d={line} stroke="#533afd" stroke-width="2.25" stroke-linecap="round" />
            <line x1="688" y1="58" x2="688" y2="220" stroke="#c7d2fe" stroke-dasharray="3 3" />
            <circle cx="688" cy="58" r="4" fill="#533afd" stroke="#fff" stroke-width="2" />
          </svg>
        </div>
        <div class="cc-channels">
          <div class="cc-ch-head">Marketplace performance</div>
          {channels.map((c) => (
            <div class="cc-ch-row">
              <span class="cc-ch-init">{c.init}</span>
              <span class="cc-ch-info">
                <span class="cc-ch-name">{c.name}</span>
                <span class="cc-ch-meta">Revenue {c.revenue} · {c.margin} margin</span>
              </span>
              <span class="cc-ch-track"><span class="cc-ch-fill" style={`width:${c.bar}%`}></span></span>
              <span class="cc-ch-val">{c.profit}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>