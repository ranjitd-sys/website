---
const platformItems = ["Profitability", "Payment Reconciliation", "Reports"];
const erps = ["Tally", "SAP", "Zoho"];
---

<style is:global>
  .pec {
    padding-block: clamp(3rem, 6vh, 4.5rem);
  }

  .pec-visual {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .pec-visual {
      /* Equal width for outer cards with explicit auto-width for arrows and connector */
      grid-template-columns: 1fr auto minmax(200px, auto) auto 1fr;
      gap: 1.25rem;
    }
  }

  /* Side Cards */
  .pec-block {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1.25rem;
    background: #ffffff;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .pec-block:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.08);
  }

  .pec-block-label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand-600, #4f46e5);
    margin-bottom: 0.5rem;
  }

  .pec-block-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink-900, #0f172a);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .pec-block-items {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .pec-block-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--ink-700, #334155);
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    background: var(--ink-50, #f8fafc);
  }

  .pec-block-item::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500, #6366f1);
    flex: none;
    box-shadow: 0 0 8px var(--brand-500, #6366f1);
  }

  /* Center Card */
  .pec-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, var(--brand-600, #2563eb), var(--brand-800, #1e3a8a));
    color: #ffffff;
    text-align: center;
    box-shadow: 0 12px 25px -5px rgba(37, 99, 235, 0.3);
  }

  .pec-center-name {
    font-size: 1.125rem;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .pec-center-badge {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(6px);
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    white-space: nowrap;
  }

  /* SVG Arrows */
  .pec-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-500, #3b82f6);
    flex-shrink: 0;
  }

  .pec-arrow svg {
    width: 2rem;
    height: 1.5rem;
  }

  @media (max-width: 47.99rem) {
    .pec-arrow svg {
      transform: rotate(90deg);
    }
  }
</style>

<section class="pec">
  <div class="mx-auto max-w-6xl px-6">
    <div class="pec-visual">
      <!-- Layer 1 Card -->
      <div class="pec-block">
        <div>
          <div class="pec-block-label">Layer 1</div>
          <div class="pec-block-name">DeepEcom Platform</div>
        </div>
        <div class="pec-block-items">
          {platformItems.map((i) => <span class="pec-block-item">{i}</span>)}
        </div>
      </div>

      <!-- Arrow 1 -->
      <div class="pec-arrow" aria-hidden="true">
        <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12h26M22 6l6 6-6 6" />
        </svg>
      </div>

      <!-- Center Connector Card -->
      <div class="pec-center">
        <div class="pec-center-name">ERP Connector</div>
        <div class="pec-center-badge">Detailed Accounting</div>
      </div>

      <!-- Arrow 2 -->
      <div class="pec-arrow" aria-hidden="true">
        <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12h26M22 6l6 6-6 6" />
        </svg>
      </div>

      <!-- Layer 2 Card -->
      <div class="pec-block">
        <div>
          <div class="pec-block-label">Layer 2</div>
          <div class="pec-block-name">Your ERP</div>
        </div>
        <div class="pec-block-items">
          {erps.map((e) => <span class="pec-block-item">{e}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>