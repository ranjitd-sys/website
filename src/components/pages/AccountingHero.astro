---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const journalLines = [
  { txn: "Sales", ledger: "Sales — Amazon", amount: "₹2,117.80", side: "credit" },
  { txn: "Output GST", ledger: "CGST + SGST", amount: "₹381.20", side: "credit" },
  { txn: "Marketplace Charges", ledger: "Amazon Charges A/c", amount: "₹315.00", side: "debit" },
  { txn: "Receivable", ledger: "Receivable — Amazon", amount: "₹2,154.80", side: "debit" },
]
---

<style is:global>
  .acc-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4.5rem, 9vh, 6.5rem) 0 clamp(2.5rem, 5vh, 4rem);
    background:
      radial-gradient(46rem 24rem at 76% -10%, rgba(44, 62, 233, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 8% -6%, rgba(127, 125, 252, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .acc-hero-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .acc-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.25rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .acc-hero-grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  /* ---------- Left column ---------- */
  .acc-hero-copy {
    max-width: 34rem;
  }
  .acc-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .acc-hero-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }
  .acc-hero-title {
    margin-top: 1.1rem;
    font-size: clamp(2.35rem, 4.2vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .acc-hero-title .accent {
    color: var(--brand-500);
  }
  .acc-hero-lead {
    margin-top: 1.05rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }
  .acc-hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .acc-hero-note {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .acc-hero-note svg {
    color: var(--success-500);
    flex: none;
  }
  .acc-hero-note b {
    font-weight: 600;
    color: var(--ink-600);
  }

  /* ---------- Right column: animated pipeline ---------- */
  .acc-hero-visual {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(0.75rem, 1.5vw, 1.25rem) 0;
  }
  .acc-node {
    width: 100%;
    max-width: 26rem;
    border: 1px solid var(--ink-200);
    border-radius: 1.125rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .acc-node-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--ink-100);
    background: var(--ink-50);
  }
  .acc-node-head .tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
  }
  .acc-node-head .id {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }
  .acc-order {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
  }
  .acc-order-src {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .acc-order-src .ic {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--brand-50);
    color: var(--brand-600);
  }
  .acc-order-src .ic svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .acc-order-amt {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }

  /* DeepEcom processing card */
  .acc-engine {
    background: linear-gradient(180deg, #ffffff 0%, var(--brand-50) 140%);
  }
  .acc-engine-body {
    padding: 0.75rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .acc-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0.6rem;
    border: 1px solid var(--ink-100);
    border-radius: 0.55rem;
    background: #fff;
    font-size: 0.75rem;
  }
  .acc-line .txn {
    font-weight: 600;
    color: var(--ink-800);
  }
  .acc-line .ledger {
    color: var(--ink-400);
    font-size: 0.7rem;
    margin-left: 0.25rem;
  }
  .acc-line .amt {
    margin-left: auto;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
  }
  .acc-line .amt.credit {
    color: var(--success-600);
  }
  .acc-line .amt.debit {
    color: var(--danger-600);
  }

  /* ERP node */
  .acc-erp {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0.9rem 1rem;
  }
  .acc-erp-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.5rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.6rem;
    background: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .acc-erp-chip .chk {
    color: var(--success-500);
  }
  .acc-erp-foot {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--ink-100);
    background: var(--ink-50);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-600);
  }
  .acc-erp-foot .ok {
    margin-left: auto;
    color: var(--success-600);
    font-variant-numeric: tabular-nums;
  }

  /* Animated connector between nodes */
  .acc-connector {
    position: relative;
    width: 1.5rem;
    height: clamp(1.75rem, 3vh, 2.25rem);
    display: flex;
    justify-content: center;
  }
  .acc-connector::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, var(--brand-200), var(--brand-400));
    opacity: 0.7;
  }
  .acc-packet {
    position: absolute;
    top: -2px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
    box-shadow: 0 0 0 3px rgba(44, 62, 233, 0.15);
    animation: acc-flow 1.8s linear infinite;
  }
  .acc-packet.p2 {
    animation-delay: 0.6s;
  }
  .acc-packet.p3 {
    animation-delay: 1.2s;
  }
  @keyframes acc-flow {
    0% {
      top: 0;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 7px);
      opacity: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .acc-hero {
      padding-top: 3.75rem;
    }
    .acc-hero-title {
      font-size: clamp(2rem, 8.5vw, 2.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .acc-packet {
      animation: none;
      opacity: 0;
    }
    .acc-connector::before {
      background: var(--brand-200);
    }
  }
</style>

<section class="acc-hero" data-hero>
  <div class="acc-hero-inner">
    <div class="acc-hero-grid">
      <!-- Left column -->
      <div class="acc-hero-copy reveal">
        <span class="acc-hero-eyebrow"><span class="dot" aria-hidden="true"></span>Ecommerce Accounting</span>
        <h1 class="acc-hero-title">
          Every ecommerce transaction. <span class="accent">Accounted for.</span>
        </h1>
        <p class="acc-hero-lead">
          Turn marketplace orders, settlements, taxes, fees, returns and inventory movements into detailed accounting entries inside your ERP — automatically.
        </p>
        <div class="acc-hero-actions">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="#how-it-works" class={buttonVariants({ variant: "outline", size: "lg" })}>
            See How It Works →
          </a>
        </div>
        <p class="acc-hero-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
          Marketplace transaction in. <b>ERP-ready accounting out.</b>
        </p>
      </div>

      <!-- Right column: animated pipeline -->
      <div class="acc-hero-visual reveal" data-delay="120" aria-label="Illustration: a marketplace order flows through DeepEcom into detailed accounting entries posted to your ERP">
        <!-- Marketplace order node -->
        <div class="acc-node">
          <div class="acc-node-head">
            <span class="tag">Marketplace Order</span>
            <span class="id">Amazon · 14 Jun 2023</span>
          </div>
          <div class="acc-order">
            <span class="acc-order-src">
              <span class="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2zM9 8h6M9 12h6"/></svg>
              </span>
              ORD-104928
            </span>
            <span class="acc-order-amt">₹2,499</span>
          </div>
        </div>

        <div class="acc-connector" aria-hidden="true">
          <span class="acc-packet"></span>
          <span class="acc-packet p2"></span>
          <span class="acc-packet p3"></span>
        </div>

        <!-- DeepEcom processing node -->
        <div class="acc-node acc-engine">
          <div class="acc-node-head">
            <span class="tag" style="color:var(--brand-600)">DeepEcom</span>
            <span class="id">Detailed accounting</span>
          </div>
          <div class="acc-engine-body">
            {journalLines.map((l) => (
              <div class="acc-line">
                <span class="txn">{l.txn}</span>
                <span class="ledger">{l.ledger}</span>
                <span class:list={["amt", l.side]}>{l.amount}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="acc-connector" aria-hidden="true">
          <span class="acc-packet"></span>
          <span class="acc-packet p2"></span>
          <span class="acc-packet p3"></span>
        </div>

        <!-- ERP node -->
        <div class="acc-node">
          <div class="acc-erp">
            <span class="acc-erp-chip"><span class="chk">✓</span> Tally</span>
            <span class="acc-erp-chip"><span class="chk">✓</span> SAP</span>
            <span class="acc-erp-chip"><span class="chk">✓</span> Zoho</span>
          </div>
          <div class="acc-erp-foot">
            Posted to your ERP
            <span class="ok">JRNL-45892 ✓</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>