---
const marketplaces = ["Amazon", "Flipkart", "Shopify", "Meesho"]
const steps = ["Understand", "Validate", "Map", "Account"]
const erps = ["Tally", "SAP", "Zoho"]
---

<style is:global>
  .mte {
    padding-block: clamp(2.25rem, 4.5vh, 3.25rem);
  }
  .mte-flow {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .mte-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: 1rem;
    }
  }
  .mte-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .mte-col-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: 0.25rem;
  }
  .mte-chip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .mte-chip .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex: none;
  }
  .mte-center {
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
    color: #fff;
    text-align: center;
  }
  .mte-center-name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .mte-center-steps {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .mte-step {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.9;
  }
  .mte-step::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    flex: none;
  }
  .mte-arrow {
    display: flex;
    justify-content: center;
    color: var(--ink-300);
  }
  @media (min-width: 56rem) {
    .mte-arrow {
      transform: rotate(0deg);
    }
  }
  @media (max-width: 55.99rem) {
    .mte-arrow {
      transform: rotate(90deg);
    }
  }
</style>

<section class="mte">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mte-flow reveal">
      <div class="mte-col">
        <span class="mte-col-label">Marketplaces</span>
        {marketplaces.map((m) => (
          <div class="mte-chip">
            <span class="dot" style="background:var(--brand-500)" />
            {m}
          </div>
        ))}
      </div>

      <div class="mte-arrow" aria-hidden="true">
        <svg width="32" height="24" viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M0 12h28M22 6l6 6-6 6" />
        </svg>
      </div>

      <div class="mte-center">
        <div class="mte-center-name">DeepEcom</div>
        <div class="mte-center-steps">
          {steps.map((s) => <span class="mte-step">{s}</span>)}
        </div>
      </div>

      <div class="mte-arrow" aria-hidden="true">
        <svg width="32" height="24" viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M0 12h28M22 6l6 6-6 6" />
        </svg>
      </div>

      <div class="mte-col">
        <span class="mte-col-label">ERP</span>
        {erps.map((e) => (
          <div class="mte-chip">
            <span class="dot" style="background:var(--success-500)" />
            {e}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
