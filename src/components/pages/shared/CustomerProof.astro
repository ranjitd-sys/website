---
import SectionHeading from "@/components/landing/section-heading.astro"
import { logoAsset } from "@/data/logoAssets"

const gatiLogo = logoAsset("gati")
---

<style is:global>
  .cp {
    padding-block: clamp(2.25rem, 4.5vh, 3.25rem);
  }
  .cp-card {
    margin-top: 2rem;
    padding: 2.5rem;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .cp-logo {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.25rem;
    border-radius: 1rem;
    background: #fff;
    border: 1px solid var(--ink-200);
    color: var(--ink-400);
    font-size: 1.25rem;
    font-weight: 700;
    overflow: hidden;
  }
  .cp-logo img {
    width: 100%;
    height: 100%;
    padding: 12px;
    object-fit: contain;
  }
  .cp-quote {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--ink-700);
    font-style: italic;
  }
  .cp-author {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .cp-role {
    font-size: 0.8125rem;
    color: var(--ink-400);
  }
</style>

<section class="cp">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      eyebrow="CUSTOMER PROOF"
      title="Trusted by ecommerce businesses."
      center
    />
    <div class="cp-card reveal">
      <div class="cp-logo">
        {gatiLogo && (
          <img
            src={gatiLogo.src}
            alt="Gati logo"
            style={{ aspectRatio: `${Math.round(gatiLogo.ratio * 10)} / 10` }}
            loading="lazy"
            decoding="async"
          />
        )}
        {!gatiLogo && "GA"}
      </div>
      <p class="cp-quote">"We moved from complex settlements to a complete financial trail for every order. Every order is accounted for, every payment can be traced, every deduction can be validated."</p>
      <div class="cp-author">Gati</div>
      <div class="cp-role">Finance Team · Order-level reconciliation &amp; complete ecommerce accounting</div>
    </div>
  </div>
</section>
