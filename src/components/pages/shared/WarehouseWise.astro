---
const warehouses = [
  { code: "DEL-01", name: "Delhi", orders: "1,248", revenue: "₹18.4L" },
  { code: "MUM-02", name: "Mumbai", orders: "986", revenue: "₹14.2L" },
  { code: "BLR-03", name: "Bangalore", orders: "742", revenue: "₹10.8L" },
]
---

<style is:global>
  .ww-panel {
    width: 100%;
    max-width: 22rem;
    background: #ffffff;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    padding: 0.5rem;
  }

  .ww-panel-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-400, #64748b);
    padding: 0.75rem 0.75rem 0.25rem;
  }

  .ww-list {
    display: flex;
    flex-direction: column;
  }

  .ww-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    border-radius: 0.625rem;
    transition: background 0.15s ease;
  }

  .ww-row:hover {
    background: var(--ink-50, #f8fafc);
  }

  .ww-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ww-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--brand-50, #eff6ff);
    color: var(--brand-600, #2563eb);
    flex-shrink: 0;
  }

  .ww-code {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-900, #0f172a);
    line-height: 1.2;
  }

  .ww-name {
    font-size: 0.75rem;
    color: var(--ink-400, #64748b);
  }

  .ww-metrics {
    display: flex;
    gap: 1.25rem;
    text-align: right;
  }

  .ww-metric-label {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--ink-400, #94a3b8);
  }

  .ww-metric-val {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-800, #1e293b);
    font-variant-numeric: tabular-nums;
  }
</style>

<aside class="ww-panel">
  <div class="ww-panel-title">Warehouses</div>
  <div class="ww-list">
    {warehouses.map((w) => (
      <div class="ww-row">
        <div class="ww-info">
          <div class="ww-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7 12 2l9 5-9 5-9-5zM3 7v10l9 5 9-5V7M12 12v10" />
            </svg>
          </div>
          <div>
            <div class="ww-code">{w.code}</div>
            <div class="ww-name">{w.name}</div>
          </div>
        </div>

        <div class="ww-metrics">
          <div>
            <div class="ww-metric-label">Orders</div>
            <div class="ww-metric-val">{w.orders}</div>
          </div>
          <div>
            <div class="ww-metric-label">Revenue</div>
            <div class="ww-metric-val">{w.revenue}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</aside>