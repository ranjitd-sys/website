---
import { ArrowRight } from "lucide-react"
const { title, body, cta, href } = Astro.props as {
  title: string
  body?: string
  cta: string
  href: string
}
---
<section class="ts-cta-strip">
  <div class="mx-auto max-w-6xl px-6">
    <div class="ts-cta-card">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <div class="flex items-start gap-3">
          <span class="ts-cta-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
          </span>
          <div>
            <p class="ts-cta-title">{title}</p>
            {body && <p class="ts-cta-body">{body}</p>}
          </div>
        </div>
        <a href={href} class="ts-cta-btn">
          {cta}
          <ArrowRight size={15} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ts-cta-strip { padding-block: clamp(1.5rem, 3vh, 2rem); }
  .ts-cta-card {
    border: 1px solid var(--ink-200);
    border-radius: 1.1rem;
    background: linear-gradient(180deg, #fff 0%, var(--brand-50) 100%);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .ts-cta-icon {
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border-radius: 0.7rem;
    background: var(--brand-600);
    color: #fff;
    flex-shrink: 0;
  }
  .ts-cta-title { font-size: 0.98rem; font-weight: 700; color: var(--ink-900); }
  .ts-cta-body { margin-top: 0.3rem; font-size: 0.8125rem; line-height: 1.5; color: var(--ink-500); max-width: 34rem; }
  .ts-cta-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    flex-shrink: 0;
    border-radius: 0.7rem;
    background: var(--brand-600);
    color: #fff;
    padding: 0.6rem 1.1rem;
    font-size: 0.875rem; font-weight: 600;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .ts-cta-btn:hover { background: var(--brand-700); transform: translateY(-1px); }
</style>
