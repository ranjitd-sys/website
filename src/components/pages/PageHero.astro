---
interface Props {
  eyebrow?: string
  title: string
  lead?: string
  /** center-aligned hero (default) */
  center?: boolean
}

const { eyebrow, title, lead, center = true } = Astro.props
---

<style is:global>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 13vh, 9rem) 0 clamp(3.5rem, 7vh, 5.5rem);
    text-align: center;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: -10% -5% auto;
    z-index: -2;
    height: 40rem;
    background:
      radial-gradient(46rem 24rem at 72% -8%, rgba(99, 91, 255, 0.13), transparent 62%),
      radial-gradient(34rem 18rem at 14% -4%, rgba(133, 124, 255, 0.1), transparent 58%);
    pointer-events: none;
  }
  .page-hero-inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .page-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-500);
  }
  .page-hero-eyebrow::before,
  .page-hero-eyebrow::after {
    content: "";
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-500);
  }
  .page-hero-title {
    margin: 1.1rem auto 0;
    max-width: 54rem;
    font-size: clamp(2.25rem, 4.8vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    font-weight: var(--font-weight-bold);
    text-wrap: balance;
    color: var(--ink-950);
  }
  .page-hero-lead {
    margin: 1.25rem auto 0;
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: var(--ink-500);
  }
  .page-hero-ctas {
    margin-top: 2rem;
  }
</style>

<section class="page-hero" data-hero>
  <div class="page-hero-inner">
    {eyebrow && <span class="page-hero-eyebrow">{eyebrow}</span>}
    <h1 class="page-hero-title">{title}</h1>
    {lead && <p class="page-hero-lead">{lead}</p>}
    <div class="page-hero-ctas"><slot /></div>
  </div>
</section>