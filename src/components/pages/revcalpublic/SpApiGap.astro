---
import { SP_API_GAP } from "@/data/amazon-fees"

const todayStatus = (cost: string) =>
  cost === "free-schedule"
    ? { label: "Public", classes: "border-brand-200/70 bg-brand-50/60 text-brand-700" }
    : { label: "Estimate", classes: "border-amber-200/70 bg-amber-50/60 text-amber-700" }
---

<section aria-labelledby="sp-api-gap" class="pb-12 lg:pb-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-card">
      <div class="flex flex-wrap items-start justify-between gap-3 border-b border-ink-100 bg-gradient-to-r from-brand-50 to-white px-5 py-4 sm:px-6">
        <div class="min-w-0">
          <p class="eyebrow">SP-API gap</p>
          <h2 id="sp-api-gap" class="mt-2 max-w-2xl text-2xl font-bold tracking-tight text-ink-950 text-balance sm:text-3xl">
            Where public estimates stop
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-500">
            Each row shows what the calculator can do from public rate cards today and what becomes exact after
            connecting Seller Central through SP-API.
          </p>
        </div>
        <span class="inline-flex shrink-0 items-center rounded-full border border-danger-200/70 bg-danger-50/60 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-danger-700">
          SP-API
        </span>
      </div>
      <ul class="divide-y divide-ink-100">
        {SP_API_GAP.map((row) => {
          const today = todayStatus(row.cost)
          return (
            <li class="grid gap-2 px-5 py-4 sm:px-6 md:grid-cols-[11rem_1fr_1fr] md:gap-6">
              <p class="text-sm font-bold text-ink-900">{row.data}</p>
              <div class="min-w-0">
                <span class={"inline-flex items-center rounded-full border px-2 py-[3px] text-[10px] font-semibold whitespace-nowrap " + today.classes}>
                  {today.label}
                </span>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{row.now}</p>
              </div>
              <div class="min-w-0">
                <span class="inline-flex items-center rounded-full border border-danger-200/70 bg-danger-50/60 px-2 py-[3px] text-[10px] font-semibold whitespace-nowrap text-danger-700">
                  SP-API
                </span>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-700">{row.spApi}</p>
              </div>
            </li>
          )
        })}
      </ul>
    </div>
  </div>
</section>
