---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const realizationData = [
  { month: "Mar", expected: "₹42.6L", received: "₹42.2L", diff: "₹0.4L", status: "warning" },
  { month: "Apr", expected: "₹43.1L", received: "₹43.1L", diff: "₹0", status: "good" },
  { month: "May", expected: "₹41.8L", received: "₹39.5L", diff: "₹2.3L", status: "warning" },
  { month: "Jun", expected: "₹40.9L", received: "₹40.9L", diff: "₹0", status: "good" },
]
const channels = [
  { name: "Amazon", expected: "₹16.4L", received: "₹16.2L", diff: "₹0.2L", status: "warning" },
  { name: "Flipkart", expected: "₹9.8L", received: "₹9.8L", diff: "₹0", status: "good" },
  { name: "Shopify", expected: "₹8.2L", received: "₹8.2L", diff: "₹0", status: "good" },
  { name: "Payments", expected: "₹8.4L", received: "₹7.8L", diff: "₹0.6L", status: "warning" },
]
---
<style is:global>
  .cfreal {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .cfreal-app {
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: auto;
  }
  .cfreal-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: linear-gradient(180deg, #ffffff, var(--ink-50));
    border-bottom: 1px solid var(--ink-200);
  }
  .cfreal-bar .dots { display: flex; gap: 0.3rem; }
  .cfreal-bar .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--ink-200); }
  .cfreal-bar .dots i:nth-child(1) { background: #fca5a5; }
  .cfreal-bar .dots i:nth-child(2) { background: #fcd34d; }
  .cfreal-bar .dots i:nth-child(3) { background: #86efac; }
  .cfreal-bar .title { margin-left: 0.25rem; font-size: 0.78rem; font-weight: 700; color: var(--ink-800); }
  .cfreal-body { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .cfreal-body { grid-template-columns: 1.2fr 0.8fr; } }
  .cfreal-panel { padding: 1rem; }
  .cfreal-panel + .cfreal-panel { border-top: 1px solid var(--ink-200); }
  @media (min-width: 48rem) { .cfreal-panel + .cfreal-panel { border-top: 0; border-left: 1px solid var(--ink-200); } }
  .cfreal-panel-title { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-400); margin-bottom: 0.8rem; }
  .cfreal-row { display: flex; align-items: center; gap: 0.7rem; padding: 0.55rem 0; }
  .cfreal-row + .cfreal-row { border-top: 1px solid var(--ink-100); }
  .cfreal-row .name { width: 6rem; flex: none; font-size: 0.8rem; font-weight: 700; color: var(--ink-900); }
  .cfreal-track { flex: 1; height: 6px; border-radius: 999px; background: var(--ink-100); overflow: hidden; }
  .cfreal-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--brand-500), var(--brand-400)); }
  .cfreal-cell { display: flex; flex-direction: column; gap: 0.2rem; }
  .cfreal-cell .label { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-400); }
  .cfreal-cell .value { font-size: 0.82rem; font-weight: 800; color: var(--ink-900); font-variant-numeric: tabular-nums; }
  .cfreal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cfreal-badge.good { background: var(--success-50); border: 1px solid var(--success-200); color: var(--success-700); }
  .cfreal-badge.warning { background: var(--warning-50); border: 1px solid var(--warning-200); color: var(--warning-700); }
  .cfreal-note { padding: 0.7rem 1rem; border-top: 1px solid var(--ink-100); background: var(--ink-50); text-align: center; font-size: 0.72rem; color: var(--ink-400); }
</style>

<section class="cfreal">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="cfreal-panel-title reveal">Realization analysis · monthly expected vs received</h2>
    <div class="cfreal-app reveal">
      <div class="cfreal-bar">
        <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span class="title">Expected vs Received</span>
      </div>

      <div class="cfreal-body">
        <div class="cfreal-panel">
          <div class="cfreal-panel-title">Monthly comparison</div>
          {realizationData.map((r) => (
            <div class="cfreal-row">
              <span class="name">{r.month}</span>
              <div class="cfreal-cell">
                <div class="label">Expected</div>
                <div class="value">{r.expected}</div>
              </div>
              <div class="cfreal-cell">
                <div class="label">Received</div>
                <div class="value">{r.received}</div>
              </div>
              <div class="cfreal-cell">
                <div class="label">Variance</div>
                <div class="value">{r.diff}</div>
              </div>
              <div class="cfreal-cell">
                <span class:list={["cfreal-badge", r.status]}>{r.status}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="cfreal-panel">
          <div class="cfreal-panel-title">Channel realization</div>
          {channels.map((c) => (
            <div class="cfreal-row">
              <span class="name">{c.name}</span>
              <div class="cfreal-cell">
                <div class="label">Expected</div>
                <div class="value">{c.expected}</div>
              </div>
              <div class="cfreal-cell">
                <div class="label">Received</div>
                <div class="value">{c.received}</div>
              </div>
              <div class="cfreal-cell">
                <div class="label">Variance</div>
                <div class="value">{c.diff}</div>
              </div>
              <div class="cfreal-cell">
                <span class:list={["cfreal-badge", c.status]}>{c.status}</span>
              </div>
            </div>
          ))}
          <p class="cfreal-note">Typical ecommerce channels show 95-98% realization; payment processors show 88-92% realization</p>
        </div>
      </div>
    </div>
  </div>
</section>