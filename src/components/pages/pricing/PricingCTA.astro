---
import { BOOK_DEMO_URL } from "@/data/navigation"
import { ArrowRight } from "lucide-react"
---

<section class="bg-gradient-to-br from-brand-600 to-brand-800 py-12 lg:py-16">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl text-balance">
      Bring your ecommerce business and your books together.
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">
      Connect your marketplaces, understand your profitability, and account every transaction automatically.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={BOOK_DEMO_URL}
        class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-lg transition hover:bg-ink-50"
      >
        Book a Demo
        <ArrowRight size={16} />
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-lg border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20"
      >
        Talk to an Expert
      </a>
    </div>
  </div>
</section>