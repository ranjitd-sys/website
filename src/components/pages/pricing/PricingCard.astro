---
import { BOOK_DEMO_URL } from "@/data/navigation"
import type { Plan } from "@/data/pricing"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight, Check } from "lucide-react"

interface Props {
  plan: Plan
  featured?: boolean
}
const { plan, featured = false } = Astro.props
const inr = (n: number) => n.toLocaleString("en-IN")
const quarterly = plan.billed.quarterly
---

<article
  id={plan.id}
  class:list={[
    "group relative flex h-full flex-col rounded-2xl border p-6 transition hover:-translate-y-0.5 hover:shadow-md scroll-mt-24",
    featured
      ? "border-brand-300 bg-white shadow-card hover:border-brand-400 plan-featured"
      : "border-ink-200 bg-white shadow-card hover:border-ink-300",
  ]}
  aria-label={`${plan.name} plan`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class:list={["text-[0.72rem] font-bold uppercase tracking-[0.14em]", featured ? "text-brand-600" : "text-ink-500"]}>
      {plan.name}
    </h3>
    {featured ? (
      <span class="flex-none rounded-full bg-brand-500 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-white shadow-sm shadow-brand-500/40">
        Most popular
      </span>
    ) : (
      <span class="flex-none rounded-full border border-ink-200 bg-ink-50 px-2.5 py-1 text-[0.65rem] font-semibold text-ink-500">
        Quarterly
      </span>
    )}
  </div>

  <div class="mt-5 flex items-baseline gap-1.5">
    <span class="text-[2.6rem] font-extrabold leading-none tracking-tight text-ink-950 num">₹{inr(plan.monthly!)}</span>
    <span class="text-sm font-medium text-ink-400">/month</span>
  </div>

  <p class="mt-3 text-sm text-ink-500">
    {quarterly ? (
      <>Billed <b class="font-semibold text-ink-800">₹{inr(quarterly)}</b> every 3 months</>
    ) : (
      "Custom billing"
    )}
  </p>

  <span
    class:list={[
      "mt-3 inline-flex w-fit items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold",
      featured ? "border-brand-100 bg-brand-50 text-brand-700" : "border-ink-200 bg-ink-50 text-ink-600",
    ]}
  >
    {plan.volume}
  </span>

  <a href={BOOK_DEMO_URL} class={buttonVariants({ size: "default", className: "mt-6 w-full" })}>
    Buy Now
    <ArrowRight size={15} />
  </a>

  <ul class="mt-6 flex flex-1 flex-col gap-3 border-t border-ink-100 pt-6">
    {plan.features.map((feature) => (
      <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-700">
        <span class="mt-0.5 grid h-[18px] w-[18px] flex-none place-items-center rounded-full border border-brand-100 bg-brand-50 text-brand-600">
          <Check size={12} strokeWidth={3} />
        </span>
        {feature}
      </li>
    ))}
  </ul>
</article>

<style>
  .plan-featured::before {
    content: "";
    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-500), var(--brand-300));
    pointer-events: none;
  }
</style>