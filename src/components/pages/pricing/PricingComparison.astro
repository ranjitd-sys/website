---
import { COMPARISON_ROWS, STANDARD_PLANS } from "@/data/pricing"
import { Check } from "lucide-react"
---

<section id="compare" aria-labelledby="comparison-title" class="scroll-mt-24">
  <div class="sec">
    <div class="max-w-3xl reveal">
      <span class="eyebrow">COMPARE</span>
      <h2 id="comparison-title" class="h2-md mt-4">Compare plans at a glance</h2>
      <p class="lead mt-5">See the exact limits and included features across the six standard plans.</p>
    </div>

    <div class="mt-10 reveal" data-delay="80">
      <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-card">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[46rem] text-left">
            <caption class="sr-only">
              Comparison of the Beginner, Emerging, Scaling, Established, High-Volume and Power plans
            </caption>
            <thead>
              <tr class="border-b border-ink-100 bg-ink-50/60">
                <th scope="col" class="w-[30%] py-3.5 pl-5 pr-4 text-sm font-semibold text-ink-600"><span class="sr-only">Plan</span></th>
                {STANDARD_PLANS.map((plan) => (
                  <th key={plan.id} scope="col" class="py-3.5 px-4 text-sm font-bold tracking-tight text-ink-900">
                    {plan.name}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {COMPARISON_ROWS.map((row) => (
                <tr key={row.label} class="border-b border-ink-100 last:border-0">
                  <th scope="row" class="py-3.5 pl-5 pr-4 text-sm font-semibold text-ink-700">{row.label}</th>
                  {row.values.map((value, i) => (
                    <td key={i} class="py-3.5 px-4 text-sm">
                      {typeof value === "boolean" ? (
                        value ? (
                          <span class="inline-grid h-5 w-5 place-items-center rounded-full border border-brand-100 bg-brand-50 text-brand-600" aria-label="Included">
                            <Check size={13} strokeWidth={3} />
                          </span>
                        ) : (
                          <span class="font-semibold text-ink-300" aria-label="Not included">—</span>
                        )
                      ) : (
                        <span class="font-bold tabular-nums text-ink-950">{value}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="border-t border-ink-100 px-5 py-4 text-xs leading-relaxed text-ink-400">
          Order volumes, marketplaces and GST limits are per month. Enterprise plans above 8,000 orders a month are
          sized individually. Data Insights and Profit Tracking are only listed where they are included.
        </p>
      </div>
    </div>
  </div>
</section>