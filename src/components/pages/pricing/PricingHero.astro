---
import { buttonVariants } from "@/components/landing/ui/button"
import { STANDARD_PLANS } from "@/data/pricing"
import { BOOK_DEMO_URL } from "@/data/navigation"
import { ArrowRight, Tag } from "lucide-react"

const inr = (n: number) => n.toLocaleString("en-IN")
---

<style>
  .prh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(6.5rem, 12vh, 8.5rem) 0 clamp(2.5rem, 5vh, 4rem);
    background:
      radial-gradient(46rem 24rem at 76% -10%, rgba(83, 58, 253, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 8% -6%, rgba(127, 125, 252, 0.09), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .prh-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .prh-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.25rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .prh-grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
</style>

<section class="prh" data-hero>
  <div class="prh-inner">
    <div class="prh-grid">
      <!-- Left: copy -->
      <div class="max-w-md reveal">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-brand-600">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
          Pricing
        </span>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.06] tracking-[-0.04em] text-ink-950 text-balance sm:text-5xl">
          Plans that grow with your <span class="text-brand-500">order volume.</span>
        </h1>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-ink-500">
          Sized by monthly order volume and billed quarterly. No per-seat fees, no hidden charges.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={BOOK_DEMO_URL} class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="/pricing#compare" class={buttonVariants({ variant: "outline", size: "lg" })}>
            Compare all plans
          </a>
        </div>
        <p class="mt-5 text-[0.8125rem] font-medium text-ink-500">
          ₹1,000/mo for your first 500 orders <span class="text-brand-500">→</span> custom plan above 8,000 orders/mo
        </p>
      </div>

      <!-- Right: plan scale -->
      <div class="reveal" data-delay="120">
        <div class="mx-auto w-full max-w-[34rem] overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-card">
          <div class="flex items-center justify-between gap-3 border-b border-ink-100 bg-gradient-to-r from-brand-50 to-white px-5 py-4">
            <div class="flex items-center gap-2.5">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-500 text-white shadow-sm shadow-brand-500/30">
                <Tag size={16} />
              </span>
              <div>
                <p class="text-sm font-bold text-ink-900">DeepEcom pricing</p>
                <p class="text-xs text-ink-400">Billed quarterly · No per-seat fees</p>
              </div>
            </div>
            <span class="rounded-full border border-brand-200 bg-white px-2.5 py-1 text-[0.62rem] font-bold uppercase tracking-wider text-brand-600">
              Volume-based
            </span>
          </div>

          <div class="divide-y divide-ink-100">
            {STANDARD_PLANS.map((plan) => (
              <div class="flex items-center justify-between gap-3 px-5 py-3">
                <div>
                  <p class="text-sm font-semibold text-ink-900">{plan.name}</p>
                  <p class="text-xs text-ink-400">{plan.volume}</p>
                </div>
                <p class="text-sm font-bold tabular-nums text-ink-900">
                  ₹{inr(plan.monthly!)}
                  <span class="font-medium text-ink-400">/mo</span>
                </p>
              </div>
            ))}
          </div>

          <div class="flex items-center justify-between gap-3 bg-gradient-to-r from-[#0a0b22] via-[#111648] to-[#241b78] px-5 py-4">
            <div>
              <p class="text-sm font-bold text-white">Enterprise Seller</p>
              <p class="text-xs text-white/60">Above 8,000 orders/month</p>
            </div>
            <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-semibold text-white">
              Custom plan
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>