---
// Import the new wrapper instead of the individual pieces
import { FaqAccordion } from "@/components/landing/ui/accordion"
import { PRICING_FAQS } from "@/data/pricing"
---

<section class="pricing-faq" aria-labelledby="faq-title">
  <div class="pricing-faq-head reveal">
    <span class="eyebrow">FAQ</span>
    <h2 id="faq-title" class="h2-md">Pricing questions, answered</h2>
    <p class="lead">Everything below is based on the published plan limits. Questions beyond that? Ask us.</p>
  </div>

  <div class="pricing-faq-acc reveal" data-delay="80">
    {/* Render the single island and pass the data */}
    <FaqAccordion client:load faqs={PRICING_FAQS} className="mx-auto max-w-3xl" />
  </div>
</section>

<style>
  .pricing-faq {
    padding-bottom: var(--section-pad, 5rem);
  }
  .pricing-faq-head {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }
  .pricing-faq-head h2 {
    margin-top: 0.7rem;
  }
  .pricing-faq-head p {
    margin-top: 0.7rem;
  }
  .pricing-faq-acc {
    margin-top: 2rem;
  }
</style>