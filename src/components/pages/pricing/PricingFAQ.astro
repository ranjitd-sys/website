---
import { PRICING_FAQS } from "@/data/pricing"
---

<section aria-labelledby="faq-title">
  <div class="sec-narrow">
    <div class="reveal">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-title" class="h2-md mt-4">Pricing questions, answered</h2>
      <p class="lead mt-5">Everything below is based on the published plan limits. Questions beyond that? Ask us.</p>
    </div>

    <div class="mt-8 flex flex-col gap-3 reveal" data-delay="80">
      {PRICING_FAQS.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-q">{f.question}</summary>
          <p class="faq-a">{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .faq-item {
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    background: #fff;
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .faq-item:hover {
    border-color: var(--ink-300);
  }
  .faq-q {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-800);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q::after {
    content: "+";
    flex: none;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--brand-600);
    transition: transform var(--transition-fast);
  }
  details[open] .faq-q::after {
    transform: rotate(45deg);
  }
  .faq-a {
    margin: 0;
    padding: 0 1.25rem 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-500);
  }
</style>