---
import { BOOK_DEMO_URL } from "@/data/navigation"
import { STANDARD_PLANS } from "@/data/pricing"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight, Check } from "lucide-react"

const STEPS = [
  {
    step: "01",
    title: "Where are you today?",
    text: "Think about your order volume, how many marketplaces you sell on, and how many GST numbers you manage.",
  },
  {
    step: "02",
    title: "What do you need?",
    text: "Tally Sync and Reports are in every plan. Data Insights and Profit Tracking come in at Emerging and above.",
  },
  {
    step: "03",
    title: "Where are you headed?",
    text: "Pick the plan that fits your current stage — you can always move up as your business grows.",
  },
]
---

<section aria-labelledby="guidance-title">
  <div class="sec">
    <div class="max-w-3xl reveal">
      <span class="eyebrow">GUIDED</span>
      <h2 id="guidance-title" class="h2-md mt-4">Which plan is right for you?</h2>
      <p class="lead mt-5">Start small. Scale as your ecommerce business grows.</p>
    </div>

    <div class="mt-10 grid reveal gap-4 md:grid-cols-3" data-delay="80">
      {STEPS.map((s) => (
        <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-card transition hover:border-ink-300 hover:shadow-md">
          <span class="text-xs font-extrabold tracking-[0.14em] text-brand-500 num">{s.step}</span>
          <h3 class="mt-3 text-lg font-bold tracking-tight text-ink-900">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{s.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-6 grid reveal gap-4 md:grid-cols-3" data-delay="120">
      {STANDARD_PLANS.map((plan) => (
        <div class="flex flex-col items-start gap-3 rounded-2xl border border-ink-200 bg-white p-6 shadow-card transition hover:border-ink-300 hover:shadow-md">
          <p class="text-sm font-bold text-ink-900">{plan.name}</p>
          <p class="text-sm leading-relaxed text-ink-500">{plan.tagline}</p>
          <a href={BOOK_DEMO_URL} class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-brand-600 hover:text-brand-700">
            Buy Now
            <ArrowRight size={14} />
          </a>
        </div>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3 rounded-2xl border border-brand-100 bg-brand-50/50 px-5 py-4 reveal" data-delay="160">
      <span class="grid h-6 w-6 flex-none place-items-center rounded-full border border-brand-100 bg-white text-brand-600">
        <Check size={13} strokeWidth={3} />
      </span>
      <p class="text-sm leading-relaxed text-ink-600">
        Every plan includes Tally Sync and Reports. Above 8,000 orders a month, the Enterprise plan is a custom fit —
        <a href="/pricing#enterprise" class="font-semibold text-brand-600 hover:text-brand-700">talk to us</a>.
      </p>
    </div>
  </div>
</section>