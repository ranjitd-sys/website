---
import { BOOK_DEMO_URL } from "@/data/navigation"
import { PLANS } from "@/data/pricing"
import { ArrowRight } from "lucide-react"

const STEPS = [
  {
    step: "01",
    title: "Where are you today?",
    text: "Think about your order volume, how many marketplaces you sell on, and how many GST numbers you manage.",
  },
  {
    step: "02",
    title: "What do you need?",
    text: "Tally Sync and Reports are in every plan. Data Insights and Profit Tracking come in at Emerging and above.",
  },
  {
    step: "03",
    title: "Where are you headed?",
    text: "Pick the plan that fits your current stage — you can always move up as your business grows.",
  },
]
---

<section class="plan-guidance" aria-labelledby="guidance-title">
  <div class="guidance-head reveal">
    <span class="eyebrow">GUIDED</span>
    <h2 id="guidance-title" class="h2-md">Which plan is right for you?</h2>
    <p class="lead">Start small. Scale as your ecommerce business grows.</p>
  </div>

  <div class="guidance-steps reveal" data-delay="80">
    {STEPS.map((s) => (
      <div class="guidance-step">
        <span class="guidance-num num" aria-hidden="true">{s.step}</span>
        <h3 class="guidance-step-title">{s.title}</h3>
        <p class="guidance-step-text">{s.text}</p>
      </div>
    ))}
  </div>

  <div class="guidance-plans reveal" data-delay="120">
    {PLANS.map((plan, i) => (
      <div class:list={["guidance-plan", i === 2 && "guidance-plan--hi"]} key={plan.id}>
        <span class="guidance-plan-name">{plan.name}</span>
        <p class="guidance-plan-text">{plan.tagline}</p>
        <a class="guidance-plan-link" href={BOOK_DEMO_URL}>
          Buy Now <ArrowRight size={14} />
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .plan-guidance {
    padding-bottom: var(--section-pad, 5rem);
  }
  .guidance-head {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }
  .guidance-head h2 {
    margin-top: 0.7rem;
  }
  .guidance-head p {
    margin-top: 0.7rem;
  }

  .guidance-steps {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .guidance-step {
    border: 1px solid var(--ink-200);
    border-radius: 12px;
    background: #fff;
    padding: 1.25rem 1.35rem;
  }
  .guidance-num {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--brand-500);
  }
  .guidance-step-title {
    margin-top: 0.55rem;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-950);
  }
  .guidance-step-text {
    margin-top: 0.4rem;
    font-size: 0.87rem;
    line-height: 1.6;
    color: var(--ink-500);
  }

  .guidance-plans {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .guidance-plan {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--ink-200);
    border-radius: 12px;
    background: linear-gradient(180deg, #ffffff 0%, var(--ink-50) 100%);
    padding: 1.25rem 1.35rem;
  }
  .guidance-plan--hi {
    border-color: var(--brand-100);
    background: linear-gradient(180deg, var(--brand-50) 0%, #ffffff 100%);
  }
  .guidance-plan-name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--ink-700);
  }
  .guidance-plan--hi .guidance-plan-name {
    color: var(--brand-600);
  }
  .guidance-plan-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-500);
  }
  .guidance-plan-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-600);
    text-decoration: none;
  }
  .guidance-plan-link:hover {
    text-decoration: underline;
  }
  .guidance-plan-link:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 48rem) {
    .guidance-steps,
    .guidance-plans {
      grid-template-columns: 1fr;
    }
  }
</style>