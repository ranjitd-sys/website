---
const businessReports = [
  { label: "Profitability Summary", cols: ["Channel", "Revenue", "Profit", "Margin"], sample: ["Amazon", "₹16.4L", "₹4.6L", "28%"], period: "Monthly" },
  { label: "Payment Reconciliation", cols: ["Source", "Expected", "Received", "Variance"], sample: ["Payment Gateway 01", "₹15.2L", "₹15.2L", "₹0"], period: "Weekly" },
  { label: "Realization Analysis", cols: ["Month", "Realization %", "Variance", "Status"], sample: ["Mar", "96%", "+2%", "Good"], period: "Monthly" },
]
---
<style is:global>
  .cfrep {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .cfrep-app {
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .cfrep-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: linear-gradient(180deg, #ffffff, var(--ink-50));
    border-bottom: 1px solid var(--ink-200);
  }
  .cfrep-bar .dots { display: flex; gap: 0.3rem; }
  .cfrep-bar .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--ink-200); }
  .cfrep-bar .dots i:nth-child(1) { background: #fca5a5; }
  .cfrep-bar .dots i:nth-child(2) { background: #fcd34d; }
  .cfrep-bar .dots i:nth-child(3) { background: #86efac; }
  .cfrep-bar .title { margin-left: 0.25rem; font-size: 0.78rem; font-weight: 700; color: var(--ink-800); }
  .cfrep-title { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-400); margin-bottom: 0.8rem; }
  .cfrep-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 48rem) { .cfrep-grid { grid-template-columns: repeat(3, 1fr); } }
  .cfrep-card {
    border: 1px solid var(--ink-200);
    border-radius: 0.85rem;
    background: linear-gradient(180deg, #fff, var(--ink-50));
    overflow: hidden;
  }
  .cfrep-card .head {
    padding: 0.8rem 1rem;
    background: linear-gradient(180deg, var(--ink-50), #fff);
    border-bottom: 1px solid var(--ink-200);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .cfrep-card .cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-400);
    border-bottom: 1px solid var(--ink-200);
  }
  .cfrep-card .row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    color: var(--ink-800);
  }
  .cfrep-card .row + .row { border-top: 1px solid var(--ink-100); }
  .cfrep-card .label { font-weight: 600; }
  .cfrep-card .value { text-align: right; }
  .cfrep-card .period {
    margin-top: 0.8rem;
    text-align: center;
    font-size: 0.7rem;
    color: var(--ink-400);
    font-weight: 700;
    text-transform: uppercase;
  }
  .cfrep-note { margin-top: 1.5rem; text-align: center; font-size: 0.72rem; color: var(--ink-400); }
  .cfrep-note b { color: var(--ink-600); }
</style>

<section class="cfrep">
  <div class="mx-auto max-w-7xl px-6">
    <div class="cfrep-app reveal">
      <div class="cfrep-bar">
        <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span class="title">Finance Teams Reports</span>
      </div>

      <div class="cfrep-grid p-3">
        {businessReports.map((r) => (
          <div class="cfrep-card">
            <div class="head">{r.label}</div>
            <div class="cols">
              {r.cols.map((c) => <div>{c}</div>)}
            </div>
            <div class="row">
              {r.sample.map((s) => <div class="value">{s}</div>)}
            </div>
            <div class="period">Available {r.period.toLowerCase()}</div>
          </div>
        ))}
      </div>
      <p class="cfrep-note">
        Reports include <b>channel breakdown, reconciliation details, and exceptions.</b> Export to Excel or directly to your ERP.
      </p>
    </div>
  </div>
</section>