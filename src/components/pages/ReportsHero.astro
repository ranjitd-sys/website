---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const filters = [
  { label: "Period", value: "Aug 1 – Aug 31" },
  { label: "Marketplace", value: "Amazon" },
  { label: "Warehouse", value: "All" },
]
const rows = [
  { id: "ORD-104928", date: "03 Sep", mp: "Amazon", product: "Ceramic Mug Set", revenue: "₹2,499", payment: "₹2,499", status: "Matched", cls: "ok" },
  { id: "ORD-104929", date: "03 Sep", mp: "Amazon", product: "Cotton T-Shirt", revenue: "₹1,499", payment: "₹1,385", status: "Mismatch", cls: "warn" },
  { id: "ORD-104930", date: "02 Sep", mp: "Flipkart", product: "Leather Wallet", revenue: "₹3,200", payment: "₹3,200", status: "Matched", cls: "ok" },
  { id: "ORD-104931", date: "02 Sep", mp: "Shopify", product: "Desk Lamp", revenue: "₹899", payment: "₹899", status: "Matched", cls: "ok" },
  { id: "ORD-104932", date: "01 Sep", mp: "Flipkart", product: "Water Bottle", revenue: "₹1,750", payment: "₹1,736", status: "Mismatch", cls: "warn" },
]
---

<style is:global>
  .rp-h {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 0 clamp(3rem, 6vh, 4.5rem);
    background:
      radial-gradient(46rem 24rem at 78% -12%, rgba(47, 114, 240, 0.12), transparent 60%),
      radial-gradient(36rem 18rem at 8% -8%, rgba(167, 139, 250, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .rp-h-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .rp-h-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .rp-h-grid {
      grid-template-columns: 0.88fr 1.12fr;
    }
  }

  /* ---------- Left ---------- */
  .rp-h-copy {
    max-width: 34rem;
  }
  .rp-h-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .rp-h-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }
  .rp-h-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .rp-h-title .accent {
    color: var(--brand-500);
  }
  .rp-h-lead {
    margin-top: 1.05rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }
  .rp-h-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .rp-h-note {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .rp-h-note svg {
    color: var(--brand-500);
    flex: none;
  }
  .rp-h-note b {
    color: var(--ink-700);
  }

  /* ---------- Right: report preview ---------- */
  .rp-app {
    background: #ffffff;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    max-width: 36rem;
    margin-inline: auto;
    width: 100%;
  }
  .rp-app-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    background: linear-gradient(180deg, #ffffff, var(--ink-50));
    border-bottom: 1px solid var(--ink-200);
  }
  .rp-app-head .dots {
    display: flex;
    gap: 0.3rem;
  }
  .rp-app-head .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-200);
  }
  .rp-app-head .dots i:nth-child(1) { background: #fca5a5; }
  .rp-app-head .dots i:nth-child(2) { background: #fcd34d; }
  .rp-app-head .dots i:nth-child(3) { background: #86efac; }
  .rp-app-head .title {
    margin-left: 0.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .rp-app-head .ready {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--success-50);
    border: 1px solid var(--success-100);
    color: var(--success-700);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .rp-app-head .ready::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success-500);
  }
  .rp-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--ink-100);
  }
  .rp-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.6rem;
    border-radius: 0.5rem;
    background: var(--ink-50);
    border: 1px solid var(--ink-200);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-600);
  }
  .rp-filter .k {
    color: var(--ink-400);
  }
  .rp-filter .v {
    font-weight: 700;
    color: var(--ink-800);
  }
  .rp-table-wrap {
    overflow-x: auto;
  }
  .rp-table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  .rp-table th {
    padding: 0.6rem 1.1rem;
    text-align: left;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-400);
    background: var(--ink-50);
    border-bottom: 1px solid var(--ink-200);
  }
  .rp-table th.right {
    text-align: right;
  }
  .rp-table td {
    padding: 0.6rem 1.1rem;
    border-bottom: 1px solid var(--ink-100);
    color: var(--ink-600);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .rp-table td.right {
    text-align: right;
  }
  .rp-table td.id {
    font-weight: 700;
    color: var(--ink-900);
  }
  .rp-table tr:last-child td {
    border-bottom: 0;
  }
  .rp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
  }
  .rp-pill::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
  .rp-pill.ok {
    background: var(--success-50);
    color: var(--success-700);
  }
  .rp-pill.ok::before {
    background: var(--success-500);
  }
  .rp-pill.warn {
    background: var(--danger-50);
    color: var(--danger-600);
  }
  .rp-pill.warn::before {
    background: var(--danger-500);
  }
  .rp-app-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--ink-200);
    background: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-600);
  }
  .rp-dl {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 0.5rem;
    background: var(--brand-500);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .rp-dl svg {
    width: 13px;
    height: 13px;
  }
  @media (max-width: 47.99rem) {
    .rp-h {
      padding-top: 5rem;
    }
    .rp-h-title {
      font-size: clamp(2rem, 8.5vw, 2.6rem);
    }
  }
</style>

<section class="rp-h" data-hero>
  <div class="rp-h-inner">
    <div class="rp-h-grid">
      <!-- Left -->
      <div class="rp-h-copy reveal">
        <span class="rp-h-eyebrow"><span class="dot" aria-hidden="true"></span>Ecommerce Reports</span>
        <h1 class="rp-h-title">
          Get the <span class="accent">data behind the numbers.</span>
        </h1>
        <p class="rp-h-lead">
          Access detailed ecommerce reports across sales, profitability, payments and marketplace activity — filtered, structured and ready to use.
        </p>
        <div class="rp-h-actions">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="/platform" class={buttonVariants({ variant: "outline", size: "lg" })}>
            Explore Platform →
          </a>
        </div>
        <p class="rp-h-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>Stop rebuilding the same numbers in spreadsheets. <b>Get them as a report.</b></span>
        </p>
      </div>

      <!-- Right: report preview -->
      <div class="rp-app reveal" data-delay="120" aria-label="Illustrative report preview showing a marketplace sales report with filters and order rows">
        <div class="rp-app-head">
          <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <span class="title">Marketplace Sales Report</span>
          <span class="ready">Ready</span>
        </div>
        <div class="rp-filters">
          {filters.map((f) => (
            <span class="rp-filter"><span class="k">{f.label}:</span> <span class="v">{f.value}</span></span>
          ))}
        </div>
        <div class="rp-table-wrap">
          <table class="rp-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Marketplace</th>
                <th>Product</th>
                <th class="right">Revenue</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td class="id">{r.id}</td>
                  <td>{r.date}</td>
                  <td>{r.mp}</td>
                  <td>{r.product}</td>
                  <td class="right">{r.revenue}</td>
                  <td><span class:list={["rp-pill", r.cls]}>{r.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="rp-app-foot">
          <span>248 orders · ₹4.2L revenue</span>
          <span class="rp-dl">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Download Report
          </span>
        </div>
      </div>
    </div>
  </div>
</section>