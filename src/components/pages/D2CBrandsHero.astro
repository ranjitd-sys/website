---
import { ArrowRight, Check } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const sources = [
  { label: "Your Website", sub: "SELL" },
  { label: "Marketplaces", sub: "SELL" },
  { label: "Payment Gateways", sub: "COLLECT" },
  { label: "Shipping & Logistics", sub: "SHIP" },
  { label: "Google & Meta Ads", sub: "ACQUIRE" },
  { label: "Other Channels", sub: "SUPPORTED" },
]

const engineFeatures = ["Connect", "Understand", "Reconcile", "Account"]

const outputs = [
  "Sales & Profitability",
  "Payment Collections",
  "Structured Reports",
]

const erps = ["Tally", "SAP", "Zoho"]
---

<style is:global>
  .d2c-h {
    position: relative;
    isolation: isolate; 
    overflow: hidden;
    padding: clamp(9rem, 9vh, 9rem) 0 clamp(2.5rem, 5vh, 3.5rem);
    
    background:
      radial-gradient(46rem 24rem at 80% -10%, rgba(83, 58, 253, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 4% -8%, rgba(167, 139, 250, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50, #f8fafc) 0%, #ffffff 100%);
  }
  .d2c-h-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter, 1.5rem);
  }
  .d2c-h-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 68rem) {
    .d2c-h-grid {
      grid-template-columns: 0.82fr 1.18fr;
    }
  }

  .d2c-h-copy {
    max-width: 32rem;
  }
  .d2c-h-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    background: var(--brand-50, #f5f3ff);
    border: 1px solid var(--brand-100, #ddd6fe);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-600, #4f46e5);
  }
  .d2c-h-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500, #6366f1);
  }
  .d2c-h-title {
    margin-top: 0.75rem;
    font-size: clamp(2.2rem, 3.5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--ink-950, #020617);
    text-wrap: balance;
  }
  .d2c-h-title .accent {
    color: var(--brand-500, #6366f1);
  }
  .d2c-h-lead {
    margin-top: 0.85rem;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1.55;
    color: var(--ink-500, #64748b);
  }
  .d2c-h-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .d2c-h-note {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-400, #94a3b8);
  }
  .d2c-h-note svg {
    color: var(--brand-500, #6366f1);
    flex: none;
  }
  .d2c-h-note b {
    color: var(--ink-700, #334155);
  }

  /* SVG Visual Styles & Flow Animation */
  .d2c-h-visual {
    width: 100%;
  }
  .d2c-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Animated Flow Effect for Connectors */
  @keyframes d2cFlowAnimation {
    from {
      stroke-dashoffset: 24;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .d2c-flow-dash {
    stroke-dasharray: 6 6;
    animation: d2cFlowAnimation 1.2s linear infinite;
  }

  .d2c-h-note-under {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.68rem;
    color: var(--ink-400, #94a3b8);
  }
</style>

<section class="d2c-h" data-hero>
  <div class="d2c-h-inner">
    <div class="d2c-h-grid">
      <!-- Left Copy -->
      <div class="d2c-h-copy reveal">
        <span class="d2c-h-eyebrow"><span class="dot" aria-hidden="true"></span>For D2C Brands</span>
        <h1 class="d2c-h-title">
          All your ecommerce channels. <span class="accent">One platform.</span>
        </h1>
        <p class="d2c-h-lead">
          Bring your selling channels, payment sources, shipping and logistics partners and ad platforms into one connected view — sales, profitability, reconciliation and accounting in a single place.
        </p>
        <div class="d2c-h-actions">
          <a href="/contact" class={buttonVariants({ size: "default" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="#how-it-works" class={buttonVariants({ variant: "outline", size: "default" })}>
            See How It Works →
          </a>
        </div>
        <p class="d2c-h-note">
          <Check size={14} />
          <span>Run your entire D2C business from <b>one platform.</b></span>
        </p>
      </div>

      <!-- Right Visual: Vector SVG Diagram (Transparent Background + Animated Flow) -->
      <div class="d2c-h-visual reveal" data-delay="120" role="img" aria-label="Diagram showing sources flowing into DeepEcom engine and out to unified reporting and ERPs">
        <svg viewBox="0 0 760 450" class="d2c-svg-diagram" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <!-- Core Engine Gradient -->
            <linearGradient id="d2cEngineGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#4338ca" />
            </linearGradient>

            <!-- Connector Flow Line Gradient -->
            <linearGradient id="d2cLineGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#818cf8" />
              <stop offset="50%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#a5b4fc" />
            </linearGradient>

            <!-- Soft Drop Shadow for Core Engine -->
            <filter id="d2cShadow" x="-10%" y="-10%" width="120%" height="130%">
              <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#533afd" flood-opacity="0.22" />
            </filter>
          </defs>

          <!-- Column Headers -->
          <text x="30" y="24" font-size="10" font-weight="800" fill="#94a3b8" letter-spacing="1.2">SOURCES</text>
          <text x="530" y="24" font-size="10" font-weight="800" fill="#94a3b8" letter-spacing="1.2">OUTPUT & INTEGRATION</text>

          <!-- Static Base Connector Lines -->
          <g stroke="#cbd5e1" stroke-width="1.5" fill="none" opacity="0.5" stroke-linecap="round">
            {sources.map((_, idx) => (
              <path d={`M 230 ${72 + idx * 58} C 255 ${72 + idx * 58}, 255 220, 280 220`} />
            ))}
            <path d="M 480 190 C 505 190, 505 160, 530 160" />
            <path d="M 480 250 C 505 250, 505 320, 530 320" />
          </g>

          <!-- Animated Flowing Dash Connector Lines -->
          <g stroke="url(#d2cLineGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" class="d2c-flow-dash">
            {sources.map((_, idx) => (
              <path d={`M 230 ${72 + idx * 58} C 255 ${72 + idx * 58}, 255 220, 280 220`} />
            ))}
            <path d="M 480 190 C 505 190, 505 160, 530 160" />
            <path d="M 480 250 C 505 250, 505 320, 530 320" />
          </g>

          <!-- LEFT COLUMN: Sources -->
          {sources.map((item, idx) => (
            <g transform={`translate(30, ${48 + idx * 58})`}>
              <rect width="200" height="48" rx="10" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
              <circle cx="18" cy="24" r="3.5" fill="#6366f1" />
              <text x="32" y="28" font-size="12" font-weight="700" fill="#0f172a">{item.label}</text>
              <text x="184" y="28" font-size="9" font-weight="800" fill="#6366f1" text-anchor="end" letter-spacing="0.5">{item.sub}</text>
            </g>
          ))}

          <!-- CENTER COLUMN: DeepEcom Core Engine -->
          <g transform="translate(280, 85)" filter="url(#d2cShadow)">
            <rect width="200" height="270" rx="16" fill="url(#d2cEngineGrad)" />
            
            <text x="100" y="36" font-size="16" font-weight="800" fill="#ffffff" text-anchor="middle">DeepEcom</text>
            <text x="100" y="52" font-size="9" font-weight="800" fill="#ffffff" opacity="0.8" text-anchor="middle" letter-spacing="1">CORE PLATFORM</text>

            <!-- Engine Feature Pills -->
            {engineFeatures.map((feat, idx) => (
              <g transform={`translate(18, ${70 + idx * 45})`}>
                <rect width="164" height="34" rx="17" fill="#ffffff" fill-opacity="0.16" />
                <circle cx="18" cy="17" r="3" fill="#ffffff" />
                <text x="32" y="21" font-size="11" font-weight="600" fill="#ffffff">{feat}</text>
              </g>
            ))}
          </g>

          <!-- RIGHT COLUMN: Outputs -->
          <!-- Box 1: Unified View -->
          <g transform="translate(530, 85)">
            <rect width="195" height="150" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
            <text x="16" y="28" font-size="10" font-weight="800" fill="#4f46e5" letter-spacing="0.8">UNIFIED VIEW</text>
            
            {outputs.map((out, idx) => (
              <g transform={`translate(16, ${54 + idx * 32})`}>
                <circle cx="4" cy="0" r="3" fill="#6366f1" />
                <text x="16" y="4" font-size="11" font-weight="700" fill="#1e293b">{out}</text>
              </g>
            ))}
          </g>

          <!-- Box 2: ERP Connectors -->
          <g transform="translate(530, 260)">
            <rect width="195" height="95" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
            <text x="16" y="28" font-size="9" font-weight="800" fill="#94a3b8" letter-spacing="0.8">ERP CONNECTORS</text>
            <text x="16" y="58" font-size="13" font-weight="800" fill="#334155">{erps.join("   •   ")}</text>
          </g>
        </svg>

        <p class="d2c-h-note-under">Illustrative composition — supported systems depend on your setup.</p>
      </div>

    </div>
  </div>
</section>