---
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const inputs = [
  { label: "Your Website", sub: "storefront orders", tone: "brand" },
  { label: "Amazon", sub: "marketplace", tone: "neutral" },
  { label: "Flipkart", sub: "marketplace", tone: "neutral" },
  { label: "Other channels", sub: "supported sales", tone: "neutral" },
]
const outputs = [
  { label: "Profitability", sub: "What you actually make" },
  { label: "Reconciliation", sub: "Expected vs received" },
  { label: "Reports", sub: "Structured exports" },
  { label: "Accounting", sub: "Order-wise entries" },
]
---

<style is:global>
  .d2c-h {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 0 clamp(3rem, 6vh, 4.5rem);
    background:
      radial-gradient(46rem 24rem at 78% -12%, rgba(44, 62, 233, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 6% -8%, rgba(167, 139, 250, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .d2c-h-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .d2c-h-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: center;
  }
  @media (min-width: 72rem) {
    .d2c-h-grid {
      grid-template-columns: 0.92fr 1.08fr;
    }
  }

  .d2c-h-copy {
    max-width: 34rem;
  }
  .d2c-h-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .d2c-h-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }
  .d2c-h-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .d2c-h-title .accent {
    color: var(--brand-500);
  }
  .d2c-h-lead {
    margin-top: 1.05rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }
  .d2c-h-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .d2c-h-note {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .d2c-h-note svg {
    color: var(--brand-500);
    flex: none;
  }
  .d2c-h-note b {
    color: var(--ink-700);
  }

  /* Right: channels → DeepEcom → one view */
  .d2c-h-visual {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
  }
  .d2c-h-flow {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .d2c-h-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .d2c-h-input {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .d2c-h-input .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-500);
    flex: none;
  }
  .d2c-h-input.neutral .dot {
    background: var(--ink-300);
  }
  .d2c-h-input .l {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-900);
  }
  .d2c-h-input .s {
    font-size: 0.64rem;
    color: var(--ink-400);
  }
  .d2c-h-down {
    display: flex;
    justify-content: center;
    color: var(--brand-400);
  }
  .d2c-h-center {
    border: 1px solid var(--brand-200);
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
    color: #fff;
    padding: 0.9rem 1.1rem;
    box-shadow: 0 16px 32px -16px rgba(44, 62, 233, 0.4);
  }
  .d2c-h-center-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .d2c-h-center-name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .d2c-h-center-tag {
    margin-left: auto;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .d2c-h-center-sub {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    opacity: 0.85;
  }
  .d2c-h-outputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .d2c-h-out {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
  }
  .d2c-h-out .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500);
    flex: none;
  }
  .d2c-h-out .txt {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-800);
  }
  .d2c-h-out .sub {
    font-size: 0.64rem;
    color: var(--ink-400);
  }

  @media (max-width: 47.99rem) {
    .d2c-h {
      padding-top: 5rem;
    }
    .d2c-h-title {
      font-size: clamp(2rem, 8.5vw, 2.6rem);
    }
  }
</style>

<section class="d2c-h" data-hero>
  <div class="d2c-h-inner">
    <div class="d2c-h-grid">
      <!-- Left -->
      <div class="d2c-h-copy reveal">
        <span class="d2c-h-eyebrow"><span class="dot" aria-hidden="true"></span>For D2C Brands</span>
        <h1 class="d2c-h-title">
          One financial view for your <span class="accent">D2C business.</span>
        </h1>
        <p class="d2c-h-lead">
          Bring your website and ecommerce marketplaces together to understand sales, profitability and payments — and connect the same transaction data to your ERP.
        </p>
        <div class="d2c-h-actions">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="#how-it-works" class={buttonVariants({ variant: "outline", size: "lg" })}>
            See How It Works →
          </a>
        </div>
        <p class="d2c-h-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>Your customers see one brand. <b>Your finances should too.</b></span>
        </p>
      </div>

      <!-- Right: channels → DeepEcom → one view -->
      <div class="d2c-h-visual reveal" data-delay="120" aria-label="Illustration: your website, Amazon, Flipkart and other channels flow into DeepEcom, becoming profitability, reconciliation, reports and accounting">
        <div class="d2c-h-flow">
          <div class="d2c-h-inputs">
            {inputs.map((s) => (
              <div class:list={["d2c-h-input", s.tone === "neutral" && "neutral"]}>
                <span class="dot" aria-hidden="true"></span>
                <span><span class="l">{s.label}</span><span class="s"> {s.sub}</span></span>
              </div>
            ))}
          </div>

          <div class="d2c-h-down" aria-hidden="true">
            <svg width="20" height="16" viewBox="0 0 20 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 0v12M4 8l6 6 6-6" /></svg>
          </div>

          <div class="d2c-h-center">
            <div class="d2c-h-center-top">
              <span class="d2c-h-center-name">DeepEcom</span>
              <span class="d2c-h-center-tag">Platform + ERP Connector</span>
            </div>
            <div class="d2c-h-center-sub">One financial layer across every channel</div>
          </div>

          <div class="d2c-h-outputs">
            {outputs.map((c) => (
              <div class="d2c-h-out">
                <span class="dot" aria-hidden="true"></span>
                <span><span class="txt">{c.label}</span><span class="sub"> {c.sub}</span></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>