---
import { ArrowRight, Check, ChevronRight } from "lucide-react"
import { buttonVariants } from "@/components/landing/ui/button"

const sources = [
  { label: "Your Website" },
  { label: "Marketplaces" },
  { label: "Payment Gateways" },
  { label: "Other Channels" },
]

const engineFeatures = ["Connect", "Understand", "Reconcile", "Account"]

const erps = ["Tally", "SAP", "Zoho"]
---

<style is:global>
  .d2c-h {
    position: relative;
    isolation: isolate; 
    overflow: hidden;
    padding: clamp(9rem, 9vh, 9rem) 0 clamp(2.5rem, 5vh, 3.5rem);
    
    background:
      radial-gradient(46rem 24rem at 80% -10%, rgba(83, 58, 253, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 4% -8%, rgba(167, 139, 250, 0.1), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
  .d2c-h-inner {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter, 1.5rem);
  }
  .d2c-h-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 68rem) {
    .d2c-h-grid {
      grid-template-columns: 0.82fr 1.18fr;
    }
  }

  .d2c-h-copy {
    max-width: 32rem;
  }
  .d2c-h-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    background: var(--brand-50, #f5f3ff);
    border: 1px solid var(--brand-100, #ddd6fe);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-600, #4f46e5);
  }
  .d2c-h-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500, #6366f1);
  }
  .d2c-h-title {
    margin-top: 0.75rem;
    font-size: clamp(2.2rem, 3.5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--ink-950, #020617);
    text-wrap: balance;
  }
  .d2c-h-title .accent {
    color: var(--brand-500, #6366f1);
  }
  .d2c-h-lead {
    margin-top: 0.85rem;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1.55;
    color: var(--ink-500, #64748b);
  }
  .d2c-h-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .d2c-h-note {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-400, #94a3b8);
  }
  .d2c-h-note svg {
    color: var(--brand-500, #6366f1);
    flex: none;
  }
  .d2c-h-note b {
    color: var(--ink-700, #334155);
  }

  /* HTML/CSS Diagram Box */
  .d2c-h-visual {
    width: 100%;
  }
  .d2c-diagram-card {
    width: 100%;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 1.25rem;
    background:
      radial-gradient(30rem 22rem at 50% -10%, rgba(83, 58, 253, 0.08), transparent 62%),
      linear-gradient(180deg, #ffffff 0%, var(--ink-50, #f8fafc) 120%);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    padding: 1.5rem;
  }

  .d2c-flow-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .d2c-flow-grid {
      grid-template-columns: 1fr auto 1.1fr auto 1.1fr;
      gap: 0.6rem;
    }
  }

  .d2c-flow-col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .d2c-col-header {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-400, #94a3b8);
    margin-bottom: 0.25rem;
  }

  /* Source Nodes */
  .d2c-source-node {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    background: #ffffff;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-900, #0f172a);
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .d2c-source-node:hover {
    border-color: var(--brand-300, #a5b4fc);
    transform: translateX(2px);
  }
  .d2c-source-node .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500, #6366f1);
    flex: none;
  }

  /* Core Engine Box */
  .d2c-engine-box {
    background: linear-gradient(135deg, var(--brand-500, #6366f1), var(--brand-700, #4338ca));
    border-radius: 0.85rem;
    padding: 1.1rem 0.9rem;
    color: #ffffff;
    box-shadow: 0 12px 24px -6px rgba(83, 58, 253, 0.35);
  }
  .d2c-engine-title {
    font-size: 0.95rem;
    font-weight: 800;
    text-align: center;
  }
  .d2c-engine-subtitle {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.8;
    margin-bottom: 0.85rem;
  }
  .d2c-engine-pills {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .d2c-engine-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.65rem;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(4px);
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 600;
  }
  .d2c-engine-pill .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff;
  }

  /* Connector Arrows */
  .d2c-flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-400, #818cf8);
    padding: 0.25rem;
  }
  @media (max-width: 47.99rem) {
    .d2c-flow-arrow {
      transform: rotate(90deg);
    }
  }

  /* Output Cards */
  .d2c-output-box {
    background: #ffffff;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 0.75rem;
    padding: 0.75rem 0.85rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
  }
  .d2c-output-tag {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-600, #4f46e5);
    margin-bottom: 0.45rem;
  }
  .d2c-output-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-800, #1e293b);
  }

  .d2c-erp-box {
    background: var(--ink-50, #f8fafc);
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
  }
  .d2c-erp-tag {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-400, #94a3b8);
    margin-bottom: 0.25rem;
  }
  .d2c-erp-names {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--ink-700, #334155);
  }

  .d2c-h-note-under {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.68rem;
    color: var(--ink-400, #94a3b8);
  }
</style>

<section class="d2c-h" data-hero>
  <div class="d2c-h-inner">
    <div class="d2c-h-grid">
      <!-- Left Copy -->
      <div class="d2c-h-copy reveal">
        <span class="d2c-h-eyebrow"><span class="dot" aria-hidden="true"></span>For D2C Brands</span>
        <h1 class="d2c-h-title">
          All your ecommerce channels. <span class="accent">One platform.</span>
        </h1>
        <p class="d2c-h-lead">
          Connect the platforms you sell on and the payment systems you use to bring sales, payments, profitability, reconciliation and accounting into one place.
        </p>
        <div class="d2c-h-actions">
          <a href="/contact" class={buttonVariants({ size: "default" })}>
            Book a Demo
            <ArrowRight size={16} />
          </a>
          <a href="#how-it-works" class={buttonVariants({ variant: "outline", size: "default" })}>
            See How It Works →
          </a>
        </div>
        <p class="d2c-h-note">
          <Check size={14} />
          <span>Run your entire D2C business from <b>one platform.</b></span>
        </p>
      </div>

      <!-- Right Visual: Clean HTML/CSS Diagram Box -->
      <div class="d2c-h-visual reveal" data-delay="120" role="img" aria-label="Diagram showing sources flowing into DeepEcom engine and out to unified reporting and ERPs">
        <div class="d2c-diagram-card">
          <div class="d2c-flow-grid">
            
            <!-- Left Column: Sources -->
            <div class="d2c-flow-col">
              <span class="d2c-col-header">Sources</span>
              {sources.map((item) => (
                <div class="d2c-source-node">
                  <span class="dot" aria-hidden="true"></span>
                  <span>{item.label}</span>
                </div>
              ))}
            </div>

            <!-- Connector 1 -->
            <div class="d2c-flow-arrow" aria-hidden="true">
              <ChevronRight size={20} />
            </div>

            <!-- Center Column: DeepEcom Engine -->
            <div class="d2c-flow-col">
              <span class="d2c-col-header">&nbsp;</span>
              <div class="d2c-engine-box">
                <div class="d2c-engine-title">DeepEcom</div>
                <div class="d2c-engine-subtitle">Core Platform</div>
                <div class="d2c-engine-pills">
                  {engineFeatures.map((feat) => (
                    <div class="d2c-engine-pill">
                      <span class="dot" aria-hidden="true"></span>
                      <span>{feat}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Connector 2 -->
            <div class="d2c-flow-arrow" aria-hidden="true">
              <ChevronRight size={20} />
            </div>

            <!-- Right Column: Outputs -->
            <div class="d2c-flow-col">
              <span class="d2c-col-header">Output & Integration</span>
              <div class="d2c-output-box">
                <div class="d2c-output-tag">Unified View</div>
                <ul class="d2c-output-list">
                  <li>• Sales & Profitability</li>
                  <li>• Payment Collections</li>
                  <li>• Structured Reports</li>
                </ul>
              </div>
              <div class="d2c-erp-box">
                <div class="d2c-erp-tag">ERP Connectors</div>
                <div class="d2c-erp-names">{erps.join("  •  ")}</div>
              </div>
            </div>

          </div>
        </div>
        <p class="d2c-h-note-under">Illustrative composition — supported systems depend on your setup.</p>
      </div>

    </div>
  </div>
</section>