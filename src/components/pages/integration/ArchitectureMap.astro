---
// ArchitectureSection.astro

const inputs = [
  { name: "Marketplaces", icon: "bag", items: ["Amazon", "Flipkart", "Meesho", "Myntra", "Ajio", "Nykaa", "JioMart"] },
  { name: "Selling platforms", icon: "globe", items: ["Website", "D2C store", "Shopify"] },
  { name: "Shipping partners", icon: "truck", items: ["Shiprocket", "Delhivery", "Ekart", "Blue Dart", "Xpressbees"] },
  { name: "Payment gateways", icon: "card", items: ["Razorpay", "PayU", "Cashfree", "PhonePe", "Paytm"] },
]

const coreEngineModules = [
  {
    category: "Financial engine",
    note: "Syncs in real time",
    items: [
      { name: "Dashboard", desc: "Live metrics" },
      { name: "Profitability", desc: "SKU-level margins" },
      { name: "Payment reconciliation", desc: "Gateway matching" },
      { name: "Reports", desc: "MIS & P&L" }
    ]
  },
  {
    category: "ERP connector",
    note: "Posts automatically",
    items: [
      { name: "Accounting", desc: "Voucher automation" },
      { name: "GST", desc: "Tax filing readiness" },
      { name: "Inventory", desc: "Stock valuation" },
      { name: "Stock transfers", desc: "Multi-warehouse" }
    ]
  },
]

const erpBoxes = [
  { name: "Tally Prime", icon: "book", version: "v3.0+", items: ["GST invoicing", "Voucher sync", "Ledger mapping"] },
  { name: "SAP S/4HANA", icon: "server", version: "Enterprise", items: ["Enterprise ledger", "Auto journals", "Multi-currency"] },
  { name: "Zoho Books", icon: "cloud", version: "Cloud API", items: ["Cloud accounts", "Bank feed sync", "Tax compliance"] },
]
---

<section class="arch section-band">
  <div class="sec">
    <h2 class="h2-md arch-title">Everything connects to one core.</h2>
    <p class="lead arch-lead">
      Raw data flows in from every channel. DeepEcom normalizes, reconciles, and turns it into audit-ready accounting entries.
    </p>
  </div>

  <div class="arch-map reveal" id="arch-map" data-uid="arch1">
    <svg class="arch-connector-canvas" id="arch-connector-svg-arch1" aria-hidden="true">
      <defs>
        <marker id="arch-arrow-in-arch1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#4f46e5" />
        </marker>
        <marker id="arch-arrow-out-arch1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#4f46e5" />
        </marker>
      </defs>
    </svg>

    <!-- INPUTS -->
    <div class="arch-col">
      <span class="arch-col-label">Data sources</span>
      {inputs.map((g) => (
        <div class="arch-group" data-card="source">
          <span class="arch-group-name">
            <span class="arch-group-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {g.icon === "bag" && (<><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></>)}
                {g.icon === "globe" && (<><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></>)}
                {g.icon === "truck" && (<><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></>)}
                {g.icon === "card" && (<><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></>)}
              </svg>
            </span>
            {g.name}
          </span>
          <div class="arch-tags">
            {g.items.map((i) => <span class="arch-tag">{i}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="arch-flow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <!-- DEEPECOM CORE -->
    <div class="arch-core" id="core-box-arch1">
      <div class="arch-core-header">
        <div class="core-logo-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <span class="arch-core-name">DeepEcom core</span>
          <span class="arch-core-sub">Autonomous financial engine</span>
        </div>
      </div>

      <div class="arch-rows">
        {coreEngineModules.map((mod) => (
          <div class="arch-row">
            <div class="arch-row-top">
              <span class="arch-row-label">{mod.category}</span>
              <span class="arch-row-note">{mod.note}</span>
            </div>
            <div class="arch-grid-features">
              {mod.items.map((item) => (
                <div class="core-feature-card">
                  <span class="feature-title">{item.name}</span>
                  <span class="feature-desc">{item.desc}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="arch-flow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <!-- ERP INTEGRATIONS -->
    <div class="arch-col arch-col-out">
      <span class="arch-col-label">ERP & destinations</span>
      {erpBoxes.map((g) => (
        <div class="arch-group arch-erp-group" data-card="output">
          <div class="erp-card-header">
            <span class="arch-group-name">
              <span class="arch-group-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {g.icon === "book" && (<><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h12"/></>)}
                  {g.icon === "server" && (<><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></>)}
                  {g.icon === "cloud" && (<><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></>)}
                </svg>
              </span>
              {g.name}
            </span>
            <span class="erp-version-badge">{g.version}</span>
          </div>
          <div class="arch-tags">
            {g.items.map((i) => <span class="arch-tag">{i}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>

  <style>
    .arch.section-band {
      background: #fafafa;
      padding: clamp(3rem, 6vh, 6rem) 0;
      overflow: hidden;
    }

    .arch-title {
      font-weight: 700;
      color: #0e1424;
      margin-bottom: 0.5rem;
    }

    .arch-lead {
      color: #6b7280;
      max-width: 42ch;
    }

    :global(.arch-map) {
      position: relative;
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: var(--space-gutter, 1.5rem);
      margin-top: 2.5rem;
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      justify-items: center;
      gap: 1.5rem;
    }

    :global(.arch-connector-canvas) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      overflow: visible;
      display: none;
    }

    :global(.arch-line) {
      fill: none;
      stroke: #c7c9d9;
      stroke-width: 1.5px;
      stroke-linecap: round;
    }

    :global(.arch-line.active) {
      stroke: #4f46e5;
      stroke-dasharray: 4 6;
      animation: archFlowAnim 16s linear infinite;
    }

    @keyframes archFlowAnim {
      from { stroke-dashoffset: 200; }
      to { stroke-dashoffset: 0; }
    }

    :global(.arch-col),
    :global(.arch-core),
    :global(.arch-flow) {
      position: relative;
      z-index: 1;
    }

    :global(.arch-col) {
      width: 100%;
      max-width: 22rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    :global(.arch-col-label) {
      font-size: 0.8rem;
      font-weight: 600;
      color: #6b7280;
    }

    /* Input & output cards — flat, hairline border, no shadow */
    :global(.arch-group) {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 0.9rem 1rem;
      transition: border-color 0.15s ease;
    }

    :global(.arch-group:hover) {
      border-color: #c7c9e0;
    }

    :global(.arch-group-name) {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 0.65rem;
    }

    :global(.arch-group-icon) {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #4f46e5;
    }

    :global(.arch-group-icon svg) { width: 14px; height: 14px; }

    :global(.arch-tags) { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    :global(.arch-tag) {
      font-size: 0.78rem;
      font-weight: 500;
      color: #475569;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 0.3rem 0.6rem;
    }

    .erp-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.65rem;
    }
    .erp-card-header :global(.arch-group-name) {
      margin-bottom: 0;
    }

    .erp-version-badge {
      font-size: 0.7rem;
      color: #94a3b8;
    }

    :global(.arch-flow) { width: 24px; height: 24px; color: #c7c9d9; transform: rotate(90deg); flex-shrink: 0; }
    :global(.arch-flow svg) { width: 20px; height: 20px; }

    /* Core box — one flat accent border, no gradient, no glass */
    :global(.arch-core) {
      position: relative;
      width: 100%;
      max-width: 28rem;
      padding: 1.4rem;
      border-radius: 10px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-left: 3px solid #4f46e5;
    }

    .arch-core-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.1rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid #eef0f4;
    }

    .core-logo-badge {
      width: 32px;
      height: 32px;
      background: #eef0ff;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #4f46e5;
      flex-shrink: 0;
    }
    .core-logo-badge svg { width: 16px; height: 16px; }

    :global(.arch-core-name) {
      display: block;
      color: #0e1424;
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .arch-core-sub {
      display: block;
      color: #8c90a4;
      font-size: 0.72rem;
    }

    :global(.arch-rows) {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    :global(.arch-row) {
      padding: 0.85rem;
      border-radius: 8px;
      background: #fafafa;
      border: 1px solid #eef0f4;
    }

    .arch-row-top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 0.6rem;
    }

    :global(.arch-row-label) {
      color: #334155;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .arch-row-note {
      font-size: 0.7rem;
      color: #94a3b8;
    }

    .arch-grid-features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .core-feature-card {
      background: #ffffff;
      border: 1px solid #eef0f4;
      border-radius: 6px;
      padding: 0.5rem 0.65rem;
    }

    .feature-title {
      display: block;
      color: #0e1424;
      font-size: 0.76rem;
      font-weight: 600;
      line-height: 1.2;
    }

    .feature-desc {
      display: block;
      color: #94a3b8;
      font-size: 0.68rem;
      margin-top: 0.1rem;
    }

    @media (min-width: 48rem) {
      :global(.arch-map) {
        grid-template-columns: 1fr 56px 1.3fr 56px 1fr;
        column-gap: 1.5rem;
        row-gap: 1rem;
        align-items: stretch;
      }
      :global(.arch-connector-canvas) { display: block; }
      :global(.arch-flow) {
        transform: none;
        margin-top: 2.5rem;
        opacity: 0;
      }
      :global(.arch-map > *) { width: 100%; }
      :global(.arch-col.arch-col-out) {
        justify-content: space-between;
        padding-top: 1.5rem;
        padding-bottom: 0.3rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :global(.arch-line.active) { animation: none; }
    }
  </style>

  <script>
    // Draws connector lines by measuring real card/core positions at
    // runtime — never hand-typed coordinates. Resize + ResizeObserver are
    // coalesced into a single rAF-scheduled render so a resize can't
    // trigger two rebuild passes back to back.
    function initArchFlow(root: HTMLElement) {
      if (root.dataset.flowInit === "1") return;
      root.dataset.flowInit = "1";

      const uid = root.dataset.uid ?? "arch1";
      const svg = root.querySelector<SVGSVGElement>(`#arch-connector-svg-${uid}`);
      const core = root.querySelector<HTMLElement>(`#core-box-${uid}`);
      if (!svg || !core) return;

      const defs = svg.querySelector("defs");
      if (!defs) return;

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function relRect(el: Element, containerRect: DOMRect) {
        const r = el.getBoundingClientRect();
        return {
          left: r.left - containerRect.left,
          right: r.right - containerRect.left,
          cy: r.top - containerRect.top + r.height / 2,
        };
      }

      function curve(x1: number, y1: number, x2: number, y2: number) {
        const midX = (x1 + x2) / 2;
        return `M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${y2}, ${x2} ${y2}`;
      }

      function isDesktop() {
        return window.matchMedia("(min-width: 48rem)").matches;
      }

      function render() {
        if (!svg || !defs) return;
        const containerRect = root.getBoundingClientRect();
        svg.setAttribute("viewBox", `0 0 ${containerRect.width} ${containerRect.height}`);

        Array.from(svg.children).forEach((child) => {
          if (child !== defs) svg.removeChild(child);
        });

        if (!isDesktop()) return;

        const coreRect = relRect(core, containerRect);
        const sources = Array.from(root.querySelectorAll<HTMLElement>('[data-card="source"]'));
        const outputs = Array.from(root.querySelectorAll<HTMLElement>('[data-card="output"]'));

        sources.forEach((el) => {
          const r = relRect(el, containerRect);
          const d = curve(r.right, r.cy, coreRect.left - 6, coreRect.cy);
          const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
          p.setAttribute("class", reduceMotion ? "arch-line" : "arch-line active");
          p.setAttribute("d", d);
          p.setAttribute("marker-end", `url(#arch-arrow-in-${uid})`);
          svg.appendChild(p);
        });

        outputs.forEach((el) => {
          const r = relRect(el, containerRect);
          const d = curve(coreRect.right + 6, coreRect.cy, r.left, r.cy);
          const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
          p.setAttribute("class", reduceMotion ? "arch-line" : "arch-line active");
          p.setAttribute("d", d);
          p.setAttribute("marker-end", `url(#arch-arrow-out-${uid})`);
          svg.appendChild(p);
        });
      }

      let scheduled = false;
      function scheduleRender() {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          render();
        });
      }

      render();
      const ro = new ResizeObserver(scheduleRender);
      ro.observe(root);
      window.addEventListener("resize", scheduleRender);
      const settleTimeout = window.setTimeout(render, 150);

      document.addEventListener(
        "astro:before-swap",
        () => {
          ro.disconnect();
          window.removeEventListener("resize", scheduleRender);
          window.clearTimeout(settleTimeout);
        },
        { once: true }
      );
    }

    document.querySelectorAll<HTMLElement>("#arch-map").forEach(initArchFlow);
  </script>
</section>