---
const products = ["Sales", "Profitability", "Payments", "Reconciliation", "Reports", "Accounting"]
const engine = ["CONNECT", "UNDERSTAND", "RECONCILE", "ACCOUNT"]
const systems = ["Marketplaces", "Payments", "Fees", "Settlements", "Returns"]
---

<section class="clayer" aria-label="The Connected Layer Architecture">
  <div class="sec">
    <div class="clayer-head">
      <span class="eyebrow">THE CONNECTED LAYER</span>
      <h2 class="h2-md clayer-title">One layer between your business and the systems behind it.</h2>
      <p class="lead clayer-lead">
        DeepEcom doesn't replace any of your systems. It sits between them, connects their data,
        and transforms fragmented inputs into unified financial truth.
      </p>
    </div>

    <div class="clayer-flow-container" role="img" aria-label="Multiple systems feed into DeepEcom engine pipeline, generating one unified business view">
      
      <!-- Stage 1: Input Systems -->
      <div class="flow-node-group">
        <span class="flow-node-label">RAW INPUTS</span>
        <div class="node-stack">
          {systems.map((sys, i) => (
            <div class="flow-pill input-pill" style={`--i: ${i}`}>
              <span class="pill-dot"></span>
              <span>{sys}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Flow Bridge 1 -->
      <div class="flow-bridge" aria-hidden="true">
        <div class="bridge-line"></div>
        <div class="bridge-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
      </div>

      <!-- Stage 2: DeepEcom Core Engine Pipeline -->
      <div class="flow-core-hub">
        <div class="core-ambient-glow"></div>
        <div class="core-header">
          <span class="core-brand">DEEPECOM</span>
          <span class="core-sub">Core Processing Pipeline</span>
        </div>
        <div class="pipeline-steps">
          {engine.map((step, i) => (
            <div class="pipeline-step-card" style={`--i: ${i}`}>
              <span class="step-num">0{i+1}</span>
              <span class="step-name">{step}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Flow Bridge 2 -->
      <div class="flow-bridge" aria-hidden="true">
        <div class="bridge-line"></div>
        <div class="bridge-arrow accent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
      </div>

      <!-- Stage 3: Unified Business View Outputs -->
      <div class="flow-node-group">
        <span class="flow-node-label output-lbl">UNIFIED VIEW</span>
        <div class="node-stack">
          {products.map((prod, i) => (
            <div class="flow-pill output-pill" style={`--i: ${i}`}>
              <span class="pill-check">✓</span>
              <span>{prod}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

  <style>
    :global(.clayer) {
      padding: clamp(2rem, 4vh, 3.5rem) 0;
      position: relative;
      overflow: hidden;
    }
    :global(.clayer-head) { max-width: 44rem; }
    :global(.clayer-title) { margin-top: 0.6rem; letter-spacing: -0.025em; font-weight: 800; }
    :global(.clayer-lead) { margin-top: 0.75rem; color: var(--ink-500); }

    :global(.clayer-flow-container) {
      margin-top: 2.5rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: center;
      position: relative;
    }

    @media (min-width: 64rem) {
      :global(.clayer-flow-container) {
        grid-template-columns: 1fr auto 1.4fr auto 1fr;
        gap: 1.5rem;
      }
    }

    :global(.flow-node-group) {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      background: #ffffff;
      border: 1px solid var(--ink-200, #e2e8f0);
      border-radius: 1.25rem;
      padding: 1.25rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.03);
    }

    :global(.flow-node-label) {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-400);
    }
    :global(.output-lbl) { color: var(--brand-600, #4f46e5); }

    :global(.node-stack) {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    :global(.flow-pill) {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--ink-700);
      background: var(--ink-50, #f8fafc);
      border: 1px solid var(--ink-200, #e2e8f0);
      border-radius: 10px;
      padding: 0.5rem 0.8rem;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    :global(.flow-pill:hover) {
      transform: translateX(2px);
      border-color: var(--ink-300);
    }

    :global(.pill-dot) {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--amber, #d97706);
    }

    :global(.output-pill) {
      background: linear-gradient(90deg, #ffffff 0%, #f4fdf8 100%);
      border-color: #d1fae5;
      color: var(--ink-900);
    }

    :global(.pill-check) {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--brand-emerald, #059669);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px; height: 16px;
      background: #d1fae5;
      border-radius: 50%;
    }

    /* Flow Bridges / Connectors */
    :global(.flow-bridge) {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      height: 100%;
      min-height: 80px;
    }

    @media (min-width: 64rem) {
      :global(.flow-bridge) { display: flex; width: 40px; }
    }

    :global(.bridge-line) {
      position: absolute;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--ink-200), var(--brand-250, #c7d2fe));
      top: 50%;
      transform: translateY(-50%);
    }

    :global(.bridge-arrow) {
      position: relative;
      z-index: 2;
      width: 28px; height: 28px;
      background: #ffffff;
      border: 1px solid var(--ink-300);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ink-500);
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    :global(.bridge-arrow.accent) {
      border-color: var(--brand-300);
      color: var(--brand-600);
      background: var(--brand-50);
    }
    :global(.bridge-arrow svg) { width: 14px; height: 14px; }

    /* DeepEcom Core Engine Hub */
    :global(.flow-core-hub) {
      position: relative;
      background: linear-gradient(135deg, #533afd 0%, #462ce0 100%);
      border-radius: 1.5rem;
      padding: 1.75rem 1.5rem;
      box-shadow: 0 20px 45px -10px rgba(83, 58, 253, 0.35);
      color: #ffffff;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
      overflow: hidden;
    }

    :global(.core-ambient-glow) {
      position: absolute;
      inset: -10px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.15) 0%, transparent 70%);
      pointer-events: none;
    }

    :global(.core-header) {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      position: relative;
      z-index: 1;
    }

    :global(.core-brand) {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: 0.08em;
    }

    :global(.core-sub) {
      font-size: 0.72rem;
      color: rgba(255, 255, 255, 0.75);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    :global(.pipeline-steps) {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
      position: relative;
      z-index: 1;
    }

    :global(.pipeline-step-card) {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 12px;
      padding: 0.75rem 0.85rem;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
      backdrop-filter: blur(8px);
      transition: background 0.2s ease, transform 0.2s ease;
    }

    :global(.pipeline-step-card:hover) {
      background: rgba(255, 255, 255, 0.18);
      transform: translateY(-2px);
    }

    :global(.step-num) {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.6);
    }

    :global(.step-name) {
      font-size: 0.85rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 0.04em;
    }
  </style>
</section>