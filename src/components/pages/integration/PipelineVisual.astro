---
// PipelineHero.astro
// Architecture flow visual: Sources -> DeepEcom core -> Unified View
//
// WHAT WAS BROKEN BEFORE:
// The connector <path> coordinates were hand-typed constants tuned for one
// specific viewBox (800x540) and one specific card count (8 left / 6 right).
// Cards actually render in a flex column, so their real Y positions depend
// on font-rendering, gaps, and how many cards exist. The hardcoded numbers
// didn't match reality, which is why the lines on the right drifted and
// poked out above the "Unified View" label instead of meeting the cards.
//
// FIX: don't hardcode any coordinates. Measure the real DOM positions of
// the core box and every card at runtime (and again on resize), then draw
// the bezier paths to match exactly. This is correct for any number of
// source/output cards and any card height.

const sources = [
  { name: "Amazon", category: "Market", icon: "box" },
  { name: "Flipkart", category: "Market", icon: "shopping-bag" },
  { name: "Shopify", category: "Store", icon: "store" },
  { name: "Payments", category: "Gateway", icon: "credit-card" },
  { name: "Settlements", category: "Banking", icon: "landmark" },
  { name: "Returns", category: "Logistics", icon: "refresh-cw" },
  { name: "Inventory", category: "WMS", icon: "clipboard" },
  { name: "Tally / ERP", category: "Finance", icon: "bar-chart" },
];

const outputs = [
  { label: "Sales Sync", sub: "Real-time stream" },
  { label: "Payment Recon", sub: "100% matched" },
  { label: "Profitability", sub: "SKU-level margins" },
  { label: "Reconciliation", sub: "Automated ledger" },
  { label: "Fin Reports", sub: "Audit-ready" },
  { label: "Auto Ledger", sub: "ERP synced" },
];
---

<div class="pipeline-visual-hero" aria-label="DeepEcom Architecture Flow">
  <!-- SVG is now an empty canvas; JS below fills it with paths measured from
       the real card/core positions, so it can never drift out of alignment. -->
  <svg
    class="hero-flow-canvas"
    id="hero-flow-canvas"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="hero-in" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#cbd5e1" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#5b4dfb" stop-opacity="0.8" />
      </linearGradient>
      <linearGradient id="hero-out" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#5b4dfb" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#10a37f" stop-opacity="0.55" />
      </linearGradient>
      <filter id="hero-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
      <marker id="arrow-in" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#5b4dfb" />
      </marker>
      <marker id="arrow-out" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#10a37f" />
      </marker>
    </defs>
    <!-- paths + particles injected here at runtime -->
  </svg>

  <div class="hero-grid-layout">
    <!-- SOURCES COLUMN -->
    <div class="hero-col">
      <div class="col-lbl"><span class="dot warning"></span> Sources</div>
      <div class="cards-box">
        {
          sources.map((s, i) => (
            <div class="h-card" data-card="source" style={`--d: ${i * 0.03}s`}>
              <div class="icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  {s.icon === "box" && (
                    <>
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                      <line x1="12" y1="22.08" x2="12" y2="12" />
                    </>
                  )}
                  {s.icon === "shopping-bag" && (
                    <>
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                      <line x1="3" y1="6" x2="21" y2="6" />
                      <path d="M16 10a4 4 0 0 1-8 0" />
                    </>
                  )}
                  {s.icon === "store" && (
                    <>
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </>
                  )}
                  {s.icon === "credit-card" && (
                    <>
                      <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                      <line x1="1" y1="10" x2="23" y2="10" />
                    </>
                  )}
                  {s.icon === "landmark" && (
                    <>
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                    </>
                  )}
                  {s.icon === "refresh-cw" && (
                    <>
                      <polyline points="1 4 1 10 7 10" />
                      <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                    </>
                  )}
                  {s.icon === "clipboard" && (
                    <>
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" y1="13" x2="8" y2="13" />
                      <line x1="16" y1="17" x2="8" y2="17" />
                    </>
                  )}
                  {s.icon === "bar-chart" && (
                    <>
                      <line x1="18" y1="20" x2="18" y2="10" />
                      <line x1="12" y1="20" x2="12" y2="4" />
                      <line x1="6" y1="20" x2="6" y2="14" />
                    </>
                  )}
                </svg>
              </div>
              <div class="c-info">
                <span class="c-title">{s.name}</span>
                <span class="c-sub">{s.category}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ENGINE CORE COLUMN -->
    <div class="hero-col center-col">
      <div class="engine-core-box" id="core-box">
        <div class="core-ring"></div>
        <div class="core-inner">
          <div class="core-logo-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 3l10 5.5-10 5.5L2 8.5 12 3z" stroke-linejoin="round" />
              <path d="M2 13.5l10 5.5 10-5.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M2 18.5l10 5.5 10-5.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="core-eyebrow">Core Engine</span>
          <h3 class="core-heading">DeepEcom</h3>
          <p class="core-subtext">Accounting Layer</p>
          <div class="core-live-pill">
            <span class="pulse-dot"></span> Live Sync
          </div>
        </div>
      </div>
    </div>

    <!-- UNIFIED VIEW COLUMN -->
    <div class="hero-col">
      <div class="col-lbl right"><span class="dot success"></span> Unified View</div>
      <div class="cards-box">
        {
          outputs.map((o, i) => (
            <div class="h-card out-card" data-card="output" style={`--d: ${i * 0.04 + 0.15}s`}>
              <div class="c-info">
                <span class="c-title">{o.label}</span>
                <span class="c-sub emerald">{o.sub}</span>
              </div>
              <div class="check-box">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                  <path d="M13.333 4L6 11.333 2.667 8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  :root {
    --card-bg: #ffffff;
    --text-dark: #0e1424;
    --text-muted: #6b7280;
    --text-faint: #9aa2b1;
    --brand-indigo: #5b4dfb;
    --brand-indigo-2: #7c6bff;
    --brand-indigo-light: #eef0ff;
    --brand-emerald: #10a37f;
    --brand-emerald-light: #ecfdf6;
    --brand-amber: #d97706;
    --border-subtle: #ecedf3;
    --border-hover: #d7d9e4;
    --surface: #fbfbfe;
    --shadow-card: 0 1px 2px rgba(15, 23, 42, 0.04), 0 10px 24px -14px rgba(15, 23, 42, 0.12);
    --shadow-card-hover: 0 4px 10px rgba(91, 77, 251, 0.08), 0 18px 32px -14px rgba(91, 77, 251, 0.18);
    --shadow-core: 0 30px 60px -18px rgba(91, 77, 251, 0.28);
  }

  .pipeline-visual-hero {
    position: relative;
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    padding: 2.5rem 1.5rem;
    border-radius: 28px;
    background:
      radial-gradient(60% 50% at 15% 10%, rgba(91, 77, 251, 0.06), transparent 70%),
      radial-gradient(60% 50% at 85% 90%, rgba(16, 163, 127, 0.06), transparent 70%),
      var(--surface);
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    letter-spacing: -0.006em;
  }

  .hero-flow-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }

  :global(.hero-line) {
    fill: none;
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-dasharray: 3 7;
    opacity: 0.85;
    animation: heroFlowAnim 14s linear infinite;
  }

  @keyframes heroFlowAnim {
    from { stroke-dashoffset: 200; }
    to { stroke-dashoffset: 0; }
  }

  .hero-grid-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 170px 1fr;
    gap: 3.25rem;
    align-items: center;
  }

  .hero-col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .col-lbl {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    background: #fff;
    border: 1px solid var(--border-subtle);
    padding: 0.3rem 0.65rem 0.3rem 0.5rem;
    border-radius: 999px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    margin-bottom: 0.15rem;
  }

  .col-lbl.right {
    align-self: flex-end;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .dot.warning { background: var(--brand-amber); box-shadow: 0 0 6px rgba(217, 119, 6, 0.45); }
  .dot.success { background: var(--brand-emerald); box-shadow: 0 0 6px rgba(16, 163, 127, 0.45); }

  .cards-box {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .h-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 0.6rem 0.85rem;
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    animation: hCardFade 0.4s ease-out var(--d) backwards;
  }

  .h-card:hover {
    border-color: rgba(91, 77, 251, 0.28);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .out-card {
    justify-content: space-between;
    background: linear-gradient(180deg, #ffffff 0%, #fafffd 100%);
    border-color: #dcf5ec;
  }

  .out-card:hover {
    border-color: rgba(16, 163, 127, 0.3);
    box-shadow: 0 4px 10px rgba(16, 163, 127, 0.08), 0 18px 32px -14px rgba(16, 163, 127, 0.2);
  }

  .icon-wrap {
    width: 32px;
    height: 32px;
    background: linear-gradient(150deg, var(--brand-indigo-light) 0%, #e4e0ff 100%);
    border: 1px solid rgba(91, 77, 251, 0.12);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-indigo);
    flex-shrink: 0;
  }

  .icon-wrap svg {
    width: 15px;
    height: 15px;
  }

  .c-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.05rem;
  }

  .c-title {
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--text-dark);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .c-sub {
    font-size: 0.62rem;
    color: var(--text-faint);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .emerald {
    color: var(--brand-emerald);
    opacity: 0.85;
  }

  .check-box {
    width: 20px;
    height: 20px;
    background: linear-gradient(150deg, var(--brand-emerald-light), #d5f6ea);
    color: var(--brand-emerald);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-box svg {
    width: 9px;
    height: 9px;
  }

  .center-col {
    align-items: center;
    justify-content: center;
  }

  .engine-core-box {
    position: relative;
    border-radius: 26px;
    padding: 2px;
    width: 100%;
    z-index: 2;
    box-shadow: var(--shadow-core);
  }

  /* Slowly rotating conic-gradient ring, clipped to a 2px border by the
     white inner panel sitting on top of it — the "premium SaaS" halo. */
  .core-ring {
    position: absolute;
    inset: 0;
    border-radius: 26px;
    background: conic-gradient(
      from 0deg,
      var(--brand-indigo) 0deg,
      var(--brand-indigo-2) 90deg,
      var(--brand-emerald) 180deg,
      var(--brand-indigo-2) 270deg,
      var(--brand-indigo) 360deg
    );
    animation: ringSpin 6s linear infinite;
    opacity: 0.9;
  }

  @keyframes ringSpin {
    to { transform: rotate(360deg); }
  }

  .core-inner {
    position: relative;
    background: #ffffff;
    border-radius: 24px;
    padding: 2.1rem 1.25rem 1.75rem;
    text-align: center;
  }

  .core-logo-badge {
    width: 52px;
    height: 52px;
    background: linear-gradient(150deg, var(--brand-indigo) 0%, var(--brand-indigo-2) 100%);
    color: #fff;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.9rem auto;
    box-shadow: 0 10px 20px -5px rgba(91, 77, 251, 0.5);
  }

  .core-logo-badge svg {
    width: 26px;
    height: 26px;
  }

  .core-eyebrow {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand-indigo);
    margin-bottom: 0.3rem;
  }

  .core-heading {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
  }

  .core-subtext {
    font-size: 0.66rem;
    color: var(--text-muted);
    margin: 0 0 1.4rem 0;
    font-weight: 500;
  }

  .core-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.85rem;
    background: var(--brand-emerald-light);
    color: var(--brand-emerald);
    font-size: 0.64rem;
    font-weight: 700;
    border-radius: 20px;
    border: 1px solid #b9ecda;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--brand-emerald);
    border-radius: 50%;
    animation: corePulse 1.8s infinite;
  }

  @keyframes corePulse {
    0%, 100% { transform: scale(0.9); opacity: 0.6; }
    50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 6px var(--brand-emerald); }
  }

  @keyframes hCardFade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .hero-grid-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero-flow-canvas { display: none; }
    .cards-box { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
    .engine-core-box { max-width: 300px; margin: 0 auto; }
  }
</style>

<script>
  // Draws every connector by MEASURING real DOM rects, instead of trusting
  // hand-typed coordinates. This is the actual fix for the right-hand-side
  // drift/overshoot: the old paths assumed a fixed 800x540 canvas with an
  // exact number of evenly-spaced cards, which broke the moment real
  // rendered heights (fonts, wrapping, card count) differed from that guess.
  function initHeroFlow(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>("#hero-flow-canvas");
    const core = root.querySelector<HTMLElement>("#core-box");
    if (!svg || !core) return;

    const defs = svg.querySelector("defs")!;

    function relRect(el: Element, containerRect: DOMRect) {
      const r = el.getBoundingClientRect();
      return {
        left: r.left - containerRect.left,
        right: r.right - containerRect.left,
        top: r.top - containerRect.top,
        bottom: r.bottom - containerRect.top,
        cy: r.top - containerRect.top + r.height / 2,
      };
    }

    function curve(x1: number, y1: number, x2: number, y2: number) {
      const midX = (x1 + x2) / 2;
      return `M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${y2}, ${x2} ${y2}`;
    }

    function render() {
      const containerRect = root.getBoundingClientRect();
      if(!svg)return;
      svg.setAttribute("viewBox", `0 0 ${containerRect.width} ${containerRect.height}`);

      // wipe previous paths/particles, keep <defs>
      Array.from(svg.children).forEach((child) => {
        if (child !== defs) svg.removeChild(child);
      });

      const coreRect = relRect(core , containerRect);
      const sourceCards = Array.from(root.querySelectorAll<HTMLElement>('[data-card="source"]'));
      const outputCards = Array.from(root.querySelectorAll<HTMLElement>('[data-card="output"]'));

      const addParticle = (d: string, color: string, dur: string, delay: number) => {
        const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        circle.setAttribute("r", "3");
        circle.setAttribute("fill", color);
        circle.setAttribute("opacity", "0.9");
        const anim = document.createElementNS("http://www.w3.org/2000/svg", "animateMotion");
        anim.setAttribute("dur", dur);
        anim.setAttribute("repeatCount", "indefinite");
        anim.setAttribute("begin", `${delay}s`);
        anim.setAttribute("path", d);
        circle.appendChild(anim);
        svg.appendChild(circle);
      };

      sourceCards.forEach((card, i) => {
        const r = relRect(card, containerRect);
        const d = curve(r.right, r.cy, coreRect.left - 6, coreRect.cy);
        const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p.setAttribute("class", "hero-line hero-line-in");
        p.setAttribute("d", d);
        p.setAttribute("stroke", "url(#hero-in)");
        p.setAttribute("filter", "url(#hero-glow)");
        p.setAttribute("marker-end", "url(#arrow-in)");
        svg.appendChild(p);
        // Every inbound line gets its own particle, staggered so the flow
        // reads as a continuous stream converging into the core.
        addParticle(d, "#5b4dfb", "2.8s", i * 0.35);
      });

      outputCards.forEach((card, i) => {
        const r = relRect(card, containerRect);
        const d = curve(coreRect.right + 6, coreRect.cy, r.left, r.cy);
        const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p.setAttribute("class", "hero-line hero-line-out");
        p.setAttribute("d", d);
        p.setAttribute("stroke", "url(#hero-out)");
        p.setAttribute("filter", "url(#hero-glow)");
        p.setAttribute("marker-end", "url(#arrow-out)");
        svg.appendChild(p);
        // Same idea fanning back out, on its own stagger so it reads as
        // "processed data leaving the core" rather than a static wire.
        addParticle(d, "#10a37f", "2.4s", i * 0.3);
      });
    }

    render();
    const ro = new ResizeObserver(() => render());
    ro.observe(root);
    window.addEventListener("resize", render);
    // Re-measure once more after fonts/layout settle.
    window.setTimeout(render, 150);
  }

  document.querySelectorAll<HTMLElement>(".pipeline-visual-hero").forEach(initHeroFlow);
</script>