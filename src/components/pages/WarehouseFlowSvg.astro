---
const warehouses = [
  { code: "WH-A", name: "Delhi", sku: "SKU-2048", qty: "1,240" },
  { code: "WH-B", name: "Mumbai", sku: "SKU-2048", qty: "860" },
]
---

<style is:global>
  .wfs {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }
  .wfs svg {
    width: 100%;
    height: auto;
    max-width: 30rem;
    display: block;
    overflow: visible;
  }
  .wfs .wh-card {
    filter: url(#wfs-shadow);
  }
  .wfs .wh-code {
    font-family: Inter, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    fill: #2c3ee9;
  }
  .wfs .wh-name {
    font-family: Inter, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    fill: #0f172a;
  }
  .wfs .wh-label {
    font-family: Inter, system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    fill: #64748b;
  }
  .wfs .wh-val {
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    fill: #0f172a;
    font-variant-numeric: tabular-nums;
  }
  .wfs .flow-guide {
    stroke: #e2e8f0;
    stroke-width: 2;
    fill: none;
  }
  .wfs .flow-anim {
    stroke: #2c3ee9;
    stroke-width: 2.5;
    fill: none;
    stroke-dasharray: 6 8;
    animation: wfs-flow 1.2s linear infinite;
  }
  .wfs .flow-dot {
    fill: #8a98f7;
    animation: wfs-dot 1.2s linear infinite;
  }
  @keyframes wfs-flow {
    to { stroke-dashoffset: -28; }
  }
  @keyframes wfs-dot {
    0% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translate(70px, 0); }
  }
  .wfs .flow-label {
    font-family: Inter, system-ui, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    fill: #2c3ee9;
  }
  .wfs .node-title {
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 800;
    fill: #0f172a;
  }
  .wfs .node-sub {
    font-family: Inter, system-ui, sans-serif;
    font-size: 9px;
    font-weight: 500;
    fill: #94a3b8;
  }
  @media (prefers-reduced-motion: reduce) {
    .wfs .flow-anim,
    .wfs .flow-dot {
      animation: none;
    }
    .wfs .flow-dot {
      opacity: 0;
    }
  }
</style>

<section class="wfs" aria-label="Warehouse and inventory flow: an Amazon order is accounted against inventory at a warehouse, with stock transfers between warehouses">
  <svg viewBox="0 0 480 460" fill="none" role="img" aria-label="Amazon order to warehouse inventory to accounting flow with a stock transfer between two warehouses">
    <defs>
      <filter id="wfs-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#0f172a" flood-opacity="0.06" />
      </filter>
    </defs>

    <!-- Top: Amazon order chip -->
    <g transform="translate(140, 20)">
      <rect x="0" y="0" width="200" height="54" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" class="wh-card" />
      <circle cx="18" cy="27" r="4" fill="#2c3ee9" />
      <text x="30" y="22" class="node-title">Amazon Order</text>
      <text x="30" y="38" class="node-sub">#104928 · 2 units · SKU-2048</text>
    </g>

    <!-- Flow: order → inventory -->
    <g>
      <path d="M 240 74 L 240 96" class="flow-guide" />
      <path d="M 240 74 L 240 96" class="flow-anim" />
      <circle cx="240" cy="80" r="3.5" class="flow-dot" />
    </g>

    <!-- Inventory accounting node -->
    <g transform="translate(120, 96)">
      <rect x="0" y="0" width="240" height="52" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" class="wh-card" />
      <rect x="0" y="0" width="4" height="52" rx="2" fill="#2c3ee9" />
      <text x="18" y="22" class="node-title">Inventory movement</text>
      <text x="18" y="38" class="node-sub">−2 units · accounted warehouse-wise</text>
    </g>

    <!-- Flow: inventory → warehouse A -->
    <g>
      <path d="M 120 148 C 120 178, 120 178, 120 200" class="flow-guide" />
      <path d="M 120 148 C 120 178, 120 178, 120 200" class="flow-anim" />
      <circle cx="120" cy="158" r="3.5" class="flow-dot" />
    </g>

    <!-- Warehouse A card -->
    <g transform="translate(20, 200)">
      <rect x="0" y="0" width="200" height="150" rx="18" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" class="wh-card" />
      <text x="18" y="28" class="wh-code">{warehouses[0].code}</text>
      <text x="18" y="50" class="wh-name">{warehouses[0].name}</text>
      <line x1="18" y1="64" x2="182" y2="64" stroke="#f1f5f9" stroke-width="1" />
      <text x="18" y="84" class="wh-label">SKU</text>
      <text x="182" y="84" text-anchor="end" class="wh-val">{warehouses[0].sku}</text>
      <text x="18" y="106" class="wh-label">Quantity</text>
      <text x="182" y="106" text-anchor="end" class="wh-val">{warehouses[0].qty}</text>
      <text x="18" y="128" class="wh-label">Stock</text>
      <text x="182" y="128" text-anchor="end" class="wh-val">In balance</text>
    </g>

    <!-- Warehouse B card -->
    <g transform="translate(260, 200)">
      <rect x="0" y="0" width="200" height="150" rx="18" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" class="wh-card" />
      <text x="18" y="28" class="wh-code">{warehouses[1].code}</text>
      <text x="18" y="50" class="wh-name">{warehouses[1].name}</text>
      <line x1="18" y1="64" x2="182" y2="64" stroke="#f1f5f9" stroke-width="1" />
      <text x="18" y="84" class="wh-label">SKU</text>
      <text x="182" y="84" text-anchor="end" class="wh-val">{warehouses[1].sku}</text>
      <text x="18" y="106" class="wh-label">Quantity</text>
      <text x="182" y="106" text-anchor="end" class="wh-val">{warehouses[1].qty}</text>
      <text x="18" y="128" class="wh-label">Stock</text>
      <text x="182" y="128" text-anchor="end" class="wh-val">In balance</text>
    </g>

    <!-- Stock transfer between warehouses -->
    <g>
      <path d="M 220 220 L 260 220" class="flow-guide" />
      <path d="M 220 220 L 260 220" class="flow-anim" />
      <circle cx="230" cy="220" r="3.5" class="flow-dot" />
      <text x="240" y="236" text-anchor="middle" class="flow-label">STOCK TRANSFER</text>
    </g>

    <!-- Flow: warehouse A → accounting -->
    <g>
      <path d="M 120 350 C 120 380, 240 380, 240 392" class="flow-guide" />
      <path d="M 120 350 C 120 380, 240 380, 240 392" class="flow-anim" />
      <circle cx="150" cy="372" r="3.5" class="flow-dot" />
    </g>

    <!-- Bottom: accounting -->
    <g transform="translate(120, 392)">
      <rect x="0" y="0" width="240" height="52" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" class="wh-card" />
      <rect x="0" y="0" width="4" height="52" rx="2" fill="#2c3ee9" />
      <text x="18" y="22" class="node-title">Accounting</text>
      <text x="18" y="38" class="node-sub">Warehouse-wise entries · posted to ERP</text>
    </g>
  </svg>
</section>