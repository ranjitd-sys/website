---
const systems = [
  { label: "Store", sub: "your website", tone: "brand", category: "Storefront" },
  { label: "Marketplace 01", sub: "sales channel", tone: "neutral", category: "Channel" },
  { label: "Marketplace 02", sub: "sales channel", tone: "neutral", category: "Channel" },
  { label: "Payment Gateway 01", sub: "collections", tone: "neutral", category: "Payments" },
  { label: "Payment Gateway 02", sub: "collections", tone: "neutral", category: "Payments" },
  { label: "Shipping Partner", sub: "logistics & dispatch", tone: "neutral", category: "Operations" },
  { label: "Ad Platforms", sub: "Google · Meta spend", tone: "neutral", category: "Marketing" },
  { label: "Reports", sub: "spreadsheets", tone: "neutral", category: "Analytics" },
  { label: "ERP", sub: "books & accounting", tone: "neutral", category: "Finance" },
]
---

<style is:global>
  .d2cf {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .d2cf-app {
    position: relative;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    background:
      radial-gradient(40rem 15rem at 50% -10%, rgba(83, 58, 253, 0.05), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, var(--ink-50) 100%);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    padding: 1.25rem;
  }
  .d2cf-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--ink-100);
  }
  .d2cf-top .title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-800);
  }
  .d2cf-top .hint {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-400);
  }
  .d2cf-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    padding-top: 1rem;
  }
  @media (min-width: 40rem) {
    .d2cf-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .d2cf-sys {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease;
  }
  .d2cf-sys:hover {
    border-color: var(--brand-300);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -2px rgba(83, 58, 253, 0.08);
  }
  .d2cf-sys.brand {
    border-color: var(--brand-200);
    background: linear-gradient(180deg, var(--brand-50), #ffffff);
  }
  .d2cf-sys .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-300);
    flex: none;
  }
  .d2cf-sys.brand .dot {
    background: var(--brand-500);
    box-shadow: 0 0 0 3px var(--brand-100);
  }
  .d2cf-sys .l {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.2;
  }
  .d2cf-sys .s {
    font-size: 0.62rem;
    color: var(--ink-400);
  }
  
  /* Connecting line with arrow */
  .d2cf-connector {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.2rem;
    color: var(--brand-500);
  }
  .d2cf-connector::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, var(--ink-200), var(--brand-300));
    z-index: 0;
  }
  .d2cf-connector svg {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border-radius: 50%;
    padding: 2px;
  }

  .d2cf-sink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-radius: 0.9rem;
    background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
    color: #ffffff;
    box-shadow: 0 12px 24px -10px rgba(83, 58, 253, 0.45);
  }
  .d2cf-sink .name {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }
  .d2cf-sink .desc {
    font-size: 0.72rem;
    opacity: 0.9;
  }
  .d2cf-sink .tag {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(4px);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>

<section class="d2cf">
  <div class="mx-auto max-w-6xl px-6">
    <div class="d2cf-app reveal" role="img" aria-label="Illustration showing individual channels consolidating into DeepEcom">
      
      <!-- Top header bar -->
      <div class="d2cf-top">
        <span class="title">Your D2C systems today</span>
        <span class="hint">Independent Data Streams</span>
      </div>

      <!-- Systems grid -->
      <div class="d2cf-grid">
        {systems.map((s) => (
          <div class:list={["d2cf-sys", s.tone === "brand" && "brand"]}>
            <span class="dot" aria-hidden="true"></span>
            <div>
              <div class="l">{s.label}</div>
              <div class="s">{s.sub}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Arrow Flow Indicator -->
      <div class="d2cf-connector" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M6 13l6 6 6-6"/>
        </svg>
      </div>

      <!-- Consolidated Sink -->
      <div class="d2cf-sink">
        <div>
          <div class="name">DeepEcom</div>
          <div class="desc">One unified platform for every stream</div>
        </div>
        <span class="tag">Unified Hub</span>
      </div>

    </div>
  </div>
</section>