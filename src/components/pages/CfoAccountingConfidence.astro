const erpSystems = ["Tally", "SAP", "Zoho Books"]
---
<style is:global>
  .cfr {
    padding-block: clamp(1rem, 2vh, 1.5rem);
  }
  .cfr-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .cfr-wrap { grid-template-columns: 1.4fr 1fr; }
  }
  .cfr-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.025em; color: var(--ink-950); }
  .cfr-lead { margin-top: 0.75rem; font-size: clamp(1rem, 1.2vw, 1.125rem); line-height: 1.6; color: var(--ink-500); }
  .cfr-sections { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  .cfr-sec {
    flex: 1 1 120px;
    min-width: 120px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: linear-gradient(180deg, #fff, var(--ink-50));
    text-align: center;
  }
  .cfr-sec svg { width: 20px; height: 20px; color: var(--brand-600); margin-bottom: 0.35rem; }
  .cfr-sec .lbl { font-size: 0.78rem; font-weight: 700; color: var(--ink-800); }
  .cfr-erp {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding-top: 2rem;
  }
  .cfr-erp-title { font-size: 0.78rem; font-weight: 700; color: var(--ink-600); text-transform: uppercase; letter-spacing: 0.08em; }
  .cfr-erp-list { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
  .cfr-erp-badge {
    padding: 0.45rem 1rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-700);
  }
  .cfr-highlight {
    margin-top: 1.25rem;
    background: linear-gradient(135deg, var(--brand-50), #fff);
    border: 1px solid var(--brand-100);
    border-radius: 1rem;
    padding: 1.25rem;
  }
  .cfr-highlight h3 { font-size: 1rem; font-weight: 700; color: var(--ink-800); margin-bottom: 0.35rem; }
  .cfr-highlight p { font-size: 0.85rem; color: var(--ink-500); line-height: 1.5; }
  @media (max-width: 55.99rem) {
    .cfr { padding-block: 0.75rem; }
  }
</style>

