---
import type { RankingBucket } from "@/lib/seo-dashboard/data"

interface Props {
  buckets: RankingBucket[]
}

const { buckets } = Astro.props

const total = buckets.reduce((s, b) => s + b.count, 0)
const noData = buckets.find((b) => b.label === "No data")?.count ?? 0
const ranked = total - noData
const top10 = (buckets.find((b) => b.label === "Top 3")?.count ?? 0) + (buckets.find((b) => b.label === "4–10")?.count ?? 0)
const maxCount = Math.max(...buckets.map((b) => b.count), 1)

const colorFor = (label: string) => {
  switch (label) {
    case "Top 3":
      return "var(--brand-700)"
    case "4–10":
      return "var(--brand-600)"
    case "11–20":
      return "var(--brand-500)"
    case "21–50":
      return "var(--brand-400)"
    case "50+":
      return "var(--ink-400)"
    default:
      return "var(--ink-300)"
  }
}
---

<section class="rounded-2xl border border-border bg-white p-6 shadow-card">
  <header>
    <div class="flex items-baseline justify-between">
      <h3 class="text-sm font-semibold text-ink-950">Ranking distribution</h3>
      <span class="font-mono text-sm font-bold text-ink-950 tabular-nums">{total}</span>
    </div>
    <p class="mt-0.5 text-xs text-muted-foreground">Latest position per keyword</p>
  </header>

  {
    total === 0 ? (
      <p class="py-10 text-center text-xs text-muted-foreground">
        No keywords recorded yet. Run the optimizer to populate the catalog.
      </p>
    ) : (
      <>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-brand-100 bg-brand-50 px-3.5 py-2.5">
            <p class="font-mono text-xl font-bold leading-none text-brand-700 tabular-nums">{top10}</p>
            <p class="mt-1.5 text-[11px] font-semibold uppercase tracking-wider text-brand-700/80">Top 10</p>
          </div>
          <div class="rounded-xl border border-border bg-ink-50 px-3.5 py-2.5">
            <p class="font-mono text-xl font-bold leading-none text-ink-700 tabular-nums">{ranked}</p>
            <p class="mt-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink-500">Ranked</p>
          </div>
        </div>

        <ul class="mt-6 space-y-3.5">
          {buckets.map((b) => {
            const pct = total === 0 ? 0 : (b.count / total) * 100
            const width = b.count === 0 ? 0 : Math.max((b.count / maxCount) * 100, 2.5)
            const zero = b.count === 0
            return (
              <li class="group flex items-center gap-3" title={`${b.label}: ${b.count} (${pct.toFixed(0)}%)`}>
                <span class:list={["w-14 shrink-0 text-xs font-semibold tabular-nums", zero ? "text-ink-400" : "text-ink-700"]}>{b.label}</span>
                <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-ink-100">
                  <div
                    class="h-full rounded-full transition-[width] duration-500 ease-out group-hover:brightness-110"
                    style={`width:${width}%;background:${colorFor(b.label)}`}
                  ></div>
                </div>
                <span class:list={["w-6 shrink-0 text-right font-mono text-xs font-bold tabular-nums", zero ? "text-ink-300" : "text-ink-950"]}>
                  {b.count}
                </span>
                <span class="w-9 shrink-0 text-right font-mono text-[11px] tabular-nums text-muted-foreground">
                  {pct === 0 ? "—" : `${pct.toFixed(0)}%`}
                </span>
              </li>
            )
          })}
        </ul>
      </>
    )
  }
</section>