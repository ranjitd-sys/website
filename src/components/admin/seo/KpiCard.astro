---
import { Eye, MousePointerClick, Percent, Target } from "lucide-react"

interface Props {
  label: string
  value: string
  hint?: string
  delta?: number
  positiveIsGood?: boolean
  verb?: string
  icon?: "clicks" | "impressions" | "ctr" | "position"
  deltaSuffix?: string
}

const { label, value, hint, delta, positiveIsGood = true, verb = "vs prev period", icon, deltaSuffix = "%" } = Astro.props

const hasDelta = typeof delta === "number" && Number.isFinite(delta)
const flat = hasDelta ? delta === 0 : false
const improved = hasDelta ? (positiveIsGood ? delta > 0 : delta < 0) : false

const ICONS = {
  clicks: MousePointerClick,
  impressions: Eye,
  ctr: Percent,
  position: Target,
}
const Icon = icon ? ICONS[icon] : null
---

<div class="group rounded-2xl border border-border bg-white p-5 shadow-card transition hover:border-ink-300">
  <div class="flex items-center justify-between">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{label}</p>
    {
      Icon && (
        <span class="grid size-8 place-items-center rounded-lg bg-brand-50 text-brand-600 transition group-hover:bg-brand-100" aria-hidden="true">
          <Icon size={15} strokeWidth={2} />
        </span>
      )
    }
  </div>
  <p class="mt-4 font-mono text-[32px] font-bold leading-none tracking-tight text-ink-950 tabular-nums">{value}</p>
  <div class="mt-3.5 flex items-baseline gap-2">
    {
      hasDelta && (
        <span
          class:list={[
            "inline-flex items-center gap-0.5 rounded-md px-1.5 py-0.5 font-mono text-xs font-semibold tabular-nums",
            flat ? "bg-ink-100 text-ink-500" : improved ? "bg-success-100 text-success-700" : "bg-danger-100 text-danger-700",
          ]}
        >
          {delta! > 0 ? "↑" : delta! < 0 ? "↓" : "·"} {Math.abs(delta!).toFixed(delta! % 1 ? 1 : 0)}
          {deltaSuffix && <span class="text-[10px] opacity-70">{deltaSuffix}</span>}
        </span>
      )
    }
    {
      !hasDelta && (
        <span class="inline-flex items-center rounded-md bg-ink-50 px-1.5 py-0.5 font-mono text-xs font-medium text-ink-300 tabular-nums">—</span>
      )
    }
    <span class="text-xs text-muted-foreground">{hint ?? verb}</span>
  </div>
</div>