---
interface Props {
  label: string
  value: string
  hint?: string
  delta?: number
  positiveIsGood?: boolean
  verb?: string
}

const { label, value, hint, delta, positiveIsGood = true, verb = "vs prev period" } = Astro.props

const hasDelta = typeof delta === "number" && Number.isFinite(delta)
const improved = hasDelta ? (positiveIsGood ? delta! < 0 : delta! > 0) : false
const flat = hasDelta ? delta! === 0 : false
---

<div class="rounded-2xl border border-border bg-white p-5 shadow-card">
  <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{label}</p>
  <p class="mt-2 font-mono text-3xl font-bold tracking-tight text-ink-950 tabular-nums">{value}</p>
  <div class="mt-3 flex items-baseline gap-2">
    {
      hasDelta && (
        <span
          class:list={[
            "inline-flex items-center rounded-md px-1.5 py-0.5 font-mono text-xs font-semibold tabular-nums",
            flat
              ? "bg-ink-100 text-ink-500"
              : improved
                ? "bg-success-100 text-success-700"
                : "bg-danger-100 text-danger-700",
          ]}
        >
          {delta! > 0 ? "↑" : delta! < 0 ? "↓" : "·"} {Math.abs(delta!).toFixed(delta! % 1 ? 1 : 0)}
        </span>
      )
    }
    <span class="text-xs text-muted-foreground">{hint ?? verb}</span>
  </div>
</div>