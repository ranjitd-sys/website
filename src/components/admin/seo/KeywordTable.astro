---
import type { KeywordMover } from "@/lib/seo-dashboard/data"

interface Props {
  movers: KeywordMover[]
}

const { movers } = Astro.props

const intentStyle = (intent: string) =>
  intent === "commercial"
    ? "text-brand-700 bg-brand-50"
    : intent === "transactional"
      ? "text-success-700 bg-success-50"
      : "text-ink-600 bg-ink-100"

const positionDot = (pos: number | null) =>
  pos === null
    ? "bg-ink-300"
    : pos <= 3
      ? "bg-success-500"
      : pos <= 10
        ? "bg-brand-600"
        : pos <= 20
          ? "bg-brand-400"
          : "bg-ink-400"

const fmt = (n: number | null) => (n === null ? "—" : n >= 1000 ? `${(n / 1000).toFixed(n % 1000 === 0 ? 0 : 1)}k` : `${n}`)

const sorted = [...movers].sort((a, b) => {
  if (a.position === null && b.position === null) return 0
  if (a.position === null) return 1
  if (b.position === null) return -1
  return a.position - b.position
})

const maxImpr = Math.max(...sorted.map((m) => m.impressions), 1)
---

<section class="overflow-hidden rounded-2xl border border-border bg-white shadow-card">
  <header class="flex items-center justify-between border-b border-border px-5 py-4">
    <div>
      <h3 class="text-sm font-semibold text-ink-950">Top keyword movers</h3>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Best position first · {sorted.filter((m) => m.position !== null).length} keywords tracked
      </p>
    </div>
    <span class="rounded-md bg-ink-50 px-2 py-0.5 font-mono text-xs font-semibold text-ink-500 tabular-nums">
      {sorted.length}
    </span>
  </header>

  {
    sorted.length === 0 ? (
      <div class="px-5 py-10 text-center text-xs text-muted-foreground">
        No ranking samples yet. Positions appear once the agent records a baseline.
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full min-w-[680px] text-sm">
          <thead>
            <tr class="border-b border-border text-[11px] uppercase tracking-wider text-muted-foreground">
              <th class="w-8 px-5 py-2.5 text-left font-semibold"><span class="sr-only">Rank</span></th>
              <th class="px-2 py-2.5 text-left font-semibold">Keyword</th>
              <th class="px-4 py-2.5 text-center font-semibold">Position</th>
              <th class="px-4 py-2.5 text-center font-semibold">Change</th>
              <th class="px-4 py-2.5 text-right font-semibold">Volume</th>
              <th class="px-4 py-2.5 text-right font-semibold">Clicks</th>
              <th class="px-5 py-2.5 text-right font-semibold">Impressions</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((m, i) => {
              const improved = m.delta !== null && m.delta < 0
              const changed = m.delta !== null && m.delta !== 0
              return (
                <tr class="border-b border-border last:border-0 hover:bg-brand-50/40">
                  <td class="px-5 py-3.5 align-top">
                    <span class="font-mono text-xs font-semibold text-ink-300 tabular-nums">{i + 1}</span>
                  </td>
                  <td class="px-2 py-3.5">
                    <p class="font-medium text-ink-900">{m.term}</p>
                    <span class:list={["mt-1 inline-flex rounded px-1.5 py-px text-[10px] font-semibold uppercase tracking-wide", intentStyle(m.intent)]}>
                      {m.intent}
                    </span>
                  </td>
                  <td class="px-4 py-3.5 text-center">
                    <span class="inline-flex items-baseline gap-1.5">
                      <span class:list={["inline-block size-1.5 translate-y-[-2px] rounded-full", positionDot(m.position)]} aria-hidden="true"></span>
                      <span class="font-mono text-lg font-bold leading-none text-ink-950 tabular-nums">
                        {m.position !== null ? `${m.position}` : "—"}
                      </span>
                    </span>
                    <p class="mt-1 text-[11px] text-muted-foreground">{m.position30 !== null ? `was ${m.position30}` : "first reading"}</p>
                  </td>
                  <td class="px-4 py-3.5 text-center">
                    {
                      changed ? (
                        <span
                          class:list={[
                            "inline-flex items-center gap-0.5 rounded-md px-1.5 py-0.5 font-mono text-xs font-semibold tabular-nums",
                            improved ? "bg-success-100 text-success-700" : "bg-danger-100 text-danger-700",
                          ]}
                        >
                          {improved ? "↓" : "↑"} {Math.abs(m.delta!)}
                        </span>
                      ) : m.position30 !== null ? (
                        <span class="inline-flex rounded-md border border-border px-1.5 py-0.5 text-xs font-medium text-ink-400">hold</span>
                      ) : (
                        <span class="inline-flex rounded-md border border-brand-200 bg-white px-1.5 py-0.5 text-xs font-medium text-brand-600">new</span>
                      )
                    }
                  </td>
                  <td class="px-4 py-3.5 text-right font-mono tabular-nums text-ink-600">{fmt(m.volume)}</td>
                  <td class="px-4 py-3.5 text-right font-mono tabular-nums text-ink-600">{fmt(m.clicks)}</td>
                  <td class="px-5 py-3.5 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <span class="h-1 w-14 overflow-hidden rounded-full bg-ink-100">
                        <span class="block h-full rounded-full bg-brand-400" style={`width:${(m.impressions / maxImpr) * 100}%`}></span>
                      </span>
                      <span class="w-12 font-mono tabular-nums text-ink-600">{fmt(m.impressions)}</span>
                    </div>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    )
  }
</section>