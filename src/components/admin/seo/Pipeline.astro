---
import type { PipelineStage } from "@/lib/seo-dashboard/data"

const { stages } = Astro.props

const activeStages: PipelineStage[] = stages.filter((s) => s.status !== "rejected")
const rejected = stages.find((s) => s.status === "rejected")
const flowCount = activeStages.length
const maxCount = Math.max(...stages.map((s) => s.count), 1)

const colorFor = (status: string) => {
  switch (status) {
    case "proposed":
      return { bar: "var(--ink-300)", text: "var(--ink-600)" }
    case "optimizing":
      return { bar: "var(--brand-400)", text: "var(--brand-700)" }
    case "approved":
      return { bar: "var(--brand-500)", text: "var(--brand-700)" }
    case "done":
      return { bar: "var(--brand-600)", text: "var(--brand-800)" }
    case "measured":
      return { bar: "var(--success-500)", text: "var(--success-700)" }
    default:
      return { bar: "var(--ink-200)", text: "var(--ink-500)" }
  }
}
---

<section class="rounded-2xl border border-border bg-white p-5 shadow-card">
  <header class="mb-4 flex items-center justify-between">
    <h3 class="text-sm font-semibold text-ink-950">Opportunity pipeline</h3>
    <span class="text-xs text-muted-foreground">{stages.reduce((s, x) => s + x.count, 0)} opportunities</span>
  </header>

  <div class="grid gap-3" style={`grid-template-columns: repeat(${flowCount}, minmax(0, 1fr))`}>
    {activeStages.map((s, i) => {
      const c = colorFor(s.status)
      return (
        <div key={s.status} class="relative">
          <div class="rounded-xl border border-border bg-ink-50/60 p-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full" style={{ background: "var(--ink-100)" }}>
              <div class="h-full rounded-full" style={`width:${(s.count / maxCount) * 100}%;background:${c.bar}`}></div>
            </div>
            <p class="mt-2 font-mono text-2xl font-bold text-ink-950 tabular-nums">{s.count}</p>
            <p class="text-xs font-semibold capitalize" style={`color:${c.text}`}>{s.status}</p>
            {s.avgScore !== null && (
              <p class="mt-0.5 text-xs text-muted-foreground">avg score {Math.round(s.avgScore)}</p>
            )}
          </div>
          {i < flowCount - 1 && (
            <span class="absolute top-1/2 -right-2.5 z-10 -translate-y-1/2 rounded-full bg-white px-0.5 text-ink-300" aria-hidden="true">
              →
            </span>
          )}
        </div>
      )
    })}
  </div>

  {
    rejected && (
      <p class="mt-4 inline-flex items-center gap-2 text-xs text-muted-foreground">
        <span class="inline-flex min-w-8 justify-center rounded-md bg-ink-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-ink-600 tabular-nums">
          {rejected.count}
        </span>
        rejected by review step
      </p>
    )
  }
</section>