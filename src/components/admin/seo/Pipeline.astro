---
import type { OpportunityStatus, PipelineStage } from "@/lib/seo-dashboard/data"

interface Props {
  stages: PipelineStage[]
}

const { stages } = Astro.props

const FLOW: OpportunityStatus[] = ["proposed", "optimizing", "approved", "done", "measured"]
const rejected = stages.find((s) => s.status === "rejected")

const stageMap = new Map(stages.map((s) => [s.status, s.count]))
const stageCount = (s: OpportunityStatus) => stageMap.get(s) ?? 0
const total = stages.reduce((acc, s) => acc + s.count, 0)
const measured = stageCount("measured")
const maxCount = Math.max(...stages.map((s) => s.count), 1)

const colorFor = (status: string) => {
  switch (status) {
    case "proposed":
      return { accent: "var(--ink-300)", bg: "var(--ink-50)", label: "var(--ink-700)", count: "var(--ink-950)" }
    case "optimizing":
      return { accent: "var(--brand-400)", bg: "var(--brand-50)", label: "var(--brand-700)", count: "var(--brand-800)" }
    case "approved":
      return { accent: "var(--brand-600)", bg: "var(--brand-100)", label: "var(--brand-800)", count: "var(--brand-900)" }
    case "done":
      return { accent: "var(--success-500)", bg: "var(--success-50)", label: "var(--success-700)", count: "var(--success-700)" }
    case "measured":
      return { accent: "var(--success-600)", bg: "var(--success-100)", label: "var(--success-700)", count: "var(--success-700)" }
    default:
      return { accent: "var(--ink-200)", bg: "var(--ink-50)", label: "var(--ink-500)", count: "var(--ink-700)" }
  }
}
---

<section class="rounded-2xl border border-border bg-white p-6 shadow-card">
  <header class="flex items-center justify-between border-b border-border px-1 pb-4">
    <div>
      <h3 class="text-sm font-semibold text-ink-950">Opportunity pipeline</h3>
      <p class="mt-0.5 text-xs text-muted-foreground">
        {total} {total === 1 ? "opportunity" : "opportunities"}
        {measured > 0 ? ` · ${measured} measured` : ""}
      </p>
    </div>
    <span class="rounded-md bg-ink-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
      proposed → measured
    </span>
  </header>

  <div class="mt-5 flex flex-wrap items-stretch gap-0">
    {FLOW.map((status, i) => {
      const count = stageCount(status)
      const c = colorFor(status)
      const pct = Math.max(4, (count / maxCount) * 100)
      const isEmpty = count === 0
      return (
        <>
          <div class:list={["relative flex min-w-0 flex-1 flex-col justify-between rounded-xl border px-4 py-4 transition", isEmpty ? "border-border bg-white opacity-60" : "border-transparent shadow-sm"]}
               style={`background:${c.bg};border-top:3px solid ${c.accent}`}>
            <p class="font-mono text-2xl font-bold tabular-nums" style={`color:${c.count}`}>{count}</p>
            <div class="mt-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider" style={`color:${c.label}`}>{status}</p>
              <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/70">
                <div class="h-full rounded-full" style={`width:${pct}%;background:${c.accent}`}></div>
              </div>
            </div>
          </div>
          {i < FLOW.length - 1 && (
            <div class="flex w-5 shrink-0 items-center justify-center text-ink-300" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          )}
        </>
      )
    })}
  </div>

  {
    rejected && rejected.count > 0 && (
      <div class="mt-4 flex items-center justify-between rounded-xl border border-border bg-danger-50 px-4 py-2.5">
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 4l8 8M12 4l-8 8" stroke="var(--danger-500)" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <p class="text-xs font-medium text-danger-700">
            <span class="font-mono font-semibold tabular-nums">{rejected.count}</span>
            <span class="ml-1">rejected by review step</span>
          </p>
        </div>
        <span class="text-[10px] uppercase tracking-wider text-danger-600/70">discarded</span>
      </div>
    )
  }
</section>