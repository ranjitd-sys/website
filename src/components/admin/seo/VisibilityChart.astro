---
import type { DailyVisibility } from "@/lib/seo-dashboard/data"

interface Props {
  days: DailyVisibility[]
  maxPoints?: number
}

const { days, maxPoints = 90 } = Astro.props
const data = days.slice(-maxPoints)
const W = 720
const H = 240
const PAD = { top: 12, right: 8, bottom: 24, left: 8 }

const n = data.length
const maxImpr = Math.max(...data.map((d) => d.impressions), 1)
const maxClicks = Math.max(...data.map((d) => d.clicks), 1)
const maxV = Math.max(maxImpr, maxClicks) * 1.15
const minPos = Math.min(...data.map((d) => d.position), 20) - 1
const maxPos = Math.max(...data.map((d) => d.position), 20) + 2

const x = (i: number) => PAD.left + (i / Math.max(n - 1, 1)) * (W - PAD.left - PAD.right)
const yImp = (v: number) => PAD.top + (1 - v / maxV) * (H - PAD.top - PAD.bottom)
const yPos = (v: number) => PAD.top + ((v - minPos) / (maxPos - minPos)) * (H - PAD.top - PAD.bottom)

const path = (series: Array<{ v: number; i: number }>) =>
  series.map((p, idx) => `${idx === 0 ? "M" : "L"}${x(p.i).toFixed(1)},${p.v.toFixed(1)}`).join(" ")

const areaPts = data.map((d, i) => ({ v: yImp(d.impressions), i }))
const areaPath = `${path(areaPts)} L${x(n - 1)},${H - PAD.bottom} L${x(0)},${H - PAD.bottom} Z`
const clicksPts = data.map((d, i) => ({ v: yImp(d.clicks), i }))
const posPts = data.map((d, i) => ({ v: yPos(d.position), i }))

const last = data[n - 1]
const gridLines = [0, 0.25, 0.5, 0.75, 1]

const fmt = (n: number) =>
  n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1)}M` : n >= 1_000 ? `${(n / 1_000).toFixed(1)}k` : `${n}`
---

<figure class="w-full" role="img" aria-label="Daily impressions, clicks and average position over the selected range">
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="presentation" aria-hidden="true">
    <defs>
      <linearGradient id="vis-area" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--brand-400)" stop-opacity="0.22" />
        <stop offset="100%" stop-color="var(--brand-400)" stop-opacity="0" />
      </linearGradient>
    </defs>

    {gridLines.map((g) => {
      const y = PAD.top + g * (H - PAD.top - PAD.bottom)
      return (
        <line
          x1={PAD.left}
          x2={W - PAD.right}
          y1={y}
          y2={y}
          stroke="var(--ink-200)"
          stroke-width="1"
          stroke-dasharray="3 4"
        />
      )
    })}

    <path d={areaPath} fill="url(#vis-area)" />
    <path d={path(clicksPts)} fill="none" stroke="var(--brand-600)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <path d={path(posPts)} fill="none" stroke="var(--ink-400)" stroke-width="1.8" stroke-dasharray="1 5" stroke-linecap="round" />

    {n > 0 && (
      <circle cx={x(n - 1)} cy={yImp(last.clicks)} r="3.5" fill="var(--brand-600)" />
    )}
  </svg>

  <figcaption class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted-foreground">
    <span class="inline-flex items-center gap-2">
      <span class="inline-block size-2 rounded-full" style="background: var(--brand-600)"></span>
      Clicks
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="inline-block size-2.5 rounded-sm" style="background: var(--brand-400); opacity: 0.45"></span>
      Impressions (area)
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="inline-block h-0.5 w-3.5 border-t border-dashed" style="border-color: var(--ink-400)"></span>
      Avg position
    </span>
    <span class="ml-auto font-mono tabular-nums">
      {data[0]?.sample_date} → {last?.sample_date} · peak {fmt(maxImpr)} impr · {fmt(last?.clicks ?? 0)} clicks
    </span>
  </figcaption>
</figure>