---
interface Props {
  text: string
  size?: "sm" | "md"
}
const { text, size = "md" } = Astro.props
---

<style is:global>
  .fli {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .fli .ic {
    flex: none;
    margin-top: 0.1em;
    color: var(--brand-500);
  }
  .fli.md {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-600);
  }
  .fli.sm {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-600);
  }
</style>

<li class:list={["fli", size]}>
  <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 6 9 17l-5-5" />
  </svg>
  <span>{text}</span>
</li>