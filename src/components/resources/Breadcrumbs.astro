---
interface Crumb {
  label: string
  href?: string
}

interface Props {
  crumbs: Crumb[]
}

const { crumbs } = Astro.props
---

<nav aria-label="Breadcrumb" class="rs-breadcrumb">
  {crumbs.map((c, i) => (
    <>
      {i > 0 && <span class="rs-breadcrumb-sep" aria-hidden="true">/</span>}
      {c.href ? <a href={c.href}>{c.label}</a> : <span class="rs-breadcrumb-current" aria-current="page">{c.label}</span>}
    </>
  ))}
</nav>