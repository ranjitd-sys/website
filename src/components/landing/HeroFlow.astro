---
const markets = [
  { id: "Am", label: "Amazon", tint: "#ff9900", bg: "#fff7e6", border: "#ffe3b3" },
  { id: "Fk", label: "Flipkart", tint: "#2874f0", bg: "#eaf1fe", border: "#c7dcfb" },
  { id: "Sy", label: "Shopify", tint: "#0f7a5a", bg: "#e6f7f0", border: "#bdebd8" },
]

const caps = [
  { title: "Understand", sub: "Business & Profitability", icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" },
  { title: "Reconcile", sub: "Payments & Settlements", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
  { title: "Account", sub: "In-depth Accounting", icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" },
]

const outputs = [
  { k: "Profitability", v: "₹8.42L" },
  { k: "Payments", v: "98.7%", n: "Reconciled" },
  { k: "Reports", v: "12,482", n: "Records" },
]

const erps = [
  { id: "Tp", label: "Tally" },
  { id: "Se", label: "SAP" },
  { id: "Zo", label: "Zoho" },
]
---

<style is:global>
  .flow {
    position: relative;
    width: 100%;
    margin-top: clamp(0.75rem, 2vh, 1.5rem);
  }
  .flow-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
    width: 100%;
  }
  .flow-card {
    background: #fff;
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    padding: 0.85rem 0.95rem;
  }
  .flow-card .f-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .flow-card .f-head .f-ic {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.5rem;
    background: var(--brand-50);
    color: var(--brand-600);
  }
  .flow-card .f-head .f-ic svg { width: 0.85rem; height: 0.85rem; }
  .flow-card .f-head strong {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }
  .flow-card .f-head .plus {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-400);
  }
  .flow-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .flow-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.5rem;
    background: #fff;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .flow-chip .tile {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 0.35rem;
    font-size: 0.55rem;
    font-weight: 800;
  }
  .flow-chip .dot {
    margin-left: auto;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--success-500);
    animation: flow-pulse 2s ease-in-out infinite;
  }

  /* center core */
  .flow-core {
    position: relative;
    z-index: 3;
    width: 100%;
    border: 1px solid rgba(83, 58, 253, 0.22);
    border-radius: 1.4rem;
    background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
    box-shadow:
      0 1px 2px rgba(15, 17, 32, 0.04),
      0 24px 48px -24px rgba(83, 58, 253, 0.32),
      inset 0 1px 0 #ffffff;
    padding: 1.05rem 1.1rem;
  }
  .flow-core::before {
    content: "";
    position: absolute;
    inset: -2.5rem -1.5rem auto;
    height: 8rem;
    background: radial-gradient(60% 70% at 50% 0%, rgba(83, 58, 253, 0.1), transparent 70%);
    pointer-events: none;
  }
  .flow-core-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--ink-100);
    margin-bottom: 0.75rem;
  }
  .flow-core-head .mark {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.65rem;
    background: var(--brand-500);
    box-shadow: 0 6px 16px rgba(83, 58, 253, 0.35);
  }
  .flow-core-head .mark svg { width: 1.05rem; height: 1.05rem; fill: #fff; }
  .flow-core-head strong {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink-900);
  }
  .flow-core-head .sub {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .flow-core-head .live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--success-600);
    background: var(--success-50);
    border: 1px solid var(--success-500);
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
  }
  .flow-core-head .live .pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--success-500);
    animation: flow-pulse 2s ease-in-out infinite;
  }
  .flow-caps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  @media (max-width: 48rem) {
    .flow-caps { grid-template-columns: 1fr; }
  }
  .flow-cap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.7rem;
    background: #fff;
  }
  .flow-cap .cap-ic {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 0.5rem;
    background: var(--brand-50);
    color: var(--brand-600);
    flex-shrink: 0;
  }
  .flow-cap .cap-ic svg { width: 0.9rem; height: 0.9rem; }
  .flow-cap .cap-tx strong {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-900);
  }
  .flow-cap .cap-tx span {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .flow-cap .cap-state {
    margin-left: auto;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--brand-500);
    box-shadow: 0 0 0 0 rgba(83, 58, 253, 0.35);
    animation: flow-cap 2.4s ease-in-out infinite;
  }
  .flow-cap:nth-child(2) .cap-state { animation-delay: 0.5s; }
  .flow-cap:nth-child(3) .cap-state { animation-delay: 1s; }
  @keyframes flow-cap {
    0%, 100% { box-shadow: 0 0 0 0 rgba(83, 58, 253, 0.3); opacity: 1; }
    50% { box-shadow: 0 0 0 5px rgba(83, 58, 253, 0.08); opacity: 0.6; }
  }

  /* connectors */
  .flow-con {
    display: block;
    width: 100%;
    margin: 0.2rem 0;
  }
  .flow-path { fill: none; stroke: var(--ink-200); stroke-width: 1.5; }
  .flow-path-live { fill: none; stroke: var(--brand-400); stroke-width: 1.6; stroke-dasharray: 3 8; stroke-linecap: round; opacity: 0.7; animation: flow-dash 1.4s linear infinite; }
  @keyframes flow-dash { to { stroke-dashoffset: -22; } }
  .flow-dot { fill: var(--brand-500); filter: drop-shadow(0 0 4px rgba(83, 58, 253, 0.5)); }

  /* outputs */
  .flow-outputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    width: 100%;
    position: relative;
    z-index: 2;
  }
  .flow-output {
    background: #fff;
    border: 1px solid var(--ink-200);
    border-radius: 0.85rem;
    box-shadow: var(--shadow-xs);
    padding: 0.65rem 0.4rem;
    text-align: center;
  }
  .flow-output .k { display: block; font-family: var(--font-sans); font-size: 0.55rem; font-weight: 700; letter-spacing: 0.09em; color: var(--ink-400); text-transform: uppercase; }
  .flow-output .v { display: block; margin-top: 0.28rem; font-family: var(--font-sans); font-size: clamp(1rem, 1.5vw, 1.3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--ink-900); line-height: 1; }
  .flow-output .n { display: block; margin-top: 0.22rem; font-family: var(--font-sans); font-size: 0.58rem; font-weight: 500; color: var(--ink-400); }

  /* erp card */
  .flow-erp {
    position: relative;
    z-index: 2;
    width: 100%;
    background: #fff;
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    padding: 0.8rem 0.9rem;
  }
  .flow-erp-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .flow-erp-head .mark {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.55rem;
    background: var(--ink-100);
    color: var(--ink-700);
  }
  .flow-erp-head .mark svg { width: 0.95rem; height: 0.95rem; }
  .flow-erp-head strong { display: block; font-family: var(--font-sans); font-size: 0.82rem; font-weight: 800; color: var(--ink-900); }
  .flow-erp-head span { font-family: var(--font-sans); font-size: 0.66rem; font-weight: 500; color: var(--ink-400); }
  .flow-erp-chips { margin-top: 0.55rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .flow-erp-chips span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--ink-700);
    background: var(--ink-50);
    border: 1px solid var(--ink-200);
    border-radius: 99px;
    padding: 0.22rem 0.55rem;
  }
  .flow-erp-chips svg { width: 0.62rem; height: 0.62rem; color: var(--success-500); }

  /* marketplace cards are left/right with the core overlapping center */
  .flow-mid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    margin-top: 0.1rem;
  }
  .flow-side {
    background: #fff;
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    box-shadow: var(--shadow-sm);
    padding: 0.7rem 0.8rem;
  }
  .flow-side strong {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink-500);
    margin-bottom: 0.4rem;
  }
  .flow-side ul { display: flex; flex-direction: column; gap: 0.3rem; }
  .flow-side li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .flow-side li .sq {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 0.35rem;
    font-size: 0.52rem;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
  }
  .flow-side li .plus { margin-left: auto; color: var(--ink-400); }

  @keyframes flow-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  @media (max-width: 48rem) {
    .flow-top { grid-template-columns: 1fr; }
    .flow-outputs { grid-template-columns: 1fr 1fr; }
    .flow-output:last-child { grid-column: span 2; }
    .flow-core { width: 100%; }
    .flow-erp { width: 100%; }
    .flow-core-head .sub { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-dot { opacity: 0; }
    .flow-path-live, .flow-chip .dot, .flow-core-head .live .pulse, .flow-cap .cap-state { animation: none !important; }
  }
</style>

<div class="flow" role="img" aria-label="Marketplaces and channels connect into DeepEcom, which understands, reconciles and accounts, producing profitability, payments and reports, and posts into your ERP">
  <!-- TOP: marketplaces + ERP side cards -->
  <div class="flow-top">
    <div class="flow-card">
      <div class="f-head">
        <span class="f-ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" /></svg>
        </span>
        <strong>Marketplaces<br />&amp; Channels</strong>
        <span class="plus">+ More</span>
      </div>
      <div class="flow-chip-row">
        {markets.map((m) => (
          <span class="flow-chip">
            <span class="t" style={`background:${m.bg}; color:${m.tint}; border:1px solid ${m.border}`}>{m.id}</span>
            {m.label}
          </span>
        ))}
      </div>
    </div>

    <div class="flow-card">
      <div class="f-head">
        <span class="f-ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 8h10M7 12h6" /></svg>
        </span>
        <strong>Your ERP</strong>
        <span class="plus">+ More</span>
      </div>
      <div class="flow-chip-row">
        {erps.map((e) => (
          <span class="flow-chip">
            <span class="tile" style="background:var(--ink-100); color:var(--ink-600)">{e.id}</span>
            {e.label}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- connector in -->
  <svg class="flow-con" viewBox="0 0 600 34" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path class="flow-path" d="M150 0 C150 17, 300 17, 300 34" />
    <path class="flow-path-live" d="M150 0 C150 17, 300 17, 300 34" />
    <path class="flow-path" d="M450 0 C450 17, 300 17, 300 34" />
    <path class="flow-path-live" d="M450 0 C450 17, 300 17, 300 34" />
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.8s" begin="0.3s" repeatCount="indefinite"><mpath href="#fc-in-1" /></animateMotion></circle>
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.8s" begin="1.1s" repeatCount="indefinite"><mpath href="#fc-in-2" /></animateMotion></circle>
    <path id="fc-in-1" d="M150 0 C150 17, 300 17, 300 34" />
    <path id="fc-in-2" d="M450 0 C450 17, 300 17, 300 34" />
  </svg>

  <!-- DEEPECOM core -->
  <div class="flow-core">
    <div class="flow-core-head">
      <span class="mark">
        <svg viewBox="0 0 24 24"><rect x="3" y="13" width="4.5" height="8" rx="1.5" /><rect x="9.75" y="8" width="4.5" height="13" rx="1.5" /><rect x="16.5" y="3" width="4.5" height="18" rx="1.5" /></svg>
      </span>
      <div>
        <strong>DEEPECOM</strong>
        <span class="sub">Your Accounting Layer for Ecommerce</span>
      </div>
      <span class="live"><span class="pulse" aria-hidden="true"></span> Live</span>
    </div>
    <div class="flow-caps">
      {caps.map((c) => (
        <div class="flow-cap">
          <span class="cap-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={c.icon} /></svg></span>
          <div class="cap-tx">
            <strong>{c.title}</strong>
            <span>{c.sub}</span>
          </div>
          <span class="cap-state" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>

  <!-- connector out -->
  <svg class="flow-con" viewBox="0 0 600 34" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path class="flow-path" d="M300 0 C300 17, 100 17, 100 34" />
    <path class="flow-path-live" d="M300 0 C300 17, 100 17, 100 34" />
    <path class="flow-path" d="M300 0 L300 34" />
    <path class="flow-path-live" d="M300 0 L300 34" />
    <path class="flow-path" d="M300 0 C300 17, 500 17, 500 34" />
    <path class="flow-path-live" d="M300 0 C300 17, 500 17, 500 34" />
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.6s" begin="0.2s" repeatCount="indefinite"><mpath href="#fc-out-1" /></animateMotion></circle>
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.6s" begin="0.8s" repeatCount="indefinite"><mpath href="#fc-out-2" /></animateMotion></circle>
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.6s" begin="1.4s" repeatCount="indefinite"><mpath href="#fc-out-3" /></animateMotion></circle>
    <path id="fc-out-1" d="M300 0 C300 17, 100 17, 100 34" />
    <path id="fc-out-2" d="M300 0 L300 34" />
    <path id="fc-out-3" d="M300 0 C300 17, 500 17, 500 34" />
  </svg>

  <!-- OUTPUTS -->
  <div class="flow-outputs">
    {outputs.map((o) => (
      <div class="flow-output">
        <span class="k">{o.k}</span>
        <span class="v">{o.v}</span>
        {o.n && <span class="n">{o.n}</span>}
      </div>
    ))}
  </div>

  <!-- connector to erp -->
  <svg class="flow-con" viewBox="0 0 600 34" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path class="flow-path" d="M100 0 C100 17, 300 17, 300 34" />
    <path class="flow-path-live" d="M100 0 C100 17, 300 17, 300 34" />
    <path class="flow-path" d="M500 0 C500 17, 300 17, 300 34" />
    <path class="flow-path-live" d="M500 0 C500 17, 300 17, 300 34" />
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.6s" begin="0.3s" repeatCount="indefinite"><mpath href="#fc-erp-1" /></animateMotion></circle>
    <circle class="flow-dot" r="2.4"><animateMotion dur="1.6s" begin="1.1s" repeatCount="indefinite"><mpath href="#fc-erp-2" /></animateMotion></circle>
    <path id="fc-erp-1" d="M100 0 C100 17, 300 17, 300 34" />
    <path id="fc-erp-2" d="M500 0 C500 17, 300 17, 300 34" />
  </svg>

  <!-- ERP destination -->
  <div class="flow-erp">
    <div class="flow-erp-head">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 8h10M7 12h6" /></svg>
      </span>
      <div>
        <strong>YOUR ERP</strong>
        <span>Tally · SAP · Zoho</span>
      </div>
    </div>
    <div class="flow-erp-chips">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-Width="3" stroke-Linecap="round" stroke-Linejoin="round"><path d="M20 6L9 17l-5-5" /></svg> Sales Posted</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-Width="3" stroke-Linecap="round" stroke-Linejoin="round"><path d="M20 6L9 17l-5-5" /></svg> GST Accounted</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-Width="3" stroke-Linecap="round" stroke-Linejoin="round"><path d="M20 6L9 17l-5-5" /></svg> Inventory Updated</span>
    </div>
  </div>
</div>