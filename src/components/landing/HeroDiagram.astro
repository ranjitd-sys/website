---
// HeroDiagram.astro
const leftSources = [130, 215, 300, 385];
const rightTargets = [155, 265, 375];
const centerY = 280;

const leftCurves = leftSources.map((y) => `M 265 ${y} C 305 ${y}, 305 ${centerY}, 380 ${centerY}`);
const rightCurves = rightTargets.map((y) => `M 740 ${centerY} C 780 ${centerY}, 780 ${y}, 858 ${y}`);
---

<div class="hero-diagram-wrap">
  <svg
    class="hero-diagram"
    viewBox="0 0 1120 560"
    role="img"
    aria-label="DeepEcom Architecture Diagram: marketplace data flows into DeepEcom, which produces ERP-ready accounting for your systems"
  >
    <defs>
      <!-- Premium Drop Shadows -->
      <filter id="card-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#0f172a" flood-opacity="0.06" />
        <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#0f172a" flood-opacity="0.03" />
      </filter>

      <filter id="center-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="18" stdDeviation="30" flood-color="#2f72f0" flood-opacity="0.16" />
        <feDropShadow dx="0" dy="5" stdDeviation="9" flood-color="#312e81" flood-opacity="0.08" />
      </filter>

      <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3.5" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>

      <!-- Center Card Gradient Border -->
      <linearGradient id="center-border" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#a5b4fc" />
        <stop offset="50%" stop-color="#6366f1" />
        <stop offset="100%" stop-color="#c084fc" />
      </linearGradient>

      <!-- Flow Guide Gradients -->
      <linearGradient id="flow-left" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#c7d2fe" />
        <stop offset="100%" stop-color="#818cf8" />
      </linearGradient>

      <linearGradient id="flow-right" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#818cf8" />
        <stop offset="100%" stop-color="#c7d2fe" />
      </linearGradient>

      <!-- Arrow Marker (points into the destination card) -->
      <marker id="arrow-r" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#6366f1" />
      </marker>

      <!-- Dot Grid Pattern for the Engine Card -->
      <pattern id="dot-grid" x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" fill="#d8dcfc" />
      </pattern>
    </defs>

    <!-- SECTION HEADERS -->
    <g class="diagram-header">
      <text x="150" y="36" text-anchor="middle" fill="#64748b" font-size="11.5" font-weight="700" letter-spacing="0.14em">MARKETPLACES</text>
      <text x="970" y="36" text-anchor="middle" fill="#64748b" font-size="11.5" font-weight="700" letter-spacing="0.14em">ERP &amp; FINANCIALS</text>
    </g>

    <!-- ===== FLOW: LEFT (marketplaces → DeepEcom) ===== -->
    <g class="connector-group">
      <!-- Subtle curved guides -->
      <g stroke="url(#flow-left)" stroke-width="1.5" stroke-dasharray="2.5 6" fill="none" opacity="0.85">
        {leftCurves.map((d) => <path d={d} />)}
      </g>
      <!-- Source nodes on the marketplace card -->
      {leftSources.map((y) => <circle cx="265" cy={y} r="2.6" fill="#818cf8" opacity="0.7" />)}
      <!-- Animated data packets funneling into DeepEcom -->
      {leftCurves.map((d, i) => (
        <path
          d={d}
          fill="none"
          stroke="#6366f1"
          stroke-width="2.5"
          stroke-dasharray="12 130"
          class={`flow-stream stream-left-${i}`}
          filter="url(#glow)"
        />
      ))}
      <!-- Convergence node where data enters DeepEcom -->
      <circle cx="380" cy={centerY} r="5" fill="#2f72f0" filter="url(#glow)" />
      <circle cx="380" cy={centerY} r="9" fill="none" stroke="#c7d2fe" stroke-width="1.5" opacity="0.8" />
    </g>

    <!-- ===== FLOW: RIGHT (DeepEcom → ERP) ===== -->
    <g class="connector-group">
      <!-- Subtle curved guides with direction arrows -->
      <g stroke="url(#flow-right)" stroke-width="1.5" stroke-dasharray="2.5 6" fill="none" opacity="0.85">
        {rightCurves.map((d) => <path d={d} marker-end="url(#arrow-r)" />)}
      </g>
      <!-- Target nodes on the ERP card -->
      {rightTargets.map((y) => <circle cx="858" cy={y} r="2.6" fill="#818cf8" opacity="0.7" />)}
      <!-- Animated data packets fanning out to the ERP -->
      {rightCurves.map((d, i) => (
        <path
          d={d}
          fill="none"
          stroke="#6366f1"
          stroke-width="2.5"
          stroke-dasharray="12 130"
          class={`flow-stream stream-right-${i}`}
          filter="url(#glow)"
        />
      ))}
      <!-- Source node at the DeepEcom exit -->
      <circle cx="740" cy={centerY} r="4" fill="#2f72f0" filter="url(#glow)" />
    </g>

    <!-- ===== LEFT CARD: MARKETPLACES ===== -->
    <g class="diagram-node node-left" transform="translate(40, 60)">
      <g class="node-hover">
      <rect width="220" height="440" rx="20" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" filter="url(#card-shadow)" />

      <!-- Amazon -->
      <g transform="translate(110, 70)">
        <text x="0" y="0" text-anchor="middle" fill="#131316" font-size="26" font-weight="800" letter-spacing="-0.02em">amazon</text>
        <path d="M -34 9 Q 0 23 34 8" fill="none" stroke="#ff9900" stroke-width="3" stroke-linecap="round" />
        <path d="M 28 3 L 34 8 L 27 13" fill="none" stroke="#ff9900" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </g>

      <!-- Flipkart -->
      <g transform="translate(110, 155)">
        <text x="-30" y="6" text-anchor="middle" fill="#2874f0" font-size="22" font-weight="800" font-style="italic">Flipkart</text>
        <g transform="translate(8, -17)">
          <rect x="0" y="0" width="24" height="24" rx="5" fill="#ffe11b" />
          <path d="M 6 6 Q 12 2 18 6" stroke="#2874f0" stroke-width="2.2" fill="none" stroke-linecap="round" />
          <text x="12" y="17" text-anchor="middle" font-weight="900" font-size="13" fill="#2874f0" font-style="italic">f</text>
        </g>
      </g>

      <!-- Shopify -->
      <g transform="translate(110, 240)">
        <g transform="translate(-60, -18)">
          <path d="M 16 4 C 16 4 13 0 9 0 C 6 0 4 4 4 9 C 4 15 16 21 16 21 C 16 21 28 15 28 9 C 28 4 25 0 22 0 C 19 0 16 4 16 4 Z" fill="#96bf48" />
          <path d="M 16 4 C 13 4 12 7 12 9 C 12 13 16 16 16 16" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round" />
        </g>
        <text x="-14" y="0" fill="#101828" font-size="21" font-weight="800" letter-spacing="-0.02em">shopify</text>
      </g>

      <!-- Meesho -->
      <g transform="translate(110, 325)">
        <text x="0" y="0" text-anchor="middle" fill="#f43397" font-size="24" font-weight="800" letter-spacing="-0.02em">meesho</text>
      </g>

      <!-- + More -->
      <text x="110" y="410" text-anchor="middle" fill="#94a3b8" font-size="13" font-weight="600">+ More Channels</text>
      </g>
    </g>

    <!-- ===== CENTER CARD: DEEPECOM ENGINE ===== -->
    <g class="diagram-node center-node" transform="translate(380, 25)">
      <g class="node-hover">
      <rect width="360" height="510" rx="24" fill="#ffffff" stroke="url(#center-border)" stroke-width="2" filter="url(#center-shadow)" />

      <!-- Interior Dot Pattern -->
      <rect x="12" y="12" width="336" height="486" rx="16" fill="url(#dot-grid)" opacity="0.55" />

      <!-- Status Pill -->
      <g transform="translate(180, 34)">
        <rect x="-65" y="-10" width="130" height="20" rx="10" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1" />
        <circle cx="-48" cy="0" r="3.5" fill="#22c55e" class="pulse-dot" />
        <text x="-36" y="3.5" fill="#15803d" font-size="9.5" font-weight="700" letter-spacing="0.05em">REAL-TIME SYNC</text>
      </g>

      <!-- Logo Header -->
      <g transform="translate(180, 82)">
        <g transform="translate(-105, -18)">
          <path d="M 16 4 L 30 11 L 16 18 L 2 11 Z" fill="#2f72f0" />
          <path d="M 2 15 L 16 22 L 30 15 L 30 19 L 16 26 L 2 19 Z" fill="#3b82f6" />
          <path d="M 2 23 L 16 30 L 30 23 L 30 27 L 16 34 L 2 27 Z" fill="#60a5fa" />
        </g>
        <text x="-65" y="6" fill="#1e3a8a" font-size="23" font-weight="900" letter-spacing="0.04em">DEEPECOM</text>
      </g>

      <!-- Feature 1: Understand -->
      <g transform="translate(36, 150)">
        <circle cx="22" cy="22" r="22" fill="#eef2ff" />
        <path d="M 13 28 L 19 20 L 25 23 L 31 12" fill="none" stroke="#2f72f0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="31" cy="12" r="2.5" fill="#2f72f0" />
        <text x="58" y="17" fill="#0f172a" font-size="15" font-weight="800">Understand</text>
        <text x="58" y="33" fill="#64748b" font-size="12" font-weight="500">Real-time insights into sales,</text>
        <text x="58" y="47" fill="#64748b" font-size="12" font-weight="500">profitability and performance</text>
      </g>

      <!-- Feature 2: Reconcile -->
      <g transform="translate(36, 250)">
        <circle cx="22" cy="22" r="22" fill="#eef2ff" />
        <path d="M 14 20 C 14 15 18 13 22 13 C 27 13 30 16 30 20 M 30 24 C 30 29 26 31 22 31 C 17 31 14 28 14 24" fill="none" stroke="#2f72f0" stroke-width="2.5" stroke-linecap="round" />
        <path d="M 27 12 L 31 16 L 27 20" fill="none" stroke="#2f72f0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M 17 24 L 13 28 L 17 32" fill="none" stroke="#2f72f0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="58" y="17" fill="#0f172a" font-size="15" font-weight="800">Reconcile</text>
        <text x="58" y="33" fill="#64748b" font-size="12" font-weight="500">Match settlements, identify</text>
        <text x="58" y="47" fill="#64748b" font-size="12" font-weight="500">discrepancies and close gaps</text>
      </g>

      <!-- Feature 3: Account -->
      <g transform="translate(36, 350)">
        <circle cx="22" cy="22" r="22" fill="#eef2ff" />
        <rect x="14" y="11" width="16" height="22" rx="3" fill="none" stroke="#2f72f0" stroke-width="2" />
        <path d="M 18 17 H 26 M 18 22 H 24 M 18 27 H 22" stroke="#2f72f0" stroke-width="2" stroke-linecap="round" />
        <text x="58" y="17" fill="#0f172a" font-size="15" font-weight="800">Account</text>
        <text x="58" y="33" fill="#64748b" font-size="12" font-weight="500">Automate accurate accounting</text>
        <text x="58" y="47" fill="#64748b" font-size="12" font-weight="500">entries in your ERP</text>
      </g>

      <!-- Bottom Tag -->
      <g transform="translate(180, 472)">
        <rect x="-110" y="-16" width="220" height="32" rx="10" fill="#2f72f0" />
        <text x="0" y="5" text-anchor="middle" fill="#ffffff" font-size="12" font-weight="700" letter-spacing="0.02em">The Ecommerce Accounting Layer</text>
      </g>
      </g>
    </g>

    <!-- ===== RIGHT CARD: YOUR ERP ===== -->
    <g class="diagram-node node-right" transform="translate(860, 60)">
      <g class="node-hover">
      <rect width="220" height="440" rx="20" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" filter="url(#card-shadow)" />

      <!-- Tally -->
      <g transform="translate(110, 95)">
        <text x="0" y="0" text-anchor="middle" fill="#131316" font-size="30" font-weight="800" letter-spacing="-0.01em">Tally</text>
        <text x="0" y="17" text-anchor="middle" fill="#15803d" font-size="7.5" font-weight="800" letter-spacing="0.1em">POWER OF SIMPLICITY</text>
      </g>

      <!-- SAP -->
      <g transform="translate(110, 205)">
        <rect x="-44" y="-21" width="88" height="40" rx="4" fill="#008fd3" />
        <text x="0" y="7" text-anchor="middle" fill="#ffffff" font-size="21" font-weight="800" font-style="italic" letter-spacing="0.04em">SAP</text>
      </g>

      <!-- Zoho Books -->
      <g transform="translate(110, 315)">
        <g transform="translate(-74, -16)">
          <rect x="0" y="0" width="14" height="14" rx="2.5" fill="#e52e2d" />
          <rect x="16" y="0" width="14" height="14" rx="2.5" fill="#22a06b" />
          <rect x="0" y="16" width="14" height="14" rx="2.5" fill="#009adf" />
          <rect x="16" y="16" width="14" height="14" rx="2.5" fill="#e58a00" />
        </g>
        <text x="-30" y="5" fill="#0f172a" font-size="18" font-weight="500">Zoho <tspan font-weight="700">Books</tspan></text>
      </g>

      <!-- + More -->
      <text x="110" y="410" text-anchor="middle" fill="#94a3b8" font-size="13" font-weight="600">+ More Systems</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .hero-diagram-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
    background: radial-gradient(circle at 50% 50%, rgba(238, 242, 255, 0.6) 0%, rgba(248, 250, 252, 0.2) 100%);
    padding: 0.5rem 0 0.25rem;
    overflow: hidden;
  }

  .hero-diagram {
    width: 100%;
    max-width: 1180px;
    height: auto;
    user-select: none;
  }

  /* Hide the diagram on single-column heroes — there's no room for both
     visuals side by side with the copy */
  @media (max-width: 67.99rem) {
    .hero-diagram-wrap {
      display: none;
    }
  }

  /* Only constrain on very short screens; otherwise the diagram renders at
     full column width so it stays large like the reference, and the dashboard
     below simply crops at the hero edge */
  @media (max-height: 700px) and (min-width: 68rem) {
    .hero-diagram {
      max-height: 300px;
    }
  }
  @media (max-height: 620px) and (min-width: 68rem) {
    .hero-diagram {
      max-height: 240px;
    }
  }

  /* Node hover lift — the inner wrapper carries no transform, so CSS
     transform on hover composes cleanly with the outer group's translate */
  .node-hover {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .node-hover:hover {
    transform: translateY(-5px);
  }

  /* Pulse dot on the REAL-TIME SYNC pill */
  .pulse-dot {
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% {
      opacity: 1;
      r: 3.5;
    }
    50% {
      opacity: 0.4;
      r: 5;
    }
    100% {
      opacity: 1;
      r: 3.5;
    }
  }

  /* Animated data packets travelling along the curved flow */
  .flow-stream {
    animation: flow 2.6s linear infinite;
  }
  .stream-left-0 { animation-delay: 0s; }
  .stream-left-1 { animation-delay: 0.45s; }
  .stream-left-2 { animation-delay: 0.9s; }
  .stream-left-3 { animation-delay: 1.35s; }
  .stream-right-0 { animation-delay: 0.25s; }
  .stream-right-1 { animation-delay: 0.8s; }
  .stream-right-2 { animation-delay: 1.35s; }

  @keyframes flow {
    from {
      stroke-dashoffset: 142;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>