---
const leftLevels = [170, 220, 270, 320, 370];
const centerHubY = 270;
const rightLevels = [190, 270, 350];
---

<div class="hero-diagram-wrap">
  <svg
    class="hero-diagram"
    viewBox="0 0 1100 540"
    role="img"
    aria-label="Marketplaces and channels connect into DeepEcom central hub, which processes data and posts into your ERP"
  >
    <defs>
      <!-- Glowing soft shadows matching the image design -->
      <filter id="card-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#0f172a" flood-opacity="0.06" />
        <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#0f172a" flood-opacity="0.03" />
      </filter>

      <filter id="center-shadow" x="-40%" y="-40%" width="180%" height="180%">
        <feDropShadow dx="0" dy="24" stdDeviation="32" flood-color="#533afd" flood-opacity="0.18" />
        <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#3d25c9" flood-opacity="0.12" />
      </filter>

      <!-- Arrow Markers -->
      <marker id="blue-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#533afd" />
      </marker>
    </defs>

    <!-- LEFT CARD: Marketplaces & Channels -->
    <g transform="translate(40, 40)">
      <rect width="210" height="460" rx="28" fill="#ffffff" filter="url(#card-shadow)" />
      
      <text x="105" y="55" text-anchor="middle" class="title-main">Marketplaces</text>
      <text x="105" y="77" text-anchor="middle" class="title-main">&amp; Channels</text>

      <!-- Amazon Logo Placeholder / Text -->
      <g transform="translate(35, 120)">
        <text x="70" y="24" text-anchor="middle" class="brand-text amazon-logo">amazon</text>
        <path d="M 35 30 Q 70 42 105 30" fill="none" stroke="#ff9900" stroke-width="2.5" stroke-linecap="round" />
      </g>

      <!-- Flipkart Logo -->
      <g transform="translate(35, 195)">
        <text x="18" y="24" class="brand-text flipkart-blue">Flipkart</text>
        <rect x="108" y="7" width="24" height="22" rx="3" fill="#ffe11b" />
        <path d="M 116 12 L 122 12 M 116 16 L 124 16 M 118 16 L 121 23" stroke="#2874f0" stroke-width="2" stroke-linecap="round" />
      </g>

      <!-- Shopify Logo -->
       
      <g transform="translate(35, 275)">
        <path d="M 22 8 C 22 8 20 4 15 4 C 11 4 8 8 8 13 C 8 21 22 28 22 28 C 22 28 36 21 36 13 C 36 8 33 4 29 4 C 24 4 22 8 22 8 Z" fill="#95bf47" />
        <text x="46" y="22" class="brand-text shopify-text">shopify</text>
      </g>

      <!-- + More Footer -->
      <text x="50" y="390" class="more-text">+ More</text>
    </g>

    <!-- CENTER CARD: DeepEcom Engine -->
    <g transform="translate(410, 30)">
      <rect width="320" height="480" rx="36" fill="#ffffff" filter="url(#center-shadow)" />

      <!-- DeepEcom Header Logo -->
      <g transform="translate(70, 52)">
        <!-- Custom Blue Symbol -->
        <path d="M 0 4 C 0 1.8 1.8 0 4 0 L 22 0 C 27.5 0 32 4.5 32 10 C 32 15.5 27.5 20 22 20 L 12 20 L 12 26 L 26 26 C 31.5 26 36 30.5 36 36 C 36 41.5 31.5 46 26 46 L 4 46 C 1.8 46 0 44.2 0 42 Z" fill="#533afd" />
        <circle cx="6" cy="10" r="3" fill="#ffffff" />
        <circle cx="6" cy="36" r="3" fill="#ffffff" />
        <text x="48" y="33" class="deepecom-logo-text">DeepEcom</text>
      </g>

      <!-- Feature 1: Understand -->
      <g transform="translate(50, 150)">
        <rect width="40" height="40" rx="10" fill="none" stroke="#533afd" stroke-width="2" />
        <path d="M 12 20 L 18 14 L 24 20 L 28 16" fill="none" stroke="#533afd" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="28" cy="16" r="2" fill="#533afd" />
        <text x="56" y="20" class="feature-title">Understand</text>
        <text x="56" y="36" class="feature-sub">Business &amp; Profitability</text>
      </g>

      <!-- Feature 2: Reconcile -->
      <g transform="translate(50, 250)">
        <rect width="40" height="40" rx="10" fill="none" stroke="#533afd" stroke-width="2" />
        <path d="M 20 12 L 28 16 L 28 24 C 28 29 20 32 20 32 C 20 32 12 29 12 24 L 12 16 Z" fill="none" stroke="#533afd" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="56" y="20" class="feature-title">Reconcile</text>
        <text x="56" y="36" class="feature-sub">Payments &amp; Settlements</text>
      </g>

      <!-- Feature 3: Account -->
      <g transform="translate(50, 350)">
        <rect width="40" height="40" rx="10" fill="none" stroke="#533afd" stroke-width="2" />
        <path d="M 15 14 H 25 M 15 20 H 25 M 15 26 H 21" stroke="#533afd" stroke-width="2" stroke-linecap="round" />
        <text x="56" y="20" class="feature-title">Account</text>
        <text x="56" y="36" class="feature-sub">In-depth Accounting</text>
      </g>
    </g>

    <!-- RIGHT CARD: Your ERP -->
    <g transform="translate(850, 80)">
      <rect width="210" height="380" rx="28" fill="#ffffff" filter="url(#card-shadow)" />

      <text x="105" y="60" text-anchor="middle" class="title-main">Your ERP</text>

      <!-- Tally Logo -->
      <g transform="translate(45, 110)">
        <text x="60" y="30" text-anchor="middle" class="brand-text tally-text">Tally</text>
      </g>

      <!-- SAP Logo -->
      <g transform="translate(55, 190)">
        <rect width="90" height="40" fill="#008fd3" rx="4" />
        <text x="45" y="26" text-anchor="middle" class="sap-text">SAP</text>
      </g>

      <!-- Zoho / Custom Logo -->
      <g transform="translate(45, 270)">
        <g transform="translate(15, 0)">
          <rect x="0" y="0" width="22" height="22" rx="4" fill="#e52e2d" />
          <rect x="25" y="0" width="22" height="22" rx="4" fill="#22a06b" />
          <rect x="50" y="0" width="22" height="22" rx="4" fill="#009adf" />
          <rect x="75" y="0" width="22" height="22" rx="4" fill="#e58a00" />
        </g>
      </g>

      <!-- + More Footer -->
      <text x="50" y="340" class="more-text">+ More</text>
    </g>

    <!-- CONVERGING LEFT CONNECTORS (Flowing inwards) -->
    <g class="connector-group">
      {leftLevels.map((y) => {
        const pathData = `M 250 ${y} C 330 ${y}, 340 ${centerHubY}, 410 ${centerHubY}`;
        return (
          <g>
            <path d={pathData} class="line-back" />
            <path d={pathData} class="line-pulse" />
            <circle cx="250" cy={y} r="3.5" fill="#533afd" />
          </g>
        )
      })}
      <!-- Dynamic dots along connectors -->
      <circle cx="310" cy="185" r="3" fill="#533afd" opacity="0.8" />
      <circle cx="340" cy="235" r="3.5" fill="#533afd" />
      <circle cx="370" cy="305" r="3" fill="#533afd" opacity="0.8" />
    </g>

    <!-- DIVERGING RIGHT CONNECTORS (Flowing outwards) -->
    <g class="connector-group">
      {rightLevels.map((y) => {
        const pathData = `M 730 ${centerHubY} C 780 ${centerHubY}, 790 ${y}, 850 ${y}`;
        return (
          <g>
            <path d={pathData} class="line-back" />
            <path d={pathData} class="line-pulse-right" marker-end="url(#blue-arrow)" />
          </g>
        )
      })}
    </g>
  </svg>
</div>

<style>
  .hero-diagram-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
    background: transparent;
    padding: 4px 10px;
    font-family: var(--font-sans), "Inter", system-ui, sans-serif;
  }
  .hero-diagram {
    width: 100%;
    max-width: 600px;
    height: auto;
  }

  /* Typography Rules */
  .title-main {
    font-size: 18px;
    font-weight: 800;
    fill: #0f172a;
  }
  .more-text {
    font-size: 15px;
    font-weight: 700;
    fill: #64748b;
  }
  .deepecom-logo-text {
    font-size: 26px;
    font-weight: 900;
    fill: #0f172a;
    letter-spacing: -0.03em;
  }
  .feature-title {
    font-size: 16px;
    font-weight: 800;
    fill: #0f172a;
  }
  .feature-sub {
    font-size: 13px;
    font-weight: 600;
    fill: #64748b;
  }

  /* Brand Typography Adjustments */
  .brand-text {
    font-weight: 800;
  }
  .amazon-logo {
    font-size: 26px;
    font-weight: 800;
    fill: #000000;
    font-family: Arial, sans-serif;
  }
  .flipkart-blue {
    font-size: 22px;
    font-weight: 800;
    fill: #2874f0;
    font-style: italic;
  }
  .shopify-text {
    font-size: 20px;
    font-weight: 800;
    fill: #000000;
  }
  .tally-text {
    font-size: 28px;
    font-weight: 800;
    fill: #991b1b;
    font-family: 'Times New Roman', serif;
    font-style: italic;
  }
  .sap-text {
    font-size: 20px;
    font-weight: 900;
    fill: #ffffff;
    font-style: italic;
  }

  /* Connector Animations */
  .line-back {
    fill: none;
    stroke: var(--brand-100);
    stroke-width: 2.5;
  }
  
  .line-pulse {
    fill: none;
    stroke: var(--brand-500);
    stroke-width: 2.5;
    stroke-dasharray: 6 10;
    animation: flowLeft 3s linear infinite;
  }

  .line-pulse-right {
    fill: none;
    stroke: var(--brand-500);
    stroke-width: 2.5;
    animation: flowRight 2.5s ease-in-out infinite;
  }

  @keyframes flowLeft {
    from {
      stroke-dashoffset: 32;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes flowRight {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -32;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-pulse, .line-pulse-right {
      animation: none;
      stroke-dasharray: none;
    }
  }
</style>