---
import { customers } from "@/data/customers"
import { logoAsset } from "@/data/logoAssets"

const clientLogos = [
  { name: "Gati", logo: "gati" },
  { name: "Vanalaya", logo: "vanalaya" },
  { name: "Zeneme", logo: "zeneme" },
  { name: "Hinduja Group", logo: "hinduja-group" },
  { name: "Paragon", logo: "paragon" },
  { name: "Rivona", logo: "rivona" },
];

const featured = customers.find((c) => c.featured) ?? customers[0];
const featuredLogo = logoAsset(featured.slug)

const caseStudy = {
  title: featured.headline,
  highlights: featured.after.slice(0, 3),
  impact: [
    "Order-wise reconciliation",
    "Settlement validation",
    "Expense verification",
    "Complete ERP accounting",
  ],
  href: `/case-studies/${featured.slug}`,
  logoText: featured.logoText,
};

const teaserStories = customers.map((c) => ({
  slug: c.slug,
  logoText: c.logoText,
  logo: logoAsset(c.slug),
  industry: c.industry,
  headline: c.headline
    .replace(/^how\s+/i, "")
    .replace(/^how\s/i, "")
    .replace(/\.$/, ""),
  problem: c.problem,
  featured: c.featured,
}));
---

<section class="customers-strip-wrapper" id="customers" aria-label="Customer Success & Case Studies">
  <div class="customers-card">
    
    <!-- Mobile-only auto-rotating case study teaser -->
    <div class="cs-teaser" aria-label="Featured customer case studies">
      <span class="cs-teaser-eyebrow">CUSTOMERS</span>
      <h3 class="cs-teaser-title">Real ecommerce businesses,<br />running on a clean financial picture.</h3>

      <div class="cs-teaser-stage">
        {teaserStories.map((story, i) => (
          <a
            href={`/case-studies/${story.slug}`}
            class={`cs-slide${story.featured ? " is-featured" : ""}${i === 0 ? " is-active" : ""}`}
            aria-hidden={i === 0 ? "false" : "true"}
          >
            <span class="cs-slide-tag">{story.industry}</span>
            <span class="cs-slide-logo">
                {story.logo ? (
                  <img
                    src={story.logo.src}
                    alt={`${story.logoText} logo`}
                    style={{ aspectRatio: `${Math.round(story.logo.ratio * 10)} / 10` }}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  story.logoText
                )}
              </span>
            <p class="cs-slide-headline">{story.headline}.</p>
            <span class="cs-slide-cta">Read their story <span class="arrow">→</span></span>
          </a>
        ))}
      </div>

      <div class="cs-teaser-dots" role="tablist" aria-label="Case study selector">
        {teaserStories.map((story, i) => (
          <button
            type="button"
            class={`cs-dot${i === 0 ? " is-active" : ""}`}
            role="tab"
            aria-label={`Show ${story.logoText} case study`}
            aria-selected={i === 0 ? "true" : "false"}
            data-index={i}
          ></button>
        ))}
      </div>
    </div>

    <div class="logos-group reveal">
      <span class="kicker">TRUSTED BY GROWING BUSINESSES</span>
      
      <div class="logo-row" role="list" aria-label="Customers using DeepEcom">
        {clientLogos.map((item, i) => {
          const asset = logoAsset(item.logo)
          return (
            <div class={`logo-item${i === 0 ? " is-first" : ""}`} role="listitem">
              {asset ? (
                <img
                  src={asset.src}
                  alt={`${item.name} logo`}
                  class="customer-logo"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="brand-text">
                  <strong>{item.name}</strong>
                </span>
              )}
            </div>
          )
        })}
      </div>
    </div>

    <div class="case-study-card reveal" data-delay="120">
      <div class="case-study-content">
        <h3>{caseStudy.title}</h3>
        
        <div class="stats-grid">
          {caseStudy.highlights.map((hl, i) => (
            <div class="stat-item">
              <span class="stat-value stat-check">✓</span>
              <span class="stat-label">{hl}</span>
            </div>
          ))}
        </div>

        <a href={caseStudy.href} class="case-study-link">
          Read Case Study <span class="arrow">→</span>
        </a>
      </div>

      <div class="case-study-image">
        <div class="impact-panel">
          <div class="impact-head">
            {featuredLogo ? (
              <span class="impact-logo" aria-hidden="true">
                <img
                  src={featuredLogo.src}
                  alt=""
                  style={{ aspectRatio: `${Math.round(featuredLogo.ratio * 10)} / 10` }}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <span class="impact-logo">{caseStudy.logoText}</span>
            )}
            <span class="impact-tag">Featured Story</span>
          </div>
          <div class="impact-chain">
            {caseStudy.impact.map((step, i) => (
              <div class="impact-step">
                <span class="impact-step-label">{step}</span>
                {i < caseStudy.impact.length - 1 && <span class="impact-arrow">→</span>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    const stage = document.querySelector(".cs-teaser");
    if (!stage) return;
    const slides = Array.from(stage.querySelectorAll(".cs-slide"));
    const dots = Array.from(stage.querySelectorAll(".cs-dot"));
    if (!slides.length) return;

    let current = 0;
    let timer = null;
    const INTERVAL = 5000;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle("is-active", active);
        s.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((d, i) => {
        d.classList.toggle("is-active", i === current);
        d.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    }

    function start() {
      if (reduceMotion || timer) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL);
    }
    function stop() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        stop();
        show(i);
        start();
      });
    });

    stage.addEventListener("mouseenter", stop);
    stage.addEventListener("mouseleave", start);
    stage.addEventListener("touchstart", stop, { passive: true });

    // Only auto-rotate after the slide is visible on screen
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) start();
          else stop();
        });
      },
      { threshold: 0.4 }
    );
    observer.observe(stage);
  })();
</script>

<style>
  .customers-strip-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: clamp(0.75rem, 1.5vw, 1.25rem) var(--space-gutter);
  }

  /* Open, flowing band — sits directly on the page canvas */
  .customers-card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 64rem) {
    .customers-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  /* Left Column: Logos */
  .logos-group {
    flex: 1.4;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2165EC;
    margin-bottom: 1.25rem;
  }

  .logo-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    align-items: center;
    gap: 0.75rem 0.5rem;
  }

  .logo-item {
    display: grid;
    place-items: center;
    height: 84px;
    padding: 0 1rem;
    border: 1px solid #eceef3;
    border-radius: 12px;
    background: #fcfcff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .logo-item:hover {
    border-color: var(--brand-200, #dbe6ff);
    background: #ffffff;
    box-shadow: 0 8px 22px -14px rgba(33, 101, 236, 0.3);
  }

  /* Brand Typography Specs (fallback when no image) */
  .brand-text {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .brand-text strong {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #0f172a;
    white-space: nowrap;
  }

  .customer-logo {
    height: 52px;
    width: 100%;
    max-width: 170px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.8;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .logo-item:hover .customer-logo {
    opacity: 1;
    filter: grayscale(0);
  }

  @media (max-width: 47.99rem) {
    .logo-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .logo-item {
      height: 72px;
      padding: 0 0.5rem;
    }
    .customer-logo {
      height: 42px;
      max-width: 130px;
    }
  }

  /* Right Column: Case Study Card */
  .case-study-card {
    flex: 1.2;
    background: #ffffff;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 1px 2px rgba(9, 17, 32, 0.04), 0 1px 3px rgba(16, 24, 40, 0.02);
  }

  @media (min-width: 40rem) {
    .case-study-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .case-study-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .case-study-content h3 {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 1rem 0;
  }

  .stats-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-check {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #f0fdf4;
    color: #22c55e;
    font-size: 0.65rem;
    font-weight: 800;
    line-height: 1;
    flex: none;
  }

  .stat-label {
    font-size: 0.72rem;
    color: #475569;
    line-height: 1.35;
    font-weight: 500;
  }

  .case-study-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #2165EC;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .case-study-link .arrow {
    font-size: 0.9rem;
  }

  .case-study-image {
    width: 100%;
    height: auto;
    min-height: 150px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--ink-100, #eef2f7);
    background:
      radial-gradient(120% 90% at 50% -10%, rgba(33, 101, 236, 0.08), transparent 60%),
      linear-gradient(180deg, #ffffff 0%, #fafaff 100%);
  }

  @media (min-width: 40rem) {
    .case-study-image {
      width: 200px;
    }
  }

  .impact-panel {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .impact-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .impact-logo {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0f172a;
  }
  .impact-logo img {
    max-width: 84px;
    max-height: 30px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .impact-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #2165EC;
    background: var(--brand-50, #f2f7ff);
    border: 1px solid var(--brand-100, #e3edff);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    white-space: nowrap;
  }
  .impact-chain {
    display: flex;
    flex-direction: column;
  }
  .impact-step {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .impact-step-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #334155;
    line-height: 1.4;
  }
  .impact-arrow {
    color: #2165EC;
    font-size: 0.8rem;
  }

  /* ----- Mobile-only auto-rotating case study teaser ----- */
  .cs-teaser {
    display: none;
  }
  @media (max-width: 47.99rem) {
    /* Swap the static featured card for the rotating teaser */
    .cs-teaser {
      display: block;
      order: -1;
      border-bottom: 1px solid var(--ink-100);
      padding: 1.25rem 0 1rem;
    }
    .customers-card .case-study-card {
      display: none;
    }
    .cs-teaser-eyebrow {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2165EC;
    }
    .cs-teaser-title {
      margin: 0.4rem 0 1rem;
      font-size: 1.2rem;
      line-height: 1.25;
      letter-spacing: -0.02em;
      font-weight: 800;
      color: var(--ink-950);
    }
    .cs-teaser-stage {
      position: relative;
    }
    .cs-slide {
      display: none;
      flex-direction: column;
      gap: 0.55rem;
      padding: 1.1rem 1.15rem;
      border: 1px solid var(--ink-200, #e2e8f0);
      border-radius: 16px;
      background: repeating-linear-gradient(
        0deg,
        rgba(33, 101, 236, 0) 0 2px,
        rgba(33, 101, 236, 0.03) 2px 34px
      );
      background-color: #ffffff;
      box-shadow: 0 1px 2px rgba(9, 17, 32, 0.04), 0 8px 22px -12px rgba(11, 17, 32, 0.12);
      text-decoration: none;
      color: inherit;
    }
    .cs-slide.is-active {
      display: flex;
      animation: cs-slide-in 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cs-slide.is-featured {
      border-color: var(--brand-200);
      background-image: repeating-linear-gradient(
          0deg,
          rgba(33, 101, 236, 0) 0 2px,
          rgba(33, 101, 236, 0.04) 2px 34px
        ),
        linear-gradient(160deg, #f2f7ff 0%, #ffffff 55%);
    }
    .cs-slide-tag {
      align-self: flex-start;
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brand-700);
      background: var(--brand-50);
      border: 1px solid var(--brand-100);
      border-radius: 999px;
      padding: 0.25rem 0.6rem;
    }
    .cs-slide-logo {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--ink-950);
    }
    .cs-slide-logo img {
      width: auto;
      max-width: 128px;
      max-height: 34px;
      object-fit: contain;
    }
    .cs-slide-headline {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.45;
      font-weight: 600;
      color: var(--ink-700);
    }
    .cs-slide-cta {
      margin-top: 0.25rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: #2165EC;
    }
    .cs-slide-cta .arrow {
      font-size: 0.9rem;
    }
    .cs-teaser-dots {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-top: 0.85rem;
    }
    .cs-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      border: none;
      padding: 0;
      background: #d7d9e4;
      cursor: pointer;
      transition: width 0.25s ease, background 0.25s ease;
    }
    .cs-dot.is-active {
      width: 22px;
      background: #2165EC;
    }
  }
  @keyframes cs-slide-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-slide.is-active {
      animation: none;
    }
  }
</style>