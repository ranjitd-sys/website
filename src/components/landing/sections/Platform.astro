---
import SectionHeading from "../section-heading.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import DashboardPreview from "./DashboardPreview.astro"

const pillars = [
  { title: "Dashboard", desc: "Your ecommerce business at a glance.", href: "/platform/dashboard" },
  { title: "Profitability", desc: "Margins by SKU, order and channel.", href: "/platform/profitability" },
  { title: "Payment Reconciliation", desc: "Expected vs actual, matched line-by-line.", href: "/platform/payment-reconciliation" },
  { title: "Reports", desc: "GST-ready exports for your finance team.", href: "/platform/reports" },
]
---

<style is:global>
  .platform-section {
    padding: clamp(5.5rem, 12vh, 9rem) 0;
  }
  .platform-inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .platform-pillars {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .platform-pillars { grid-template-columns: repeat(4, 1fr); }
  }
  .platform-pillar {
    display: block;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--ink-200);
    border-radius: 1rem;
    background: #fff;
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .platform-pillar:hover {
    border-color: var(--brand-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .platform-pillar strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }
  .platform-pillar span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    color: var(--ink-500);
  }
</style>

<section class="platform-section" id="platform">
  <div class="platform-inner">
    <SectionHeading
      eyebrow="Platform"
      title="Understand your ecommerce business."
      lead="DeepEcom Platform brings every marketplace into one place — so you see real profitability, reconciled payments, and reports your team can act on."
    />

    <div class="reveal">
      <DashboardPreview />
    </div>

    <div class="platform-pillars reveal">
      {
        pillars.map((p) => (
          <a href={p.href} class="platform-pillar">
            <strong>{p.title}</strong>
            <span>{p.desc}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>