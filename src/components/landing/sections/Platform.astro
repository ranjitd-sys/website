---
const metrics = [
  { label: "Total Revenue", value: "₹4,21,74,740", change: "14.2%", type: "up" },
  { label: "Total Profit", value: "₹1,13,74,340", change: "18.2%", type: "up" },
  { label: "Total Orders", value: "28,892", change: "8.1%", type: "up" },
  { label: "Returns", value: "₹22,08,169", change: "2.4%", type: "down" },
  { label: "Net Realized Price", value: "₹1,22,04,840", change: "11.3%", type: "up" },
];

const channels = [
  { name: "Amazon", percentage: "72.8%", color: "#3b82f6" },
  { name: "Shopify", percentage: "14.2%", color: "#06b6d4" },
  { name: "Flipkart", percentage: "8.1%", color: "#ec4899" },
  { name: "Others", percentage: "4.9%", color: "#8b5cf6" },
];

const barHeights = [25, 40, 30, 55, 35, 45, 60, 95, 65, 35, 55, 40, 30, 50, 45, 30];
---

<section class="platform-showcase" id="platform" aria-label="DeepEcom Platform">
  <div class="platform-card">
    <div class="showcase-row">

      <div class="showcase-copy reveal">
      <span class="kicker">DEEPECOM PLATFORM</span>
      <h3 class="title">
        Understand your business.<br />In real time.
      </h3>
      <p class="desc">
        Powerful dashboards and reports that help you scale profitably, monitor payouts, and make smarter decisions.
      </p>
      
      <a href="/platform" class="cta-link">
        Explore Platform
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <div class="dashboard-wrapper reveal" data-delay="120">
      <div class="dashboard-card">
        
        <div class="dash-header">
          <h4 class="dash-title">Overview</h4>
          <div class="dash-actions">
            <button class="filter-btn">
              Filter: Last 7 Days
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <button class="more-btn">More</button>
          </div>
        </div>

        <div class="metrics-row">
          {metrics.map((m) => (
            <div class="metric-block">
              <span class="m-label">{m.label}</span>
              <span class="m-val">{m.value}</span>
              <div class="m-trend">
                <span class="trend-indicator">
                  {m.type === 'up' ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
                  )}
                </span>
                <span class="trend-text"><span class="highlight">{m.type === 'up' ? '+' : '-'}{m.change}</span> vs last month</span>
              </div>
            </div>
          ))}
        </div>

        <div class="visuals-row">
          
          <div class="trend-section">
            <h5 class="section-title">Revenue Trend</h5>
            <div class="chart-container">
              <div class="grid-lines">
                <span>25M</span>
                <span>20M</span>
                <span>15M</span>
                <span>10M</span>
                <span>5M</span>
                <span>0</span>
              </div>
              
              <div class="chart-area">
                <svg class="trend-line" viewBox="0 0 400 120" preserveAspectRatio="none">
                  <path d="M 0 90 L 25 75 L 50 85 L 75 50 L 100 65 L 125 55 L 150 40 L 175 25 L 200 10 L 225 35 L 250 15 L 275 40 L 300 50 L 325 35 L 350 45 L 375 25 L 400 30" fill="none" stroke="#8b5cf6" stroke-width="2.5" stroke-linejoin="round"/>
                </svg>
                
                <div class="bars-container">
                  {barHeights.map((h, i) => (
                    <div class="bar-group">
                      <div class={`bar ${i % 2 === 0 ? 'dark-blue' : 'light-blue'}`} style={`height: ${h}%; animation-delay: ${i * 24}ms;`}></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="donut-section">
            <h5 class="section-title">Revenue by Channel</h5>
            <div class="donut-layout">
              <div class="donut-svg-wrapper">
                <svg viewBox="0 0 36 36" class="donut-chart">
                  <path class="d-base" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <path class="d-segment amz" stroke-dasharray="72.8, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <path class="d-segment shp" stroke-dasharray="14.2, 100" stroke-dashoffset="-72.8" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <path class="d-segment flp" stroke-dasharray="8.1, 100" stroke-dashoffset="-87" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                </svg>
              </div>
              <ul class="legend-list">
                {channels.map((c) => (
                  <li class="legend-item">
                    <div class="l-left">
                      <span class="l-dot" style={`background-color: ${c.color};`}></span>
                      <span class="l-name">{c.name}</span>
                    </div>
                    <span class="l-val">{c.percentage}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
    </div>
  </div>
</section>

<style>
  /* Card — single dark surface with a soft radial glow */
  .platform-card {
    background-color: #0b1120;
    background-image: radial-gradient(circle at 50% 0%, #172033 0%, #0b1120 72%);
    border-radius: 24px;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Left Copy */
  .showcase-copy {
    display: flex;
    flex-direction: column;
  }

  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #818cf8;
  }

  .title {
    margin-top: 0.875rem;
    font-size: clamp(1.85rem, 2.5vw, 2.35rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: #ffffff;
  }

  .desc {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 32rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #a5b4fc;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .cta-link:hover {
    gap: 0.75rem;
    color: #c7d2fe;
  }

  /* Right Dashboard */
  .dashboard-wrapper {
    width: 100%;
    filter: drop-shadow(0 25px 35px rgba(0, 0, 0, 0.3));
  }

  .dashboard-card {
    background: #ffffff;
    border-radius: 14px;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    container-type: inline-size;
  }

  /* Dash Header */
  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dash-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .dash-actions {
    display: flex;
    gap: 0.5rem;
  }

  .filter-btn, .more-btn {
    background: transparent;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    font-size: 0.75rem;
    color: #475569;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: inherit;
  }

  /* Metrics Row */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    padding: 1rem 0;
  }

  .metric-block {
    display: flex;
    flex-direction: column;
    padding: 0 0.875rem;
    border-right: 1px solid #f1f5f9;
  }

  .metric-block:first-child { padding-left: 0; }
  .metric-block:last-child { border-right: none; padding-right: 0; }

  .m-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
  }

  .m-val {
    font-size: 1rem;
    font-weight: 800;
    color: #0f172a;
    margin-top: 0.35rem;
    letter-spacing: -0.01em;
  }

  .m-trend {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.35rem;
  }

  .trend-indicator {
    width: 10px;
    height: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trend-indicator svg {
    width: 100%;
    height: 100%;
  }

  .trend-text {
    font-size: 0.625rem;
    color: #94a3b8;
    font-weight: 500;
    white-space: nowrap;
  }

  .trend-text .highlight {
    color: #10b981;
    font-weight: 600;
  }

  /* Visuals Row */
  .visuals-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 31rem) {
    .visuals-row {
      grid-template-columns: 1fr;
    }
  }

  .section-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 1rem 0;
  }

  /* Trend Chart */
  .chart-container {
    position: relative;
    height: 150px;
    display: flex;
  }

  .grid-lines {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-right: 0.75rem;
    font-size: 0.625rem;
    color: #94a3b8;
    font-weight: 500;
    text-align: right;
  }

  .chart-area {
    flex: 1;
    position: relative;
    border-bottom: 1px solid #f1f5f9;
  }

  .trend-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .bars-container {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4px;
    padding: 0 5px;
    z-index: 1;
  }

  /* Bars grow in when the dashboard is revealed */
  .dashboard-wrapper.in .bar {
    transform-origin: bottom;
    animation: bar-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  @keyframes bar-rise {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  .bar-group {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }

  .bar {
    width: 100%;
    border-radius: 2px 2px 0 0;
  }

  .bar.dark-blue { background-color: #3b82f6; }
  .bar.light-blue { background-color: #93c5fd; }

  /* Donut Chart */
  .donut-layout {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .donut-svg-wrapper {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
  }

  .donut-chart {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .d-base {
    fill: none;
    stroke: #f1f5f9;
    stroke-width: 6;
  }

  .d-segment {
    fill: none;
    stroke-width: 6;
  }

  .d-segment.amz { stroke: #3b82f6; }
  .d-segment.shp { stroke: #06b6d4; }
  .d-segment.flp { stroke: #ec4899; }

  .legend-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .legend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.6875rem;
  }

  /* When the card is too narrow, drop the legend under the donut */
  @container (max-width: 25rem) {
    .donut-layout {
      flex-wrap: wrap;
    }
    .legend-list {
      flex-basis: 100%;
    }
  }

  .l-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .l-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .l-name {
    color: #64748b;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .l-val {
    color: #0f172a;
    font-weight: 700;
    flex-shrink: 0;
  }
</style>