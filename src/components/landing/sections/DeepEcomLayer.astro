---
import PipelineVisual from "@/components/landing/PipelineVisual.astro";
---

<style is:global>
  .layer {
    position: relative;
    padding: clamp(4rem, 8vh, 6rem) 0;
    background: #f8fafc;
  }

  .layer-inner {
    max-width: var(--container-content, 80rem);
    margin-inline: auto;
    padding-inline: var(--space-gutter, 1.5rem);
  }

  .layer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .layer-grid {
      grid-template-columns: 320px 1fr;
    }
  }

  .layer-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4f46e5;
  }

  .layer-title {
    margin-top: 1rem;
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: #0f172a;
  }

  .layer-lead {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #64748b;
  }
</style>

<section class="layer" id="layer">
  <div class="layer-inner">
    <div class="layer-grid">
      <div class="layer-info">
        <span class="layer-eyebrow">THE DEEPECOM DIFFERENCE</span>
        <h2 class="layer-title">We turn all of it into one financial picture.</h2>
        <p class="layer-lead">
          DeepEcom captures, categorizes and reconciles every ecommerce event — so you get accurate insights and complete accounting, every time.
        </p>
      </div>

      <div class="layer-visual">
        <PipelineVisual />
      </div>
    </div>
  </div>
</section>