---
// Raw Marketplace Events
const rawData = [
  { label: "Amazon Order", icon: "cart" },
  { label: "Settlement", icon: "document" },
  { label: "Payment", icon: "card" },
  { label: "Return", icon: "return" },
  { label: "Inventory Movement", icon: "box" },
  { label: "Marketplace Fee", icon: "tag" },
  { label: "TCS / TDS", icon: "receipt" },
];

// Central Engine Features
const engineFeatures = [
  {
    title: "Understand",
    desc: "Get clarity on sales, profitability & performance",
    icon: "chart",
  },
  {
    title: "Reconcile",
    desc: "Match settlements, find issues & close gaps",
    icon: "sync",
  },
  {
    title: "Account",
    desc: "Generate accurate accounting for your ERP.",
    icon: "file",
  },
];

// Business-Ready Outputs
const businessOutputs = [
  { label: "Profitability & Insights", icon: "trending" },
  { label: "Reconciled Payouts", icon: "check-circle" },
  { label: "Detailed Reports", icon: "reports" },
  { label: "ERP-Ready Accounting", icon: "database" },
];
---

<section class="difference-section">
  <div class="difference-container">
    <div class="difference-card">
      
      <!-- Left Info Column -->
      <div class="info-column reveal">
        <span class="eyebrow">THE DEEPECOM DIFFERENCE</span>
        <h2 class="title">We turn all of it into one financial picture.</h2>
        <p class="lead">
          DeepEcom captures, categorizes and reconciles every ecommerce event — so you get accurate insights and complete accounting, every time.
        </p>
      </div>

      <!-- Right Interactive Pipeline -->
      <div class="pipeline-column reveal" data-delay="120">
        
        <!-- CARD 1: RAW DATA -->
        <div class="card raw-card">
          <div class="card-header">RAW MARKETPLACE DATA</div>
          <ul class="data-list">
            {rawData.map((item) => (
              <li class="data-item">
                <span class="icon-wrap indigo">
                  {item.icon === "cart" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>}
                  {item.icon === "document" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>}
                  {item.icon === "card" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>}
                  {item.icon === "return" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>}
                  {item.icon === "box" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>}
                  {item.icon === "tag" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>}
                  {item.icon === "receipt" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><line x1="9" y1="15" x2="15" y2="15"/></svg>}
                </span>
                <span class="data-label">{item.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- ARROW 1 -->
        <div class="pipeline-connector" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>

        <!-- CARD 2: ENGINE (HIGHLIGHTED) -->
        <div class="card engine-card">
          <div class="engine-banner">
            <div class="engine-logo">
              <svg viewBox="0 0 32 32" fill="none" class="brand-mark">
                <path d="M16 4L28 10L16 16L4 10Z" fill="#ffffff" />
                <path d="M4 14L16 20L28 14" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                <path d="M4 18L16 24L28 18" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
              </svg>
              <span>DEEPECOM</span>
            </div>
          </div>

          <div class="engine-body">
            {engineFeatures.map((f) => (
              <div class="feature-item">
                <span class="feature-badge">
                  {f.icon === "chart" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 9l-5 5-2-2-4 4"/></svg>}
                  {f.icon === "sync" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 11-.57-8.38l5.67-5.67"/></svg>}
                  {f.icon === "file" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
                </span>
                <div class="feature-info">
                  <h4 class="feature-title">{f.title}</h4>
                  <p class="feature-desc">{f.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ARROW 2 -->
        <div class="pipeline-connector" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>

        <!-- CARD 3: BUSINESS READY -->
        <div class="card business-card">
          <div class="card-header">BUSINESS-READY DATA</div>
          <ul class="output-list">
            {businessOutputs.map((item) => (
              <li class="output-item">
                <span class="icon-wrap green">
                  {item.icon === "trending" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                  {item.icon === "check-circle" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>}
                  {item.icon === "reports" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
                  {item.icon === "database" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>}
                </span>
                <span class="output-label">{item.label}</span>
              </li>
            ))}
          </ul>

          <div class="audit-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            <span>100% Accurate. Audit Ready.</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --bg-surface: #f8fafc;
    --text-primary: #0f172a;
    --text-muted: #64748b;
    --brand-indigo: #2f72f0;
    --brand-blue: #2165ec;
    --brand-emerald: #10b981;
    --border-subtle: #e2e8f0;
    --card-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04), 0 8px 10px -6px rgba(15, 23, 42, 0.02);
  }

  .difference-section {
    width: 100%;
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    display: flex;
    justify-content: center;
    -webkit-font-smoothing: antialiased;
  }

  .difference-container {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  /* Main Card Layout */
  .difference-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    padding: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 68rem) {
    .difference-card {
      grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  /* Left Header Content */
  .info-column {
    display: flex;
    flex-direction: column;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-indigo);
  }

  .title {
    margin-top: 0.75rem;
    font-size: clamp(1.85rem, 2.5vw, 2.35rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .lead {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* Right Pipeline Row - Vertically Center Aligned */
  .pipeline-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
  }

  @media (min-width: 52rem) {
    .pipeline-column {
      flex-direction: row;
      justify-content: space-between;
      align-items: center; /* Ensures exact vertical middle alignment across cards & arrows */
    }
  }

  /* Cards Common Styling */
  .card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    box-shadow: var(--card-shadow);
    flex: 1;
    width: 100%;
    min-height: 380px; /* Equalizes card vertical baseline */
    display: flex;
    flex-direction: column;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px -5px rgba(15, 23, 42, 0.08);
  }

  .card-header {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    text-align: center;
    padding: 1.25rem 1rem 0.5rem;
  }

  /* Connecting Arrows - Perfectly Centered Vertical Align */
  .pipeline-connector {
    width: 32px;
    height: 32px;
    color: var(--brand-indigo);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.8;
  }

  .pipeline-connector svg {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 51.95rem) {
    .pipeline-connector {
      transform: rotate(90deg);
      margin: 0.25rem 0;
    }
  }

  /* Card 1: Raw Data */
  .data-list {
    list-style: none;
    padding: 0.5rem 1.15rem 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .data-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #334155;
    padding: 0.15rem 0;
  }

  .icon-wrap {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-wrap svg {
    width: 16px;
    height: 16px;
  }

  .icon-wrap.indigo { color: var(--brand-indigo); }
  .icon-wrap.green { color: var(--brand-emerald); }

  /* Card 2: Engine Highlight Card — wider than the side cards so text can breathe */
  .engine-card {
    flex: 1.4 1 0%;
    border: 2px solid var(--brand-indigo);
    box-shadow: 0 12px 28px -5px rgba(47, 114, 240, 0.18);
    overflow: hidden;
  }

  .engine-banner {
    background: linear-gradient(135deg, #2f72f0 0%, #2165ec 100%);
    padding: 1.1rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .engine-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .brand-mark {
    width: 24px;
    height: 24px;
  }

  .engine-body {
    padding: 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 1.5rem;
    height: 100%;
  }

  .feature-item {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    z-index: 1;
  }

  .feature-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #eef0fe;
    color: var(--brand-indigo);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(47, 114, 240, 0.15);
  }

  .feature-badge svg {
    width: 16px;
    height: 16px;
  }

  .feature-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .feature-desc {
    margin: 0.3rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Card 3: Business Ready */
  .output-list {
    list-style: none;
    padding: 0.6rem 1rem 0.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .output-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 10px;
    padding: 0.6rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #334155;
    transition: background 0.15s ease;
  }

  .output-item:hover {
    background: #f1f5f9;
  }

  .audit-badge {
    margin: auto 1rem 1.15rem;
    padding: 0.65rem;
    background-color: #eef0fe;
    border: 1px solid #b4bcfb;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    color: var(--brand-blue);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .audit-badge svg {
    width: 15px;
    height: 15px;
  }
</style>