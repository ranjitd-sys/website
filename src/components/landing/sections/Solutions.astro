---
import { logoAsset } from "@/data/logoAssets";

const solutions = [
  {
    label: "Amazon Sellers",
    desc: "End-to-end visibility into Amazon business and settlements.",
    href: "/solutions/amazon-sellers",
    type: "brand",
    icon: "amazon",
  },
  {
    label: "D2C Brands",
    desc: "Unify marketplace, D2C sales and ERP in one financial view.",
    href: "/solutions/d2c-brands",
    type: "brand",
    icon: "shopify",
  },
  {
    label: "Enterprise",
    desc: "High volume, multi-warehouse operations with complex accounting needs.",
    href: "/solutions/enterprise",
    type: "svg",
    path: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    label: "For CFOs",
    desc: "Get accurate numbers, faster close and better control.",
    href: "/solutions/cfos",
    type: "svg",
    path: "M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z",
  },
  {
    label: "For Accountants",
    desc: "Automate entries, reduce effort and stay audit ready.",
    href: "/solutions/accountants",
    type: "svg",
    path: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    label: "For Business Owners",
    desc: "Make confident decisions with real-time financial clarity.",
    href: "/solutions/business-owners",
    type: "svg",
    path: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
  },
];
---

<section class="solutions-strip-wrapper" id="solutions" aria-label="Solutions Overview">
  <div class="solutions-card">
    
    <!-- Kicker Header -->
    <span class="kicker">BUILT FOR EVERY KIND OF ECOMMERCE BUSINESS</span>

    <!-- 6-Column Grid Layout -->
    <div class="solutions-grid">
      {
        solutions.map((s, i) => (
          <a href={s.href} class="solution-item-card reveal" data-delay={(i % 3) * 90}>
            
            <div class="item-header">
              <!-- Icon Avatar -->
              <div class="icon-avatar micro-icon micro-ping">
                {s.icon && (
                  <img src={logoAsset(s.icon)?.src} alt="" width="22" height="22" loading="lazy" />
                )}
                {s.type === 'svg' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={s.path} />
                  </svg>
                )}
              </div>

              <!-- Title -->
              <strong>{s.label}</strong>
            </div>

            <!-- Description -->
            <p>{s.desc}</p>

            <!-- Link -->
            <span class="explore-link">
              Explore 
              <span class="arrow">→</span>
            </span>

          </a>
        ))
      }
    </div>

  </div>
</section>

<style>
  .solutions-strip-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: clamp(0.75rem, 1.5vw, 1.25rem) var(--space-gutter);
  }

  /* Open, flowing band — sits directly on the page canvas */
  .solutions-card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 1.25rem 0;
  }

  /* Header Kicker */
  .kicker {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-600);
    margin-bottom: 1.5rem;
  }

  /* Grid Layout: Stacks on mobile, 6 columns on desktop */
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .solutions-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 80rem) {
    .solutions-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 0.75rem;
    }
  }

  /* Individual Sub-card Styles */
  .solution-item-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--ink-200, #e2e8f0);
    border-radius: 12px;
    padding: 1.25rem 1rem;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(9, 17, 32, 0.04), 0 1px 3px rgba(16, 24, 40, 0.02);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .solution-item-card:hover {
    transform: translateY(-2px);
    border-color: rgba(33, 101, 236, 0.35);
    box-shadow: 0 8px 18px rgba(9, 17, 32, 0.07);
  }

  /* Top row containing Icon and Title */
  .item-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .icon-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: var(--brand-600);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-avatar svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .icon-avatar img {
    width: 1.15rem;
    height: 1.15rem;
    object-fit: contain;
  }

  .item-header strong {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }

  /* Description Body */
  .solution-item-card p {
    font-size: 0.725rem;
    line-height: 1.45;
    color: #64748b;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  /* Explore Link at Bottom */
  .explore-link {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-600);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: gap 0.2s ease;
  }

  .solution-item-card:hover .explore-link {
    gap: 0.4rem;
  }
</style>