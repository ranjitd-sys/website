---
import SectionHeading from "../section-heading.astro"
import { CheckCircle } from "../icons"
import { Badge } from "@deepecom/ui/ui/badge"

const checks = ["SKU-level margins", "Anomaly detection", "GST-ready exports"]

const rows = [
  { init: "Az", name: "Amazon", orders: "4,812", gross: "₹18,42,300", ded: "−₹5,12,480", net: "₹13,29,820", status: "Reconciled", variant: "success" },
  { init: "Fk", name: "Flipkart", orders: "3,204", gross: "₹9,86,150", ded: "−₹2,71,090", net: "₹7,15,060", status: "Reconciled", variant: "success" },
  { init: "Me", name: "Meesho", orders: "1,978", gross: "₹4,31,720", ded: "−₹1,02,340", net: "₹3,29,380", status: "Pending", variant: "warning" },
  { init: "Jm", name: "JioMart", orders: "642", gross: "₹1,58,900", ded: "−₹41,220", net: "₹1,17,680", status: "Mismatch", variant: "error", neg: "−₹1,240" },
  { init: "Sy", name: "Shopify", orders: "1,092", gross: "₹7,94,610", ded: "−₹1,66,540", net: "₹6,28,070", status: "Reconciled", variant: "success" },
] as const
---

<section class="py-20 md:py-28" id="analytics">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      eyebrow="Payment reconciliation"
      title="Every rupee, traceable to its order."
      lead="Every settlement line item is matched to its order and its invoice — discrepancies are flagged before they ever reach your books."
      center
    >
      <ul class="reveal mt-6 flex flex-wrap justify-center gap-x-6 gap-y-3">
        {
          checks.map((c) => (
            <li class="flex items-center gap-2 text-sm font-semibold text-ink">
              <CheckCircle />
              {c}
            </li>
          ))
        }
      </ul>
    </SectionHeading>

    <!-- desktop / tablet table -->
    <div class="reveal mt-2 hidden overflow-hidden rounded-2xl border border-border bg-card shadow-card md:block">
      <div class="flex items-center gap-3 border-b border-border bg-zinc-50/70 px-5 py-3.5">
        <span class="text-sm font-bold tracking-tight text-ink">August settlements</span>
        <span class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-2.5 py-1.5 text-xs font-semibold text-muted-foreground">
          Aug 2026
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] text-sm">
          <thead>
            <tr class="border-b border-border bg-white text-left text-[11px] font-bold tracking-[0.09em] text-zinc-400 uppercase">
              <th class="px-5 py-3">Marketplace</th>
              <th class="px-5 py-3 text-right">Orders</th>
              <th class="px-5 py-3 text-right">Gross</th>
              <th class="px-5 py-3 text-right">Deductions</th>
              <th class="px-5 py-3 text-right">Net payout</th>
              <th class="px-5 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-subtle">
            {
              rows.map((r) => (
                <tr class="transition-colors hover:bg-zinc-50/70">
                  <td class="px-5 py-3.5">
                    <span class="flex items-center gap-2.5 font-semibold">
                      <span class="grid size-7 place-items-center rounded-lg border border-border bg-subtle text-[11px] font-bold text-muted-foreground">{r.init}</span>
                      {r.name}
                    </span>
                  </td>
                  <td class="num px-5 py-3.5 text-right text-zinc-400">{r.orders}</td>
                  <td class="num px-5 py-3.5 text-right">{r.gross}</td>
                  <td class="num px-5 py-3.5 text-right text-zinc-400">{r.ded}</td>
                  <td class="num px-5 py-3.5 text-right font-bold">
                    {r.net}
                    {"neg" in r && r.neg && <span class="num ml-1.5 text-xs font-semibold text-red-700">{r.neg}</span>}
                  </td>
                  <td class="px-5 py-3.5">
                    <Badge variant={r.variant}>{r.status}</Badge>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="flex items-center gap-2 border-t border-border bg-zinc-50/70 px-5 py-3 text-xs text-zinc-400">
        <svg class="size-3.5 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        Discrepancies flagged before they reach your ledger.
      </p>
    </div>

    <!-- mobile settlement cards -->
    <div class="mx-auto mt-2 grid max-w-md gap-3 md:hidden">
      {
        rows.map((r) => (
          <article class="rounded-2xl border border-border bg-white p-4 shadow-xs reveal">
            <div class="flex items-center gap-3">
              <span class="grid size-8 shrink-0 place-items-center rounded-lg border border-border bg-subtle text-[11px] font-bold text-muted-foreground">{r.init}</span>
              <div>
                <b class="block text-sm font-bold tracking-tight text-ink">{r.name}</b>
                <span class="block text-xs text-zinc-400">{r.orders} orders</span>
              </div>
              <Badge variant={r.variant} className="ml-auto">{r.status}</Badge>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5 border-t border-dashed border-border pt-3">
              <div>
                <i class="block text-[10.5px] font-bold tracking-widest text-zinc-400 uppercase not-italic">Gross</i>
                <em class="num mt-0.5 block text-[13.5px] font-semibold not-italic text-ink">{r.gross}</em>
              </div>
              <div>
                <i class="block text-[10.5px] font-bold tracking-widest text-zinc-400 uppercase not-italic">Deductions</i>
                <em class="num mt-0.5 block text-[13.5px] font-semibold not-italic text-ink">{r.ded}</em>
              </div>
            </div>
            <div class="mt-3 flex items-center justify-between gap-3 rounded-xl border border-indigo-100 bg-accent px-3.5 py-2.5">
              <i class="text-[10.5px] font-bold tracking-widest text-accent-foreground uppercase not-italic">Net payout</i>
              <em class="num text-[15px] font-extrabold not-italic text-ink">{r.net}</em>
            </div>
            {"neg" in r && r.neg && (
              <p class="mt-2.5 flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs leading-snug font-semibold text-red-800">
                <svg class="mt-0.5 size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"></path><path d="M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"></path></svg>
                Commission mismatch of ₹1,240 flagged for review
              </p>
            )}
          </article>
        ))
      }
      <p class="flex items-center justify-center gap-2 pt-1 text-xs text-zinc-400">
        <svg class="size-3.5 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        Discrepancies flagged before they reach your ledger.
      </p>
    </div>
  </div>
</section>
