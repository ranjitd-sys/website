---
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"
---

<style is:global>
  /* ============================================================
     HERO
     Marketplace → DeepEcom → Intelligence → Reconciliation → Accounting → ERP
     ============================================================ */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7rem, 13vh, 9.5rem) 0 clamp(4.5rem, 9vh, 7rem);
  }

  /* Atmospheric gradient field */
  .hero::before {
    content: "";
    position: absolute;
    inset: -10% -5% auto;
    z-index: -2;
    height: 58rem;
    background:
      radial-gradient(52rem 30rem at 72% -6%, rgba(99, 91, 255, 0.16), transparent 60%),
      radial-gradient(40rem 22rem at 10% 0%, rgba(133, 124, 255, 0.12), transparent 58%),
      radial-gradient(70rem 40rem at 50% 118%, rgba(79, 70, 229, 0.1), transparent 60%);
    pointer-events: none;
  }

  /* subtle dot grid for financial-infrastructure feel */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image: radial-gradient(rgba(15, 23, 42, 0.045) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent 70%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    text-align: center;
  }

  /* ---------- eyebrow ---------- */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.375rem 0.875rem 0.375rem 0.4rem;
    border: 1px solid var(--ink-200);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
  }
  .hero-eyebrow:hover {
    border-color: var(--brand-300);
    color: var(--ink-700);
  }
  .hero-eyebrow .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--brand-500);
    box-shadow: 0 0 0 3px var(--brand-100);
  }

  /* ---------- headline ---------- */
  .hero-title {
    margin: 1.5rem auto 0;
    max-width: 60rem;
    font-size: clamp(2.75rem, 6.4vw, 5.25rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
    font-weight: var(--font-weight-bold);
    text-wrap: balance;
    color: var(--ink-950);
  }
  .hero-title .grad {
    background: linear-gradient(100deg, var(--brand-600) 0%, var(--brand-500) 48%, var(--ink-500) 110%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* ---------- lead ---------- */
  .hero-lead {
    margin: 1.4rem auto 0;
    max-width: 38rem;
    font-size: clamp(1.0625rem, 1.45vw, 1.25rem);
    line-height: 1.7;
    color: var(--ink-500);
    text-wrap: pretty;
  }

  /* ---------- CTAs ---------- */
  .hero-actions {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  /* ============ Product/data composition stage ============ */
  .hero-stage {
    margin-top: clamp(3rem, 6vh, 4.5rem);
    position: relative;
    perspective: 1400px;
  }

  .hero-stage-glow {
    position: absolute;
    inset: -3rem -3rem auto;
    height: 26rem;
    background: radial-gradient(50% 55% at 50% 0%, rgba(99, 91, 255, 0.13), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-visual {
    position: relative;
    margin-inline: auto;
    max-width: 66rem;
    animation: hero-rise 0.9s var(--ease-out) both;
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(1.6rem); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- Main console card ---------- */
  .hero-console {
    position: relative;
    z-index: 1;
    transform: perspective(1400px) rotateX(1.5deg);
    transform-origin: center bottom;
    border: 1px solid var(--ink-200);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #ffffff 0%, var(--ink-50) 100%);
    box-shadow:
      0 1px 2px rgba(15, 17, 32, 0.03),
      0 2px 4px -1px rgba(15, 17, 32, 0.04),
      0 40px 80px -40px rgba(15, 17, 32, 0.35);
    overflow: hidden;
  }

  .console-topbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--ink-200);
    background: rgba(255, 255, 255, 0.85);
  }
  .console-topbar .dots {
    display: flex;
    gap: 0.3rem;
  }
  .console-topbar .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--ink-200);
  }
  .console-topbar .dots i:first-child { background: var(--danger-400, #fca5a5); }
  .console-topbar .dots i:nth-child(2) { background: var(--warning-400, #fcd34d); }
  .console-topbar .dots i:last-child { background: var(--success-400, #86efac); }
  .console-topbar .addr {
    flex: 1;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-700);
    letter-spacing: -0.01em;
  }
  .console-topbar .addr span {
    color: var(--ink-400);
    font-weight: 400;
  }
  .console-topbar .live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--success-600);
    background: var(--success-50);
    border: 1px solid var(--success-500);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.6rem;
  }
  .console-topbar .live .pulse {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--success-500);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ---------- Console body: pipeline + panel ---------- */
  .console-body {
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    align-items: stretch;
    gap: 0;
  }

  /* Left: data-flow pipeline */
  .pipeline-pane {
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-right: 1px solid var(--ink-200);
  }

  .flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }
  .flow-node .box {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 0.9rem;
    background: #fff;
    border: 1px solid var(--ink-200);
    box-shadow: var(--shadow-sm);
    color: var(--ink-400);
  }
  .flow-node.is-core .box {
    background: var(--brand-500);
    border-color: var(--brand-500);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(99, 91, 255, 0.65);
  }
  .flow-node .box svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .flow-node .cap {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-400);
    white-space: nowrap;
  }
  .flow-node.is-core .cap {
    color: var(--brand-600);
    font-weight: 700;
  }

  /* connector with animated data flow */
  .flow-link {
    position: relative;
    flex: 0 0 2rem;
    height: 2px;
    overflow: visible;
  }
  .flow-link .track {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--ink-300), var(--ink-200));
  }
  .flow-link .track::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--brand-500), transparent);
    transform: translateX(-100%);
    animation: flow-sweep 1.8s ease-in-out infinite;
  }
  @keyframes flow-sweep {
    0% { transform: translateX(-100%); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  /* mini settlement / ledger table */
  .ledger {
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    overflow: hidden;
    background: #fff;
    text-align: left;
  }
  .ledger-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 0.6rem 0.9rem;
    background: var(--ink-50);
    border-bottom: 1px solid var(--ink-200);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-400);
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 1.4rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--ink-100);
  }
  .ledger-row:first-of-type { border-top: 0; }
  .ledger-row .logo {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 0.4rem;
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: 0.55rem;
    font-weight: 700;
  }
  .ledger-row .who { text-align: left; }
  .ledger-row .who strong {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-800);
  }
  .ledger-row .who span {
    font-size: 0.6875rem;
    color: var(--ink-400);
  }
  .ledger-row .status {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }
  .ledger-row .status.ok { color: var(--success-600); background: var(--success-50); }
  .ledger-row .status.warn { color: var(--warning-600); background: var(--warning-50); }

  /* Right: chart + KPI panel */
  .insight-pane {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
  }
  .insight-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .insight-head strong {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }
  .insight-head span {
    font-size: 0.6875rem;
    color: var(--ink-400);
  }

  .spark {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 3.2rem;
  }
  .spark i {
    flex: 1;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, var(--brand-400), var(--brand-600));
    animation: spark-grow 1.2s var(--ease-out) both;
  }
  .spark i:nth-child(1){ height: 40%; animation-delay: 0s; }
  .spark i:nth-child(2){ height: 55%; animation-delay: 0.04s; }
  .spark i:nth-child(3){ height: 48%; animation-delay: 0.08s; }
  .spark i:nth-child(4){ height: 66%; animation-delay: 0.12s; }
  .spark i:nth-child(5){ height: 58%; animation-delay: 0.16s; }
  .spark i:nth-child(6){ height: 78%; animation-delay: 0.2s; }
  .spark i:nth-child(7){ height: 70%; animation-delay: 0.24s; }
  .spark i:nth-child(8){ height: 92%; animation-delay: 0.28s; }
  .spark i:nth-child(9){ height: 84%; animation-delay: 0.32s; }
  .spark i:nth-child(10){ height: 100%; animation-delay: 0.36s; }
  @keyframes spark-grow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  .insight-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .stat {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--ink-200);
    border-radius: 0.75rem;
    background: #fff;
  }
  .stat .k {
    display: block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-400);
  }
  .stat .v {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-900);
  }

  /* ---------- Floating panels (depth) ---------- */
  .hero-float {
    position: absolute;
    z-index: 3;
    background: #fff;
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    box-shadow: var(--shadow-lg);
    padding: 0.75rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation: float-y 5.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes float-y {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  .hero-float .icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: var(--brand-50);
    color: var(--brand-600);
  }
  .hero-float .icon svg { width: 1rem; height: 1rem; }
  .hero-float .meta strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }
  .hero-float .meta span {
    font-size: 0.6875rem;
    color: var(--ink-400);
  }
  .hero-float.fl-1 {
    top: -1.4rem;
    left: 2%;
    animation-delay: 0s;
  }
  .hero-float.fl-2 {
    top: 2.5rem;
    right: 1%;
    animation-delay: 1.1s;
  }
  .hero-float.fl-3 {
    bottom: -1.5rem;
    left: 6%;
    animation-delay: 0.6s;
  }
  .hero-float.fl-4 {
    bottom: -1.2rem;
    right: 5%;
    animation-delay: 1.6s;
  }

  /* ---------- reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hero-visual, .hero-float, .hero-console { animation: none !important; transform: none !important; }
    .flow-link .track::after, .console-topbar .live .pulse, .spark i { animation: none !important; }
  }

  /* ============ Responsive ============ */
  @media (max-width: 64rem) {
    .console-body {
      grid-template-columns: 1fr;
    }
    .pipeline-pane {
      border-right: 0;
      border-bottom: 1px solid var(--ink-200);
    }
    .hero-float.fl-1, .hero-float.fl-4 { display: none; }
  }

  @media (max-width: 48rem) {
    .hero { padding-top: clamp(6rem, 15vw, 7.5rem); }
    .hero-float { display: none; }
    .flow { gap: 0.25rem; }
    .flow-link { flex-basis: 0.75rem; }
    .flow-node .box {
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 0.75rem;
    }
    .flow-node .box svg { width: 1.15rem; height: 1.15rem; }
    .flow-node .cap { font-size: 0.5625rem; }
    .hero-console { transform: none; }
  }
</style>

<header class="hero" id="hero">
  <div class="hero-inner mt-25">
    <a href="#platform" class="hero-eyebrow  group inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-slate-50/80 px-10 py-1 text-xs font-semibold text-slate-700 backdrop-blur-md transition-all duration-200 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 hover:shadow-sm">
  <span class="relative flex size-2 items-center justify-center" aria-hidden="true">
    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
    <span class="relative size-1.5 rounded-full bg-emerald-500"></span>
  </span>
  <span>The accounting layer for ecommerce</span>
  <svg class="size-3 text-slate-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
  </svg>
</a>

    <h1 class="hero-title reveal">
      Your ecommerce business,
      <span class="grad">connected.</span>
    </h1>

    <p class="hero-lead reveal">
      Connect your marketplaces, understand your profitability, reconcile your payments, and automatically
      account every transaction in your ERP.
    </p>

    <div class="hero-actions reveal ">
      <a href="#contact" class={buttonVariants({ size: "lg" })}>
        Book a Demo
        <ArrowRight size={16} />
      </a>
      <a href="#platform" class={buttonVariants({ variant: "outline", size: "lg" })}>
        Explore Platform
      </a>
    </div>

    <div class="hero-stage reveal ">
      <div class="hero-stage-glow" aria-hidden="true"></div>

      <div class="hero-visual mt-10">
        <!-- floating panels -->
        <div class="hero-float fl-1" aria-hidden="true">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
          <div class="meta">
            <strong>Reconciled</strong>
            <span>Amazon settlement</span>
          </div>
        </div>
        <div class="hero-float fl-2" aria-hidden="true">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16M7 13l4-4 4 3 5-6"/></svg></span>
          <div class="meta">
            <strong>Profitability</strong>
            <span>Gross &amp; net margin</span>
          </div>
        </div>
        <div class="hero-float fl-3" aria-hidden="true">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6M9 16h6M6 3h12a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2z"/></svg></span>
          <div class="meta">
            <strong>GST voucher</strong>
            <span>Ready to post</span>
          </div>
        </div>
        <div class="hero-float fl-4" aria-hidden="true">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6"/></svg></span>
          <div class="meta">
            <strong>ERP synced</strong>
            <span>Tally · Zoho · SAP</span>
          </div>
        </div>

        <!-- main console -->
        <div class="hero-console">
          <div class="console-topbar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="addr">DeepEcom <span>· Finance control center</span></span>
            <span class="live"><span class="pulse" aria-hidden="true"></span> Live</span>
          </div>

          <div class="console-body">
            <!-- pipeline -->
            <div class="pipeline-pane">
              <div class="flow" role="img" aria-label="Marketplace data flows through DeepEcom intelligence, reconciliation and accounting into the ERP">
                <div class="flow-node">
                  <span class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg></span>
                  <span class="cap">Marketplace</span>
                </div>
                <span class="flow-link"><span class="track"></span></span>

                <div class="flow-node is-core">
                  <span class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="13" width="4.5" height="8" rx="1"/><rect x="9.75" y="8" width="4.5" height="13" rx="1"/><rect x="16.5" y="3" width="4.5" height="18" rx="1"/></svg></span>
                  <span class="cap">DeepEcom</span>
                </div>
                <span class="flow-link"><span class="track"></span></span>

                <div class="flow-node">
                  <span class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
                  <span class="cap">Intelligence</span>
                </div>
                <span class="flow-link"><span class="track"></span></span>

                <div class="flow-node">
                  <span class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg></span>
                  <span class="cap">Reconcile</span>
                </div>
                <span class="flow-link"><span class="track"></span></span>

                <div class="flow-node">
                  <span class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6M9 16h6M6 3h12a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2z"/></svg></span>
                  <span class="cap">Accounting</span>
                </div>
                <span class="flow-link"><span class="track"></span></span>

                <div class="flow-node">
