---
import { ArrowRight } from "lucide-react"
import HeroDiagram from "@/components/landing/HeroDiagram.astro"
import DashboardPreview from "./DashboardPreview.astro"
---

<style is:global>
  .hero-section {
    position: relative;
    background:
      radial-gradient(48rem 22rem at 78% -10%, rgba(47, 114, 240, 0.14), transparent 60%),
      radial-gradient(36rem 18rem at 12% -6%, rgba(127, 125, 252, 0.1), transparent 58%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: clamp(4.5rem, 6vh, 5.5rem);
    padding-bottom: clamp(2rem, 4vh, 3rem);
    overflow: hidden;
  }

  .hero-container {
    width: 100%;
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 0.84fr 1.16fr;
      gap: 2.5rem;
    }
  }

  /* Tighter stacking gap on single-column (tablet) hero */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero-grid {
      gap: 2rem;
    }
  }

  /* ---------- Left column ---------- */
  .hero-copy {
    max-width: 34rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .hero-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
  }

  .hero-title {
    margin-top: 1.1rem;
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-950);
    text-wrap: balance;
  }
  .hero-title .dot,
  .hero-title .accent {
    color: var(--brand-500);
  }

  .hero-lead {
    margin-top: 1rem;
    max-width: 32rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--ink-500);
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn-primary-de {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    background: var(--brand-500);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm), 0 0 0 1px rgba(47, 114, 240, 0.2);
    transition: background-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .btn-primary-de:hover {
    background: var(--brand-600);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
    color: #fff;
  }
  .btn-secondary-de {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--ink-200);
    color: var(--ink-900);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .btn-secondary-de:hover {
    border-color: var(--brand-300);
    background: var(--brand-50);
    box-shadow: var(--shadow-sm);
    color: var(--ink-900);
  }

  .hero-note {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .hero-note svg {
    color: var(--brand-500);
  }

  /* ---------- Right column ---------- */
  .hero-visual {
    position: relative;
    width: 100%;
  }

  /* On desktop the visual is viewport-height so the dashboard preview
     bleeds off the bottom edge — the editorial "product peek" crop */
  @media (min-width: 64rem) {
    .hero-visual {
      height: calc(100svh - clamp(4.5rem, 6vh, 5.5rem) - clamp(2rem, 4vh, 3rem));
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    /* keep the diagram compact so the dashboard's KPIs + charts are in view */
    .hero-diagram-wrap {
      flex-shrink: 0;
      padding: 0 0 0.5rem;
    }
  }

  /* Dashboard preview inside the hero: strip the section band so it reads
     as a floating product card, and drop the settlements feed for a clear
     overview (it's cropped by the hero edge anyway) */
  .hero-visual .dash-stage {
    background: transparent;
    border: none;
  }
  .hero-visual .dash-stage aside {
    display: none !important;
  }
  .hero-visual .dash-stage [class*="grid-cols-[1fr_340px]"] {
    grid-template-columns: 1fr;
  }

  /* ---------- Mobile & tablet tightening ---------- */
  @media (max-width: 48rem) {
    .hero-section {
      padding-top: 4.25rem;
      padding-bottom: 2.5rem;
    }
    .hero-grid {
      gap: 2.25rem;
    }
    .hero-title {
      font-size: clamp(2.05rem, 8vw, 2.55rem);
      line-height: 1.08;
    }
    .hero-lead {
      margin-top: 1rem;
      font-size: 1rem;
    }
    .hero-actions {
      margin-top: 1.5rem;
    }
    .hero-note {
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section {
      background: linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
    }
  }
</style>

<section class="hero-section" id="hero">
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left column: copy + CTAs -->
      <div class="hero-copy reveal">
        <span class="hero-eyebrow"><span class="dot" aria-hidden="true"></span>Your accounting layer for ecommerce</span>

        <h1 class="hero-title">
          The <span class="accent">accounting layer</span> built for ecommerce businesses<span class="dot">.</span>
        </h1>

        <p class="hero-lead">
          Connect your marketplaces. Understand your profitability. Reconcile every payment. And automatically account transactions in your ERP.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="btn-primary-de">
            Book a Demo
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a href="/platform" class="btn-secondary-de">
            Explore Platform
          </a>
        </div>

        <p class="hero-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
          Marketplace data in. ERP-ready accounting out.
        </p>
      </div>

      <!-- Right column: pipeline + dashboard composition -->
      <div class="hero-visual reveal" data-delay="140">
        <HeroDiagram />
        <DashboardPreview compact />
      </div>
    </div>
  </div>
</section>