---
const marketplaces = [
  { name: "Amazon", logo: "amazon" },
  { name: "Flipkart", logo: "flipkart" },
  { name: "Shopify", logo: "shopify" },
  { name: "Meesho", logo: "meesho" },
  { name: "Myntra", logo: "myntra" },
];

const erps = [
  { name: "Tally", logo: "tally" },
  { name: "SAP", logo: "sap" },
  { name: "Zoho Books", logo: "zoho" },
  { name: "Busy", logo: "busy" },
];
---

<section class="integrations-strip-wrapper" aria-label="Supported Integrations">
  <div class="integrations-card reveal">
    
    <!-- Left Section: Marketplaces -->
    <div class="int-group">
      <span class="kicker">WORKS WITH THE SYSTEMS YOU USE</span>
      
      <div class="logo-row">
        {marketplaces.map((item) => (
          <div class="logo-item">
            {item.logo === 'amazon' && (
              <span class="brand-text amazon">amazon</span>
            )}
            {item.logo === 'flipkart' && (
              <span class="brand-text flipkart">Flipkart <span class="fk-box">f</span></span>
            )}
            {item.logo === 'shopify' && (
              <span class="brand-text shopify"><span class="sp-icon">🛍️</span> shopify</span>
            )}
            {item.logo === 'meesho' && (
              <span class="brand-text meesho">meesho</span>
            )}
            {item.logo === 'myntra' && (
              <span class="brand-text myntra"><span class="m-icon">M</span> Myntra</span>
            )}
          </div>
        ))}
        
        <div class="logo-item more-badge">
          <span>+ More</span>
        </div>
      </div>
    </div>

    <!-- Center Divider Line -->
    <div class="center-divider"></div>

    <!-- Right Section: ERPs & Accounting -->
    <div class="int-group">
      <span class="kicker">ERPs & ACCOUNTING</span>
      
      <div class="logo-row">
        {erps.map((item) => (
          <div class="logo-item">
            {item.logo === 'tally' && (
              <div class="tally-box">
                <span class="tally-title">Tally</span>
                <span class="tally-sub">POWER OF SIMPLICITY</span>
              </div>
            )}
            {item.logo === 'sap' && (
              <span class="sap-badge">SAP</span>
            )}
            {item.logo === 'zoho' && (
              <span class="brand-text zoho"><span class="zh-box">Z</span> Zoho Books</span>
            )}
            {item.logo === 'busy' && (
              <span class="brand-text busy">busy</span>
            )}
          </div>
        ))}

        <div class="logo-item more-badge">
          <span>+ More</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .integrations-strip-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--space-gutter);
  }

  /* Outer White Container Card */
  .integrations-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  @media (min-width: 64rem) {
    .integrations-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  /* Sub Group Layout */
  .int-group {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Vertical Divider */
  .center-divider {
    width: 100%;
    height: 1px;
    background-color: #f1f5f9;
  }

  @media (min-width: 64rem) {
    .center-divider {
      width: 1px;
      height: 60px;
    }
  }

  /* Header Kicker */
  .kicker {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2c3ee9;
    margin-bottom: 1.25rem;
  }

  /* Logo Items Row */
  .logo-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.85rem;
    border-right: 1px solid #f1f5f9;
    height: 36px;
  }

  .logo-item:last-child {
    border-right: none;
    padding-right: 0;
  }

  /* Brand Typography & Badges */
  .brand-text {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .brand-text.amazon {
    color: #000000;
    font-family: Arial, sans-serif;
  }

  .brand-text.flipkart {
    color: #2874f0;
    font-style: italic;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .fk-box {
    background: #ff9f00;
    color: #fff;
    font-size: 0.65rem;
    padding: 1px 4px;
    border-radius: 2px;
    font-style: normal;
  }

  .brand-text.shopify {
    color: #000000;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .brand-text.meesho {
    color: #f43f5e;
    font-weight: 700;
  }

  .brand-text.myntra {
    color: #000000;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.9rem;
  }

  .m-icon {
    color: #ff3f6c;
    font-weight: 900;
  }

  .tally-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .tally-title {
    font-family: Georgia, serif;
    font-weight: bold;
    font-size: 1.15rem;
    color: #000000;
    font-style: italic;
  }

  .tally-sub {
    font-size: 0.4rem;
    font-weight: 700;
    color: #10b981;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }

  .sap-badge {
    background: #008fd3;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.85rem;
    padding: 2px 8px;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .brand-text.zoho {
    color: #000000;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .zh-box {
    border: 1.5px solid #22c55e;
    color: #22c55e;
    font-size: 0.65rem;
    padding: 0 3px;
    border-radius: 3px;
  }

  .brand-text.busy {
    color: #1d4ed8;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .more-badge {
    font-size: 0.725rem;
    font-weight: 600;
    color: #64748b;
  }
</style>