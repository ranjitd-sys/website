---
const capabilities = [
  {
    title: "Order-wise",
    desc: "Every order accounted for",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6M9 16h4",
  },
  {
    title: "GST-wise",
    desc: "Tax-level accounting",
    icon: "M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z",
  },
  {
    title: "Warehouse-wise",
    desc: "Across locations and warehouses",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
  },
  {
    title: "Marketplace-wise",
    desc: "Separate channel accounting",
    icon: "M3 21V8l9-5 9 5v13M9 21v-6h6v6M9 10h.01M15 10h.01M9 14h.01M15 14h.01",
  },
  {
    title: "Returns",
    desc: "Sales & return accounting",
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
  },
  {
    title: "Stock Transfers",
    desc: "Inventory movements accounted for",
    icon: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
  },
  {
    title: "TCS / TDS",
    desc: "Auto calculation and accounting",
    icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
];
---

<section class="capability-strip-wrapper" aria-label="Capabilities Overview">
  <div class="capability-card">
    
    <!-- Header Kicker -->
    <span class="kicker">COMPLETE ECOMMERCE ACCOUNTING</span>

    <!-- 7-Column Grid -->
    <div class="capability-grid">
      {
        capabilities.map((c, i) => (
          <div class="capability-item reveal" data-delay={i * 60}>
            <div class="icon-bubble">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={c.icon} />
              </svg>
            </div>
            <div class="item-text">
              <strong>{c.title}</strong>
              <p>{c.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>

<style>
  .capability-strip-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--space-gutter);
  }

  /* Single Outer White Card Container */
  .capability-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.5rem 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  /* Blue Header Text */
  .kicker {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4f46e5;
    margin-bottom: 1.5rem;
  }

  /* Grid Layout: Stacks on mobile, 7 columns on large desktop */
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .capability-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 80rem) {
    .capability-grid {
      grid-template-columns: repeat(7, 1fr);
      gap: 0;
    }
  }

  /* Individual Item Layout */
  .capability-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  /* Subtle vertical divider between items on full screen */
  @media (min-width: 80rem) {
    .capability-item {
      border-right: 1px solid #f1f5f9;
      padding-left: 0.75rem;
    }
    .capability-item:first-child {
      padding-left: 0;
    }
    .capability-item:last-child {
      border-right: none;
      padding-right: 0;
    }
  }

  /* Circular Icon Avatar */
  .icon-bubble {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #e0e7ff; /* Very light purple/blue tint */
    color: #4338ca;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-bubble svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* Text Content */
  .item-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .item-text strong {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
    white-space: nowrap;
  }

  .item-text p {
    font-size: 0.6875rem;
    line-height: 1.35;
    color: #64748b;
    margin: 0;
  }
</style>