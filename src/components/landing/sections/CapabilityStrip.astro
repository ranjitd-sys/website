---
const capabilities = [
  {
    title: "Order-wise",
    desc: "Every order accounted individually, never lumped into summaries",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6M9 16h4",
  },
  {
    title: "GST-wise",
    desc: "IGST, CGST, SGST split by type and state, ERP-ready",
    icon: "M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z",
  },
  {
    title: "Warehouse-wise",
    desc: "Stock and values tracked per warehouse and fulfilment centre",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
  },
  {
    title: "Marketplace-wise",
    desc: "Fees, charges and payouts handled separately per marketplace",
    icon: "M3 21V8l9-5 9 5v13M9 21v-6h6v6M9 10h.01M15 10h.01M9 14h.01M15 14h.01",
  },
  {
    title: "Returns",
    desc: "Returns and refunds flow into your books automatically",
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
  },
  {
    title: "Stock Transfers",
    desc: "Inter-warehouse movement accounted without inventory drift",
    icon: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
  },
  {
    title: "TCS / TDS",
    desc: "Withholding tax captured and posted exactly where it belongs",
    icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
]
---

<style is:global>
  .capability-band {
    border-block: 1px solid var(--ink-200);
    background: var(--surface-subtle);
    padding: clamp(3.5rem, 8vh, 5.5rem) 0;
  }
  .capability-inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .capability-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 2.25rem;
  }
  .capability-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: var(--font-weight-bold);
    color: var(--ink-950);
  }
  .capability-note {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-400);
  }
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--ink-200);
    border-radius: var(--radius-xl);
    background: #fff;
    overflow: hidden;
    box-shadow: var(--shadow-xs);
  }
  @media (min-width: 48rem) {
    .capability-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .capability-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem;
    border-right: 1px solid var(--ink-100);
    border-bottom: 1px solid var(--ink-100);
  }
  @media (max-width: 47.99rem) {
    .capability-cell:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (min-width: 48rem) {
    .capability-cell:nth-child(4n) {
      border-right: 0;
    }
    .capability-cell:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }
  .capability-cell:last-child {
    border-bottom: 0;
  }
  .capability-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: var(--brand-50);
    color: var(--brand-600);
  }
  .capability-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .capability-cell strong {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }
  .capability-cell span {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-500);
  }
</style>

<section class="capability-band" id="capabilities" aria-label="Accounting capabilities">
  <div class="capability-inner">
    <div class="capability-head reveal">
      <h2 class="capability-title">Complete accounting, built to match ecommerce complexity.</h2>
      <span class="capability-note">Detailed, line-by-line — ready for your ERP</span>
    </div>

    <div class="capability-grid reveal">
      {
        capabilities.map((c) => (
          <div class="capability-cell">
            <span class="capability-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg>
            </span>
            <strong>{c.title}</strong>
            <span>{c.desc}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>