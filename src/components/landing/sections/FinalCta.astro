---
import SectionHeading from "../section-heading.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"

const trust = [
  "Read-only API access",
  "GST-compliant exports",
  "Your data is never resold",
]
---

<style is:global>
  .final-cta {
    padding: clamp(5.5rem, 12vh, 9rem) 0;
  }
  .final-cta-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ink-200);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, #ffffff 0%, var(--ink-50) 100%);
    box-shadow: var(--shadow-card);
    padding: clamp(2.75rem, 7vw, 5rem) var(--space-gutter);
    text-align: center;
  }
  .final-cta-card::before {
    content: "";
    position: absolute;
    inset: -8rem -6rem auto;
    height: 22rem;
    background: radial-gradient(50% 55% at 50% 0%, rgba(83, 58, 253, 0.16), transparent 70%);
    pointer-events: none;
  }
  .final-cta-title {
    position: relative;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: var(--font-weight-bold);
    color: var(--ink-950);
    max-width: 46rem;
    margin-inline: auto;
    text-wrap: balance;
  }
  .final-cta-lead {
    position: relative;
    margin: 1rem auto 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-500);
  }
  .final-cta-actions {
    position: relative;
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .final-cta-trust {
    position: relative;
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
  }
  .final-cta-trust li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-500);
  }
  .final-cta-trust svg {
    color: var(--success-600);
  }
</style>

<section class="final-cta" id="get-started">
  <div class="final-cta-card reveal">
    <h2 class="final-cta-title">Bring your ecommerce business and accounting together.</h2>
    <p class="final-cta-lead">
      See your marketplaces, profitability, reconciliation and ERP accounting — all in one layer.
    </p>
    <div class="final-cta-actions">
      <a href="/contact" class={buttonVariants({ size: "lg" })}>
        Book a Demo
        <ArrowRight size={16} />
      </a>
    </div>
    <ul class="final-cta-trust">
      {
        trust.map((t) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
            {t}
          </li>
        ))
      }
    </ul>
  </div>
</section>