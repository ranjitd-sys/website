---
const microNotes = [
  "No credit card required",
  "Set up in minutes",
];
---

<section class="cta-banner-wrapper" id="get-started">
  <div class="cta-banner">
    
    <!-- Left Group: Logo + Typography -->
    <div class="cta-content-left">
      <!-- Circular Logo Avatar -->
      <div class="logo-avatar">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="brand-icon">
          <path d="M16 4L6 9.5V22.5L16 28L26 22.5V9.5L16 4Z" stroke="#2563eb" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M10 12L16 15.5L22 12" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10 16.5L16 20L22 16.5" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Text Container -->
      <div class="text-group">
        <h2 class="banner-title">
          Bring your ecommerce business<br />and your books together.
        </h2>
        <p class="banner-lead">
          Connect your marketplaces. Understand your business.<br />Automate your accounting.
        </p>
      </div>
    </div>

    <!-- Right Group: Buttons + Micro Copy -->
    <div class="cta-content-right">
      <div class="button-group">
        <a href="/contact" class="btn-primary">
          Book a Demo <span class="arrow">→</span>
        </a>
        <a href="/contact" class="btn-secondary">
          Talk to an Expert
        </a>
      </div>

      <div class="micro-notes">
        <span>{microNotes[0]}</span>
        <span class="dot">•</span>
        <span>{microNotes[1]}</span>
      </div>
    </div>

  </div>
</section>

<style>
  .cta-banner-wrapper {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Main Container Card with Dark Blue Gradient */
  .cta-banner {
    background: linear-gradient(135deg, #07091e 0%, #0d1238 50%, #171d54 100%);
    border-radius: 20px;
    padding: 2.5rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: 0 10px 30px rgba(7, 9, 30, 0.35);
  }

  @media (min-width: 64rem) {
    .cta-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Left Section Layout */
  .cta-content-left {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  /* Circular White Logo Avatar */
  .logo-avatar {
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .brand-icon {
    width: 2.25rem;
    height: 2.25rem;
  }

  /* Text Styles */
  .text-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .banner-title {
    color: #ffffff;
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .banner-title {
      font-size: 1.875rem;
    }
  }

  .banner-lead {
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.45;
    margin: 0;
  }

  /* Right Section Layout */
  .cta-content-right {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
  }

  @media (min-width: 64rem) {
    .cta-content-right {
      align-items: flex-start;
    }
  }

  /* Button Group */
  .button-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  /* Solid Blue Primary Button */
  .btn-primary {
    background: #2563eb;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.75rem 1.35rem;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }

  .btn-primary .arrow {
    font-size: 1rem;
    line-height: 1;
  }

  /* Outlined Secondary Button */
  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.75rem 1.35rem;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Micro Copy Footer Notes */
  .micro-notes {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.725rem;
    color: #64748b;
  }

  .micro-notes .dot {
    font-size: 0.6rem;
  }
</style>