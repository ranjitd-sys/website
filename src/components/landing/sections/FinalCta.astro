---
const microNotes = [
  "No credit card required",
  "Set up in minutes",
];
---

<section class="cta-banner-wrapper" id="get-started">
  <div class="cta-banner">
    <!-- Soft violet atmosphere -->
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="cta-grid" aria-hidden="true"></div>

    <div class="cta-banner-inner">
      <!-- Left Group: Typography -->
      <div class="cta-content-left">
        <span class="cta-eyebrow">GET STARTED</span>
        <h2 class="banner-title">
          Bring your ecommerce business<br /> and your books together.
        </h2>
        <p class="banner-lead">
          Connect your marketplaces. Understand your business. Automate your accounting.
        </p>
      </div>

      <!-- Right Group: Buttons + Micro Copy -->
      <div class="cta-content-right">
        <div class="button-group">
          <a href="/contact" class="btn-primary">
            Book a Demo <span class="arrow">→</span>
          </a>
          <a href="/contact" class="btn-secondary">
            Talk to an Expert
          </a>
        </div>

        <div class="micro-notes">
          <span>{microNotes[0]}</span>
          <span class="dot">•</span>
          <span>{microNotes[1]}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    padding-block: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  /* Dark rich DeepEcom blue-violet card */
  .cta-banner {
    position: relative;
    isolation: isolate;
    background: linear-gradient(135deg, #150f38 0%, #191040 45%, #241458 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: clamp(2rem, 4.5vw, 3.5rem);
    overflow: hidden;
  }

  /* Violet atmosphere glows */
  .cta-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(62rem 30rem at 88% -18%, rgba(83, 58, 253, 0.45) 0%, rgba(83, 58, 253, 0) 55%),
      radial-gradient(50rem 26rem at -15% 115%, rgba(124, 95, 255, 0.22) 0%, rgba(124, 95, 255, 0) 55%);
    pointer-events: none;
  }

  /* Faint fintech grid texture */
  .cta-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
    background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    -webkit-mask-image: radial-gradient(80% 90% at 70% 20%, #000 0%, transparent 75%);
    mask-image: radial-gradient(80% 90% at 70% 20%, #000 0%, transparent 75%);
    pointer-events: none;
  }

  .cta-banner-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .cta-banner-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Left Section Layout */
  .cta-content-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 38rem;
  }

  .cta-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #b9a9ff;
  }

  /* Text Styles */
  .banner-title {
    color: #ffffff;
    font-size: clamp(1.625rem, 4vw, 2.375rem);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .banner-lead {
    color: #b6bdd3;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Right Section Layout */
  .cta-content-right {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
  }

  @media (min-width: 64rem) {
    .cta-content-right {
      align-items: flex-end;
      flex-shrink: 0;
    }
  }

  /* Button Group */
  .button-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  /* Solid Blue Primary Button */
  .btn-primary {
    background: #ffffff;
    color: #150f38;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.8rem 1.4rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 1px 2px rgba(9, 17, 32, 0.16), 0 10px 24px -12px rgba(0, 0, 0, 0.45);
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    background: #f0eefd;
    color: #241458;
    transform: translateY(-1px);
    box-shadow: 0 12px 26px -12px rgba(0, 0, 0, 0.5);
  }

  .btn-primary .arrow {
    font-size: 1rem;
    line-height: 1;
  }

  /* Outlined Secondary Button */
  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.8rem 1.4rem;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Micro Copy Footer Notes */
  .micro-notes {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.725rem;
    color: #8b93ad;
  }

  .micro-notes .dot {
    font-size: 0.6rem;
  }

  @media (max-width: 30rem) {
    .button-group {
      width: 100%;
    }
    .button-group .btn-primary,
    .button-group .btn-secondary {
      flex: 1;
      justify-content: center;
    }
  }
</style>