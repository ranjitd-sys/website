---
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"

const trust = [
  "Read-only API access",
  "GST-compliant exports",
  "Your data is never resold",
]
---

<style is:global>
  .final-cta {
    padding: clamp(5.5rem, 12vh, 9rem) 0;
  }
  .final-cta-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1.75rem;
    background:
      radial-gradient(48rem 26rem at 85% -10%, rgba(127, 125, 252, 0.28), transparent 60%),
      radial-gradient(36rem 20rem at 8% 115%, rgba(83, 58, 253, 0.3), transparent 60%),
      linear-gradient(180deg, var(--ink-900) 0%, var(--ink-950) 100%);
    box-shadow: var(--shadow-2xl);
    padding: clamp(3.5rem, 8vw, 6rem) var(--space-gutter);
    text-align: center;
    color: #fff;
  }
  .final-cta-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(60% 60% at 50% 40%, #000 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(60% 60% at 50% 40%, #000 0%, transparent 100%);
    pointer-events: none;
  }
  .final-cta-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-300);
  }
  .final-cta-title {
    margin-top: 1rem;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: var(--font-weight-bold);
    color: #fff;
    max-width: 46rem;
    margin-inline: auto;
    text-wrap: balance;
  }
  .final-cta-lead {
    margin: 1.1rem auto 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-300);
  }
  .final-cta-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .final-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8125rem 1.5rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font-size: var(--text-lead);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .final-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-sm);
    color: #fff;
  }
  .final-cta-trust {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
  }
  .final-cta-trust li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-300);
  }
  .final-cta-trust svg {
    color: var(--brand-300);
  }
</style>

<section class="final-cta" id="get-started">
  <div class="final-cta-card reveal">
    <span class="final-cta-eyebrow">The accounting layer for ecommerce</span>
    <h2 class="final-cta-title">Bring your ecommerce business and your books together.</h2>
    <p class="final-cta-lead">
      Connect your marketplaces, understand your business and automate ecommerce accounting.
    </p>
    <div class="final-cta-actions">
      <a href="/contact" class={buttonVariants({ variant: "white", size: "lg" })}>
        Book a Demo
        <ArrowRight size={16} />
      </a>
      <a href="/contact" class="final-cta-secondary">
        Talk to an Expert
      </a>
    </div>
    <ul class="final-cta-trust">
      {
        trust.map((t) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
            {t}
          </li>
        ))
      }
    </ul>
  </div>
</section>