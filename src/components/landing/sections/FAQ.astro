---
import SectionHeading from "../section-heading.astro"
import FaqAccordion from "../faq-accordion"
---

<section class="py-20 md:py-28" id="faq">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      eyebrow="FAQ"
      title="Frequently asked questions."
      lead="Need help with something, or have questions about a feature? Here are the answers sellers ask us most."
      center
    />
    <div class="reveal mt-12">
      <FaqAccordion client:visible />
    </div>
  </div>
</section>
