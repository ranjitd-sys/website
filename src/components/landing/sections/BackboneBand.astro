---
import LineGrid from "../LineGrid.astro"

const stats = [
  { value: "2", label: "Core products" },
  { value: "3", label: "ERPs supported" },
  { value: "11", label: "Accounting stages, order to ERP" },
  { value: "100%", label: "Order-level, line-by-line" },
]
---

<style is:global>
  .backbone {
    position: relative;
    isolation: isolate;
    padding: clamp(4.5rem, 10vh, 7rem) 0;
    background: var(--ink-950);
    color: var(--ink-100);
    overflow: hidden;
  }
  .backbone::before {
    content: "";
    position: absolute;
    inset: -8rem -6rem auto;
    z-index: -1;
    height: 24rem;
    background: radial-gradient(50% 60% at 50% 0%, rgba(83, 58, 253, 0.22), transparent 70%);
    pointer-events: none;
  }
  .backbone-inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    text-align: center;
  }
  .backbone-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-400);
  }
  .backbone-title {
    margin: 1.1rem auto 0;
    max-width: 44rem;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
    color: #fff;
  }
  .backbone-lead {
    margin: 1rem auto 0;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-400);
  }
  .backbone-grid {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ink-800);
    border: 1px solid var(--ink-800);
    border-radius: 1.25rem;
    overflow: hidden;
  }
  @media (min-width: 48rem) {
    .backbone-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .backbone-stat {
    background: var(--ink-900);
    padding: 1.6rem 1.25rem;
  }
  .backbone-stat .v {
    display: block;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .backbone-stat .k {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-400);
  }
</style>

<section class="backbone" aria-label="DeepEcom by the numbers">
  <LineGrid size="clamp(7rem, 11vw, 11rem)" side style="--side-inset: calc(50% - min(var(--container-content), 100%) / 2 + var(--space-gutter))" />
  <div class="backbone-inner">
    <p class="backbone-eyebrow">The accounting layer</p>
    <h2 class="backbone-title">One layer between your marketplaces and your books.</h2>
    <p class="backbone-lead">
      DeepEcom turns raw marketplace activity into intelligence, reconciliation and complete ERP accounting.
    </p>

    <div class="backbone-grid">
      {
        stats.map((s) => (
          <div class="backbone-stat">
            <span class="v">{s.value}</span>
            <span class="k">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>