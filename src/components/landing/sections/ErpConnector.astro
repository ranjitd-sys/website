---
import AccountingPreview from "@/components/landing/AccountingPreview.astro"
---

<style is:global>
  .showcase {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(36rem 20rem at 10% -12%, rgba(83, 58, 253, 0.2), transparent 60%),
      linear-gradient(180deg, var(--ink-900) 0%, var(--ink-950) 100%);
    color: var(--ink-100);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(2rem, 4vw, 2.75rem);
    height: 100%;
  }
  .showcase .kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-300);
  }
  .showcase h3 {
    margin-top: 0.9rem;
    max-width: 26rem;
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: var(--font-weight-bold);
    color: #fff;
    text-wrap: balance;
  }
  .showcase p {
    margin-top: 0.9rem;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-400);
  }
  .showcase-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--brand-300);
    text-decoration: none;
    transition: gap var(--transition-base), color var(--transition-base);
  }
  .showcase-cta:hover {
    gap: 0.75rem;
    color: #fff;
  }
  .showcase-media {
    margin-top: auto;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.4));
  }
</style>

<section class="showcase" id="erp-connector" aria-label="DeepEcom ERP Connector">
  <div>
    <span class="kicker">ERP Connector</span>
    <h3>Account every transaction. Automatically.</h3>
    <p>
      Convert ecommerce orders into detailed, GST-ready accounting entries and post them into
      your ERP — order by order, warehouse by warehouse.
    </p>
    <a href="/erp-connector" class="showcase-cta">
      Explore ERP Connector
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
  <div class="showcase-media">
    <AccountingPreview />
  </div>
</section>
