---
const points = [
  {
    title: "An order isn't just an order.",
    // Shopping Cart Icon
    icon: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    title: "A payment isn't just a payment.",
    // Credit Card Icon
    icon: "M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5zm0 5h20M6 15h2",
  },
  {
    title: "And your settlement isn't your revenue.",
    // Bank Building Icon
    icon: "M3 21h18M3 10h18M5 10v11M9 10v11M13 10v11M17 10v11M12 3L2 7h20l-10-4z",
  },
];

const events = [
  "Orders",
  "GST",
  "Fees",
  "TCS / TDS",
  "Returns",
  "Inventory",
  "Settlements",
  "Payouts",
  "And more",
];
---

<div class="problem-wrapper">
  <div class="problem-card reveal">
    <!-- Top Grid Section -->
    <div class="problem-top">
      <div class="problem-header">
        <span class="problem-eyebrow">THE PROBLEM</span>
        <h2 class="problem-title">
          Ecommerce accounting<br />is complicated.
        </h2>
      </div>

      <div class="problem-points">
        {
          points.map((p) => (
            <div class="problem-point">
              <svg
                class="point-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={p.icon} />
              </svg>
              <p class="point-title">{p.title}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Divider Line -->
    <div class="problem-divider" aria-hidden="true"></div>

    <!-- Bottom Events & Multiplier Strip -->
    <div class="problem-bottom">
      <div class="problem-events">
        {
          events.map((e, i) => (
            <>
              <span class="event-item">{e}</span>
              {i < events.length - 1 && <span class="event-dot">•</span>}
            </>
          ))
        }
      </div>

      <div class="problem-multiply">
        Multiply that by <span class="highlight">100,000 orders.</span>
      </div>
    </div>
  </div>
</div>

<style>
  .problem-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(1rem, 2vw, 1.5rem) var(--space-gutter);
    background: transparent;
  }

  /* Single unified container matching image */
  .problem-card {
    width: 100%;
    background:
      radial-gradient(40rem 18rem at 100% -20%, rgba(44, 62, 233, 0.06), transparent 62%),
      #f8f9fd;
    border: 1px solid #e6e8f1;
    border-radius: 20px;
    padding: 3rem 3.5rem 2.25rem;
    box-shadow: 0 4px 24px -4px rgba(9, 17, 32, 0.06);
  }

  /* Top Section Grid */
  .problem-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 52rem) {
    .problem-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    }
  }

  .problem-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2c3ee9;
    margin-bottom: 0.75rem;
  }

  .problem-title {
    margin: 0;
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    line-height: 1.15;
    font-weight: 800;
    color: #0b132a;
    letter-spacing: -0.02em;
  }

  /* 3 Points Column Grid */
  .problem-points {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .problem-points {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .problem-point {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  /* Frameless clean SVG icons */
  .point-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: #2c3ee9;
    stroke-width: 1.8;
  }

  .point-title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 700;
    color: #0b132a;
    letter-spacing: -0.01em;
  }

  /* Thin separator line */
  .problem-divider {
    height: 1px;
    background-color: #e2e8f0;
    margin: 2.5rem 0 1.5rem;
    opacity: 0.8;
  }

  /* Bottom Strip */
  .problem-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .problem-events {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #717d96;
  }

  .event-dot {
    color: #a0aec0;
    font-size: 0.75rem;
  }

  .problem-multiply {
    font-size: 1.125rem;
    font-weight: 800;
    color: #0b132a;
    letter-spacing: -0.01em;
  }

  .problem-multiply .highlight {
    color: #2c3ee9;
  }
</style>