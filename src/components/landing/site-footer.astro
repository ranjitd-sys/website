---
import { LogoMark } from "./icons"

const columns = [
  {
    title: "Products",
    links: [
      ["/platform", "Platform"],
      ["/erp-connector", "ERP Connector"],
    ],
  },
  {
    title: "Solutions",
    links: [
      ["/solutions/amazon-sellers", "Amazon Sellers"],
      ["/solutions/d2c-brands", "D2C Brands"],
      ["/solutions/enterprise", "Enterprise"],
      ["/solutions/cfos", "CFOs"],
      ["/solutions/accountants", "Accountants"],
      ["/solutions/business-owners", "Business Owners"],
    ],
  },
  {
    title: "Integrations",
    links: [
      ["/integrations/amazon", "Amazon"],
      ["/integrations/flipkart", "Flipkart"],
      ["/integrations/shopify", "Shopify"],
      ["/integrations/meesho", "Meesho"],
      ["/integrations/tally", "Tally"],
      ["/integrations/sap", "SAP"],
      ["/integrations/zoho-books", "Zoho Books"],
    ],
  },
  {
    title: "Resources",
    links: [
      ["/resources/blog", "Blog"],
      ["/resources/guides", "Guides"],
      ["/resources/ecommerce-accounting", "Ecommerce Accounting"],
      ["/resources/reconciliation", "Reconciliation"],
      ["/resources/gst", "GST"],
      ["/resources/erp", "ERP"],
      ["/resources/faqs", "FAQs"],
      ["/resources/help-center", "Help Center"],
    ],
  },
  {
    title: "Company",
    links: [
      ["/customers", "Customers"],
      ["/pricing", "Pricing"],
      ["/about", "About"],
      ["/careers", "Careers"],
      ["/contact", "Contact"],
      ["/partners", "Partners"],
    ],
  },
  {
    title: "Legal",
    links: [
      ["/privacy", "Privacy"],
      ["/terms", "Terms"],
      ["/security", "Security"],
    ],
  },
]
---

<style is:global>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface-subtle);
  }
  .site-footer-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 8vh, 5rem) 2.5rem;
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.7fr repeat(6, 1fr);
      gap: 2rem;
    }
  }
  .footer-brand {
    max-width: 20rem;
  }
  .footer-brand .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-950);
    text-decoration: none;
  }
  .footer-brand .logo:hover {
    color: var(--ink-950);
  }
  .footer-brand p {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .footer-brand .foot-note {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand-600);
  }
  .footer-col h4 {
    margin-bottom: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .footer-col a {
    display: block;
    padding-block: 0.3rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .footer-col a:hover {
    color: var(--ink-950);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
    padding-block: 1.4rem;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
  .footer-social {
    display: flex;
    gap: 0.5rem;
  }
  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
  }
  .footer-bottom-links a {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .footer-bottom-links a:hover {
    color: var(--ink-950);
  }
  .footer-social a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: #fff;
    color: var(--muted-foreground);
    transition: border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }
  .footer-social a:hover {
    border-color: var(--brand-200);
    color: var(--brand-600);
    transform: translateY(-1px);
  }
</style>

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <LogoMark />
          DeepEcom
        </a>
        <p>
          Your accounting layer for ecommerce — marketplace data, profitability, payment
          reconciliation and detailed ERP accounting.
        </p>
        <p class="foot-note">Marketplace data in. ERP-ready accounting out.</p>
      </div>

      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <h4>{col.title}</h4>
            {
              col.links.map(([href, label]) => (
                <a href={href}>{label}</a>
              ))
            }
          </nav>
        ))
      }
    </div>

    <div class="footer-bottom">
      <span>© 2026 DeepEcom Technologies Pvt Ltd. All rights reserved.</span>
      <nav class="footer-bottom-links" aria-label="Accounts and legal">
        <a href="/login">Login</a>
        <a href="/contact">Book a Demo</a>
        <span aria-hidden="true">·</span>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
    </div>
  </div>
</footer>