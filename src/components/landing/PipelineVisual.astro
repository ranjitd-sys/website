---
// Import Lucide icons or use inline SVGs as needed
---

<style>
  .pipeline-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .pipeline-container {
      flex-direction: row;
      gap: 1rem;
    }
  }

  /* Cards Setup */
  .card {
    background: #ffffff;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
    padding: 1.5rem;
    width: 100%;
    flex: 1;
  }

  /* Left & Right Card Styling */
  .card-header {
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .item-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .item-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #334155;
  }

  .item-icon {
    width: 1rem;
    height: 1rem;
    color: #6366f1;
    flex-shrink: 0;
  }

  /* Center Highlight Card */
  .card-center {
    background: linear-gradient(180deg, #4f46e5 0%, #3730a3 100%);
    border-radius: 1.25rem;
    padding: 0.5rem;
    color: white;
    box-shadow: 0 10px 30px -5px rgba(79, 70, 229, 0.3);
    flex: 1.1;
  }

  .brand-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 0;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-size: 0.9375rem;
  }

  .center-inner {
    background: #ffffff;
    border-radius: 0.875rem;
    padding: 1.25rem 1rem;
    color: #0f172a;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .step-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #eef2ff;
    color: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0f172a;
  }

  .step-desc {
    font-size: 0.6875rem;
    color: #64748b;
    margin-top: 0.125rem;
  }

  /* Arrows */
  .arrow {
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 47.9375rem) {
    .arrow {
      transform: rotate(90deg);
    }
  }

  /* Badge at the bottom right */
  .audit-badge {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #4f46e5;
  }
</style>

<div class="pipeline-container">
  <!-- Card 1: Input -->
  <div class="card">
    <div class="card-header">Raw Marketplace Data</div>
    <ul class="item-list">
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
        Amazon Order
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Settlement
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V8a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        Payment
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H4m0 0l4-4m-4 4l4 4"/></svg>
        Return
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        Inventory Movement
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 11h.01M7 15h.01M13 7h.01M13 11h.01M13 15h.01M19 7h.01M19 11h.01M19 15h.01"/></svg>
        Marketplace Fee
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/></svg>
        TCS / TDS
      </li>
    </ul>
  </div>

  <!-- Arrow 1 -->
  <div class="arrow">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
  </div>

  <!-- Card 2: Core Processing -->
  <div class="card-center">
    <div class="brand-header">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      DEEPECOM
    </div>
    <div class="center-inner">
      <div class="step-item">
        <div class="step-icon">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        </div>
        <div>
          <div class="step-title">Understand</div>
          <div class="step-desc">Get clarity on sales, profitability & performance</div>
        </div>
      </div>

      <div class="step-item">
        <div class="step-icon">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </div>
        <div>
          <div class="step-title">Reconcile</div>
          <div class="step-desc">Match settlements, find issues & close gaps</div>
        </div>
      </div>

      <div class="step-item">
        <div class="step-icon">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <div class="step-title">Account</div>
          <div class="step-desc">Generate accurate accounting for your ERP</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Arrow 2 -->
  <div class="arrow">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
  </div>

  <!-- Card 3: Output -->
  <div class="card">
    <div class="card-header">Business-Ready Data</div>
    <ul class="item-list">
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        Profitability & Insights
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Reconciled Payouts
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Detailed Reports
      </li>
      <li class="item-row">
        <svg class="item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>
        ERP-Ready Accounting
      </li>
    </ul>

    <div class="audit-badge">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      100% Accurate, Audit Ready
    </div>
  </div>
</div>