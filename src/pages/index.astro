        stroke: #ececf0;
        stroke-width: 1;
      }
      .flow-pill-txt {
        font-family: Inter, sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        fill: #71717a;
      }
      .node-sub {
        font-family: Inter, sans-serif;
        font-size: 11px;
        font-weight: 500;
        fill: #8b8b94;
      }
      .hint-label {
        font-family: Inter, sans-serif;
        font-size: 12px;
        font-weight: 500;
        fill: #8b8b94;
      }
      .core-title {
        font-family: Inter, sans-serif;
        font-size: 17px;
        font-weight: 700;
        fill: #09090b;
        letter-spacing: -0.02em;
      }
      .core-sub {
        font-family: Inter, sans-serif;
        font-size: 12px;
        font-weight: 500;
        fill: #8b8b94;
      }
      .core-chip {
