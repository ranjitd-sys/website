<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DeepEcom — Ecommerce Finance Control Center</title>
    <meta
      name="description"
      content="DeepEcom tracks real profits across multiple marketplaces. Automate Tally accounting, reconcile payments effortlessly, and get GST-ready exports."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,450;14..32,500;14..32,600;14..32,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #ffffff;
        --bg-subtle: #f7f8fa;
        --bg-inset: #fafafb;
        --ink: #09090b;
        --text-1: #18181b;
        --text-2: #52525b;
        --text-3: #8b8b94;
        --border: #e6e6ea;
        --border-strong: #d9d9de;
        --accent: #4f46e5;
        --accent-hover: #4338ca;
        --accent-soft: #eef2ff;
        --accent-border: #c7d2fe;
        --green: #15803d;
        --green-bg: #f0fdf4;
        --green-border: #bbf7d0;
        --amber: #b45309;
        --amber-bg: #fffbeb;
        --amber-border: #fde68a;
        --red: #b91c1c;
        --red-bg: #fef2f2;
        --red-border: #fecaca;
        --shadow-xs: 0 1px 2px rgba(16, 24, 40, 0.05);
        --shadow-sm:
          0 1px 3px rgba(16, 24, 40, 0.07), 0 1px 2px rgba(16, 24, 40, 0.04);
        --shadow-md:
          0 12px 24px -8px rgba(16, 24, 40, 0.1),
          0 4px 8px -4px rgba(16, 24, 40, 0.05);
        --shadow-xl:
          0 1px 3px rgba(16, 24, 40, 0.05),
          0 32px 64px -24px rgba(16, 24, 40, 0.16);
        --radius-card: 14px;
        --radius-lg: 18px;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family:
          "Inter",
          ui-sans-serif,
          system-ui,
          -apple-system,
          sans-serif;
        background: var(--bg);
        color: var(--text-1);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      ::selection {
        background: var(--accent-soft);
        color: var(--accent-hover);
      }
      a {
        color: inherit;
      }
      button {
        font: inherit;
        cursor: pointer;
      }
      svg {
        display: block;
      }
      [id] {
        scroll-margin-top: 92px;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border-strong);
        border-radius: 8px;
        border: 3px solid var(--bg);
      }

      .wrap {
        max-width: 1152px;
        margin-inline: auto;
        padding-inline: 24px;
      }
      .sec {
        padding-block: clamp(72px, 9vw, 128px);
      }
      .sec-subtle {
        background: var(--bg-subtle);
        border-block: 1px solid var(--border);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12.5px;
        font-weight: 650;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 20px;
      }
      .eyebrow::before {
        content: "";
        width: 20px;
        height: 2px;
        background: var(--accent);
        border-radius: 2px;
      }
      .eyebrow.center::after {
        content: "";
        width: 20px;
        height: 2px;
        background: var(--accent);
        border-radius: 2px;
      }

      .h2 {
        font-size: clamp(30px, 4vw, 52px);
        font-weight: 620;
        letter-spacing: -0.03em;
        line-height: 1.08;
        color: var(--ink);
      }
      .lead {
        font-size: clamp(16px, 1.35vw, 19px);
        line-height: 1.65;
        color: var(--text-2);
        max-width: 560px;
        margin-top: 18px;
      }
      .sec-head {
        margin-bottom: clamp(44px, 5vw, 72px);
        max-width: 720px;
      }
      .sec-head.center {
        margin-inline: auto;
        text-align: center;
      }
      .sec-head.center .lead {
        margin-inline: auto;
      }

      .num {
        font-variant-numeric: tabular-nums;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 550;
        font-size: 15px;
        letter-spacing: -0.01em;
        border-radius: 10px;
        padding: 12px 22px;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.18s ease;
        white-space: nowrap;
      }
      .btn svg {
        width: 16px;
        height: 16px;
      }
      .btn-primary {
        background: var(--accent);
        color: #fff;
        box-shadow:
          var(--shadow-xs),
          inset 0 1px 0 rgba(255, 255, 255, 0.14);
      }
      .btn-primary:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
      }
      .btn-secondary {
        background: #fff;
        color: var(--text-1);
        border-color: var(--border-strong);
        box-shadow: var(--shadow-xs);
      }
      .btn-secondary:hover {
        border-color: #c4c4cc;
        background: var(--bg-inset);
        transform: translateY(-1px);
      }
      .btn-sm {
        padding: 8px 16px;
        font-size: 14px;
        border-radius: 9px;
      }
      .btn-lg {
        padding: 14px 26px;
        font-size: 15.5px;
        border-radius: 11px;
      }

      .reveal {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 0.7s var(--ease-out),
          transform 0.7s var(--ease-out);
      }
      .reveal.in {
        opacity: 1;
        transform: none;
      }

      .nav {
        position: fixed;
        inset-inline: 0;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.84);
        backdrop-filter: blur(14px) saturate(1.5);
        -webkit-backdrop-filter: blur(14px) saturate(1.5);
        border-bottom: 1px solid transparent;
        transition:
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }
      .nav.scrolled {
        border-bottom-color: var(--border);
        box-shadow: var(--shadow-xs);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        gap: 36px;
        height: 68px;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 680;
        font-size: 17.5px;
        letter-spacing: -0.02em;
        color: var(--ink);
      }
      .logo-mark {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: var(--accent);
        display: grid;
        place-items: center;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.25),
          0 2px 6px rgba(79, 70, 229, 0.35);
      }
      .nav-links {
        display: flex;
        gap: 4px;
        margin-inline: auto;
      }
      .nav-links a {
        text-decoration: none;
        color: var(--text-2);
        font-size: 14.5px;
        font-weight: 500;
        padding: 7px 13px;
        border-radius: 8px;
        transition:
          color 0.15s ease,
          background 0.15s ease;
      }
      .nav-links a:hover {
        color: var(--ink);
        background: rgba(9, 9, 11, 0.045);
      }
      .nav-right {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .nav-signin {
        text-decoration: none;
        color: var(--text-2);
        font-size: 14.5px;
        font-weight: 500;
        padding: 7px 10px;
        border-radius: 8px;
      }
      .nav-signin:hover {
        color: var(--ink);
      }
      .menu-btn {
        display: none;
        background: none;
        border: 1px solid var(--border);
        border-radius: 9px;
        width: 38px;
        height: 38px;
        place-items: center;
        color: var(--text-1);
      }
      .mobile-menu {
        display: none;
        position: fixed;
        top: 68px;
        inset-inline: 0;
        z-index: 99;
        background: #fff;
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow-md);
        padding: 12px 24px 20px;
      }
      .mobile-menu.open {
        display: block;
      }
      .mobile-menu a {
        display: block;
        padding: 12px 4px;
        text-decoration: none;
        color: var(--text-1);
        font-weight: 550;
        font-size: 16px;
        border-bottom: 1px solid var(--bg-subtle);
      }
      .mobile-menu .btn {
        margin-top: 16px;
        width: 100%;
      }

      .hero {
        padding-top: clamp(140px, 16vw, 188px);
        text-align: center;
        position: relative;
      }
      .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #fff;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        color: var(--text-2);
        font-size: 13.5px;
        font-weight: 520;
        padding: 7px 14px 7px 9px;
        border-radius: 999px;
        margin-bottom: 30px;
        text-decoration: none;
        transition:
          border-color 0.15s ease,
          transform 0.15s ease;
      }
      .hero-pill:hover {
        border-color: var(--accent-border);
        transform: translateY(-1px);
      }
      .hero-pill .tag {
        background: var(--accent);
        color: #fff;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 0.04em;
        padding: 2.5px 8px;
        border-radius: 999px;
      }
      .hero h1 {
        font-size: clamp(32px, 5vw, 62px);
        font-weight: 640;
        letter-spacing: -0.045em;
        line-height: 1.06;
        color: var(--ink);
        max-width: 880px;
        margin-inline: auto;
        text-wrap: balance;
      }
      .hero h1 em {
        font-style: normal;
        color: var(--text-3);
        font-weight: 560;
      }
      .hero-sub {
        font-size: clamp(16.5px, 1.5vw, 19.5px);
        line-height: 1.66;
        color: var(--text-2);
        max-width: 640px;
        margin: 26px auto 0;
      }
      .hero-ctas {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 38px;
      }
      .hero-note {
        margin-top: 18px;
        font-size: 13.5px;
        color: var(--text-3);
        display: flex;
        gap: 7px;
        align-items: center;
        justify-content: center;
      }
      .hero-note svg {
        width: 14px;
        height: 14px;
        color: var(--green);
      }

      .dash-stage {
        margin-top: clamp(56px, 7vw, 88px);
        background: linear-gradient(
          to bottom,
          #fff 118px,
          var(--bg-subtle) 118px
        );
        border-block: 1px solid var(--border);
        padding-bottom: clamp(56px, 6vw, 80px);
      }

      .dash {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        overflow: hidden;
        text-align: left;
      }
      .dash-top {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 20px;
        border-bottom: 1px solid var(--border);
        background: #fcfcfd;
      }
      .dash-crumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 550;
        color: var(--text-1);
        min-width: 0;
      }
      .dash-crumb .org {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .org-badge {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: var(--ink);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        display: grid;
        place-items: center;
        letter-spacing: 0.02em;
      }
      .dash-crumb .sep {
        color: var(--border-strong);
      }
      .dash-crumb .page {
        color: var(--text-2);
        font-weight: 480;
      }
      .dash-search {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--border);
        background: #fff;
        border-radius: 8px;
        padding: 6.5px 10px;
        font-size: 12.5px;
        color: var(--text-3);
        min-width: 210px;
      }
      .dash-search svg {
        width: 13px;
        height: 13px;
      }
      .dash-search kbd {
        margin-left: auto;
        font-family: inherit;
        font-size: 10.5px;
        color: var(--text-3);
        border: 1px solid var(--border);
        background: var(--bg-inset);
        border-radius: 4px;
        padding: 1px 5px;
      }
      .icon-btn {
        position: relative;
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        color: var(--text-2);
        border: 1px solid transparent;
      }
      .icon-btn:hover {
        background: var(--bg-subtle);
      }
      .icon-btn svg {
        width: 15px;
        height: 15px;
      }
      .icon-btn .dot {
        position: absolute;
        top: 6px;
        right: 7px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--amber);
        border: 1.5px solid #fff;
      }
      .avatar-stack {
        display: flex;
      }
      .avatar-stack span {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 10.5px;
        font-weight: 650;
        color: var(--text-2);
        background: var(--bg-subtle);
        border: 1.5px solid #fff;
        margin-left: -7px;
      }
      .avatar-stack span:first-child {
        margin-left: 0;
        background: var(--accent-soft);
        color: var(--accent-hover);
        border-color: var(--accent-border);
      }

      .dash-body {
        padding: clamp(18px, 2.6vw, 28px);
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .kpis {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
      }
      .kpi {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 18px 14px;
        background: #fff;
        transition:
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }
      .kpi:hover {
        box-shadow: var(--shadow-sm);
        border-color: var(--border-strong);
      }
      .kpi-label {
        font-size: 12.5px;
        font-weight: 520;
        color: var(--text-2);
        letter-spacing: 0.01em;
      }
      .kpi-value-row {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-top: 7px;
      }
      .kpi-value {
        font-size: clamp(21px, 2vw, 26px);
        font-weight: 660;
        letter-spacing: -0.025em;
        color: var(--ink);
      }
      .kpi-unit {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-3);
      }
      .delta {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 999px;
        margin-top: 10px;
      }
      .delta svg {
        width: 11px;
        height: 11px;
      }
      .delta.up {
        color: var(--green);
        background: var(--green-bg);
      }
      .spark {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 30px;
        margin-top: 12px;
      }
      .spark i {
        flex: 1;
        background: #e8e8ee;
        border-radius: 2px;
        min-height: 4px;
      }
      .spark i:last-child {
        background: var(--accent);
      }

      .dash-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 14px;
        align-items: stretch;
      }
      .panel {
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
      }
      .panel-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px 18px;
        border-bottom: 1px solid var(--border);
      }
      .panel-title {
        font-size: 14px;
        font-weight: 620;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .legend {
        display: flex;
        gap: 14px;
        margin-left: auto;
        font-size: 11.5px;
        color: var(--text-2);
        font-weight: 500;
      }
      .legend i {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
      }
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 550;
        color: var(--text-2);
        border: 1px solid var(--border);
        background: #fff;
        padding: 5px 10px;
        border-radius: 8px;
      }
      .chip svg {
        width: 12px;
        height: 12px;
        color: var(--text-3);
      }
      .live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--green);
      }
      .live::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green);
        animation: pulse 2.2s infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.35;
        }
      }

      .chart-wrap {
        position: relative;
        padding: 14px 10px 6px;
      }
      .chart-wrap svg {
        width: 100%;
        height: auto;
      }
      .tooltip {
        position: absolute;
        top: 4%;
        right: 3.5%;
        background: var(--ink);
        color: #fff;
        border-radius: 9px;
        padding: 8px 12px;
        text-align: left;
        pointer-events: none;
        box-shadow: var(--shadow-md);
        line-height: 1.35;
      }
      .tooltip .t-label {
        font-size: 10.5px;
        font-weight: 550;
        color: #a1a1aa;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .tooltip .t-val {
        font-size: 14.5px;
        font-weight: 650;
        letter-spacing: -0.01em;
      }
      .tooltip .t-delta {
        font-size: 11px;
        font-weight: 550;
        color: #86efac;
      }

      .feed-list {
        padding: 4px 0;
      }
      .feed-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 18px;
        border-bottom: 1px solid var(--bg-subtle);
      }
      .feed-row:last-child {
        border-bottom: 0;
      }
      .mkt-logo {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        font-size: 12.5px;
        font-weight: 700;
        background: var(--bg-subtle);
        color: var(--text-2);
        border: 1px solid var(--border);
      }
      .feed-main {
        min-width: 0;
      }
      .feed-name {
        font-size: 13.5px;
        font-weight: 590;
        color: var(--ink);
        letter-spacing: -0.005em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .feed-time {
        font-size: 11.5px;
        color: var(--text-3);
      }
      .feed-right {
        margin-left: auto;
        text-align: right;
      }
      .feed-amt {
        font-size: 13.5px;
        font-weight: 620;
        color: var(--ink);
        letter-spacing: -0.01em;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 620;
        letter-spacing: 0.01em;
        padding: 2.5px 9px;
        border-radius: 999px;
        border: 1px solid;
        margin-top: 3px;
      }
      .badge::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
      }
      .badge.green {
        color: var(--green);
        background: var(--green-bg);
        border-color: var(--green-border);
      }
      .badge.amber {
        color: var(--amber);
        background: var(--amber-bg);
        border-color: var(--amber-border);
      }
      .badge.red {
        color: var(--red);
        background: var(--red-bg);
        border-color: var(--red-border);
      }
      .panel-foot {
        padding: 11px 18px;
        border-top: 1px solid var(--border);
        background: #fcfcfd;
      }
      .panel-foot a {
        font-size: 12.5px;
        font-weight: 590;
        color: var(--accent);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }
      .panel-foot a:hover {
        color: var(--accent-hover);
      }
      .panel-foot svg {
        width: 13px;
        height: 13px;
      }

