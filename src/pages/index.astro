      }
      .fact-row:last-of-type {
        border-bottom: 0;
      }
      .fact-ic {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--accent-soft);
        border: 1px solid var(--accent-border);
        color: var(--accent);
        display: grid;
        place-items: center;
        flex-shrink: 0;
      }
      .fact-ic svg {
        width: 17px;
        height: 17px;
      }
      .fact-row b {
        display: block;
        font-size: 14.5px;
        font-weight: 620;
        color: var(--ink);
      }
      .fact-row span {
        font-size: 13.5px;
        color: var(--text-2);
      }
      .form-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        padding: clamp(24px, 3vw, 36px);
      }
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
      }
      .field.full {
        grid-column: 1 / -1;
      }
      .field label {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
      }
      .field input,
      .field textarea {
        font: inherit;
        font-size: 14.5px;
        color: var(--ink);
        border: 1px solid var(--border-strong);
        border-radius: 10px;
        padding: 11px 14px;
        background: #fff;
        width: 100%;
        transition:
          border-color 0.15s ease,
          box-shadow 0.15s ease;
      }
      .field textarea {
        min-height: 130px;
        resize: vertical;
      }
      .field input::placeholder,
      .field textarea::placeholder {
        color: var(--text-3);
      }
      .field input:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
      }
      .form-card .btn {
        width: 100%;
        margin-top: 22px;
      }
      .form-hint {
        font-size: 12px;
        color: var(--text-3);
        text-align: center;
        margin-top: 14px;
      }
      .form-success {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 14px;
        padding: 40px 16px;
      }
      .form-success .big-check {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--green-bg);
        border: 1px solid var(--green-border);
        color: var(--green);
        display: grid;
        place-items: center;
      }
      .form-success .big-check svg {
        width: 24px;
        height: 24px;
      }
      .form-success h3 {
        font-size: 19px;
        font-weight: 640;
        letter-spacing: -0.015em;
      }
      .form-success p {
        font-size: 14.5px;
        color: var(--text-2);
        max-width: 340px;
      }

      footer {
        border-top: 1px solid var(--border);
        background: var(--bg-subtle);
      }
      .foot-grid {
        display: grid;
        grid-template-columns: 1.7fr 1fr 1fr;
        gap: 48px;
        padding-block: clamp(52px, 6vw, 80px) 48px;
      }
      .foot-brand p {
        font-size: 14px;
        line-height: 1.65;
        color: var(--text-2);
        max-width: 320px;
        margin-top: 18px;
      }
      .socials {
        display: flex;
        gap: 8px;
        margin-top: 24px;
      }
      .socials a {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        border: 1px solid var(--border);
        background: #fff;
        display: grid;
        place-items: center;
        color: var(--text-2);
        transition: all 0.18s ease;
      }
      .socials a:hover {
        color: var(--accent);
        border-color: var(--accent-border);
        transform: translateY(-1px);
        box-shadow: var(--shadow-xs);
      }
      .socials svg {
        width: 15px;
        height: 15px;
      }
      .foot-col h4 {
        font-size: 12px;
        font-weight: 660;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 18px;
      }
      .foot-col a {
        display: block;
        font-size: 14px;
        color: var(--text-2);
        text-decoration: none;
        padding: 5.5px 0;
        transition: color 0.15s ease;
      }
      .foot-col a:hover {
        color: var(--ink);
      }
      .foot-bottom {
        border-top: 1px solid var(--border);
        padding-block: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--text-3);
      }

      @media (max-width: 1060px) {
        .dash-grid {
          grid-template-columns: 1fr;
        }
        .feed-panel {
          display: none;
        }
        .split,
        .contact-grid {
          grid-template-columns: 1fr;
        }
        .quotes {
          grid-template-columns: 1fr;
        }
        .plans {
          grid-template-columns: 1fr;
          max-width: 460px;
          margin-inline: auto;
        }
        .why-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .foot-grid {
          grid-template-columns: 1fr 1fr;
        }
        .span-2,
        .span-3 {
          grid-column: span 6;
        }
      }
      @media (max-width: 900px) {
        .nav-links,
        .nav-signin {
          display: none;
        }
        .menu-btn {
          display: grid;
        }
        .nav-right {
          margin-left: auto;
        }
        .kpis {
          grid-template-columns: repeat(2, 1fr);
        }
        .dash-search {
          display: none;
        }
      }
      @media (max-width: 620px) {
        .why-grid {
          grid-template-columns: 1fr;
        }
        .form-grid {
          grid-template-columns: 1fr;
        }
        .foot-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .hero-ctas .btn {
          width: 100%;
        }
        .dash-crumb .org {
          max-width: 44vw;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .avatar-stack {
          display: none;
        }
        .hero-pill {
          max-width: calc(100% - 8px);
          white-space: normal;
          text-align: left;
        }
        .wrap {
          padding-inline: 18px;
        }
        .tooltip {
          display: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
        html {
          scroll-behavior: auto;
        }
      }
    </style>
