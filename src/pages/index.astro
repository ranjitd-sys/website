      /* ============ FLOW DIAGRAM ============ */
      .flowcard {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        padding: clamp(14px, 2.5vw, 36px);
        overflow: hidden;
      }
      .flow-desktop {
        overflow-x: auto;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
      }
      .flow-desktop svg {
        width: 100%;
        min-width: 700px;
        height: auto;
        display: block;
      }
      .flow-mobile {
        display: none;
      }
      .flow-mobile svg {
        width: 100%;
        height: auto;
        display: block;
      }
      @media (max-width: 760px) {
        .flow-desktop {
          display: none;
        }
        .flow-mobile {
          display: block;
        }
      }
      .flowline-base {
        stroke: #e4e4e7;
        stroke-width: 1.5;
        fill: none;
      }
      .flowline-dash {
        stroke: #4f46e5;
        stroke-opacity: 0.5;
        stroke-width: 1.5;
        fill: none;
        stroke-dasharray: 6 9;
        animation: dashFlow 1.3s linear infinite;
      }
      @keyframes dashFlow {
        to {
          stroke-dashoffset: -30;
        }
      }
      .node-box {
        fill: #fff;
        stroke: #e6e6ea;
        stroke-width: 1;
      }
      .node-logo {
        fill: #f4f4f6;
        stroke: #e6e6ea;
        stroke-width: 1;
      }
      .node-name {
