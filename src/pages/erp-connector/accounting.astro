---
import PageLayout from "@/layouts/PageLayout.astro"
import AccountingHero from "@/components/pages/AccountingHero.astro"
import SectionHeading from "@/components/landing/section-heading.astro"
import TransactionDecomposition from "@/components/pages/TransactionDecomposition.astro"
import ErpOutputVoucher from "@/components/pages/ErpOutputVoucher.astro"
import GstWiseAccounting from "@/components/pages/GstWiseAccounting.astro"
import SettlementDecomposition from "@/components/pages/SettlementDecomposition.astro"
import InventoryAccounting from "@/components/pages/InventoryAccounting.astro"
import HowItWorksSteps from "@/components/pages/HowItWorksSteps.astro"
import FeatureListItem from "@/components/ui/FeatureListItem.astro"
import { ArrowRight, CheckCircle2, Building2, UserCheck, Briefcase } from "lucide-react"

const erpIntegrations = [
  {
    name: "Tally",
    tag: "Small & Mid-Market",
    points: ["Sales & GST vouchers", "Output CGST / SGST / IGST ledgers", "TCS ledger (271H)", "Receivable & charge ledgers"],
    voucherPrefix: "Voucher",
    voucherCode: "JRNL-45892",
  },
  {
    name: "SAP",
    tag: "Enterprise ERP",
    points: ["FI postings with GL mapping", "Tax codes mapped per rate", "Profit-center & cost-center detail", "Document number on posting"],
    voucherPrefix: "Doc",
    voucherCode: "1900048217",
  },
  {
    name: "Zoho Books",
    tag: "Cloud Accounting",
    points: ["Gateway-charge mapping", "GST tax profile per line", "Bank & receivable reconciliation", "Posting with source reference"],
    voucherPrefix: "Entry",
    voucherCode: "AI-33178",
  },
]

const personas = [
  {
    title: "CFO",
    desc: "Financial visibility, gross margin precision, and real-time ledger control.",
    icon: Building2,
  },
  {
    title: "Accountant",
    desc: "Detailed ecommerce accounting eliminating bulk manual ERP voucher entries.",
    icon: UserCheck,
  },
  {
    title: "Business Owner",
    desc: "Clear clarity on net earned revenue versus marketplace payout discrepancies.",
    icon: Briefcase,
  },
]

const faqs = [
  { q: "How does DeepEcom account for ecommerce orders?", a: "Every marketplace order becomes a complete set of journal entries — sales, GST by head, marketplace charges, TCS/TDS, receivable, and payment — posted directly into your ERP." },
  { q: "How is GST handled?", a: "GST is separated by head — CGST, SGST, and IGST — for every line item, keeping your output tax ledgers and GSTR-1/3B filing data fully aligned." },
  { q: "How are marketplace charges and TCS/TDS handled?", a: "Commissions, shipping fees, fixed fee deductions, and TCS/TDS are captured as dedicated debit entries within the specific settlement context." },
  { q: "How are returns and refunds accounted for?", a: "Returns automatically generate credit notes to reverse revenue and tax. Reversals and restocking entries keep inventory balanced." },
  { q: "How are inventory and stock transfers handled?", a: "Inventory movements and warehouse-to-warehouse stock transfers generate real-time postings across source and target locations." },
  { q: "Can DeepEcom post to Tally, SAP, and Zoho?", a: "Yes. Native connectors post fully structured voucher types directly via secure APIs into Tally Prime, SAP S/4HANA/ECC, and Zoho Books." },
  { q: "How does settlement accounting work?", a: "Sale value and cash collection are decoupled. Orders post to marketplace receivables, while payouts clear those receivables alongside itemized charge deductions." },
]

// Schema markup for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
}
---

<PageLayout
  title="Ecommerce Accounting & ERP Automation | DeepEcom"
  description="Automate order-wise, GST-wise, and warehouse-wise accounting from Amazon, Flipkart, and Shopify directly into Tally, SAP, or Zoho Books."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- 01 HERO -->
  <AccountingHero />

  <!-- 02 DECOMPOSITION -->
  <section class="section-band">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 band-bleed">
      <SectionHeading
        eyebrow="THE CHALLENGE"
        title="One order. Multiple accounting events."
        lead="A single marketplace order generates sales revenue, tax liabilities, platform deductions, TCS, receivables, and returns. DeepEcom accounts for every variable automatically."
        center
      />
      <div class="mt-10">
        <TransactionDecomposition />
      </div>
    </div>
  </section>

  <!-- 03 OUTPUT VOUCHER -->
  <section class="py-12 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="text-xs font-semibold uppercase tracking-widest text-brand-600">THE OUTPUT</span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl mt-2">See what actually gets posted.</h2>
          <p class="mt-4 text-base leading-relaxed text-ink-600">
            Every transaction is formatted as a balanced journal entry. Output GST, commission expenses, and net payouts are isolated into their designated GL accounts.
          </p>
          <ul class="mt-6 space-y-3">
            <FeatureListItem text="Balanced debits and credits for every transaction" />
            <FeatureListItem text="GST split automatically across CGST, SGST, and IGST" />
            <FeatureListItem text="Marketplace fees isolated from gross sales revenue" />
            <FeatureListItem text="Full audit trail linked to original order IDs" />
          </ul>
        </div>
        <div class="lg:col-span-7">
          <ErpOutputVoucher />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 GST ACCOUNTING -->
  <section class="section-band">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 band-bleed">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="order-2 lg:order-1 lg:col-span-7">
          <GstWiseAccounting />
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5">
          <span class="text-xs font-semibold uppercase tracking-widest text-brand-600">GST COMPLIANCE</span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl mt-2">Precision GST allocation per line item.</h2>
          <p class="mt-4 text-base leading-relaxed text-ink-600">
            CGST, SGST, and IGST are applied dynamically according to supply state and HSN codes, guaranteeing precise tax filing data across all channels.
          </p>
          <ul class="mt-6 space-y-3">
            <FeatureListItem text="Tax calculated dynamically by place of supply" />
            <FeatureListItem text="HSN-level taxable values preserved" />
            <FeatureListItem text="Return credit notes accurately reverse tax balances" />
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 SETTLEMENTS -->
  <section class="py-12 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="text-xs font-semibold uppercase tracking-widest text-brand-600">RECONCILIATION</span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl mt-2">From gross sale to bank payout.</h2>
          <p class="mt-4 text-base leading-relaxed text-ink-600">
            Marketplace payments rarely equal sale prices due to commissions, shipping charges, and withholdings. DeepEcom isolates each fee for effortless bank reconciliation.
          </p>
          <ul class="mt-6 space-y-3">
            <FeatureListItem text="Gross sales revenue separated from marketplace deductions" />
            <FeatureListItem text="TCS (271H) and TDS (194O) entries captured per batch" />
            <FeatureListItem text="Receivables updated seamlessly upon payment clearance" />
          </ul>
        </div>
        <div class="lg:col-span-7">
          <SettlementDecomposition />
        </div>
      </div>
    </div>
  </section>

  <!-- 06 INVENTORY & RETURNS -->
  <section class="section-band">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 band-bleed">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="order-2 lg:order-1 lg:col-span-7">
          <InventoryAccounting />
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5">
          <span class="text-xs font-semibold uppercase tracking-widest text-brand-600">INVENTORY LOGISTICS</span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl mt-2">Accurate inventory valuation.</h2>
          <p class="mt-4 text-base leading-relaxed text-ink-600">
            Keep cost of goods sold (COGS) and stock counts aligned. Returns and multi-warehouse stock transfers generate instant journal updates.
          </p>
          <ul class="mt-6 space-y-3">
            <FeatureListItem text="Automatic COGS adjustments on returns" />
            <FeatureListItem text="Warehouse-level stock movement journalization" />
            <FeatureListItem text="Batch and serial identification preserved" />
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 HOW IT WORKS -->
  <section class="py-12 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeading
        eyebrow="PROCESS"
        title="Automated sync in five steps."
        lead="Fetch channel activity, map chart of accounts, process rules, balance journals, and sync straight into your ERP."
        center
      />
      <div class="mt-12">
        <HowItWorksSteps />
      </div>
    </div>
  </section>

  <!-- 08 INTEGRATIONS -->
  <section class="section-band">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 band-bleed">
      <SectionHeading
        eyebrow="ERP NATIVE"
        title="Direct posting to your current accounting system."
        lead="Seamless integration with leading business accounting software using standard posting structures."
        center
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {erpIntegrations.map((erp) => (
          <div class="flex flex-col justify-between rounded-2xl border border-ink-200 bg-white p-6 shadow-sm transition-all hover:border-ink-300 hover:shadow-md">
            <div>
              <div class="flex items-center justify-between border-b border-ink-100 pb-4">
                <h3 class="text-lg font-bold text-ink-900">{erp.name}</h3>
                <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">{erp.tag}</span>
              </div>
              <ul class="mt-4 space-y-2.5">
                {erp.points.map((point) => (
                  <FeatureListItem text={point} size="sm" />
                ))}
              </ul>
            </div>
            <div class="mt-6 border-t border-dashed border-ink-200 pt-3 text-xs text-ink-500">
              Sample Format: <span class="font-mono font-semibold text-ink-800">{erp.voucherPrefix} #{erp.voucherCode}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 09 PERSONAS -->
  <section class="py-12 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeading
        eyebrow="STAKEHOLDERS"
        title="Tailored for financial control."
        center
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {personas.map((persona) => {
          const Icon = persona.icon
          return (
            <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-sm transition-all hover:border-ink-300 hover:shadow-md">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <Icon size={24} aria-hidden="true" />
              </div>
              <h3 class="text-lg font-bold text-ink-900">{persona.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{persona.desc}</p>
            </div>
          )
        })}
      </div>
    </div>
  </section>

  <!-- 10 FAQ -->
  <section class="section-band">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 band-bleed">
      <SectionHeading
        eyebrow="QUESTIONS"
        title="Frequently asked questions."
        center
      />
      <div class="mt-10 space-y-3">
        {faqs.map((faq, index) => (
          <details class="group rounded-xl border border-ink-200 bg-white p-4 transition-all [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-ink-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded">
              <span>{faq.q}</span>
              <span class="ml-4 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-brand-50 text-brand-600 transition-transform duration-200 group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11 CTA -->
  <section class="bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 py-16 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Automate your ecommerce accounting today.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100 text-balance">
        Eliminate manual data entry, streamline bank reconciliations, and establish direct ledger posting to your ERP.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-900 shadow-md transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Book a Demo
          <ArrowRight size={16} />
        </a>
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Talk to an Expert
        </a>
      </div>
    </div>
  </section>
</PageLayout>