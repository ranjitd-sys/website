---
import PageLayout from "@/layouts/PageLayout.astro"
import Hero from "@/components/customers/Hero.astro"
import LogoStrip from "@/components/customers/LogoStrip.astro"
import FeaturedStory from "@/components/customers/FeaturedStory.astro"
import Struggle from "@/components/customers/Struggle.astro"
import Transformation from "@/components/customers/Transformation.astro"
import Outcome from "@/components/customers/Outcome.astro"
import StoriesGrid from "@/components/customers/StoriesGrid.astro"
import ProductImpact from "@/components/customers/ProductImpact.astro"
import BusinessTypes from "@/components/customers/BusinessTypes.astro"
import Quotes from "@/components/customers/Quotes.astro"
import FAQ from "@/components/customers/FAQ.astro"
import FinalCTA from "@/components/customers/FinalCTA.astro"
---

<PageLayout
  title="Customers — DeepEcom"
  description="See how ecommerce businesses use DeepEcom to bring marketplace data, profitability, payment reconciliation and detailed accounting into one connected workflow."
>
  <!-- 01 HERO -->
  <Hero />

  <!-- 02 LOGO STRIP -->
  <LogoStrip />

  <!-- 03 FEATURED STORY -->
  <FeaturedStory />

  <!-- 04 THE PROBLEM -->
  <Struggle />

  <!-- 05 THE TRANSFORMATION -->
  <Transformation />

  <!-- 06 THE OUTCOME -->
  <Outcome />

  <!-- 07 ALL STORIES -->
  <StoriesGrid />

  <!-- 08 PRODUCT IMPACT -->
  <ProductImpact />

  <!-- 09 WHO IT'S FOR -->
  <BusinessTypes />

  <!-- 10 CUSTOMER VOICES -->
  <Quotes />

  <!-- 11 FAQ -->
  <FAQ />

  <!-- 12 FINAL CTA -->
  <FinalCTA />
</PageLayout>

<style is:global>
  main .sec, main .sec-narrow {
    padding-block: clamp(2rem, 3.6vh, 3.25rem);
  }
</style>