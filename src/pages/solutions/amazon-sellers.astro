---
import PageLayout from "@/layouts/PageLayout.astro"
import AmazonSellersHero from "@/components/pages/AmazonSellersHero.astro"
import SectionHeading from "@/components/landing/section-heading.astro"
import TransactionDecomposition from "@/components/pages/TransactionDecomposition.astro"
import ProfitabilityPanel from "@/components/pages/ProfitabilityPanel.astro"
import ReconciliationPanel from "@/components/pages/ReconciliationPanel.astro"
import SettlementDecomposition from "@/components/pages/SettlementDecomposition.astro"
import ErpOutputVoucher from "@/components/pages/ErpOutputVoucher.astro"
import GstWiseAccounting from "@/components/pages/GstWiseAccounting.astro"
import WarehouseWise from "@/components/pages/WarehouseWise.astro"
import WarehouseFlowSvg from "@/components/pages/WarehouseFlowSvg.astro"
import ReportsPanel from "@/components/pages/ReportsPanel.astro"
import HowItWorksSteps from "@/components/pages/HowItWorksSteps.astro"
import PlatformErpConnector from "@/components/pages/PlatformErpConnector.astro"
import CustomerProof from "@/components/pages/CustomerProof.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"
import OrderInventoryCompare from "@/components/pages/OrderInventoryCompare.astro"

const streams = [
  { label: "Orders", sub: "Every sale" },
  { label: "Payments", sub: "Settlements & fees" },
  { label: "Returns", sub: "Reversals" },
  { label: "Charges", sub: "Deductions" },
  { label: "GST", sub: "Tax context" },
  { label: "Inventory", sub: "Warehouse & stock" },
]

const personaData = [
  {
    title: "Business Owner",
    role: "Strategic Growth",
    desc: "Know what you sold, what Amazon paid and what you actually made.",
    icon: '<path d="M3 11 12 3l9 8M5 10v10h14V10"/>',
  },
  {
    title: "CFO",
    role: "Financial Control",
    desc: "Understand profitability, payment realization and financial performance.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    title: "Accountant",
    role: "Reconciliation",
    desc: "Reconcile Amazon settlements and maintain detailed accounting in the ERP.",
    icon: '<path d="M6 2h8l4 4v16H6zM14 2v4h4"/><path d="M8 7h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"/>',
  },
]

const faqs = [
  { q: "How does DeepEcom connect with Amazon?", a: "DeepEcom connects supported Amazon marketplace data — orders, settlements, returns, charges and tax context — into one financial view." },
  { q: "What Amazon data can DeepEcom process?", a: "DeepEcom works with the transaction data your Amazon business generates, including orders, payments, settlements, charges, returns and inventory movements." },
  { q: "Can I see Amazon profitability?", a: "Yes. Profitability is shown as revenue after the deductions and supported costs your Amazon data carries." },
  { q: "Can I reconcile Amazon settlements?", a: "Yes. DeepEcom compares expected settlements with what you actually received and surfaces every difference." },
  { q: "How does DeepEcom handle Amazon marketplace charges?", a: "Supported marketplace charges and deductions are reflected in the settlement picture and in accounting, so the difference is explainable." },
  { q: "Can I view expected vs received payments?", a: "Yes. Expected and received amounts are shown side by side for settlements and orders." },
  { q: "Can accounting be generated order-wise?", a: "Yes. Each Amazon order is accounted individually with its revenue, charges, GST and receivable." },
  { q: "How is GST represented?", a: "GST context carried by the transaction is represented in the accounting — the tax component is kept with the order." },
  { q: "How are TCS/TDS-related values handled?", a: "TCS and TDS related to marketplace transactions are captured within the accounting entries they apply to." },
  { q: "How are returns reflected?", a: "Returns reverse the original sale and its tax through accounting, so revenue and tax ledgers stay balanced." },
  { q: "Can warehouse information be maintained?", a: "Yes. Warehouse context is part of the transaction and is carried into warehouse-wise accounting." },
  { q: "Can stock transfers be accounted for?", a: "Yes. Transfers between warehouses are accounted with entries in both source and destination." },
  { q: "Can reports be downloaded?", a: "Yes. Reports on sales, profitability, payments and reconciliation are available for export." },
  { q: "Can Amazon accounting be posted to Tally, SAP or Zoho?", a: "Yes. Prepared entries post into Tally, SAP or Zoho with the vouchers and ledgers your finance team expects." },
  { q: "What is the difference between DeepEcom Platform and ERP Connector?", a: "The Platform helps you understand the business — profitability, reconciliation and reports. The ERP Connector turns the same transaction layer into detailed accounting inside your ERP." },
]
---

<PageLayout
  title="Amazon Sellers — Profitability, Reconciliation & Accounting | DeepEcom"
  description="DeepEcom helps Amazon sellers understand profitability, reconcile settlements and account every transaction with detailed GST and warehouse accounting — into Tally, SAP or Zoho."
>
  <!-- 01 — HERO -->
  <AmazonSellersHero />

  <!-- 02 — THE PROBLEM -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.15fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">THE PROBLEM</span>
          <h2 class="h2-md mt-4">Selling on Amazon is simple. Understanding the numbers isn't.</h2>
          <p class="lead mt-5">
            An Amazon business creates many streams of information — orders, payments, returns, charges, GST, TCS, inventory and settlements. At scale, those streams are hard to reconcile and understand.
          </p>
        </div>
        <div class="reveal grid gap-3 sm:grid-cols-2">
          {streams.map((s) => (
            <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card transition hover:border-ink-300 hover:shadow-md">
              <div class="text-sm font-semibold text-ink-800">{s.label}</div>
              <div class="mt-1 text-xs text-ink-400">{s.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — ONE AMAZON ORDER → FULL JOURNEY -->
  <section>
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">THE JOURNEY</span>
        <h2 class="h2-md mt-4">One Amazon order creates more than a sale.</h2>
        <p class="lead mt-5">Every order passes through sale, GST, charges, TCS, receivable, settlement, payment and — when it returns — inventory. DeepEcom accounts for the full journey.</p>
      </div>
      <div class="mt-10">
        <TransactionDecomposition />
      </div>
    </div>
  </section>

  <!-- 04 — AMAZON PROFITABILITY -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">PROFITABILITY</span>
          <h2 class="h2-md mt-4">Know what you actually make on Amazon.</h2>
          <p class="lead mt-5">
            Amazon sales are not Amazon profit. DeepEcom shows revenue after the deductions and supported costs your data carries — per order, product and channel.
          </p>
          <div class="mt-6">
            <a href="/platform/profitability" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline" style="text-underline-offset:0.2em">
              Explore Profitability →
            </a>
          </div>
        </div>
        <div class="reveal">
          <ProfitabilityPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- 05 — AMAZON PAYMENT RECONCILIATION -->
  <section>
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">RECONCILIATION</span>
          <h2 class="h2-md mt-4">Know what Amazon should have paid — and what you received.</h2>
          <p class="lead mt-5">
            Expected vs received, side by side, with every difference flagged. Nothing slips through unreconciled.
          </p>
          <div class="mt-6">
            <a href="/platform/payment-reconciliation" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline" style="text-underline-offset:0.2em">
              Explore Payment Reconciliation →
            </a>
          </div>
        </div>
        <div class="reveal">
          <ReconciliationPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — CHARGES & DEDUCTIONS -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.2fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">CHARGES &amp; DEDUCTIONS</span>
          <h2 class="h2-md mt-4">See what comes out before the money reaches you.</h2>
          <p class="lead mt-5">
            Gross sale, marketplace charges and supported deductions are kept separate, so the settlement and the receivable are clear in your books.
          </p>
        </div>
        <div class="reveal">
          <SettlementDecomposition />
        </div>
      </div>
    </div>
  </section>

  <!-- 07 — ORDER ACCOUNTING -->
  <section>
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">ORDER ACCOUNTING</span>
          <h2 class="h2-md mt-4">Account every Amazon order in detail.</h2>
          <p class="lead mt-5">
            Each order becomes a balanced journal — sales and output GST on one side, charges and receivable on the other — posted into your ERP.
          </p>
          <ul class="mt-6 flex flex-col gap-3.5">
            {
              [
                { t: "Order-wise entries", s: "Not summary totals" },
                { t: "GST split by head", s: "CGST, SGST, IGST" },
                { t: "Traceable to the order", s: "Every entry linked to its source" },
              ].map((x) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-lg bg-brand-50 text-brand-600">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                  <span class="text-sm leading-relaxed">
                    <b class="font-semibold text-ink-900">{x.t}.</b>{" "}
                    <span class="text-ink-500">{x.s}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="reveal">
          <ErpOutputVoucher />
        </div>
      </div>
    </div>
  </section>

  <!-- 08 — GST & TAX -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">GST &amp; TAX</span>
          <h2 class="h2-md mt-4">Keep the tax context inside the Amazon transaction.</h2>
          <p class="lead mt-5">
            Taxable value, GST by head and TCS/TDS stay with each order as it moves into accounting.
          </p>
        </div>
        <div class="reveal">
          <GstWiseAccounting />
        </div>
      </div>
    </div>
  </section>

  <!-- 09 — WAREHOUSE & INVENTORY -->
  <section>
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.05fr]">
        <div class="mt-8">
          <OrderInventoryCompare />
        </div>
        <div class="order-1 lg:order-2">
          <span class="eyebrow">WAREHOUSE &amp; INVENTORY</span>
          <h2 class="h2-md mt-4">Know where your Amazon inventory belongs.</h2>
          <p class="lead mt-5">
            Orders, inventory and stock are accounted warehouse-wise — with stock transfers posted between locations. This is inventory accounting, not a warehouse management system.
          </p>
        </div>
        
      </div>
    </div>
  </section>

  <!-- 10 — REPORTS -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">REPORTS</span>
          <h2 class="h2-md mt-4">Get the Amazon reports behind the numbers.</h2>
          <p class="lead mt-5">
            Sales, profitability, reconciliation and transactions — filtered, structured and ready to download.
          </p>
        </div>
        <div class="reveal">
          <ReportsPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- 11 — HOW IT WORKS -->
  <section id="how-it-works" class="section-band">
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">HOW IT WORKS</span>
        <h2 class="h2-md mt-4">Connect Amazon once. Start with a clearer financial view.</h2>
        <p class="lead mt-5">Five stages from Amazon data to detailed accounting in your ERP.</p>
      </div>
      <HowItWorksSteps
        steps={[
          { num: "01", label: "Connect", desc: "Connect supported Amazon marketplace data." },
          { num: "02", label: "Collect", desc: "Bring order, settlement and transaction data into DeepEcom." },
          { num: "03", label: "Understand", desc: "Turn raw marketplace data into structured business information." },
          { num: "04", label: "Reconcile", desc: "Compare expected and actual payments." },
          { num: "05", label: "Account", desc: "Generate detailed accounting and send it into the ERP." },
        ]}
      />
    </div>
  </section>

  <!-- 12 — PLATFORM + ERP -->
  <section>
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">ONE SYSTEM</span>
        <h2 class="h2-md mt-4">Understand your Amazon business. Then account for it.</h2>
        <p class="lead mt-5">
          The Platform helps you understand profitability and reconcile payments. The ERP Connector turns the same Amazon transaction layer into detailed accounting in your ERP.
        </p>
      </div>
      <div class="mt-10 reveal">
        <PlatformErpConnector />
      </div>
    </div>
  </section>

  <!-- 13 — WHO IT'S FOR -->
  <section class="section-band">
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">WHO IT'S FOR</span>
        <h2 class="h2-md mt-4">Built for Amazon businesses and the teams behind them.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {personaData.map((p) => (
          <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-card transition hover:border-ink-300 hover:shadow-md">
            <div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={p.icon} />
              </svg>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-600">{p.role}</span>
            <h3 class="mt-1 text-lg font-bold text-ink-900">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 14 — CUSTOMER PROOF -->
  <section>
    <div class="sec">
      <CustomerProof />
    </div>
  </section>

  <!-- 15 — FAQ -->
  <section class="section-band">
    <div class="sec-narrow">
      <span class="eyebrow">FAQ</span>
      <h2 class="h2-md mt-4">Amazon sellers, explained.</h2>
      <div class="mt-10 flex flex-col gap-3">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-q">{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 16 — FINAL CTA -->
  <section class="bg-gradient-to-br from-brand-600 to-brand-800 py-12 lg:py-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Know your Amazon business beyond the marketplace dashboard.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">
        Bring profitability, payment reconciliation, reporting and detailed accounting into one connected layer.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-lg transition hover:bg-ink-50">
          Book a Demo
          <ArrowRight size={16} />
        </a>
        <a href="/platform" class="inline-flex items-center gap-2 rounded-lg border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20">
          See the Platform →
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .faq-item {
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    background: #fff;
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .faq-item:hover {
    border-color: var(--ink-300);
  }
  .faq-q {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-800);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q::after {
    content: "+";
    flex: none;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--brand-600);
    transition: transform var(--transition-fast);
  }
  details[open] .faq-q::after {
    transform: rotate(45deg);
  }
  .faq-a {
    margin: 0;
    padding: 0 1.25rem 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-500);
  }
</style>