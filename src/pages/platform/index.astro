---
import PageLayout from "@/layouts/PageLayout.astro"
import PlatformHero from "@/components/pages/PlatformHero.astro"
import SectionHeading from "@/components/landing/section-heading.astro"
import PlatformCapabilities from "@/components/pages/PlatformCapabilities.astro"
import FragmentationVisual from "@/components/pages/FragmentationVisual.astro"
import ProfitabilityPanel from "@/components/pages/ProfitabilityPanel.astro"
import ReconciliationPanel from "@/components/pages/ReconciliationPanel.astro"
import MarketplaceCompare from "@/components/pages/MarketplaceCompare.astro"
import ReportsPanel from "@/components/pages/ReportsPanel.astro"
import HowItWorksSteps from "@/components/pages/HowItWorksSteps.astro"
import PlatformErpConnector from "@/components/pages/PlatformErpConnector.astro"
import CustomerProof from "@/components/pages/CustomerProof.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"

const personas = [
  {
    title: "Business Owners",
    desc: "See what you sold, what you earned and how every channel is performing.",
    icon: '<path d="M3 11 12 3l9 8M5 10v10h14V10"/>',
  },
  {
    title: "CFOs",
    desc: "Understand profitability, payments and business performance across channels.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    title: "Finance & Accounting Teams",
    desc: "Get a structured view of marketplace data and reconciliation.",
    icon: '<path d="M6 2h8l4 4v16H6zM14 2v4h4"/><path d="M8 7h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"/>',
  },
]

const faqs = [
  { q: "What is the DeepEcom Platform?", a: "DeepEcom Platform connects your marketplaces and turns fragmented marketplace data into a clear view of sales, profitability, payments and business performance." },
  { q: "Which marketplaces can connect to the Platform?", a: "The Platform supports supported ecommerce channels such as Amazon, Flipkart, Shopify and Meesho." },
  { q: "What does the Platform dashboard show?", a: "The dashboard brings together sales, orders, profitability, payment status and marketplace performance in one connected view." },
  { q: "How does DeepEcom calculate profitability?", a: "Profitability is shown as revenue after the supported deductions your marketplace data carries — so you see profit rather than just gross sales." },
  { q: "How does payment reconciliation work?", a: "The Platform compares the settlements you expect with what you actually received, and surfaces every difference." },
  { q: "Can I compare different marketplaces?", a: "Yes. Marketplace performance — sales, orders and profitability — can be compared across every channel you sell on." },
  { q: "Can I download reports?", a: "Yes. Structured reports on sales, orders, payments, profitability and reconciliation are available for export." },
  { q: "What kind of reports are available?", a: "Reports cover the Platform's supported areas — sales, orders, payments, profitability and reconciliation." },
  { q: "Can I see profitability across marketplaces?", a: "Yes. Profitability is visible per marketplace and consolidated across your channels." },
  { q: "Can I use the Platform without the ERP Connector?", a: "Yes. The Platform is a standalone product for understanding your business. The ERP Connector is a separate layer for accounting." },
  { q: "What is the difference between the Platform and ERP Connector?", a: "The Platform helps you understand what is happening in your ecommerce business. The ERP Connector turns the transaction layer into detailed accounting inside your ERP." },
  { q: "How does the Platform work with Tally, SAP and Zoho?", a: "Through the ERP Connector, which posts detailed ecommerce accounting into Tally, SAP or Zoho. The Platform itself focuses on business intelligence." },
]
---

<PageLayout
  title="Platform — Understand Your Ecommerce Business | DeepEcom"
  description="DeepEcom Platform connects your marketplaces and turns fragmented ecommerce data into one clear view of sales, profitability, payments and performance."
>
  <!-- 01 — HERO -->
  <PlatformHero />

  <!-- 02 — WHAT THE PLATFORM GIVES YOU -->
  <section class="section-band">
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">WHAT IT GIVES YOU</span>
        <h2 class="h2-md mt-4">Four answers, one connected view.</h2>
        <p class="lead mt-5">The Platform exists to answer the questions that matter when you sell across multiple marketplaces.</p>
      </div>
      <PlatformCapabilities />
    </div>
  </section>

  <!-- 03 — THE ECOMMERCE DATA PROBLEM -->
  <section>
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.25fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">THE PROBLEM</span>
          <h2 class="h2-md mt-4">Your ecommerce numbers live in too many places.</h2>
          <p class="lead mt-5">
            Every marketplace sends its own reports, its own settlement data and its own numbers. Sales, orders, returns, payments, fees and profitability arrive fragmented — and that fragmentation hides what your business is really doing.
          </p>
        </div>
        <div class="reveal">
          <FragmentationVisual />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — MARKETPLACE DATA → DEEPECOM -->
  <section class="section-band">
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">DATA FLOW</span>
        <h2 class="h2-md mt-4">Bring your marketplace data into one view.</h2>
        <p class="lead mt-5">Marketplace data in. A clear business view out.</p>
      </div>
      <div class="mt-10 grid reveal gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            { label: "Sales", sub: "Revenue across channels", icon: '<path d="M3 3v16a2 2 0 0 0 2 2h16M7 13l4-4 4 3 5-6"/>' },
            { label: "Orders", sub: "Volume and order context", icon: '<path d="M6 3h12a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2zM9 8h6M9 12h6"/>' },
            { label: "Payments", sub: "Settlements and payouts", icon: '<path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 9h18M16 14h.01"/>' },
            { label: "Returns", sub: "Returned orders and value", icon: '<path d="M21 12a9 9 0 1 1-2.6-6.3M21 3v6h-6"/>' },
            { label: "Fees", sub: "What marketplaces keep", icon: '<path d="M12 2 2 7l10 5 10-5-10-5zM2 12l10 5 10-5M2 17l10 5 10-5"/>' },
            { label: "Performance", sub: "Channel-level trends", icon: '<path d="M12 2 2 7l10 5 10-5-10-5z"/>' },
          ].map((d) => (
            <div class="flex items-start gap-3 rounded-xl border border-ink-200 bg-white p-4 shadow-card transition hover:border-ink-300 hover:shadow-md">
              <span class="mt-0.5 grid h-9 w-9 flex-none place-items-center rounded-lg bg-brand-50 text-brand-600">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={d.icon} /></svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-ink-800">{d.label}</span>
                <span class="mt-0.5 block text-xs text-ink-400">{d.sub}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 05 — PROFITABILITY -->
  <section>
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">PROFITABILITY</span>
          <h2 class="h2-md mt-4">Know what you actually make.</h2>
          <p class="lead mt-5">
            Sales isn't profit. The Platform shows revenue after the deductions your marketplace data carries — so you see what you genuinely earn, per marketplace and across your business.
          </p>
          <ul class="mt-6 flex flex-col gap-3.5">
            {
              [
                { t: "Profit after deductions", s: "Revenue minus fees and supported costs" },
                { t: "Per marketplace and product", s: "Know where you genuinely make money" },
                { t: "Gross never hides the picture", s: "The real margin is always in view" },
              ].map((x) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-lg bg-brand-50 text-brand-600">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                  <span class="text-sm leading-relaxed">
                    <b class="font-semibold text-ink-900">{x.t}.</b>{" "}
                    <span class="text-ink-500">{x.s}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 flex items-start gap-2.5 rounded-xl border border-ink-200 bg-white px-4 py-3 shadow-sm">
            <svg class="mt-0.5 flex-none text-brand-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 12v4"/></svg>
            <p class="text-sm leading-relaxed text-ink-600">
              Marketplace fees and deductions are the difference between looking profitable and being profitable — the Platform keeps both in view.
            </p>
          </div>
        </div>
        <div class="reveal">
          <ProfitabilityPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — PAYMENT RECONCILIATION -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">PAYMENT RECONCILIATION</span>
          <h2 class="h2-md mt-4">Reconcile every rupee you're owed.</h2>
          <p class="lead mt-5">
            The Platform compares the settlements you expect with what you actually receive, and flags every difference — so nothing slips through.
          </p>
          <ul class="mt-6 flex flex-col gap-3.5">
            {
              [
                { t: "Expected vs received", s: "Every settlement compared side by side" },
                { t: "Differences flagged", s: "Nothing unreconciled slips through" },
                { t: "Status at a glance", s: "Matched, difference and pending, clearly marked" },
              ].map((x) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-lg bg-brand-50 text-brand-600">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                  <span class="text-sm leading-relaxed">
                    <b class="font-semibold text-ink-900">{x.t}.</b>{" "}
                    <span class="text-ink-500">{x.s}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 flex items-start gap-2.5 rounded-xl border border-ink-200 bg-white px-4 py-3 shadow-sm">
            <svg class="mt-0.5 flex-none text-brand-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 12v4"/></svg>
            <p class="text-sm leading-relaxed text-ink-600">
              A single mismatched settlement can hide fees, returns or withholding — the Platform surfaces it before it reaches your books.
            </p>
          </div>
        </div>
        <div class="reveal">
          <ReconciliationPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- 07 — MARKETPLACE PERFORMANCE -->
  <section>
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.25fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">MARKETPLACE PERFORMANCE</span>
          <h2 class="h2-md mt-4">See how every channel is performing.</h2>
          <p class="lead mt-5">
            One business, multiple channels, one consolidated view — compare sales, orders and profitability across every marketplace you sell on.
          </p>
        </div>
        <div class="reveal">
          <MarketplaceCompare />
        </div>
      </div>
    </div>
  </section>

  <!-- 08 — REPORTS -->
  <section class="section-band">
    <div class="sec">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="max-w-lg reveal">
          <span class="eyebrow">REPORTS</span>
          <h2 class="h2-md mt-4">Turn your ecommerce data into the reports your business needs.</h2>
          <p class="lead mt-5">
            Structured, downloadable reports on sales, orders, payments, profitability and reconciliation — ready for your finance team.
          </p>
        </div>
        <div class="reveal">
          <ReportsPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- 09 — HOW THE PLATFORM WORKS -->
  <section id="how-it-works">
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">HOW IT WORKS</span>
        <h2 class="h2-md mt-4">From marketplace data to business clarity.</h2>
        <p class="lead mt-5">Five stages turn fragmented channel data into a view you can act on.</p>
      </div>
      <HowItWorksSteps
        steps={[
          { num: "01", label: "Connect", desc: "Connect your supported marketplaces." },
          { num: "02", label: "Collect", desc: "Bring marketplace data into DeepEcom." },
          { num: "03", label: "Structure", desc: "Organize the data into a consistent business view." },
          { num: "04", label: "Understand", desc: "Analyze profitability, payments and performance." },
          { num: "05", label: "Report", desc: "Download and use the resulting reports." },
        ]}
      />
    </div>
  </section>

  <!-- 10 — PLATFORM + ERP CONNECTOR -->
  <section class="section-band">
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">ONE SYSTEM</span>
        <h2 class="h2-md mt-4">Understand the business. Then account for it.</h2>
        <p class="lead mt-5">
          The Platform helps you understand what is happening across your ecommerce business. The ERP Connector takes the same transaction layer into detailed accounting inside your ERP.
        </p>
      </div>
      <div class="mt-12 reveal">
        <PlatformErpConnector />
      </div>
    </div>
  </section>

  <!-- 11 — WHO IT'S FOR -->
  <section>
    <div class="sec">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">WHO IT'S FOR</span>
        <h2 class="h2-md mt-4">Built for the people who need clarity on ecommerce numbers.</h2>
      </div>
      <div class="mt-10 grid reveal gap-6 md:grid-cols-3">
        {personas.map((p) => (
          <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-card transition hover:border-ink-300 hover:shadow-md">
            <div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={p.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-ink-900">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 12 — CUSTOMER PROOF -->
  <section class="section-band">
    <div class="sec">
      <CustomerProof />
    </div>
  </section>

  <!-- 13 — FAQ -->
  <section>
    <div class="sec-narrow">
      <span class="eyebrow">FAQ</span>
      <h2 class="h2-md mt-4">The Platform, explained.</h2>
      <div class="mt-8 flex flex-col gap-3 reveal">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-q">{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 14 — FINAL CTA -->
  <section class="bg-gradient-to-br from-brand-600 to-brand-800 py-12 lg:py-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Know what's happening in your ecommerce business.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">
        Connect your marketplaces and turn fragmented data into a clear view of profitability, payments and performance.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-lg transition hover:bg-ink-50">
          Book a Demo
          <ArrowRight size={16} />
        </a>
        <a href="/platform/dashboard" class="inline-flex items-center gap-2 rounded-lg border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20">
          Explore the Platform →
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .faq-item {
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    background: #fff;
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .faq-item:hover {
    border-color: var(--ink-300);
  }
  .faq-q {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-800);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q::after {
    content: "+";
    flex: none;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--brand-600);
    transition: transform var(--transition-fast);
  }
  details[open] .faq-q::after {
    transform: rotate(45deg);
  }
  .faq-a {
    margin: 0;
    padding: 0 1.25rem 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-500);
  }
</style>