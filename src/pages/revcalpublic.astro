---
import PageLayout from "@/layouts/PageLayout.astro"
import RevenueCalculator from "@/components/pages/revcalpublic/RevenueCalculator"
import SpApiGap from "@/components/pages/revcalpublic/SpApiGap.astro"
import CtaBand from "@/components/pages/shared/CtaBand.astro"
import { AMAZON_IN_SOURCES } from "@/data/amazon-fees"
import { FlaskConical, ShieldCheck } from "lucide-react"
---

<PageLayout
  title="Amazon Revenue Calculator — Prototype | DeepEcom"
  description="Compare Amazon Fulfilment, Easy Ship, Self Ship and Seller Flex on one order — referral fee, closing fee, weight handling and GST, estimated from Amazon India's public fee rate cards."
  noindex
>
  <header class="rv-head">
    <div class="mx-auto max-w-6xl px-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-[0.7rem] font-bold tracking-[0.14em] text-brand-600 uppercase">
        <FlaskConical size={12} />
        Prototype · Public data
      </span>
      <h1 class="mt-4 max-w-3xl text-3xl font-extrabold leading-[1.08] tracking-[-0.035em] text-ink-950 text-balance sm:text-4xl">
        Amazon revenue calculator, side by side.
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-500">
        Define a product and compare fulfilment options — referral fee, closing fee, weight handling, storage and GST —
        with the cost per unit, net proceeds, profit and margin for each.
      </p>
      <p class="mt-4 inline-flex items-start gap-2 text-[0.8125rem] leading-relaxed text-ink-500">
        <ShieldCheck size={15} className="mt-0.5 flex-none text-brand-500" />
        Estimates from Amazon.in's public rate cards. Exact per-order fees need your Seller Central account (SP-API).
      </p>
    </div>
  </header>

  <section id="calculator" class="pb-4">
    <div class="mx-auto max-w-6xl px-6">
      <RevenueCalculator client:load />
    </div>
  </section>

  <SpApiGap />

  <section class="pb-12 lg:pb-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="rounded-2xl border border-ink-200 bg-ink-50/60 p-5 sm:p-6">
        <span class="eyebrow">SOURCES &amp; METHOD</span>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-500">
          Referral fees follow Amazon.in's published rate card (effective 16 March). Closing fees follow the rate card
          effective September 7, 2026. Weight handling is modelled from Amazon's published worked examples (per 500 g,
          by zone). Storage uses the published ₹50/cu ft/month. Amazon applies 18% GST to all fees. Values marked
          <span class="mx-1 rounded border border-amber-200 bg-amber-50 px-1.5 py-px text-[10px] font-bold uppercase text-amber-700">est</span>
          are modelled from published examples; values marked
          <span class="mx-1 rounded border border-danger-200 bg-danger-50 px-1.5 py-px text-[10px] font-bold uppercase text-danger-700">SP-API</span>
          need your Seller Central account. Amazon's own note applies: fees are indicative and the final fee depends on
          category, size, weight, volumetric weight and additional services.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href={AMAZON_IN_SOURCES.feeSchedule} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline">
            Amazon.in fee schedule →
          </a>
          <a href={AMAZON_IN_SOURCES.referral} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline">
            Referral fee rate card →
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    dark
    title="Estimates are only the start."
    lead="DeepEcom connects marketplaces, reconciles payments and accounts every order in your ERP. Book a demo to see the real numbers."
  />
</PageLayout>

<style>
  .rv-head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(6.5rem, 12vh, 8.5rem) 0 clamp(2rem, 4vh, 3rem);
    background:
      radial-gradient(46rem 24rem at 76% -10%, rgba(33, 101, 236, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 8% -6%, rgba(164, 197, 255, 0.09), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
</style>