---
import PageLayout from "@/layouts/PageLayout.astro"
import IntegrationHero from "@/components/pages/integration/IntegrationHero.astro"
import FragmentationWall from "@/components/pages/integration/FragmentationWall.astro"
import ConnectedLayer from "@/components/pages/integration/ConnectedLayer.astro"
import ArchitectureMap from "@/components/pages/integration/ArchitectureMap.astro"
import EcosystemShowcase from "@/components/pages/integration/EcosystemShowcase.astro"
import AfterConnected from "@/components/pages/integration/AfterConnected.astro"
import OutcomeBlocks from "@/components/pages/integration/OutcomeBlocks.astro"
import HowItWorks from "@/components/pages/integration/HowItWorks.astro"
import PlatformErpCombo from "@/components/pages/integration/PlatformErpCombo.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import Navbar from "@/components/landing/site-nav"

const faqs = [
  {
    q: "What systems can I connect to DeepEcom?",
    a: "DeepEcom connects the systems verified on this page: marketplaces like Amazon, Flipkart, Shopify and Meesho, and ERPs like Tally, SAP and Zoho Books. The ecosystem is designed to grow — new connections are added based on what customers actually run on.",
  },
  {
    q: "Which marketplaces are supported?",
    a: "Amazon, Flipkart, Shopify and Meesho are supported today. Each marketplace sends its data into DeepEcom in its own format, and DeepEcom turns it into one consistent financial layer.",
  },
  {
    q: "Does DeepEcom integrate with payment gateways?",
    a: "Yes. DeepEcom connects payment settlement data so you can match what you expected to receive against what actually arrived — the core of the Payment Reconciliation product.",
  },
  {
    q: "Does DeepEcom connect with Tally?",
    a: "Yes. DeepEcom posts detailed ecommerce accounting into Tally — order-wise, GST-wise and warehouse-wise, including TCS/TDS and stock transfers.",
  },
  {
    q: "Does DeepEcom connect with SAP?",
    a: "Yes. DeepEcom structures ecommerce transactions into detailed accounting for SAP systems.",
  },
  {
    q: "Does DeepEcom connect with Zoho Books?",
    a: "Yes. DeepEcom accounts ecommerce transactions inside Zoho Books with the same detail and structure.",
  },
  {
    q: "What data flows into DeepEcom after a system is connected?",
    a: "Orders, settlements, fees, returns, inventory movement, taxes and payment records — the transaction data those systems already hold. DeepEcom doesn't ask you to re-enter anything.",
  },
  {
    q: "What happens after a system is connected?",
    a: "The data comes together, then it becomes useful: sales and profitability on the Platform dashboard, expected-vs-received reconciliation, reports, and detailed accounting through the ERP Connector.",
  },
  {
    q: "Does DeepEcom replace my ERP?",
    a: "No. DeepEcom is the layer that makes your ERP ecommerce-ready. Your ERP stays the system of record — DeepEcom puts the right ecommerce transactions into it, in detail.",
  },
  {
    q: "How is an integration different from ERP accounting?",
    a: "Connecting a system brings data in. Accounting is what DeepEcom does with it: classifying revenue, fees, taxes and payouts into correct, ERP-ready entries rather than a raw stream of records.",
  },
  {
    q: "Can I connect multiple systems at the same time?",
    a: "Yes. Most DeepEcom customers run several marketplaces and one ERP together. Every addition lands in the same financial layer, so nothing fragments as you grow.",
  },
  {
    q: "Does DeepEcom connect to shipping or logistics platforms?",
    a: "Not as a shipping or tracking platform. Shipping and logistics partners like Shiprocket, Delhivery, Ekart, Blue Dart and Xpressbees connect so fulfilment costs land in profitability and accounting — but DeepEcom doesn't generate or track shipments. If a specific logistics workflow matters to you, tell us.",
  },
  {
    q: "Are the integration details and data fields always up to date?",
    a: "Each integration page describes what that system connects and what DeepEcom does with the data. Capabilities are only listed where they're verified — nothing is advertised before it exists.",
  },
]
---

<PageLayout
  title="Ecommerce Integrations — DeepEcom"
  description="DeepEcom connects your marketplaces, shipping partners, payment gateways and ERP into one financial layer. Amazon, Flipkart, Shopify, Myntra, Tally, SAP, Zoho and more."
>

  <!-- 01 HERO -->
  <IntegrationHero />

  <!-- 02 PROBLEM / CHAOS -->
  <FragmentationWall />

  <!-- 03 THE CONNECTED LAYER -->
  <ConnectedLayer />

  <!-- 04 DEEPECOM ARCHITECTURE -->
  <ArchitectureMap />

  <!-- 05 INTEGRATION CATEGORIES -->
  <EcosystemShowcase />



  <!-- 13 PRODUCT OUTCOMES -->
  <OutcomeBlocks />

  <!-- 15 HOW IT WORKS -->
  <HowItWorks />

  <!-- 16 PLATFORM + ERP CONNECTOR -->




  <!-- 18 FAQ -->
  <section class="faq">
    <div class="sec-narrow">
      <span class="eyebrow eyebrow-center">FAQ</span>
      <h2 class="h2-md faq-title">Integration questions, answered.</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-q">{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 19 FINAL CTA -->
  <section class="ifinal">
    <div class="sec">
      <div class="ifinal-card">
        <h2 class="ifinal-title">Connect your business. Simplify your numbers.</h2>
        <p class="ifinal-lead">
          Bring the systems behind your ecommerce business into one connected financial layer.
        </p>
        <div class="ifinal-ctas">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo
          </a>
          <a href="/platform" class="ifinal-ghost">
            Explore Platform
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  /* Density pass — keep the 19-section rhythm but tighten vertical padding */
  :global(main .sec),
  :global(main .sec-narrow) {
    padding-block: clamp(1.75rem, 3.4vh, 3rem);
  }
:global(.after-flow),
    :global(.arch-map),
    :global(.fwall-canvas) {
      padding-top: clamp(1.25rem, 2vh, 2rem);
      padding-bottom: clamp(1.5rem, 3vh, 2.75rem);
    }

  /* ---------- FAQ ---------- */
  .faq { padding: clamp(1.5rem, 3vh, 2.5rem) 0; }
  .faq-title { margin-top: 0.8rem; text-align: center; }
  .faq-list {
    margin-top: 1.75rem;
    max-width: 46rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .faq-item {
    border: 1px solid var(--ink-200);
    border-radius: 0.9rem;
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .faq-item[open] {
    border-color: var(--brand-200);
    box-shadow: 0 8px 24px -12px rgba(83, 58, 253, 0.18);
  }
  .faq-q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-950);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-400);
    border-bottom: 2px solid var(--ink-400);
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform 0.2s ease, margin-top 0.2s ease;
  }
  .faq-item[open] .faq-q::after {
    transform: rotate(-135deg);
    margin-top: 3px;
  }
  .faq-q:hover { color: var(--brand-600); }
  .faq-a {
    padding: 0 1.15rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-500);
    max-width: 42rem;
  }

  /* ---------- final cta ---------- */
  .ifinal { padding: clamp(2rem, 4vh, 3rem) 0 clamp(4rem, 8vh, 6rem); }
  .ifinal-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    border-radius: 1.5rem;
    background:
      radial-gradient(60% 80% at 50% 0%, rgba(123, 98, 254, 0.35), transparent 70%),
      linear-gradient(150deg, #1e1560 0%, #2c1b8d 45%, #533afd 130%);
    padding: clamp(3rem, 7vw, 5rem) var(--space-gutter);
    color: #fff;
  }
  .ifinal-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(255,255,255,0.12) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 60% at 50% 0%, #000, transparent);
  }
  .ifinal-title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
    max-width: 44rem;
    margin-inline: auto;
    text-wrap: balance;
  }
  .ifinal-lead {
    margin: 1rem auto 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.75);
  }
  .ifinal-ctas {
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .ifinal-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 999px;
    padding: 0.65rem 1.4rem;
    transition: background 0.2s ease;
  }
  .ifinal-ghost:hover { background: rgba(255,255,255,0.1); }
</style>