---
import PageLayout from "@/layouts/PageLayout.astro"
import CtaBand from "@/components/pages/shared/CtaBand.astro"
import { FREE_TOOLS } from "@/data/tools"
import { Wrench, ArrowRight, Clock } from "lucide-react"

const live = FREE_TOOLS.filter((t) => t.status === "live")
const planned = FREE_TOOLS.filter((t) => t.status === "planned")
---

<PageLayout
  title="Free Ecommerce Tools — Calculators for Amazon & Meesho Sellers | DeepEcom"
  description="Free tools for ecommerce sellers: Amazon fee and revenue calculator, Meesho shipping-label cropper, GST, reconciliation and ERP previews. No sign-up."
>
  <header class="rv-head">
    <div class="mx-auto max-w-6xl px-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-[0.7rem] font-bold tracking-[0.14em] text-brand-600 uppercase">
        <Wrench size={12} />
        Free tools · No sign-up
      </span>
      <h1 class="mt-4 max-w-3xl text-3xl font-extrabold leading-[1.08] tracking-[-0.035em] text-ink-950 text-balance sm:text-4xl">
        Free tools for ecommerce sellers.
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-500">
        Calculators and utilities built from the same fee data and accounting logic
        that powers DeepEcom — free to use, private by default, no account needed.
      </p>
    </div>
  </header>

  <section class="pb-4">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-4 sm:grid-cols-2">
        {live.map((t) => (
          <a
            href={t.href ?? "/tools"}
            class="group rounded-2xl border border-ink-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md sm:p-6"
          >
            <div class="flex items-center gap-2">
              <span class="rounded border border-emerald-200 bg-emerald-50 px-1.5 py-px text-[10px] font-bold uppercase text-emerald-700">Live</span>
              <span class="text-[11px] font-medium text-ink-400">{t.tier}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold text-ink-950">{t.name}</h2>
            <p class="mt-1 text-sm font-semibold text-brand-600">{t.tagline}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{t.description}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              Open tool <ArrowRight size={15} class="transition group-hover:translate-x-0.5" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-12 lg:pb-16">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-lg font-bold text-ink-950">Coming soon</h2>
      <p class="mt-1 max-w-2xl text-sm text-ink-500">
        More calculators and reconciliation utilities are on the way. Each one ships here first.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {planned.map((t) => (
          <div class="rounded-2xl border border-ink-200 bg-ink-50/50 p-5">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 rounded border border-ink-200 bg-white px-1.5 py-px text-[10px] font-bold uppercase text-ink-500">
                <Clock size={10} /> Planned
              </span>
            </div>
            <h3 class="mt-3 text-base font-bold text-ink-900">{t.name}</h3>
            <p class="mt-1 text-[13px] leading-relaxed text-ink-500">{t.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    dark
    title="Tools are only the start."
    lead="DeepEcom connects marketplaces, reconciles payments and accounts every order in your ERP. Book a demo to see the real numbers."
  />
</PageLayout>

<style>
  .rv-head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(6.5rem, 12vh, 8.5rem) 0 clamp(2rem, 4vh, 3rem);
    background:
      radial-gradient(46rem 24rem at 76% -10%, rgba(33, 101, 236, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 8% -6%, rgba(164, 197, 255, 0.09), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
</style>
