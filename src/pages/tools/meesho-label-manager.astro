---
import PageLayout from "@/layouts/PageLayout.astro"
import LabelManager from "@/components/pages/meesho-label-manager/LabelManager"
import CtaBand from "@/components/pages/shared/CtaBand.astro"
import { ScanBarcode, ShieldCheck } from "lucide-react"
---

<PageLayout
  title="Meesho Label Manager — Crop, Split & Print Shipping Labels | DeepEcom"
  description="Upload your Meesho shipping-label PDF and get print-ready 4×6 labels in seconds. Auto-detect, split, crop and resize — free, unlimited, 100% private in your browser."
  noindex
>
  <header class="ml-head">
    <div class="mx-auto max-w-6xl px-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-[0.7rem] font-bold tracking-[0.14em] text-brand-600 uppercase">
        <ScanBarcode size={12} />
        Free tool · No sign-up
      </span>
      <h1 class="mt-4 max-w-3xl text-3xl font-extrabold leading-[1.08] tracking-[-0.035em] text-ink-950 text-balance sm:text-4xl">
        Meesho labels, print-ready in seconds.
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-500">
        Upload the shipping-label PDF from your Meesho supplier panel. We detect each
        label, split it from the invoice, crop the whitespace and size it for your
        printer — 4×6 thermal or A4 sheets. Sort by courier or SKU, add a SKU-qty
        overlay, and export the invoices or a picklist as separate PDFs.
      </p>
      <p class="mt-4 inline-flex items-start gap-2 text-[0.8125rem] leading-relaxed text-ink-500">
        <ShieldCheck size={15} className="mt-0.5 flex-none text-brand-500" />
        Everything runs in your browser. Your PDF never leaves your device.
      </p>
    </div>
  </header>

  <section id="tool" class="pb-4">
    <div class="mx-auto max-w-6xl px-6">
      <LabelManager client:only="react" />
    </div>
  </section>

  <section class="pb-12 lg:pb-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="rounded-2xl border border-ink-200 bg-ink-50/60 p-5 sm:p-6">
        <span class="eyebrow">HOW IT WORKS</span>
        <div class="mt-3 grid gap-4 text-sm leading-relaxed text-ink-500 sm:grid-cols-3">
          <p><strong class="text-ink-800">1. Upload.</strong> Download the label PDF from your Meesho supplier panel and drop it above.</p>
          <p><strong class="text-ink-800">2. Choose your output.</strong> A4 sheets with cut guides, 4×6 thermal pages, or both plus a separate invoices PDF and picklist.</p>
          <p><strong class="text-ink-800">3. Download or print.</strong> Preview every label, download the processed PDF, print at 100% scale.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    dark
    title="Labels are only the start."
    lead="DeepEcom connects marketplaces, reconciles payments and accounts every order in your ERP. Book a demo to see the real numbers."
  />
</PageLayout>

<style>
  .ml-head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(6.5rem, 12vh, 8.5rem) 0 clamp(2rem, 4vh, 3rem);
    background:
      radial-gradient(46rem 24rem at 76% -10%, rgba(33, 101, 236, 0.12), transparent 60%),
      radial-gradient(34rem 18rem at 8% -6%, rgba(164, 197, 255, 0.09), transparent 55%),
      linear-gradient(180deg, var(--ink-50) 0%, #ffffff 100%);
  }
</style>
