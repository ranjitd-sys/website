---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Navigation from "@/components/navigation/Navigation.astro"
import Footer from "@/components/Footer.astro"

// Read and parse session cookie
const sessionCookie = Astro.cookies.get("user_session")?.value;
const user = sessionCookie ? JSON.parse(sessionCookie) : null;

const chapters = [
  { id: "01", title: "Introduction to Effect", description: "Why Effect exists and the problems it solves", isLocked: false },
  { id: "02", title: "Effect Basics", description: "Constructing, running, and composing basic Effects", isLocked: !user },
  { id: "03", title: "Error Management", description: "Expected vs unexpected errors and typed channels", isLocked: !user },
]
---

<BaseLayout title="Effect Institute" description="Effect lessons.">
  <div class="min-h-screen bg-black font-mono text-xs text-zinc-100">
    <div class="mx-auto max-w-2xl border-x border-zinc-900 bg-black min-h-screen flex flex-col justify-between">
      
      <div>
        <Navigation activeSlug="institute" />

        <!-- Sub-Header / User State -->
        <header class="flex items-center justify-between border-b border-zinc-900 px-4 py-2.5 uppercase">
          <a href="/" class="font-semibold tracking-widest text-zinc-200">EFFECT INSTITUTE</a>
          
          {user ? (
            <div class="flex items-center gap-2">
              <img src={user.avatar} alt={user.login} class="h-4 w-4 rounded-full border border-zinc-700" />
              <span class="text-[11px] text-zinc-300">@{user.login}</span>
              <a href="/api/auth/logout" class="text-zinc-500 hover:text-red-400 ml-2">LOGOUT</a>
            </div>
          ) : (
            <a href="/api/auth/github" class="flex items-center gap-1.5 text-[11px] text-zinc-400 hover:text-white transition-colors">
              <span>📌</span> SIGN IN
            </a>
          )}
        </header>

        <!-- Dynamic Join / Welcome Bar -->
        <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-900 px-4 py-4 bg-black">
          <div>
            <h1 class="text-xs font-medium text-zinc-100">
              {user ? `Welcome back, ${user.name}` : "Strange, semi-interactive Effect lessons"}
            </h1>
            <p class="mt-0.5 text-[11px] text-zinc-500">
              {user ? "All chapters are now unlocked for your account." : "Sign in with GitHub to unlock all lessons."}
            </p>
          </div>
          
          {!user && (
            <a 
              href="/api/auth/github" 
              class="inline-flex items-center justify-center gap-2 bg-white px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-wider text-black transition-all hover:bg-zinc-200"
            >
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              JOIN US
            </a>
          )}
        </section>

        <!-- Chapters List with Dynamic Lock Icons -->
        <main class="divide-y divide-zinc-900 border-b border-zinc-900">
          {chapters.map((chapter) => (
            <a 
              href={chapter.isLocked ? "/api/auth/github" : `/lessons/${chapter.id}`}
              class="group flex items-center justify-between px-4 py-3.5 hover:bg-zinc-900/40 transition-colors"
            >
              <div>
                <h2 class="text-xs font-medium text-zinc-200 group-hover:text-white">
                  {chapter.id}. {chapter.title}
                </h2>
                <p class="mt-0.5 text-[11px] text-zinc-500">{chapter.description}</p>
              </div>

              <div class="shrink-0">
                {chapter.isLocked ? (
                  <span class="text-zinc-600 text-xs">🔒</span>
                ) : (
                  <span class="text-emerald-500 text-xs">🔓</span>
                )}
              </div>
            </a>
          ))}
        </main>
      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>