---
import PageLayout from "@/layouts/PageLayout.astro"
import CtaBand from "@/components/pages/CtaBand.astro"
import Breadcrumbs from "@/components/resources/Breadcrumbs.astro"
import ResourceSearch from "@/components/resources/ResourceSearch.astro"
import { GUIDES } from "@/data/resources/guides"
import { buildSearchIndex } from "@/data/resources/index"
import "@/styles/resources.css"
import { ArrowUpRight } from "lucide-react"

const searchIndex = buildSearchIndex()
---

<PageLayout
  title="Guides — Work through ecommerce accounting with your own data | DeepEcom"
  description="End-to-end guides on ecommerce accounting, marketplaces reconciliation, GST and TCS/TDS, marketplace profitability and making your ERP ecommerce-ready."
>
  <header class="rs-hero">
    <div class="rs-container">
      <Breadcrumbs crumbs={[{ label: "Resources", href: "/resources" }, { label: "Guides" }]} />
      <h1 class="rs-hero-title">Guides, not overviews.</h1>
      <p class="rs-hero-lead">
        Structured, end-to-end walkthroughs you can work through with your own orders and
        settlements — from the event map of an order through to posting in Tally, SAP or Zoho.
      </p>
      <div class="rs-hero-actions">
        <ResourceSearch items={searchIndex} placeholder="Search the guides…" />
      </div>
    </div>
  </header>

  <main>
    <section class="rs-section-tight">
      <div class="rs-container">
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem">
          {GUIDES.map((g, i) => (
            <article class="rs-card" style="display:flex;gap:0.85rem;padding:1.4rem">
              <div class="rs-card-head">
                <span class="rs-card-chip">{g.topic}</span>
                <ArrowUpRight class="rs-card-arrow" width={16} height={16} />
              </div>
              <h2 class="rs-card-title">
                <a href={`/resources/guides/${g.id}`} style="text-decoration:none;color:inherit">
                  {g.title}
                </a>
              </h2>
              <p class="rs-card-desc">{g.description}</p>

              <ol style="margin:0.25rem 0 0;padding-left:1.1rem;display:flex;flex-direction:column;gap:0.3rem">
                {g.chapters.slice(0, 5).map((c, j) => (
                  <li style="font-size:0.82rem;color:var(--ink-500);line-height:1.45">
                    {j < g.chapters.length - 1 ? c : `${c} …`}
                  </li>
                ))}
              </ol>

              <span class="rs-card-meta" style="margin-top:auto">
                {g.level} · {g.readingTime} · {g.chapters.length} chapters
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="rs-section">
      <div class="rs-container">
        <div class="rs-split" style="grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr)">
          <div>
            <p class="rs-head-eyebrow">Suggested order</p>
            <h2 class="rs-head-title">A sensible reading path</h2>
            <p class="rs-head-lead">
              If you are new to ecommerce accounting, start with the foundation guide and
              follow the arrows. Each guide builds on the one before it.
            </p>
          </div>
          <ol style="display:flex;flex-direction:column;gap:0.65rem;list-style:none;padding:0;margin:0">
            {[
              { label: "Ecommerce accounting for marketplaces", href: "/resources/guides/ecommerce-accounting", meta: "Start here" },
              { label: "Reconciling marketplace payments and payouts", href: "/resources/guides/payment-reconciliation", meta: "Then" },
              { label: "GST for ecommerce marketplaces", href: "/resources/guides/gst-for-ecommerce", meta: "Then" },
              { label: "Measuring true marketplace profitability", href: "/resources/guides/marketplace-profitability", meta: "Then" },
              { label: "Making your ERP ecommerce-ready", href: "/resources/guides/erp-integration", meta: "Finish" },
            ].map((s) => (
              <li>
                <a class="rs-topic-link" href={s.href}>
                  <strong>{s.label}</strong>
                  <span>{s.meta}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </main>

  <CtaBand
    dark
    title="Reading is good. Seeing it on your data is better."
    lead="Book a demo and we'll run a guide's worth of your real orders through DeepEcom."
  />
</PageLayout>