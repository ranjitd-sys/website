---
import PageLayout from "@/layouts/PageLayout.astro"
import CtaBand from "@/components/pages/shared/CtaBand.astro"
import ResourceSearch from "@/components/resources/ResourceSearch.astro"
import ResourceGrid, { type GridChip } from "@/components/resources/ResourceGrid.astro"
import ResourceCard from "@/components/resources/ResourceCard.astro"
import Breadcrumbs from "@/components/resources/Breadcrumbs.astro"
import { POSTS_CATALOG, HUBS_CATALOG, buildSearchIndex } from "@/data/resources/index"
import "@/styles/resources.css"
import { Rss } from "lucide-react"

const searchIndex = buildSearchIndex()

const categories: string[] = []
for (const p of POSTS_CATALOG) {
  if (!categories.includes(p.category)) categories.push(p.category)
}

const chips: GridChip[] = [
  { id: "all", label: "All" },
  ...categories.map((c) => ({ id: c, label: c, field: "data-category" })),
]
---

<PageLayout
  title="Blog — Ecommerce accounting and ERP notes | DeepEcom"
  description="Posts on order-wise accounting, marketplace charges, payment reconciliation, GST, TCS and TDS, inventory and ERP integration for ecommerce finance teams."
>
  <header class="rs-hero">
    <div class="rs-container">
      <Breadcrumbs crumbs={[{ label: "Resources", href: "/resources" }, { label: "Blog" }]} />
      <h1 class="rs-hero-title">The DeepEcom Blog</h1>
      <p class="rs-hero-lead">
        Focused notes on ecommerce finance: how one order becomes many accounting events,
        why settlements never match, where TCS and TDS hide, and how it all lands in an ERP.
      </p>
      <div class="rs-hero-actions">
        <ResourceSearch items={searchIndex} placeholder="Search the blog…" />
        <a class="btn btn-secondary" href="/resources/blog/rss.xml" style="padding-block:0.8rem;display:inline-flex;align-items:center;gap:0.45rem">
          <Rss width={15} height={15} />
          RSS
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="rs-section-tight" style="padding-bottom:0">
      <div class="rs-container">
        <ResourceGrid
          items={POSTS_CATALOG}
          chips={chips}
          featuredId="why-ecommerce-accounting-is-different"
        />
      </div>
    </section>

    <section class="rs-section">
      <div class="rs-container">
        <div class="rs-head">
          <p class="rs-head-eyebrow">Topics</p>
          <h2 class="rs-head-title">Deep-dive hubs by subject</h2>
          <p class="rs-head-lead">
            Each hub explains one area end-to-end, with tables, flows and guides you can
            work through.
          </p>
        </div>
        <div class="rs-grid cols-4">
          {HUBS_CATALOG.map((h) => (
            <ResourceCard item={h} />
          ))}
        </div>
      </div>
    </section>
  </main>

  <CtaBand
    dark
    title="Prefer talking to a human?"
    lead="Book a demo and we'll walk through the same concepts against your actual marketplace data."
  />
</PageLayout>