---
import PageLayout from "@/layouts/PageLayout.astro"
import CtaBand from "@/components/pages/CtaBand.astro"
import Breadcrumbs from "@/components/resources/Breadcrumbs.astro"
import FlowDiagram, { type FlowStage } from "@/components/resources/FlowDiagram.astro"
import HubTable from "@/components/resources/HubTable.astro"
import ResourceCard from "@/components/resources/ResourceCard.astro"
import { resourcesForTopic } from "@/data/resources/index"
import "@/styles/resources.css"
import { ArrowUpRight } from "lucide-react"

const related = resourcesForTopic("reconciliation")

const flow: FlowStage[] = [
  { label: "1", title: "Expected", sub: "Order receivables", highlight: true },
  { label: "2", title: "Settled", sub: "Settlement statement" },
  { label: "3", title: "Matched", sub: "Order ↔ settlement" },
  { label: "4", title: "Received", sub: "Bank deposits" },
  { label: "5", title: "Explained", sub: "Zero unexplained residue", highlight: true },
]

const topics = [
  { id: "why", title: "Why settlements don't match", desc: "Orders, charges, refunds and taxes arrive at different times." },
  { id: "match-orders", title: "Matching orders to settlements", desc: "Linking settlement lines back to the orders they belong to." },
  { id: "match-bank", title: "Matching settlements to bank", desc: "Payouts, splits and payment-processing differences." },
  { id: "matching", title: "The reconciled position", desc: "Receivables, settlements and bank in agreement." },
]
---

<PageLayout
  title="Payment Reconciliation — Expected, settled and received, in agreement | DeepEcom"
  description="How marketplace payment reconciliation works: matching orders to settlements and settlements to bank deposits until receivables, settlements and payouts agree with nothing unexplained."
>
  <header class="rs-hero">
    <div class="rs-container">
      <Breadcrumbs crumbs={[{ label: "Resources", href: "/resources" }, { label: "Reconciliation" }]} />
      <h1 class="rs-hero-title">Payment reconciliation, demystified.</h1>
      <p class="rs-hero-lead">
        A settlement pools many orders into one net payment. Reconciliation is the
        discipline of closing the gap between what you expected, what was settled and
        what actually reached your bank — until nothing is left unexplained.
      </p>
      <div class="rs-hero-actions">
        <a class="btn btn-primary" href="/resources/guides/payment-reconciliation">Read the reconciliation guide</a>
        <a class="btn btn-secondary" href="/platform/payment-reconciliation">Explore the feature</a>
      </div>
    </div>
  </header>

  <main>
    <section class="rs-section">
      <div class="rs-container">
        <div class="rs-head">
          <p class="rs-head-eyebrow">The position</p>
          <h2 class="rs-head-title">Three numbers, one answer</h2>
          <p class="rs-head-lead">
            Reconciliation moves through five states. Each one is a checkable position,
            not a judgement call.
          </p>
        </div>
        <FlowDiagram stages={flow} caption="From expected receivables to a reconciled position" />
      </div>
    </section>

    <hr class="rs-rule" />

    <section class="rs-section" id="why">
      <div class="rs-container">
        <div class="rs-split">
          <div>
            <p class="rs-head-eyebrow">Why it's hard</p>
            <h2 class="rs-head-title">Most gaps are timing and classification</h2>
            <p class="rs-head-lead">
              Rarely is a difference a mystery "loss". Fees appear in settlements, refunds
              arrive weeks later, TDS is withheld at payout, and marketplaces correct
              prior periods. Each is explainable — once you can see it.
            </p>
          </div>
          <div>
            <HubTable
              head={["Difference", "Cause"]}
              rows={[
                ["Unanticipated fees", "Charges appear in settlements, not in the order feed"],
                ["Refunds and reversals", "Returns arrive after the original settlement"],
                ["TCS / TDS", "Tax withheld per marketplace rules"],
                ["Payment processing", "Bank-level differences on the payout"],
                ["Corrections", "Marketplace adjusts prior-period amounts"],
                ["Settlement lags", "Orders settle in a later period than the sale"],
              ]}
            />
          </div>
        </div>
      </div>
    </section>

    <hr class="rs-rule" />

    <section class="rs-section" id="matching">
      <div class="rs-container">
        <div class="rs-head">
          <p class="rs-head-eyebrow">The matching</p>
          <h2 class="rs-head-title">Two matches close the loop</h2>
        </div>
        <div class="rs-split" style="align-items:start">
          <div>
            <h3 style="font-size:1.05rem;font-weight:600;color:var(--ink-900);margin:0 0 0.6rem" id="match-orders">
              Order → settlement
            </h3>
            <HubTable
              head={["Settlement line", "Matches to"]}
              rows={[
                ["Order value", "Expected sales per order"],
                ["Commission and fees", "Charge lines per order"],
                ["Refund value", "Reversal of prior entries"],
                ["TCS / TDS", "Tax positions per order"],
                ["Net amount", "The settlement total"],
              ]}
            />
          </div>
          <div>
            <h3 style="font-size:1.05rem;font-weight:600;color:var(--ink-900);margin:0 0 0.6rem" id="match-bank">
              Settlement → bank
            </h3>
            <p style="font-size:0.9rem;color:var(--ink-600);line-height:1.6">
              Payouts are matched against bank deposits, handling splits across periods
              and currencies and payment-processing differences — until the deposited
              cash reconciles to its settlements.
            </p>
            <p class="rs-callout" style="margin-top:0.75rem">
              The goal is not zero difference. It is a difference that is fully explained,
              bucketed by cause, and reviewable.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="rs-section-tight">
      <div class="rs-container">
        <div class="rs-head" style="margin-bottom:1rem">
          <p class="rs-head-eyebrow">Go deeper</p>
          <h2 class="rs-head-title">Related resources</h2>
        </div>
        <div class="rs-grid cols-3">
          {related.map((r) => (
            <ResourceCard item={r} />
          ))}
        </div>
      </div>
    </section>
  </main>

  <CtaBand
    dark
    title="See your own settlements reconciled."
    lead="Connect a marketplace and watch expected, settled and received come to a position."
  />
</PageLayout>