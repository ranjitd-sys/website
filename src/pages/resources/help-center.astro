---
import PageLayout from "@/layouts/PageLayout.astro"
import CtaBand from "@/components/pages/CtaBand.astro"
import Breadcrumbs from "@/components/resources/Breadcrumbs.astro"
import ResourceSearch from "@/components/resources/ResourceSearch.astro"
import { HELP_GROUPS, HELP_HERO } from "@/data/resources/help"
import { buildSearchIndex } from "@/data/resources/index"
import "@/styles/resources.css"
import { ArrowUpRight } from "lucide-react"

const searchIndex = buildSearchIndex()
---

<PageLayout
  title="Help Center — Documentation for DeepEcom Platform and ERP Connector | DeepEcom"
  description="Help Center documentation: connect marketplaces, understand dashboards and profitability, reconcile payments, and post order-wise, GST-wise, warehouse-wise accounting into Tally, SAP and Zoho."
>
  <header class="rs-hero">
    <div class="rs-container">
      <Breadcrumbs crumbs={[{ label: "Resources", href: "/resources" }, { label: "Help Center" }]} />
      <h1 class="rs-hero-title">Help Center</h1>
      <p class="rs-hero-lead">
        Documentation for getting started, the Platform, the ERP Connector, integrations
        and billing — written for the person actually using it.
      </p>
      <div class="rs-hero-actions">
        <ResourceSearch items={searchIndex} placeholder="Search documentation, e.g. “Tally” or “reconcile”…" />
      </div>
    </div>
  </header>

  <main>
    <section class="rs-section-tight">
      <div class="rs-container">
        <p class="rs-head-eyebrow">Start here</p>
        <div class="rs-quick">
          {HELP_HERO.map((h) => (
            <a href={h.href}>
              <span>{h.title}</span>
              <span>{h.description}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rs-section">
      <div class="rs-container">
        <div class="rs-doc-layout">
          <nav class="rs-doc-sidebar" aria-label="Documentation">
            {HELP_GROUPS.map((g) => (
              <div class="rs-doc-sidebar-group">
                <span class="rs-doc-sidebar-group-title">{g.label}</span>
                {g.items.map((item) => (
                  <a href={item.href}>{item.title}</a>
                ))}
              </div>
            ))}
          </nav>

          <div class="rs-doc-content">
            {HELP_GROUPS.map((g) => (
              <div style="margin-bottom:2.5rem" id={g.id}>
                <div class="rs-head" style="margin-bottom:1rem">
                  <p class="rs-head-eyebrow">{g.label}</p>
                  <h2 class="rs-head-title" style="font-size:1.4rem">{g.description}</h2>
                </div>
                <div class="rs-doc-grid">
                  {g.items.map((item) => (
                    <a class="rs-topic-link" href={item.href} style="align-items:flex-start;padding:1.1rem 1.2rem;flex-direction:column;gap:0.5rem">
                      <strong style="font-size:1rem">{item.title}</strong>
                      <span>{item.description}</span>
                      <ArrowUpRight width={16} height={16} />
                    </a>
                  ))}
                </div>
              </div>
            ))}

            <hr class="rs-rule" style="margin-block:1.5rem" />

            <div class="rs-callout">
              <strong>Can't find an answer?</strong> Check the <a href="/resources/faqs">FAQs</a>,
              or <a href="/contact">contact the DeepEcom team</a> directly — we answer
              integration, reconciliation and posting questions daily.
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <CtaBand
    dark
    title="Help is one conversation away."
    lead="Book a demo, or ask a question about your marketplaces, ERP and data."
  />
</PageLayout>