---
import PageLayout from "@/layouts/PageLayout.astro"
import PageHero from "@/components/pages/PageHero.astro"
import FeatureGrid from "@/components/pages/FeatureGrid.astro"
import CtaBand from "@/components/pages/CtaBand.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"
---

<PageLayout
  title="JioMart Seller Accounting — DeepEcom"
  description="Connect JioMart seller data with DeepEcom — channel profitability, payment reconciliation and detailed ERP accounting alongside your other marketplaces."
>
  <PageHero
    eyebrow="INTEGRATIONS · JIOMART"
    title="JioMart, in the same financial picture."
    lead="DeepEcom connects your JioMart seller data and brings orders, settlements and fees into the same intelligence, reconciliation and accounting layer as your other channels."
  >
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/contact" class={buttonVariants({ size: "lg" })}>
        Book a Demo
        <ArrowRight size={16} />
      </a>
      <a href="/integrations/marketplaces" class={buttonVariants({ variant: "outline", size: "lg" })}>
        All Marketplaces
      </a>
    </div>
  </PageHero>

  <FeatureGrid
    eyebrow="JIOMART · CAPABILITIES"
    title="What DeepEcom handles for JioMart sellers."
    lead="Channel data aggregated into the same connected layer as your other marketplaces."
    features={[
      { title: "Settlement Reconciliation", description: "Match JioMart settlements to your bank and flag discrepancies.", icon: "wallet" },
      { title: "Fee Extraction", description: "Commissions, shipping and other charges, line by line.", icon: "receipt" },
      { title: "GST & TCS/TDS", description: "Output GST and withholding tax, accounted correctly.", icon: "calculator" },
      { title: "Order-wise Accounting", description: "Every order accounted individually, ERP-ready.", icon: "layers" },
      { title: "Channel Profitability", description: "Compare JioMart against your other marketplace channels.", icon: "trend" },
      { title: "ERP Posting", description: "Detailed entries posted into Tally, SAP or Zoho.", icon: "building" },
    ]}
    columns={3}
    center
  />

  <CtaBand
    title="Add JioMart to your financial picture."
    lead="See how DeepEcom brings JioMart into the same layer as your other channels."
  />
</PageLayout>