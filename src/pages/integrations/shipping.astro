---
import PageLayout from "@/layouts/PageLayout.astro"
import PageHero from "@/components/pages/PageHero.astro"
import FeatureGrid from "@/components/pages/FeatureGrid.astro"
import CtaBand from "@/components/pages/CtaBand.astro"
import SectionHeading from "@/components/landing/section-heading.astro"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight } from "lucide-react"

const partners = [
  { name: "Shiprocket", desc: "Shipping partner data into fulfilment cost visibility" },
  { name: "Delhivery", desc: "Fulfilment costs reflected in profitability and accounting" },
  { name: "Ekart", desc: "Marketplace logistics data into cost visibility" },
  { name: "Blue Dart", desc: "Express shipping costs connected to their orders" },
  { name: "Xpressbees", desc: "Fulfilment and logistics costs into the financial picture" },
]
---

<PageLayout
  title="Shipping Partner Integrations — DeepEcom"
  description="Connect shipping and logistics partner data with DeepEcom so fulfilment costs land in profitability and accounting, tied to their orders."
>
  <PageHero
    eyebrow="INTEGRATIONS · SHIPPING"
    title="Fulfilment costs, tied to the orders they belong to."
    lead="DeepEcom connects your shipping partners so logistics, courier and fulfilment costs show up in the same profitability and accounting picture as the orders they serve."
  >
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/contact" class={buttonVariants({ size: "lg" })}>
        Book a Demo
        <ArrowRight size={16} />
      </a>
      <a href="/integrations" class={buttonVariants({ variant: "outline", size: "lg" })}>
        All Integrations
      </a>
    </div>
  </PageHero>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow="SHIPPING PARTNERS"
      title="Shipping data, in one financial layer."
      lead="Each shipping partner reports fulfilment costs differently. DeepEcom ties them to their orders so you see true delivered profit."
      center
    />
    <div class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
      {
        partners.map((p) => (
          <div class="flex items-start gap-4 rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-sm font-bold text-brand-600">
              {p.name[0]}
            </span>
            <span>
              <span class="flex items-center gap-2 text-lg font-semibold tracking-tight text-ink-900">
                {p.name}
              </span>
              <span class="mt-1 block text-sm text-muted-foreground">{p.desc}</span>
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <FeatureGrid
    eyebrow="CAPABILITIES"
    title="Fulfilment costs, accounted correctly."
    lead="Shipping data becomes part of the same financial layer as sales and settlements."
    features={[
      { title: "Cost Visibility", description: "Courier and fulfilment costs surfaced per order and channel.", icon: "truck" },
      { title: "Profitability", description: "True delivered profit per order, SKU and marketplace.", icon: "trend" },
      { title: "Accounting", description: "Shipping costs classified correctly into ERP-ready entries.", icon: "receipt" },
      { title: "ERP Posting", description: "Fulfilment expenses posted into Tally, SAP or Zoho.", icon: "building" },
    ]}
    columns={4}
    center
  />

  <CtaBand
    title="See fulfilment costs in your real numbers."
    lead="A single financial view that includes what it really cost to deliver."
  />
</PageLayout>