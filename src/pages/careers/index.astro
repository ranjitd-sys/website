---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/navigation/Navigation.astro";
import Footer from "@/components/Footer.astro";
import { parseSignedSession } from "@/lib/session";

// Parse user session cookie
const user = parseSignedSession(Astro.cookies.get("user_session")?.value);

const isPhase1Done = user?.phase1Completed ?? false;
const analysisStatus = user?.analysisStatus || "idle";
const isRepoLinked = Boolean(user?.selectedRepo);
---

<BaseLayout title="Careers & Institute" description="Master our stack. Join the team.">
  <div class="min-h-screen bg-black text-zinc-100 font-mono text-xs selection:bg-zinc-800 selection:text-emerald-400">
    
    <!-- Outer Container -->
    <div class="mx-auto max-w-4xl border-x border-zinc-900 shadow-2xl">
      
      <!-- Navigation -->
      <Navigation activeSlug="careers" />
      
      <!-- Sticky Frosted Glass Header with Logout Toggle -->
      <header class="sticky top-0 z-50 flex items-center justify-between border-b border-zinc-900/80 px-4 sm:px-6 py-3 tracking-wider uppercase text-[11px] bg-zinc-950/70 backdrop-blur-md transition-all">
        <a href="/" class="font-semibold tracking-widest text-zinc-300 hover:text-white transition-colors flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          INSTITUTE / CAREERS
        </a>
        
        {user ? (
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="flex items-center gap-2 bg-zinc-900/80 border border-zinc-800 px-2 py-1 rounded-sm">
              <img src={user.avatar} alt={user.login} class="w-4 h-4 rounded-full border border-zinc-700" />
              <span class="text-zinc-200 text-[10px] hidden sm:inline">{user.login}</span>
            </div>
            <!-- Logout Button -->
            <a 
              href="/api/auth/logout" 
              class="text-zinc-400 hover:text-red-400 border border-zinc-800 hover:border-red-900/50 bg-zinc-900/50 hover:bg-red-950/20 px-2.5 py-1 rounded-sm transition-all flex items-center gap-1.5 text-[10px] font-bold"
            >
              <span>LOGOUT</span>
              <span class="text-[9px] text-zinc-500">↳</span>
            </a>
          </div>
        ) : (
          <a 
            href="/api/auth/github" 
            class="text-zinc-400 hover:text-white border border-zinc-800 hover:border-zinc-600 bg-zinc-900/40 hover:bg-zinc-800/60 px-3 py-1 rounded-sm transition-all text-[10px] font-bold"
          >
            AUTHENTICATE →
          </a>
        )}
      </header>

      <!-- Hero & Mission -->
      <section class="border-b border-zinc-900 px-4 sm:px-6 py-8 bg-gradient-to-b from-zinc-950/80 to-black">
        <div class="max-w-xl">
          <div class="inline-block border border-zinc-800 bg-zinc-900/50 px-2.5 py-1 text-[10px] text-zinc-400 uppercase tracking-widest mb-3">
            PROOF OF CAPABILITY ENGINE
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-3 uppercase leading-tight">
            Master the Stack.<br />
            <span class="text-zinc-500">Analyze your code.</span>
          </h1>
          <p class="text-[11px] text-zinc-400 leading-relaxed">
            We bypass traditional resume screening. Complete our functional curriculum, submit your codebase for automated static analysis, and unlock direct interviews.
          </p>
        </div>

        <!-- Progress Tracker Bar -->
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-2 border border-zinc-900 bg-zinc-950 p-2">
          <div class={`px-3 py-2 border ${user ? 'border-emerald-500/30 bg-emerald-950/10' : 'border-zinc-800 bg-black'}`}>
            <span class="text-[9px] text-zinc-500 block uppercase">Step 01</span>
            <span class={`font-bold ${user ? 'text-emerald-400' : 'text-zinc-400'}`}>
              {user ? '✓ GitHub Connected' : '1. Connect Account'}
            </span>
          </div>

          <div class={`px-3 py-2 border ${isPhase1Done ? 'border-emerald-500/30 bg-emerald-950/10' : user ? 'border-amber-500/30 bg-amber-950/10' : 'border-zinc-800 bg-black opacity-50'}`}>
            <span class="text-[9px] text-zinc-500 block uppercase">Step 02</span>
            <span class={`font-bold ${isPhase1Done ? 'text-emerald-400' : user ? 'text-amber-400' : 'text-zinc-500'}`}>
              {isPhase1Done ? '✓ Track Finished' : '2. Complete Track'}
            </span>
          </div>

          <div class={`px-3 py-2 border ${analysisStatus === 'done' ? 'border-emerald-500/30 bg-emerald-950/10' : isPhase1Done ? 'border-zinc-700 bg-black' : 'border-zinc-800 bg-black opacity-50'}`}>
            <span class="text-[9px] text-zinc-500 block uppercase">Step 03</span>
            <span class={`font-bold ${analysisStatus === 'done' ? 'text-emerald-400' : isPhase1Done ? 'text-zinc-300' : 'text-zinc-500'}`}>
              {analysisStatus === 'done' ? '✓ Code Analyzed' : '3. Submit Repo'}
            </span>
          </div>
        </div>
      </section>

      <main>
        <!-- ==================== PHASE 1: CURRICULUM ==================== -->
        <div class="border-b border-zinc-900 px-4 sm:px-6 py-2.5 text-[10px] tracking-widest text-zinc-500 uppercase bg-zinc-950/80 flex justify-between items-center">
          <span>Phase 01 / Required Curriculum</span>
          <span class={user ? "text-emerald-400 font-bold" : "text-zinc-600"}>
            {user ? "UNLOCKED" : "LOCKED"}
          </span>
        </div>

        <div class="relative border-b border-zinc-900 bg-black overflow-hidden">
          
          <!-- Blurred Teaser Content -->
          <div class={`p-4 sm:p-6 transition-all duration-500 ${!user ? 'blur-md opacity-25 select-none pointer-events-none filter scale-[0.99]' : ''}`}>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="max-w-xl space-y-2">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-zinc-500 font-bold">01.</span>
                  <h3 class="text-xs font-bold text-white uppercase tracking-wide">
                    Functional Fundamentals with Effect-TS
                  </h3>
                  {isPhase1Done && (
                    <span class="text-[9px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-1.5 py-0.5 font-bold">
                      PASSED
                    </span>
                  )}
                </div>
                <p class="text-[11px] text-zinc-400 leading-relaxed">
                  Master algebraic data types, error management, and concurrency models in Effect-TS. Completing this module unlocks code repository submission.
                </p>
                <div class="flex gap-2 pt-1">
                  <span class="border border-zinc-800 bg-zinc-900/60 text-zinc-400 text-[9px] px-2 py-0.5">3 Modules</span>
                </div>
              </div>

              <div class="shrink-0">
                <a 
                  href="/careers/effect-ts" 
                  class={`text-[10px] uppercase font-bold tracking-wider border px-3.5 py-2 transition-all inline-block w-full sm:w-auto text-center ${
                    isPhase1Done 
                      ? 'border-zinc-700 text-zinc-300 hover:bg-zinc-800' 
                      : 'border-white bg-white text-black hover:bg-zinc-200'
                  }`}
                >
                  {isPhase1Done ? "Review Track" : "Start Track →"}
                </a>
              </div>
            </div>
          </div>

          <!-- Glassmorphic Overlay with Lock Icon & Call-to-Action -->
          {!user && (
            <div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-black/70 backdrop-blur-md p-4 text-center">
              <div class="w-8 h-8 rounded-full border border-zinc-800 flex items-center justify-center text-zinc-400 text-sm mb-2 shadow-xl">
                🔒
              </div>
              <h4 class="text-xs font-bold text-zinc-200 uppercase tracking-wider mb-1">
                Curriculum Module Locked
              </h4>
              <p class="text-[11px] text-zinc-400 max-w-xs sm:max-w-sm mx-auto mb-3 leading-relaxed">
                Connect your GitHub account to unlock Effect-TS Functional Fundamentals and start the assessment.
              </p>
              <a 
                href="/api/auth/github" 
                class="text-[10px] uppercase font-bold tracking-wider border border-white bg-white text-black hover:bg-zinc-200 px-4 py-2 inline-block transition-all shadow-xl"
              >
                Authenticate via GitHub →
              </a>
            </div>
          )}

        </div>

        <!-- ==================== PHASE 2: REPO SUBMISSION ==================== -->
        <div class="border-b border-zinc-900 px-4 sm:px-6 py-2.5 text-[10px] tracking-widest text-zinc-500 uppercase bg-zinc-950/80 flex justify-between items-center">
          <span>Phase 02 / Repository Analysis</span>
          <span class={isPhase1Done ? "text-emerald-400 font-bold" : "text-zinc-600"}>
            {isPhase1Done ? "UNLOCKED" : "LOCKED"}
          </span>
        </div>

        <div class="p-4 sm:p-6 border-b border-zinc-900 bg-black">
          {!isPhase1Done ? (
            /* Locked State */
            <div class="border border-dashed border-zinc-800 bg-zinc-950/50 p-6 text-center">
              <span class="text-zinc-600 text-lg block mb-2">🔒</span>
              <h4 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-1">
                Repository Submission Locked
              </h4>
              <p class="text-[11px] text-zinc-500 max-w-sm mx-auto">
                Complete <strong class="text-zinc-400">Phase 01: Effect-TS Fundamentals</strong> above to unlock the capability evaluation engine.
              </p>
            </div>
          ) : (
            /* Unlocked State */
            <div class="space-y-4">
              <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 mb-1">
                  <span class="text-emerald-400">⚡</span> Static Codebase Assessment
                </h4>
                <p class="text-[11px] text-zinc-400">
                  Select a GitHub repository that demonstrates your implementation patterns.
                </p>
              </div>

              <!-- Repo Selection Controls -->
              <div class="border border-zinc-800 bg-zinc-950 p-3 sm:p-4">
                <span class="text-[10px] text-zinc-500 uppercase tracking-wider block mb-2">
                  Target Repository:
                </span>

                {!isRepoLinked ? (
                  <div class="flex flex-col sm:flex-row gap-2">
                    <select 
                      id="repo-select" 
                      class="bg-black border border-zinc-800 text-zinc-200 px-3 py-2 text-xs flex-1 outline-none focus:border-zinc-500 truncate"
                    >
                      <option value="">Fetching your repositories...</option>
                    </select>
                    <button 
                      id="save-repo-btn"
                      class="bg-white text-black font-bold uppercase px-4 py-2 text-[10px] tracking-wider hover:bg-zinc-200 transition-colors shrink-0"
                    >
                      Link Repository
                    </button>
                  </div>
                ) : (
                  <div class="flex items-center justify-between gap-2 bg-black border border-zinc-900 px-3 py-2">
                    <span class="text-zinc-200 font-bold tracking-wide truncate">{user?.selectedRepo}</span>
                    <button 
                      id="change-repo-btn" 
                      class="text-[10px] text-zinc-500 hover:text-white underline uppercase transition-colors shrink-0"
                    >
                      Change Repository
                    </button>
                  </div>
                )}
              </div>

              <!-- Trigger Analysis Action -->
              {isRepoLinked && (
                <div class="border-t border-zinc-900 pt-3">
                  {analysisStatus === "idle" && (
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <span class="text-[11px] text-zinc-400">Ready for automated inspection.</span>
                      <button 
                        id="run-analysis-btn"
                        class="bg-emerald-400 hover:bg-emerald-300 text-black font-bold uppercase px-4 py-2 text-[10px] tracking-wider transition-colors shrink-0"
                      >
                        Run Analysis Pipeline →
                      </button>
                    </div>
                  )}
                  <!-- Container to display fetched repository files -->
                  <!-- File List Container -->
<div id="analysis-output" class="hidden border border-zinc-800 bg-zinc-950 p-4 mt-4 space-y-3">
  <div class="flex items-center justify-between border-b border-zinc-800 pb-2">
    <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">
      📁 Scanned Repository Files
    </span>
    <span id="file-count-badge" class="text-[10px] bg-zinc-900 border border-zinc-800 text-zinc-400 px-2 py-0.5">
      0 files
    </span>
  </div>

  <ul id="file-list" class="max-h-64 overflow-y-auto divide-y divide-zinc-900 font-mono text-[11px] pr-1"></ul>
</div>

                  {analysisStatus === "running" && (
                    <div class="flex items-center gap-3 text-amber-400 text-[11px] bg-amber-950/20 border border-amber-900/40 p-3">
                      <span class="animate-spin">🌀</span>
                      <span>Evaluating architecture, AST patterns, and Effect-TS compliance...</span>
                    </div>
                  )}

                  {analysisStatus === "done" && (
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-zinc-950 border border-emerald-500/30 p-4">
                      <div>
                        <span class="text-[10px] text-emerald-400 uppercase font-bold block">
                          Analysis Complete
                        </span>
                        <span class="text-2xl font-bold text-white">{user?.analysisStatus ?? 94}/100</span>
                      </div>
                      <a 
                        href="/careers/analysis-report" 
                        class="border border-zinc-700 bg-zinc-900 hover:bg-white hover:text-black text-zinc-200 font-bold uppercase text-[10px] px-3 py-2 transition-colors text-center shrink-0"
                      >
                        Inspect Report →
                      </a>
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </div>

        <!-- ==================== OPEN ROLES ==================== -->
        <div class="border-b border-zinc-900 px-4 sm:px-6 py-2.5 text-[10px] tracking-widest text-zinc-500 uppercase bg-zinc-950/80">
          Open Positions
        </div>

        <div class="divide-y divide-zinc-900">
          <!-- Position 1 -->
          <div class={`p-4 sm:p-6 transition-opacity ${analysisStatus === 'done' ? 'opacity-100' : 'opacity-50'}`}>
            <div class="flex items-center justify-between gap-2 mb-1">
              <h3 class="text-xs font-bold text-white uppercase tracking-wide">Systems Backend Engineer</h3>
              <span class="text-[9px] border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 px-1.5 py-0.5 font-bold shrink-0">HIRING</span>
            </div>
            <p class="text-[11px] text-zinc-500 mb-3">Focus: Effect-TS, Distributed Systems, Cloud Native Infrastructure</p>
            <div class="text-[10px] text-zinc-400 border border-zinc-900 p-2.5 bg-zinc-950/50">
              {analysisStatus === 'done' ? (
                <a href="/careers/apply/backend" class="text-emerald-400 hover:underline font-bold uppercase">
                  Submit Application with Evaluation Report →
                </a>
              ) : (
                <span class="text-zinc-600">Complete curriculum and repository analysis to unlock application.</span>
              )}
            </div>
          </div>
        </div>

      </main>

    </div>
    <Footer />
  </div>
</BaseLayout>

<script define:vars={{ slug: "effect-ts" }}>
  // Repository Selection & Analysis Logic
  const selectEl = document.getElementById("repo-select");
  const saveBtn = document.getElementById("save-repo-btn");
  const changeBtn = document.getElementById("change-repo-btn");
  const analysisBtn = document.getElementById("run-analysis-btn");

  if (selectEl) {
    fetch("/api/auth/github/repos")
      .then(res => res.json())
      .then(repos => {
        selectEl.innerHTML = '<option value="">-- Select GitHub Repository --</option>';
        repos.forEach((r) => {
          const opt = document.createElement("option");
          opt.value = r.fullName;
          opt.textContent = `${r.fullName} ${r.private ? '[private]' : ''}`;
          selectEl.appendChild(opt);
        });
      })
      .catch(() => {
        selectEl.innerHTML = '<option value="">Failed to fetch repositories</option>';
      });
  }

  saveBtn?.addEventListener("click", async () => {
    const repoFullName = selectEl?.value;
    if (!repoFullName) return alert("Please select a repository from the list.");

    const res = await fetch("/api/auth/github/select-repo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ repoFullName })
    });

    if (res.ok) window.location.reload();
  });

  changeBtn?.addEventListener("click", async () => {
    const res = await fetch("/api/auth/github/select-repo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ repoFullName: "" })
    });

    if (res.ok) window.location.reload();
  });

  analysisBtn?.addEventListener("click", async () => {
    analysisBtn.disabled = true;
    analysisBtn.innerText = "Fetching Repository Files...";

    try {
      const res = await fetch("/api/careers/analyze-repo", { method: "POST" });
      const data = await res.json();

      if (res.ok && data.success) {
        const outputContainer = document.getElementById("analysis-output");
        const fileCountBadge = document.getElementById("file-count-badge");
        const fileList = document.getElementById("file-list");

        if (outputContainer && fileList && fileCountBadge) {
          fileCountBadge.textContent = `${data.fileCount} files`;
          fileList.innerHTML = "";

          // Render only file paths
          data.files.forEach((file) => {
            const li = document.createElement("li");
            li.className = "py-1.5 px-2 text-zinc-300 hover:bg-zinc-900/60 flex items-center gap-2";
            li.innerHTML = `<span class="text-zinc-600">📄</span> <span>${file.path}</span>`;
            fileList.appendChild(li);
          });

          outputContainer.classList.remove("hidden");
        }

        analysisBtn.innerText = "Analysis Complete ✓";
      } else {
        alert(data.error || "Failed to fetch repository files.");
        analysisBtn.disabled = false;
        analysisBtn.innerText = "Run Analysis Pipeline →";
      }
    } catch (err) {
      alert("Error fetching repository files.");
      analysisBtn.disabled = false;
      analysisBtn.innerText = "Run Analysis Pipeline →";
    }
  });

  // Quiz Attempt Validation & Enforcement Logic
  const completeBtn = document.getElementById("complete-lesson-btn");
  const statusEl = document.getElementById("lesson-status");
  const errorEl = document.getElementById("quiz-error");
  const errorTextEl = document.getElementById("quiz-error-text");
  const successEl = document.getElementById("quiz-success");
  const successTextEl = document.getElementById("quiz-success-text");
  const questions = document.querySelectorAll(".quiz-question");

  function setAttemptRecordedState(scorePercentage) {
    if (!completeBtn || !statusEl) return;

    const isPassed = scorePercentage >= 70;

    if (isPassed) {
      if (errorEl) {
        errorEl.classList.add("hidden");
        errorEl.classList.remove("flex");
      }
      if (successEl && successTextEl) {
        successEl.classList.remove("hidden");
        successEl.classList.add("flex");
        successTextEl.textContent = `Score: ${Math.round(scorePercentage)}%. Requirement met (70%+). Attempt completed.`;
      }

      statusEl.textContent = "Assessment Completed (Passed) ✓";
      statusEl.classList.replace("text-zinc-400", "text-emerald-400");
    } else {
      if (successEl) {
        successEl.classList.add("hidden");
        successEl.classList.remove("flex");
      }
      if (errorEl && errorTextEl) {
        errorEl.classList.remove("hidden");
        errorEl.classList.add("flex");
        errorTextEl.textContent = `Score: ${Math.round(scorePercentage)}%. Attempt recorded (Did not meet 70% threshold).`;
      }

      statusEl.textContent = "Assessment Completed (Failed) ✗";
      statusEl.classList.replace("text-zinc-400", "text-red-400");
    }

    completeBtn.textContent = "Return to Curriculum";
    completeBtn.classList.remove("bg-white", "text-black", "hover:bg-zinc-200");
    completeBtn.classList.add("bg-zinc-800", "text-zinc-100", "hover:bg-zinc-700", "border", "border-zinc-700");

    localStorage.setItem(`lesson:${slug}:attempted`, "true");
    localStorage.setItem(`lesson:${slug}:score`, scorePercentage.toString());

    document.querySelectorAll("input[type='radio']").forEach(input => {
      input.disabled = true;
    });
    document.querySelectorAll(".radio-label").forEach(label => {
      label.classList.add("opacity-50", "cursor-not-allowed");
      label.classList.remove("hover:bg-zinc-900", "hover:border-zinc-700", "cursor-pointer");
    });
  }

  // Check attempt status on load
  const hasAttempted = localStorage.getItem(`lesson:${slug}:attempted`) === "true";
  const savedScore = localStorage.getItem(`lesson:${slug}:score`);

  if (hasAttempted) {
    setAttemptRecordedState(savedScore !== null ? parseFloat(savedScore) : 0);
  }

  completeBtn?.addEventListener("click", () => {
    if (localStorage.getItem(`lesson:${slug}:attempted`) === "true") {
      window.location.href = "/careers";
      return;
    }

    if (questions.length === 0) {
      setAttemptRecordedState(100);
      return;
    }

    let unattemptedCount = 0;

    // Reset visual error indicators
    questions.forEach(q => q.classList.remove("border-red-500/50"));

    // Check if every question has a selected answer
    questions.forEach((q) => {
      const qIndex = q.getAttribute("data-question-index");
      const selected = document.querySelector(`input[name="question-${qIndex}"]:checked`);

      if (!selected) {
        unattemptedCount++;
        q.classList.add("border-red-500/50");
      }
    });

    // Halt submission if any questions remain unanswered
    if (unattemptedCount > 0) {
      if (errorEl && errorTextEl) {
        errorTextEl.textContent = `Please answer all questions before submitting. (${unattemptedCount} remaining)`;
        errorEl.classList.remove("hidden");
        errorEl.classList.add("flex");
        errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      return;
    }

    // Calculate score
    let correctCount = 0;
    questions.forEach((q) => {
      const qIndex = q.getAttribute("data-question-index");
      const correctIndex = q.getAttribute("data-correct-index");
      const selected = document.querySelector(`input[name="question-${qIndex}"]:checked`);

      if (selected && selected.value === correctIndex) {
        correctCount++;
      }
    });

    const scorePercentage = (correctCount / questions.length) * 100;
    setAttemptRecordedState(scorePercentage);
  });
</script>