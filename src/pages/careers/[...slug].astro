---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Navigation from "@/components/navigation/Navigation.astro"
import Footer from "@/components/Footer.astro"
import { lessons } from "@/data/lession" 
import { parseSignedSession, safeLookup } from "@/lib/session"

console.log(typeof(Astro.cookies.get("user_session")?.value));

const session =  Astro.cookies.get("user_session")?.value;
console.log("sesison", session)
if (!session) {
  return Astro.redirect("/careers");
}

const { slug } = Astro.params;

const lesson = safeLookup(lessons, slug);
if (!lesson) {
  return Astro.redirect("/404");
}

if (!lesson) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={lesson.title} description={lesson.description}>
  <div class="min-h-screen bg-black text-zinc-100 font-mono text-sm flex flex-col">
    
    <!-- Header Area -->
    <div class="border-b border-zinc-900">
      <Navigation activeSlug="careers" />
      <header class="mx-auto max-w-4xl flex items-center justify-between px-6 py-4 tracking-wider uppercase">
        <a href="/careers" class="font-semibold tracking-widest text-zinc-500 hover:text-zinc-100 transition-colors flex items-center gap-2">
          <span class="text-xs">←</span> BACK TO CURRICULUM
        </a>
        <div class="flex items-center gap-2 text-xs text-emerald-400 bg-emerald-500/10 px-3 py-1 border border-emerald-500/20">
          <span>✓</span> AUTHENTICATED
        </div>
      </header>
    </div>

    <!-- Main Content Area -->
    <main class="flex-grow mx-auto max-w-3xl w-full px-6 py-16">
      
      <!-- Lesson Title -->
      <div class="mb-16 border-b border-zinc-900 pb-10">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-100 mb-6 uppercase leading-tight">
          {lesson.title}
        </h1>
        <p class="text-base text-zinc-400 leading-relaxed max-w-2xl">
          {lesson.description}
        </p>
      </div>
      
      <!-- Lesson Sections -->
      <div class="space-y-16">
        {lesson.sections?.map((section:any) => (
          <section class="relative">
            <h2 class="text-base font-bold text-zinc-100 mb-6 tracking-widest uppercase border-l-4 border-zinc-800 pl-4">
              {section.title}
            </h2>
            
            <p class="text-[15px] md:text-base text-zinc-300 leading-[2] mb-8">
              {section.text}
            </p>
            
            {section.code && (
              <div class="border border-zinc-800 bg-[#0a0a0a] rounded-md overflow-hidden my-8 shadow-xl shadow-black/50">
                <div class="flex items-center px-5 py-3 border-b border-zinc-900 bg-[#111] text-xs text-zinc-500 uppercase tracking-widest gap-3">
                  <div class="flex gap-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-zinc-700"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-zinc-700"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-zinc-700"></div>
                  </div>
                  <span class="ml-2 text-zinc-400 font-semibold">index.ts</span>
                </div>
                <div class="p-6 overflow-x-auto">
                  <pre class="text-[13.5px] text-zinc-300 font-mono m-0 leading-[1.7]"><code>{section.code}</code></pre>
                </div>
              </div>
            )}
          </section>
        ))}
      </div>

      <!-- KNOWLEDGE CHECK / QUIZ -->
      {lesson.quiz && lesson.quiz.length > 0 && (
        <div class="mt-24 pt-16 border-t border-dashed border-zinc-800">
          <h2 class="text-2xl font-bold text-zinc-100 mb-4 uppercase tracking-widest">
            Knowledge Check
          </h2>
          <p class="text-sm text-zinc-500 mb-12 font-mono bg-zinc-900/50 p-4 border-l-2 border-emerald-500/50 inline-block">
            // Score 70% or higher to pass this assessment.
          </p>

          <div id="quiz-container" class="space-y-12">
            {lesson.quiz.map((q:any, qIndex: any) => (
              <div class="quiz-question bg-black border border-zinc-900 p-6 md:p-8" data-question-index={qIndex} data-correct-index={q.correctOptionIndex}>
                <h3 class="text-base md:text-[17px] text-zinc-100 mb-6 font-bold leading-relaxed">
                  <span class="text-zinc-500 mr-2">{qIndex + 1}.</span> {q.question}
                </h3>
                
                {q.code && (
                  <div class="border border-zinc-800 bg-[#0a0a0a] p-5 rounded-md mb-6 shadow-md">
                    <pre class="text-[13px] text-zinc-300 font-mono m-0 leading-relaxed"><code>{q.code}</code></pre>
                  </div>
                )}
                
                <div class="space-y-3">
                  {q.options.map((opt:any, optIndex:any) => (
                    <label class="radio-label flex items-start gap-4 p-5 border border-zinc-800 bg-zinc-950 hover:bg-zinc-900 hover:border-zinc-700 cursor-pointer transition-all group">
                      <div class="mt-0.5">
                        <input 
                          type="radio" 
                          name={`question-${qIndex}`} 
                          value={optIndex} 
                          class="w-4 h-4 accent-emerald-500 bg-zinc-900 border-zinc-700 cursor-pointer" 
                        />
                      </div>
                      <span class="text-[14px] md:text-[15px] text-zinc-400 group-hover:text-zinc-100 transition-colors select-none leading-relaxed">
                        {opt}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Error Message Banner -->
          <div id="quiz-error" class="hidden mt-10 text-sm text-red-400 border border-red-500/30 bg-red-500/10 px-6 py-5 uppercase tracking-widest items-center gap-3">
            <span class="text-lg font-bold">✗</span> 
            <span id="quiz-error-text" class="font-semibold">Review your answers and try again.</span>
          </div>

          <!-- Success Message Banner -->
          <div id="quiz-success" class="hidden mt-10 text-sm text-emerald-400 border border-emerald-500/30 bg-emerald-500/10 px-6 py-5 uppercase tracking-widest items-center gap-4">
            <span class="text-2xl font-bold">✓</span> 
            <div class="flex flex-col">
              <strong class="font-bold text-base">ASSESSMENT PASSED</strong>
              <span id="quiz-success-text" class="text-xs text-emerald-500/80 normal-case tracking-normal font-mono mt-1"></span>
            </div>
          </div>

        </div>
      )}

      <!-- Action Area: Complete Lesson -->
      <div class="mt-16 pt-8 border-t border-zinc-900 flex flex-col sm:flex-row justify-between items-center gap-6">
        <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
          <span class="text-xs text-zinc-600 uppercase tracking-widest mb-1">Lesson Progress</span>
          <span id="lesson-status" class="text-sm text-zinc-400 uppercase font-bold tracking-widest">Pending Completion</span>
        </div>
        
        <button
          id="complete-lesson-btn"
          class="bg-white text-black px-10 py-4 text-sm font-bold uppercase tracking-wider hover:bg-zinc-200 hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          {lesson.quiz && lesson.quiz.length > 0 ? "Submit & Complete" : "Mark as Complete"}
        </button>
      </div>

    </main>

    <Footer />
  </div>
</BaseLayout>

<script define:vars={{ slug }}>
  const completeBtn = document.getElementById("complete-lesson-btn");
  const statusEl = document.getElementById("lesson-status");
  const errorEl = document.getElementById("quiz-error");
  const errorTextEl = document.getElementById("quiz-error-text");
  const successEl = document.getElementById("quiz-success");
  const successTextEl = document.getElementById("quiz-success-text");
  const questions = document.querySelectorAll(".quiz-question");

  function lockQuiz() {
    document.querySelectorAll("input[type='radio']").forEach(input => { input.disabled = true; });
    document.querySelectorAll(".radio-label").forEach(label => {
      label.classList.add("opacity-50", "cursor-not-allowed");
      label.classList.remove("hover:bg-zinc-900", "hover:border-zinc-700", "cursor-pointer");
    });
  }

  function renderResult(scorePercentage, passed) {
    if (!completeBtn || !statusEl) return;

    if (passed) {
      errorEl?.classList.add("hidden"); errorEl?.classList.remove("flex");
      if (successEl && successTextEl) {
        successEl.classList.remove("hidden"); successEl.classList.add("flex");
        successTextEl.textContent = `Score: ${Math.round(scorePercentage)}%. Requirement met (70%+). Attempt completed.`;
      }
      statusEl.textContent = "Assessment Completed (Passed) ✓";
      statusEl.classList.replace("text-zinc-400", "text-emerald-400");
    } else {
      successEl?.classList.add("hidden"); successEl?.classList.remove("flex");
      if (errorEl && errorTextEl) {
        errorEl.classList.remove("hidden"); errorEl.classList.add("flex");
        errorTextEl.textContent = `Score: ${Math.round(scorePercentage)}%. Attempt recorded (Did not meet 70% threshold).`;
      }
      statusEl.textContent = "Assessment Completed (Failed) ✗";
      statusEl.classList.replace("text-zinc-400", "text-red-400");
    }

    completeBtn.textContent = "Return to Curriculum";
    completeBtn.classList.remove("bg-white", "text-black", "hover:bg-zinc-200");
    completeBtn.classList.add("bg-zinc-800", "text-zinc-100", "hover:bg-zinc-700", "border", "border-zinc-700");

    // Cosmetic only — server re-grades on every real submission, so this
    // can't be used to fake a pass; it just avoids re-showing the quiz UI.
    localStorage.setItem(`lesson:${slug}:attempted`, "true");
    localStorage.setItem(`lesson:${slug}:score`, scorePercentage.toString());
    localStorage.setItem(`lesson:${slug}:passed`, passed ? "true" : "false");

    lockQuiz();
  }

  const hasAttempted = localStorage.getItem(`lesson:${slug}:attempted`) === "true";
  if (hasAttempted) {
    const savedScore = parseFloat(localStorage.getItem(`lesson:${slug}:score`) ?? "0");
    const savedPassed = localStorage.getItem(`lesson:${slug}:passed`) === "true";
    renderResult(savedScore, savedPassed);
  }

  completeBtn?.addEventListener("click", async () => {
    if (localStorage.getItem(`lesson:${slug}:attempted`) === "true") {
      window.location.href = "/careers";
      return;
    }

    let answers = [];

    if (questions.length > 0) {
      let unattemptedCount = 0;
      questions.forEach(q => q.classList.remove("border-red-500/50"));

      questions.forEach((q) => {
        const qIndex = q.getAttribute("data-question-index");
        const selected = document.querySelector(`input[name="question-${qIndex}"]:checked`);
        if (!selected) {
          unattemptedCount++;
          q.classList.add("border-red-500/50");
          answers.push(-1);
        } else {
          answers.push(Number(selected.value));
        }
      });

      if (unattemptedCount > 0) {
        if (errorEl && errorTextEl) {
          errorTextEl.textContent = `Please answer all questions before submitting. (${unattemptedCount} remaining)`;
          errorEl.classList.remove("hidden");
          errorEl.classList.add("flex");
          errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        return;
      }
    }

    try {
      const res = await fetch("/api/careers/submit-quiz", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, answers }),
      });
      if (!res.ok) throw new Error(`Server responded with ${res.status}`);
      const data = await res.json();
      renderResult(data.scorePercentage, data.passed);
    } catch (err) {
      console.error("Failed to submit quiz:", err);
      if (errorEl && errorTextEl) {
        errorTextEl.textContent = "Something went wrong submitting your answers. Please try again.";
        errorEl.classList.remove("hidden");
        errorEl.classList.add("flex");
      }
    }
  });
</script>