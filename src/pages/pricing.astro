---
import PageLayout from "@/layouts/PageLayout.astro"
import PricingHero from "@/components/pages/pricing/PricingHero.astro"
import BillingSelector from "@/components/pages/pricing/BillingSelector"
import PricingCard from "@/components/pages/pricing/PricingCard.astro"
import PricingComparison from "@/components/pages/pricing/PricingComparison.astro"
import PlanGuidance from "@/components/pages/pricing/PlanGuidance.astro"
import PricingFAQ from "@/components/pages/pricing/PricingFAQ.astro"
import PricingCTA from "@/components/pages/pricing/PricingCTA.astro"
import { BOOK_DEMO_URL } from "@/data/navigation"
import { PLANS, BILLING_CYCLES } from "@/data/pricing"

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "DeepEcom Seller Plans",
  description:
    "DeepEcom connects ecommerce marketplaces to business intelligence, payment reconciliation and detailed ERP accounting. Plans are sized by monthly order volume and billed quarterly.",
  offers: PLANS.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.monthly,
    priceCurrency: "INR",
    billingIncrement: "P1M",
    url: "https://deepecom.com/pricing",
    description: `${plan.name} — ${plan.features.join(", ")}.`,
  })),
}
---

<PageLayout
  title="Pricing — Simple plans for every ecommerce stage | DeepEcom"
  description="DeepEcom pricing is sized by monthly order volume: Beginner Seller ₹1,000/month, Emerging Seller ₹2,000/month and Scaling Seller ₹3,000/month, billed quarterly. No per-seat fees, no hidden charges."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div id="pricing-period-root" data-pricing-root data-active="quarterly">
    <PricingHero
      title="Flexible plans for every stage of your ecommerce business."
      lead="Plans are sized by monthly order volume and billed quarterly. No per-seat fees, no hidden charges."
    />

    <section class="pricing-body" aria-label="Plans and billing">
      <div class="billing-shell reveal">
        <BillingSelector client:load />
        <p class="billing-hint">Choose a billing period to see the full picture.</p>
      </div>

      <div class="pricing-cards-grid">
        <div class="reveal">
          <PricingCard plan={PLANS[0]} emphasis={0} />
        </div>
        <div class="reveal" data-delay="80">
          <PricingCard plan={PLANS[1]} emphasis={1} />
        </div>
        <div class="reveal" data-delay="160">
          <PricingCard plan={PLANS[2]} emphasis={2} />
        </div>
      </div>
    </section>

    <PricingComparison />
    <PlanGuidance />

    <aside class="pagy-band reveal" aria-label="Pay as you go">
      <p class="pagy-title">Pay as you go</p>
      <p class="pagy-text">A plan for every monthly order volume — upgrade or downgrade as you grow. Ever.</p>
      <a class="pagy-link" href={BOOK_DEMO_URL}>Talk to us about your volume →</a>
    </aside>

    <PricingFAQ />
    <PricingCTA />
  </div>
</PageLayout>

<style is:global>
  .pricing-body {
    padding-bottom: var(--section-pad, 5rem);
  }

  /* Billing selector */
  .billing-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .billing-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--ink-200);
    border-radius: 999px;
    background: var(--ink-50);
  }
  .billing-option {
    appearance: none;
    border: none;
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-600);
    background: transparent;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .billing-option:hover {
    color: var(--ink-950);
  }
  .billing-option:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }
  .billing-option.is-active {
    background: var(--brand-500);
    color: #fff;
    box-shadow: 0 1px 2px rgba(11, 17, 32, 0.12), 0 8px 18px -8px rgba(83, 58, 253, 0.55);
  }
  .billing-hint {
    font-size: 0.76rem;
    color: var(--ink-400);
  }

  /* Cards */
  .pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  /* Billing-period switching (driven by data-active on #pricing-period-root) */
  [data-pricing-root] .plan-billed-line {
    display: none;
  }
  [data-pricing-root][data-active="quarterly"] [data-cycle="quarterly"],
  [data-pricing-root][data-active="halfYearly"] [data-cycle="halfYearly"],
  [data-pricing-root][data-active="yearly"] [data-cycle="yearly"] {
    display: block;
  }

  /* Pay-as-you-go band */
  .pagy-band {
    max-width: var(--container-content);
    margin-inline: auto;
    margin-bottom: var(--section-pad, 5rem);
    padding: 1.6rem clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    border: 1px solid var(--ink-200);
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff 0%, var(--ink-50) 100%);
  }
  .pagy-title {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-950);
  }
  .pagy-text {
    flex: 1;
    min-width: 16rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-500);
  }
  .pagy-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-600);
    text-decoration: none;
    white-space: nowrap;
  }
  .pagy-link:hover {
    text-decoration: underline;
  }
  .pagy-link:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 64rem) {
    .pricing-cards-grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
      margin-inline: auto;
    }
  }
</style>