---
import PageLayout from "@/layouts/PageLayout.astro"
import PricingHero from "@/components/pages/pricing/PricingHero.astro"
import PricingCard from "@/components/pages/pricing/PricingCard.astro"
import PricingEnterprise from "@/components/pages/pricing/PricingEnterprise.astro"
import PricingComparison from "@/components/pages/pricing/PricingComparison.astro"
import PlanGuidance from "@/components/pages/pricing/PlanGuidance.astro"
import PricingFAQ from "@/components/pages/pricing/PricingFAQ.astro"
import PricingCTA from "@/components/pages/pricing/PricingCTA.astro"
import { STANDARD_PLANS } from "@/data/pricing"

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "DeepEcom Seller Plans",
  description:
    "DeepEcom connects ecommerce marketplaces to business intelligence, payment reconciliation and detailed ERP accounting. Plans are sized by monthly order volume and billed quarterly.",
  offers: STANDARD_PLANS.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.monthly,
    priceCurrency: "INR",
    billingIncrement: "P1M",
    url: "https://deepecom.com/pricing",
    description: `${plan.name} — ${plan.features.join(", ")}.`,
  })),
}
---

<PageLayout
  title="Pricing — Simple plans for every ecommerce stage | DeepEcom"
  description="DeepEcom pricing is sized by monthly order volume: from Beginner Seller ₹1,000/month up to Power Seller ₹6,000/month, billed quarterly. Custom Enterprise plans for sellers above 8,000 orders a month."
  ogKey="pricing"
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://deepecom.com/" },
        { "@type": "ListItem", position: 2, name: "Pricing", item: "https://deepecom.com/pricing" },
      ],
    },
    jsonLd,
  ]}
>
  <!-- 01 — HERO -->
  <PricingHero />

  <!-- 02 — PLANS -->
  <section class="section-band" aria-label="Plans and billing">
    <div class="sec">
      <div class="flex flex-wrap items-end justify-between gap-4 reveal">
        <div class="max-w-3xl">
          <span class="eyebrow">PLANS</span>
          <h2 class="h2-md mt-4">Six plans, sized by monthly order volume.</h2>
          <p class="lead mt-5">Pick the plan that fits your current stage — you can always move up as your business grows.</p>
        </div>
        <a
          href="#compare"
          class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-bold text-brand-600 transition-colors hover:text-brand-700"
        >
          Compare all plans
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="mt-10 grid reveal gap-4 md:grid-cols-2 xl:grid-cols-3">
        {STANDARD_PLANS.map((plan) => (
          <PricingCard plan={plan} featured={plan.id === "scaling"} key={plan.id} />
        ))}
      </div>

      <PricingEnterprise />
    </div>
  </section>

  <!-- 03 — COMPARISON -->
  <PricingComparison />

  <!-- 04 — GUIDED -->
  <section class="section-band">
    <PlanGuidance />
  </section>

  <!-- 05 — FAQ -->
  <PricingFAQ />

  <!-- 06 — FINAL CTA -->
  <PricingCTA />
</PageLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>