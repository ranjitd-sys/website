---
import PageLayout from "@/layouts/PageLayout.astro"
import { customers } from "@/data/customers"
import { logoAsset } from "@/data/logoAssets"
import { buttonVariants } from "@/components/landing/ui/button"
import { ArrowRight, ArrowLeft, X, Check } from "lucide-react"

const { slug } = Astro.params
const customer = customers.find((c) => c.slug === slug)

if (!customer) {
  return Astro.redirect("/customers")
}

const customerLogo = logoAsset(customer.slug)

const related = customers.filter((c) => c.slug !== slug).slice(0, 2)
const relatedLogos = related.map((r) => ({ customer: r, logo: logoAsset(r.slug) }))
---

<PageLayout
  title={`${customer.name} — DeepEcom Case Study`}
  description={`How ${customer.name} uses DeepEcom to solve ${customer.industry.toLowerCase()} ecommerce financial complexity.`}
>
  <!-- 01 CUSTOMER HERO -->
  <section class="csh-hero">
    <div class="sec">
      <a href="/customers" class="csh-back"><ArrowLeft size={14} /> All Customers</a>
      <div class="csh-inner">
        <div class="csh-copy">
          <span class="csh-industry">{customer.industry}</span>
          <h1 class="csh-title">{customer.headline}</h1>
          <p class="csh-problem">{customer.problem}</p>
        </div>
        <div class="csh-viz" aria-label={`${customer.name} DeepEcom data pipeline`}>
          <div class="csh-viz-head">
            {customerLogo ? (
              <span class="csh-viz-mark csh-viz-mark-img" aria-hidden="true">
                <img
                  src={customerLogo.src}
                  alt=""
                  style={{
                    aspectRatio: `${Math.round(customerLogo.ratio * 10)} / 10`,
                  }}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <span class="csh-viz-mark" aria-hidden="true">{customer.logoText.charAt(0)}</span>
            )}
            <div class="csh-viz-meta">
              <span class="csh-viz-name">{customer.logoText}</span>
              <span class="csh-viz-type">{customer.businessType}</span>
            </div>
            {customer.featured && <span class="csh-viz-tag">FEATURED</span>}
          </div>

          <div class="csh-vflow">
            <div class="csh-node">
              <span class="csh-node-label">MARKETPLACE DATA</span>
              <div class="csh-node-chips">
                <span class="csh-chip">Amazon</span>
                <span class="csh-chip">Flipkart</span>
                <span class="csh-chip">Shopify</span>
                <span class="csh-chip csh-chip-more">+ more</span>
              </div>
            </div>

            <div class="csh-vline" aria-hidden="true"></div>

            <div class="csh-deepecom">
              <span class="csh-deepecom-brand">DEEPECOM</span>
              <div class="csh-deepecom-steps">
                <span class="csh-step">Understand</span>
                <span class="csh-step-arrow" aria-hidden="true">→</span>
                <span class="csh-step">Reconcile</span>
                <span class="csh-step-arrow" aria-hidden="true">→</span>
                <span class="csh-step">Account</span>
              </div>
            </div>

            <div class="csh-vline" aria-hidden="true"></div>

            <div class="csh-node">
              <span class="csh-node-label">WHAT THEY USE</span>
              <div class="csh-node-chips">
                {customer.products.slice(0, 4).map((p) => (
                  <span class="csh-chip csh-chip-brand">{p}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 CUSTOMER QUOTE -->
  {customer.quote && customer.quoteAuthor !== "CONTENT NEEDED" && (
    <section class="csq-section">
      <div class="sec">
        <blockquote class="csq-card">
          <div class="csq-mark">"</div>
          <p class="csq-text">{customer.quote}</p>
          <cite class="csq-meta">
            <span class="csq-author">{customer.quoteAuthor}</span>
            <span class="csq-role">{customer.quoteRole}</span>
          </cite>
        </blockquote>
      </div>
    </section>
  )}

  <!-- 03 ABOUT THE BUSINESS -->
  <section class="cs-about">
    <div class="sec">
      <div class="cs-grid">
        <div class="cs-about-left">
          <span class="eyebrow">ABOUT THE BUSINESS</span>
          <h2 class="cs-section-title">{customer.name}</h2>
          <div class="cs-meta-grid">
            <div class="cs-meta-item">
              <span class="cs-meta-label">Industry</span>
              <span class="cs-meta-value">{customer.industry}</span>
            </div>
            <div class="cs-meta-item">
              <span class="cs-meta-label">Business Type</span>
              <span class="cs-meta-value">{customer.businessType}</span>
            </div>
            <div class="cs-meta-item">
              <span class="cs-meta-label">Products Used</span>
              <div class="cs-meta-tags">
                {customer.products.map((p) => (
                  <span class="cs-tag">{p}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 THE CHALLENGE -->
  <section class="cs-challenge">
    <div class="sec">
      <div class="cs-challenge-inner">
        <span class="eyebrow">THE CHALLENGE</span>
        <h2 class="cs-section-title">Before DeepEcom</h2>
        <p class="cs-challenge-text">{customer.problem}</p>
        <div class="cs-before-list">
          {customer.before.map((item) => (
            <div class="cs-before-item">
              <span class="cs-x">✕</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 05 WHAT DEEPECOM IMPLEMENTED -->
  <section class="cs-impl">
    <div class="sec">
      <div class="cs-impl-inner">
        <span class="eyebrow">DEEPECOM IMPLEMENTATION</span>
        <h2 class="cs-section-title">What DeepEcom implemented</h2>
        <div class="cs-impl-grid">
          {customer.implementation.map((impl) => (
            <div class="cs-impl-card">
              <span class="cs-impl-label">{impl.label}</span>
              <span class="cs-impl-detail">{impl.detail}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 06 HOW THEY USE DEEPECOM -->
  <section class="cs-usage">
    <div class="sec">
      <div class="cs-usage-head">
        <span class="eyebrow">HOW THEY USE DEEPECOM</span>
        <h2 class="cs-section-title">The transformation</h2>
        <p class="cs-usage-lead">
          Fragmented marketplace data goes in one way. It comes out as order-level,
          GST-ready, ERP-ready accounting.
        </p>
      </div>

      <div class="cs-pipeline">
        <!-- Before State -->
        <div class="cs-pipe-zone cs-pipe-before">
          <div class="cs-pipe-zone-head">
            <span class="cs-pipe-dot cs-pipe-dot-x" aria-hidden="true"></span>
            Before DeepEcom
          </div>
          <ul class="cs-pipe-list">
            {customer.before.map((item, index) => (
              <li class="cs-pipe-item cs-pipe-item-x">
                <span class="cs-pipe-marker" aria-hidden="true"><X size={11} /></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Connector -->
        <div class="cs-pipe-link" aria-hidden="true">
          <svg viewBox="0 0 88 240" preserveAspectRatio="none">
            <path class="cs-pipe-path" d="M2 34 C 30 34, 46 66, 86 76" />
            <path class="cs-pipe-path cs-pipe-path-dash" d="M2 34 C 30 34, 46 66, 86 76" />
            <path class="cs-pipe-path" d="M2 120 C 30 120, 46 120, 86 120" />
            <path class="cs-pipe-path cs-pipe-path-dash" d="M2 120 C 30 120, 46 120, 86 120" />
            <path class="cs-pipe-path" d="M2 206 C 30 206, 46 174, 86 164" />
            <path class="cs-pipe-path cs-pipe-path-dash" d="M2 206 C 30 206, 46 174, 86 164" />
            <circle class="cs-pipe-node-dim" cx="2" cy="34" r="3" />
            <circle class="cs-pipe-node-dim" cx="2" cy="120" r="3" />
            <circle class="cs-pipe-node-dim" cx="2" cy="206" r="3" />
            <circle class="cs-pipe-node" cx="86" cy="76" r="3" />
            <circle class="cs-pipe-node" cx="86" cy="120" r="3" />
            <circle class="cs-pipe-node" cx="86" cy="164" r="3" />
          </svg>
        </div>

        <!-- DeepEcom Engine -->
        <div class="cs-pipe-engine">
          <div class="cs-engine-inner">
            <span class="cs-engine-badge">DEEPECOM</span>
            <div class="cs-engine-steps">
              <span class="cs-engine-step">Understand</span>
              <span class="cs-engine-arrow" aria-hidden="true">→</span>
              <span class="cs-engine-step">Reconcile</span>
              <span class="cs-engine-arrow" aria-hidden="true">→</span>
              <span class="cs-engine-step">Account</span>
            </div>
            <p class="cs-engine-sub">
              Marketplace data, payments and accounting pass through one connected financial layer.
            </p>
            <div class="cs-engine-impl">
              {customer.implementation.map((impl) => (
                <div class="cs-engine-impl-item">
                  <span class="cs-engine-impl-label">{impl.label}</span>
                  <span class="cs-engine-impl-detail">{impl.detail}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Connector -->
        <div class="cs-pipe-link" aria-hidden="true">
          <svg viewBox="0 0 88 240" preserveAspectRatio="none">
            <path class="cs-pipe-path" d="M2 76 C 42 66, 56 34, 86 34" />
            <path class="cs-pipe-path cs-pipe-path-dash" d="M2 76 C 42 66, 56 34, 86 34" />
            <path class="cs-pipe-path" d="M2 120 C 42 120, 56 120, 86 120" />
            <path class="cs-pipe-path cs-pipe-path-dash" d="M2 120 C 42 120, 56 120, 86 120" />
            <path class="cs-pipe-path" d="M2 164 C 42 174, 56 206, 86 206" />
            <path class="cs-pipe-path cs-pipe-path-dash" d="M2 164 C 42 174, 56 206, 86 206" />
            <circle class="cs-pipe-node" cx="2" cy="76" r="3" />
            <circle class="cs-pipe-node-dim" cx="2" cy="120" r="3" />
            <circle class="cs-pipe-node" cx="86" cy="34" r="3" />
            <circle class="cs-pipe-node-dim" cx="86" cy="120" r="3" />
            <circle class="cs-pipe-node-dim" cx="86" cy="206" r="3" />
          </svg>
        </div>

        <!-- After State -->
        <div class="cs-pipe-zone cs-pipe-after">
          <div class="cs-pipe-zone-head">
            <span class="cs-pipe-dot cs-pipe-dot-check" aria-hidden="true"></span>
            After DeepEcom
          </div>
          <ul class="cs-pipe-list">
            {customer.after.map((item, index) => (
              <li  class="cs-pipe-item cs-pipe-item-check">
                <span class="cs-pipe-marker cs-pipe-marker-check" aria-hidden="true"><Check size={11} /></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 RESULTS -->
  <section class="cs-results">
    <div class="sec">
      <div class="cs-results-inner">
        <span class="eyebrow">RESULTS</span>
        <h2 class="cs-section-title">What changed</h2>
        <p class="cs-results-text">{customer.outcome}</p>
        <div class="cs-after-list">
          {customer.after.map((item) => (
            <div class="cs-after-item">
              <span class="cs-check">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 08 CUSTOMER QUOTE (END) -->
  {customer.quote && customer.quoteAuthor !== "CONTENT NEEDED" && (
    <section class="csq-section">
      <div class="sec">
        <blockquote class="csq-card csq-end">
          <div class="csq-mark">"</div>
          <p class="csq-text">{customer.quote}</p>
          <cite class="csq-meta">
            <span class="csq-author">{customer.quoteAuthor}</span>
            <span class="csq-role">{customer.quoteRole}</span>
          </cite>
        </blockquote>
      </div>
    </section>
  )}

  <!-- 09 RELATED CASE STUDIES -->
  <section class="cs-related">
    <div class="sec">
      <span class="eyebrow">RELATED CASE STUDIES</span>
      <h2 class="cs-section-title">More customer stories</h2>
      <div class="cs-related-grid">
        {relatedLogos.map(({ customer: r, logo }) => (
          <a href={`/case-studies/${r.slug}`} class="cs-related-card">
            <div class="cs-related-head">
              {logo ? (
                <span class="cs-related-mark cs-related-mark-img" aria-hidden="true">
                  <img
                    src={logo.src}
                    alt=""
                    style={{ aspectRatio: `${Math.round(logo.ratio * 10)} / 10` }}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : (
                <span class="cs-related-mark" aria-hidden="true">{r.logoText.charAt(0)}</span>
              )}
              <span class="cs-related-meta">
                <span class="cs-related-name">{r.name}</span>
                <span class="cs-related-industry">{r.industry}</span>
              </span>
            </div>
            <h3 class="cs-related-title">{r.headline}</h3>
            <div class="cs-related-chips">
              {r.products.slice(0, 3).map((p) => (
                <span class="cs-related-chip">{p}</span>
              ))}
            </div>
            <span class="cs-related-read">
              Read Case Study
              <span class="cs-related-arrow" aria-hidden="true"><ArrowRight size={14} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 FINAL CTA -->
  <section class="cs-final">
    <div class="sec">
      <div class="cs-final-card">
        <h2 class="cs-final-title">See how DeepEcom can work for your business.</h2>
        <div class="cs-final-ctas">
          <a href="/contact" class={buttonVariants({ size: "lg" })}>
            Book a Demo <ArrowRight size={16} />
          </a>
          <a href="/customers" class="cs-final-ghost">All Case Studies</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  main .sec, main .sec-narrow { padding-block: clamp(1.75rem, 3.4vh, 3rem); }

  /* Hero */
  .csh-hero { padding: clamp(5rem, 10vh, 7rem) 0 clamp(2rem, 4vh, 3rem); }
  .csh-back { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; font-weight: 600; color: var(--brand-600); text-decoration: none; margin-bottom: 1.5rem; }
  .csh-back:hover { text-decoration: underline; }
  .csh-inner { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; }
  @media (min-width: 64rem) { .csh-inner { grid-template-columns: 1.2fr 0.8fr; } }
  .csh-industry { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-600); }
  .csh-title { margin-top: 0.75rem; font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.12; letter-spacing: -0.03em; font-weight: 800; color: var(--ink-950); }
  .csh-problem { margin-top: 1rem; font-size: 1rem; line-height: 1.65; color: var(--ink-500); max-width: 38rem; }
  .csh-logo-card {
    background: linear-gradient(180deg, #ffffff 0%, #fcfcff 100%);
    border: 1px solid var(--ink-200); border-radius: 14px;
    padding: 2rem; text-align: center;
    box-shadow: 0 1px 2px rgba(11,17,32,0.04), 0 10px 30px -14px rgba(11,17,32,0.1);
  }
  .csh-logo { display: block; font-size: 1.5rem; font-weight: 800; color: var(--ink-900); }
  .csh-type { margin-top: 0.5rem; font-size: 0.75rem; font-weight: 600; color: var(--brand-600); background: var(--brand-50); border: 1px solid var(--brand-100); border-radius: 999px; padding: 0.2rem 0.6rem; display: inline-block; }

  /* Case hero visual (pipeline) */
  .csh-viz {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ink-200);
    border-radius: 18px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfbfd 100%);
    box-shadow: 0 1px 2px rgba(11,17,32,0.05), 0 24px 48px -22px rgba(11,17,32,0.18);
    padding: 1.25rem;
    max-width: 22rem;
    min-width: 0;
  }
  .csh-viz::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 70% at 50% -20%, rgba(83,58,253,0.07), transparent 60%);
  }
  .csh-viz-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0 0.25rem 0.9rem;
    border-bottom: 1px solid var(--ink-150, var(--ink-200));
  }
  .csh-viz-mark {
    flex: none;
    width: 36px; height: 36px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: linear-gradient(150deg, #533afd, #2c1b8d);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    /* box-shadow: 0 8px 16px -8px rgba(83,58,253,0.55); */
  }
  .csh-viz-mark-img {
    width: auto;
    min-width: 36px;
    padding: 0 5px;
    background: transparent;
  }
  .csh-viz-mark-img img {
    width: auto;
    max-width: 72px;
    max-height: 28px;
    object-fit: contain;
  }
  .csh-viz-meta { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .csh-viz-name { font-size: 1rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ink-900); }
  .csh-viz-type { font-size: 0.72rem; font-weight: 600; color: var(--ink-400); text-transform: capitalize; }
  .csh-viz-tag {
    margin-left: auto;
    flex: none;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--brand-700);
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  .csh-vflow { display: flex; flex-direction: column; align-items: stretch; margin-top: 1rem; }
  .csh-node {
    border: 1px solid var(--ink-200);
    border-radius: 12px;
    background: #fff;
    padding: 0.75rem 0.85rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .csh-node-label { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-400); }
  .csh-node-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .csh-chip {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-600);
    background: var(--ink-100);
    border: 1px solid var(--ink-200);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }
  .csh-chip-more { color: var(--ink-400); background: transparent; border-style: dashed; }
  .csh-chip-brand {
    color: var(--brand-700);
    background: var(--brand-50);
    border-color: var(--brand-100);
  }

  .csh-vline {
    position: relative;
    height: 30px;
    display: flex;
    justify-content: center;
  }
  .csh-vline::before {
    content: "";
    width: 1.5px;
    height: 100%;
    background-image: repeating-linear-gradient(to bottom, var(--brand-400) 0px 5px, transparent 5px 11px);
    animation: csh-vflow 0.8s linear infinite;
  }
  .csh-vline::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 0; height: 0;
    border-left: 4.5px solid transparent;
    border-right: 4.5px solid transparent;
    border-top: 5px solid var(--brand-500);
  }
  @media (prefers-reduced-motion: reduce) { .csh-vline::before { animation: none; } }
  @keyframes csh-vflow {
    to { background-position: 0 -11px; }
  }

  .csh-deepecom {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    padding: 1rem 1.1rem;
    text-align: center;
    background:
      radial-gradient(120% 100% at 50% -30%, rgba(160,140,255,0.45), transparent 55%),
      linear-gradient(150deg, #1e1560 0%, #2c1b8d 55%, #533afd 130%);
    box-shadow: 0 1px 2px rgba(11,17,32,0.05), 0 16px 32px -16px rgba(83,58,253,0.5);
    color: #fff;
  }
  .csh-deepecom-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #cfc6ff;
  }
  .csh-deepecom-brand::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 999px;
    background: #a78bfa;
    box-shadow: 0 0 0 3px rgba(167,139,250,0.3);
  }
  .csh-deepecom-steps {
    margin-top: 0.55rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .csh-step {
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(255,255,255,0.13);
    border: 1px solid rgba(255,255,255,0.24);
    border-radius: 999px;
    padding: 0.28rem 0.7rem;
    white-space: nowrap;
  }
  .csh-step-arrow { color: rgba(255,255,255,0.65); font-size: 0.75rem; }
  @media (min-width: 64rem) {
    .csh-viz { margin-left: auto; }
  }

  /* Quote */
  .csq-section { padding: clamp(1.5rem, 3vh, 2.5rem) 0; }
  .csq-card {
    background: linear-gradient(180deg, #ffffff 0%, #fcfcff 100%);
    border: 1px solid var(--ink-200); border-radius: 16px;
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 1px 2px rgba(11,17,32,0.04), 0 10px 30px -14px rgba(11,17,32,0.1);
    border-left: 4px solid var(--brand-500);
    position: relative; overflow: hidden;
  }
  .csq-card::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(130% 70% at 50% -30%, rgba(83,58,253,0.04), transparent 62%); }
  .csq-mark { position: relative; font-size: 4rem; line-height: 1; font-weight: 800; color: var(--brand-200); }
  .csq-text { position: relative; margin-top: 0.5rem; font-size: 1.2rem; line-height: 1.65; color: var(--ink-700); font-style: italic; }
  .csq-meta { position: relative; display: flex; flex-direction: column; gap: 0.15rem; margin-top: 1rem; font-style: normal; }
  .csq-author { font-size: 0.9rem; font-weight: 700; color: var(--ink-900); }
