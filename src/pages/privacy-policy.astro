---
import PageLayout from "@/layouts/PageLayout.astro"
import CtaBand from "@/components/pages/shared/CtaBand.astro"
import Breadcrumbs from "@/components/resources/Breadcrumbs.astro"
import "@/styles/resources.css"

const sections = [
  { id: "information-we-collect", num: "01", title: "Information We Collect" },
  { id: "how-we-use-your-information", num: "02", title: "How We Use Your Information" },
  { id: "data-sharing-and-disclosure", num: "03", title: "Data Sharing and Disclosure" },
  { id: "chrome-extension", num: "04", title: "DeepEcom Chrome Extension" },
  { id: "data-retention-and-deletion-policy", num: "05", title: "Data Retention and Deletion Policy" },
  { id: "data-security-measures", num: "06", title: "Data Security Measures" },
  { id: "user-rights-and-choices", num: "07", title: "User Rights and Choices" },
  { id: "updates-to-this-policy", num: "08", title: "Updates to This Policy" },
  { id: "contact-us", num: "09", title: "Contact Us" },
]
---

<PageLayout
  title="Privacy Policy — DeepEcom"
  description="How DeepEcom collects, uses, shares, stores and deletes the data that flows between your marketplaces and ERP."
>
  <main class="rs-section-tight" style="padding-top:5.5rem">
    <div class="rs-container">
      <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Privacy Policy" }]} />

      <header class="rs-article-header" style="margin-bottom:1.75rem">
        <span class="rs-card-chip">Legal</span>
        <h1 class="rs-hero-title" style="margin-top:0.85rem">Privacy Policy</h1>
        <p class="rs-hero-lead" style="max-width:40rem">
          How we collect, use, share, store and delete the data that flows through DeepEcom.
        </p>
        <div class="rs-article-meta">
          <span>Effective date · 14-10-2026</span>
          <span>·</span>
          <span>9 sections</span>
        </div>
      </header>

      <div class="rs-article">
        <div>
          <article class="rs-prose" id="article-body">
            <p>
              DeepEcom Technologies Pvt Ltd ("DeepEcom," "we," "our," or "us") respects your privacy
              and is committed to protecting your personal information. This Privacy Policy explains
              how we collect, use, share, store, and delete data when you use deepecom.com, the
              DeepEcom web application, and the DeepEcom Chrome extension (together, the
              "Services"), in line with applicable law and the terms of the marketplaces you connect.
            </p>

            <h2 id="information-we-collect">Information We Collect</h2>
            <p>
              We collect only what the Services need. You choose which marketplaces and ERP systems
              to connect.
            </p>
            <ul>
              <li>
                <strong>Personally Identifiable Information (PII):</strong> Names, email addresses,
                phone numbers, business and billing details, and shipping information provided by
                sellers using our Services, including customer details (such as names and delivery
                addresses) that appear in marketplace orders you connect.
              </li>
              <li>
                <strong>Order and Transaction Data:</strong> Order history, tax invoices, payment and
                settlement details, and reconciliation data from the marketplaces and ERP systems you
                connect.
              </li>
              <li>
                <strong>Technical and Usage Data:</strong> IP addresses, device details, browser type,
                and interaction logs, including through cookies and similar technologies.
              </li>
              <li>
                <strong>Chrome Extension Data:</strong> Account identifiers, session tokens, and, for
                marketplaces you connect, session information used to download the reports you
                request (see Section 4).
              </li>
            </ul>
            <p>Our Services are for businesses and are not directed at anyone under 18.</p>

            <h2 id="how-we-use-your-information">How We Use Your Information</h2>
            <p>We use your data for the following purposes:</p>
            <ul>
              <li>
                <strong>Providing Services:</strong> To facilitate ecommerce automation, including
                payment reconciliation, tax invoicing, ERP accounting, and compliance management.
              </li>
              <li>
                <strong>Order Fulfilment Support:</strong> To process shipping information for seller
                orders where you use our tools for this.
              </li>
              <li>
                <strong>Regulatory Compliance:</strong> To meet financial and tax compliance
                requirements based on regional regulations.
              </li>
              <li>
                <strong>Security &amp; Fraud Prevention:</strong> To safeguard user data and prevent
                fraudulent activities.
              </li>
              <li>
                <strong>Customer Support and Improvement:</strong> To assist with inquiries and
                improve the Services.
              </li>
            </ul>
            <p>
              We do not use your data for advertising, and we use data received from marketplaces
              only to provide the Services you request.
            </p>

            <h2 id="data-sharing-and-disclosure">Data Sharing and Disclosure</h2>
            <p>
              We do not sell or rent your personal information. We may share data in these
              circumstances:
            </p>
            <ul>
              <li>
                <strong>With Marketplaces and ERP Systems You Connect:</strong> Such as Amazon
                (SP-API), Flipkart, Meesho, Shopify, and Tally, as necessary to fulfil marketplace
                order, tax, and accounting processing requirements.
              </li>
              <li>
                <strong>With Authorized Third-Party Service Providers:</strong> For hosting and
                storage, real-time messaging, payment processing, tax calculations, and shipment
                fulfilment. They may use data only on our instructions and under confidentiality
                obligations.
              </li>
              <li>
                <strong>With Government and Regulatory Bodies:</strong> If required by law or for tax
                compliance.
              </li>
              <li>
                <strong>In a Business Transfer:</strong> If DeepEcom is involved in a merger,
                acquisition, or sale of assets, data may pass to the successor, which must honour
                this policy.
              </li>
            </ul>
            <p>
              Data is stored primarily in India. Our service providers may process data outside India
              as permitted by law.
            </p>

            <h2 id="chrome-extension">DeepEcom Chrome Extension</h2>
            <p>
              The extension lets you sync marketplace reports and post accounting data from the
              DeepEcom dashboard to your ERP, such as Tally.
            </p>
            <ul>
              <li>
                <strong>What it accesses:</strong> Your DeepEcom account identifiers and session
                tokens; session information for marketplaces you connect, used to download reports
                you request; the reports and accounting data you choose to sync; and the ERP
                addresses you approve.
              </li>
              <li>
                <strong>Your control:</strong> The extension requests access to a specific ERP
                address only when you click to grant it, sends data only to addresses you approve,
                and you can remove access at any time in the extension or in Chrome's extension
                settings.
              </li>
              <li>
                <strong>Secure connections:</strong> We use encrypted connections wherever the
                destination supports them. Some ERP systems on the same computer or a private
                network accept only unencrypted connections; we use these only for addresses you
                approve.
              </li>
              <li>
                <strong>Browser storage:</strong> Settings, pending jobs, and session information are
                kept in the extension's storage in your browser and are removed when you uninstall
                it.
              </li>
              <li>
                <strong>Limited Use:</strong> DeepEcom's use and transfer of information received
                through the DeepEcom Chrome extension adheres to the Chrome Web Store User Data
                Policy, including the Limited Use requirements. We use this information only to
                provide the features described here, and not for advertising, resale, or credit
                decisions.
              </li>
              <li>
                <strong>Consent:</strong> The extension asks for your consent before it starts
                handling data.
              </li>
            </ul>

            <h2 id="data-retention-and-deletion-policy">Data Retention and Deletion Policy</h2>
            <p>
              We retain your data only for as long as required for the purposes stated above. Our
              data deletion process includes:
            </p>
            <ul>
              <li>
                <strong>User-Initiated Deletion:</strong> You may request deletion of your account
                and associated data by contacting{" "}
                <a href="mailto:privacy@deepecom.com">privacy@deepecom.com</a>. Upon verification, we
                will delete your data within <strong>30 days</strong>.
              </li>
              <li>
                <strong>Automatic Data Deletion:</strong> We delete data from accounts that stay
                inactive for <strong>a defined period</strong>, after notifying you in advance,
                unless we are legally required to retain it.
              </li>
              <li>
                <strong>PII Anonymization:</strong> If immediate deletion is not possible due to
                compliance obligations, we anonymize data to prevent identification.
              </li>
              <li>
                <strong>Backup Data:</strong> Encrypted backups are retained for up to{" "}
                <strong>90 days</strong> before permanent deletion.
              </li>
            </ul>

            <h2 id="data-security-measures">Data Security Measures</h2>
            <p>
              We use reasonable technical and organizational safeguards to protect your information,
              including:
            </p>
            <ul>
              <li>
                <strong>Encryption:</strong> Data is encrypted in transit using industry-standard
                protocols (TLS) wherever the destination supports it, and backups are encrypted.
              </li>
              <li>
                <strong>Access Control Mechanisms:</strong> To restrict access to authorized
                personnel only.
              </li>
              <li>
                <strong>Regular Security Reviews:</strong> To maintain our security practices in line
                with industry standards.
              </li>
            </ul>
            <p>
              No system is completely secure. If a breach affects your data, we will notify you and
              the authorities as the law requires.
            </p>

            <h2 id="user-rights-and-choices">User Rights and Choices</h2>
            <p>You have the right to:</p>
            <ul>
              <li>Access, correct, or delete your personal data.</li>
              <li>Request details on how your data is processed.</li>
              <li>Withdraw your consent at any time, which stops processing that depends on it.</li>
              <li>Nominate another person to exercise these rights on your behalf.</li>
              <li>Opt out of non-essential data collection and marketing communications.</li>
            </ul>
            <p>
              For any requests, please contact{" "}
              <a href="mailto:privacy@deepecom.com">privacy@deepecom.com</a>. We will respond within
              the time the law requires, and in any case within <strong>90 days</strong>.
            </p>

            <h2 id="updates-to-this-policy">Updates to This Policy</h2>
            <p>
              We may update this Privacy Policy periodically to reflect changes in our Services or
              legal requirements. We will post the updated version here with a new date, and notify
              users via email or in-app announcements before material changes take effect.
            </p>

            <h2 id="contact-us">Contact Us</h2>
            <p>
              If you have any questions about this Privacy Policy or our data handling practices,
              please contact:
            </p>
            <blockquote>
              <p><strong>DeepEcom Technologies Pvt Ltd</strong></p>
              <p>
                GVRX+29H, Liberty Phase 2, Ragvilas Society, Koregaon Park, Pune, Maharashtra 411001
              </p>
              <p>
                Email: <a href="mailto:privacy@deepecom.com">privacy@deepecom.com</a>
              </p>
              <p>
                Website:{" "}
                <a href="https://deepecom.com/">deepecom.com</a>
              </p>
            </blockquote>

            <hr />

            <p>
              By using our Services, you acknowledge this Privacy Policy. The Chrome extension asks
              for your consent separately before it handles data.
            </p>
          </article>
        </div>

        <aside>
          <nav class="rs-toc" aria-label="On this page">
            <span class="rs-toc-title">On this page</span>
            <ul>
              {sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      </div>
    </div>
  </main>

  <CtaBand
    dark
    title="Questions about how DeepEcom handles your data?"
    lead="Book a demo and see how marketplace data becomes clean, accounted, ERP-ready information."
  />
</PageLayout>
