---
import AdminLayout from "@/layouts/AdminLayout.astro"
import { SAMPLE_DASHBOARD, type DashboardData, type SeoMetric } from "@/lib/seo-dashboard/data"
import { loadDashboard } from "@/lib/seo-dashboard/db"
import { ADMIN_COOKIE, verifyAdminToken } from "@/lib/admin-auth"
import KpiCard from "@/components/admin/seo/KpiCard.astro"
import VisibilityChart from "@/components/admin/seo/VisibilityChart.astro"
import RankingBars from "@/components/admin/seo/RankingBars.astro"
import KeywordTable from "@/components/admin/seo/KeywordTable.astro"
import Pipeline from "@/components/admin/seo/Pipeline.astro"
import ChangesTable from "@/components/admin/seo/ChangesTable.astro"
import LearningsList from "@/components/admin/seo/LearningsList.astro"

const useSample = Astro.url.searchParams.get("sample") === "1"
const CHART_RANGE = Math.min(Math.max(Number(Astro.url.searchParams.get("range")) || 28, 7), 90)

const METRICS: SeoMetric[] = ["traffic", "position"]
const metricParam = Astro.url.searchParams.get("metric") ?? ""
const metric: SeoMetric = METRICS.includes(metricParam as SeoMetric) ? (metricParam as SeoMetric) : "traffic"
const METRIC_LABEL: Record<SeoMetric, string> = { traffic: "Traffic", position: "Position" }

const AUTHENTICATED = verifyAdminToken(Astro.cookies.get(ADMIN_COOKIE)?.value)
if (!AUTHENTICATED) {
  return Astro.redirect("/admin/login")
}

const data: DashboardData = useSample ? SAMPLE_DASHBOARD : await loadDashboard()

const DAYS = 28
const MS_DAY = 86_400_000
const daily = data.daily
const latestMs = daily.length ? new Date(daily[daily.length - 1]!.sample_date).getTime() : Date.now()
const cutoff = (days: number) => latestMs - days * MS_DAY

const chartData = daily.filter((d) => new Date(d.sample_date).getTime() >= cutoff(CHART_RANGE))
const recent = daily.filter((d) => new Date(d.sample_date).getTime() >= cutoff(DAYS))
const prior = daily.filter((d) => {
  const t = new Date(d.sample_date).getTime()
  return t >= cutoff(DAYS * 2) && t < cutoff(DAYS)
})

const period = (rows: typeof daily) => {
  const clicks = rows.reduce((s, r) => s + r.clicks, 0)
  const impressions = rows.reduce((s, r) => s + r.impressions, 0)
  const position = rows.length ? rows.reduce((s, r) => s + r.position, 0) / rows.length : null
  const ctr = impressions ? clicks / impressions : null
  return { clicks, impressions, position, ctr }
}

const now = period(recent)
const prev = period(prior)
const hasNow = recent.length > 0
const hasPrev = prior.length > 0

const pctDelta = (a: number | null, b: number | null): number | undefined =>
  hasPrev && a !== null && b !== null && b !== 0 ? Math.round(((a - b) / b) * 1000) / 10 : undefined
const posDelta = (a: number | null, b: number | null): number | undefined =>
  hasPrev && a !== null && b !== null ? Math.round((a - b) * 10) / 10 : undefined

const totalKeywords = data.keywords.reduce((s, k) => s + k.count, 0)
const fmtInt = (n: number) => n.toLocaleString("en-IN")

const kpis = [
  {
    label: "Clicks",
    value: hasNow ? fmtInt(now.clicks) : "—",
    delta: pctDelta(now.clicks, prev.clicks),
    positiveIsGood: true,
    icon: "clicks" as const,
    hint: hasPrev ? undefined : "no prior window yet",
  },
  {
    label: "Impressions",
    value: hasNow ? fmtInt(now.impressions) : "—",
    delta: pctDelta(now.impressions, prev.impressions),
    positiveIsGood: true,
    icon: "impressions" as const,
    hint: hasPrev ? undefined : "no prior window yet",
  },
  {
    label: "Avg CTR",
    value: now.ctr !== null ? `${(now.ctr * 100).toFixed(1)}%` : "—",
    delta: pctDelta(now.ctr, prev.ctr),
    positiveIsGood: true,
    icon: "ctr" as const,
    hint: hasPrev ? undefined : "no prior window yet",
  },
  {
    label: "Avg position",
    value: now.position !== null ? now.position.toFixed(1) : "—",
    delta: posDelta(now.position, prev.position),
    positiveIsGood: false,
    icon: "position" as const,
    deltaSuffix: "",
    hint: hasPrev ? "lower is better" : "no prior window yet",
  },
]

const sourceLabel = useSample ? "SAMPLE data" : "live · DeepRank DB"
---

<AdminLayout title="SEO Dashboard — DeepEcom" description="DeepEcom SEO agent KPIs" active="seo" agentName="SEO Agent">
  <form slot="header-actions" method="post" action="/api/admin/logout">
    <button
      type="submit"
      class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-3 py-1.5 text-xs font-semibold text-ink-700 transition hover:border-danger-200 hover:bg-danger-50 hover:text-danger-700"
    >
      Sign out
    </button>
  </form>
  <>
    <section class="relative overflow-hidden border-b border-border bg-ink-950 text-white">
          <div
            class="pointer-events-none absolute inset-0"
            aria-hidden="true"
            style="background:
              radial-gradient(48rem 24rem at 82% -30%, rgba(33,101,236,0.32), transparent 60%),
              radial-gradient(30rem 18rem at 15% 110%, rgba(92,148,255,0.12), transparent 55%)"
          ></div>
          <div class="relative mx-auto max-w-7xl px-6 py-12 sm:px-8">
            <div class="flex flex-wrap items-end justify-between gap-8">
              <div>
                <p class="flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.16em] text-brand-400">
                  <span class="h-px w-8 bg-brand-500" aria-hidden="true"></span>
                  DeepRank · SEO Agent
                </p>
                <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-[2.6rem] sm:leading-[1.1]">SEO Agent KPIs</h1>
                <p class="mt-3.5 max-w-xl text-sm leading-relaxed text-white/60">
                  Track what the DeepEcom SEO agent is shipping — visibility, rankings, the opportunity
                  pipeline, and measured results of deployed changes.
                </p>
              </div>
              <div class="min-w-56 rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-4 backdrop-blur">
                <p class="flex items-center justify-end gap-2 text-[11px] font-semibold uppercase tracking-wider text-white/50">
                  <span
                    class="inline-block size-2 rounded-full"
                    style={`background:${useSample ? "var(--warning-500)" : "var(--success-500)"}`}
                    aria-hidden="true"
                  ></span>
                  {useSample ? "Sample" : "Live"}
                </p>
                <p class="mt-2 font-mono text-xl font-bold tabular-nums text-white">{data.dataFreshness ?? "—"}</p>
                <p class="mt-1 text-xs text-white/50">
                  {totalKeywords} keywords · {sourceLabel}
                </p>
              </div>
            </div>
          </div>
        </section>

        <main class="relative mx-auto max-w-7xl space-y-6 px-6 py-8 sm:px-8">
          <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            {kpis.map((k) => (
              <KpiCard {...k} />
            ))}
          </section>

          <section class="rounded-2xl border border-border bg-white p-6 shadow-card lg:col-span-3">
            <header class="flex flex-wrap items-center justify-between gap-4 border-b border-border px-2 pb-5">
              <div>
                <h2 class="text-sm font-semibold text-ink-950">Visibility over time</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">{METRIC_LABEL[metric]} · last {CHART_RANGE} days</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <nav class="flex items-center gap-1 rounded-lg border border-border bg-ink-50 p-0.5 text-xs" aria-label="Metric">
                  {METRICS.map((mk) => (
                    <a
                      href={`?range=${CHART_RANGE}&metric=${mk}`}
                      aria-current={mk === metric ? "page" : undefined}
                      class:list={[
                        "rounded-md px-2.5 py-1 font-semibold transition",
                        mk === metric ? "bg-white text-ink-900 shadow-sm" : "text-muted-foreground hover:text-ink-900",
                      ]}
                    >
                      {METRIC_LABEL[mk]}
                    </a>
                  ))}
                </nav>
                <nav class="flex items-center gap-1 rounded-lg border border-border bg-ink-50 p-0.5 text-xs" aria-label="Chart range">
                  {[7, 28, 90].map((r) => (
                    <a
                      href={`?range=${r}&metric=${metric}`}
                      aria-current={r === CHART_RANGE ? "page" : undefined}
                      class:list={[
                        "rounded-md px-2.5 py-1 font-semibold transition",
                        r === CHART_RANGE ? "bg-white text-ink-900 shadow-sm" : "text-muted-foreground hover:text-ink-900",
                      ]}
                    >
                      {r}d
                    </a>
                  ))}
                </nav>
              </div>
            </header>
            <div class="mt-6">
              {chartData.length >= 2 ? (
                <VisibilityChart days={chartData} metric={metric} range={CHART_RANGE} />
              ) : (
                <div class="flex h-40 items-center justify-center rounded-xl border border-dashed border-ink-200 text-center text-xs text-muted-foreground">
                  <p class="max-w-sm">
                    Not enough position samples yet in this range. The agent records a sample when it
                    creates a PR, so this chart fills in as the agent runs.
                  </p>
                </div>
              )}
            </div>
          </section>

          <section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="lg:col-span-1">
              <RankingBars buckets={data.buckets} />
            </div>
            <div class="lg:col-span-2">
              <KeywordTable movers={data.movers} />
            </div>
          </section>

          <section>
            <Pipeline stages={data.pipeline} />
          </section>

          <section>
            <ChangesTable changes={data.recentChanges} summary={data.changes} />
          </section>

          <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <LearningsList learnings={data.learnings} />
            <div class="rounded-2xl border border-border bg-white p-5 shadow-card">
              <header class="mb-4">
                <h3 class="text-sm font-semibold text-ink-950">Per-page breakdown</h3>
                <p class="text-xs text-muted-foreground">
                  Placeholder for a future per-page URL view and CSV export of dashboard data.
                </p>
              </header>
              <div class="flex h-40 items-center justify-center rounded-xl border border-dashed border-ink-200 text-xs text-muted-foreground">
                Coming soon
              </div>
            </div>
          </section>
        </main>
      </>
</AdminLayout>
