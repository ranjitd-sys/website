---
import AdminLayout from "@/layouts/AdminLayout.astro"
import { Mail, Search } from "lucide-react"
import { getAgentBySlug, type AdminAgentIcon } from "@/data/admin-nav"
import { ADMIN_COOKIE, verifyAdminToken } from "@/lib/admin-auth"

const isAdmin = verifyAdminToken(Astro.cookies.get(ADMIN_COOKIE)?.value)
if (!isAdmin) {
  return Astro.redirect("/admin/login")
}

const agent = getAgentBySlug(Astro.params.agent ?? "")
if (!agent) {
  return new Response(null, { status: 404, statusText: "Not Found" })
}

const ICONS: Record<AdminAgentIcon, typeof Search> = {
  search: Search,
  mail: Mail,
}
const Icon = ICONS[agent.icon]
---

<AdminLayout
  title={`${agent.name} — DeepEcom`}
  description={`${agent.name} — coming soon.`}
  active={agent.id}
  agentName={agent.name}
>
  <section class="relative flex min-h-[calc(100svh-3.5rem)] items-center justify-center overflow-hidden px-6 py-24">
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background:
        radial-gradient(44rem 22rem at 50% 0%, rgba(33,101,236,0.08), transparent 60%),
        radial-gradient(30rem 18rem at 85% 100%, rgba(92,148,255,0.06), transparent 55%)"
    ></div>

    <div class="relative w-full max-w-md rounded-2xl border border-border bg-white p-8 text-center shadow-card">
      <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-ink-50 text-ink-400" aria-hidden="true">
        <Icon size={26} strokeWidth={1.6} />
      </span>

      <p class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-warning-200 bg-warning-50 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-warning-700">
        <span class="size-1.5 rounded-full bg-warning-500" aria-hidden="true"></span>
        Coming soon
      </p>

      <h1 class="mt-3 text-2xl font-bold tracking-tight text-ink-950">{agent.name}</h1>
      <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">{agent.blurb}</p>

      <div class="mt-7 border-t border-border pt-5">
        <a
          href="/admin/seo"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition hover:text-brand-700"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M12 8H4M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Back to SEO Agent
        </a>
      </div>
    </div>
  </section>
</AdminLayout>
